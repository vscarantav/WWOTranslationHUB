      <item ident="g6cec9a549edb067496d6fe32f1651131" title="Canvas Notification">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.true_false.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;ol&gt;
&lt;li&gt;&lt;a class="inline_disabled" href="https://community.canvaslms.com/t5/Student-Guide/How-do-I-add-contact-methods-to-receive-Canvas-notifications-as/ta-p/516" target="_blank"&gt;Add your contact methods in Canvas&lt;/a&gt; so you can receive notifications, in your preferred delivery (text or email).&lt;/li&gt;
&lt;li&gt;&lt;a class="inline_disabled" href="https://community.instructure.com/en/kb/articles/662894-how-do-i-manage-my-canvas-notification-settings?utm_source=community-search&amp;amp;utm_medium=organic-search&amp;amp;utm_term=Set+your+notification+preferences+in+Canvas" target="_blank"&gt;Set your notification preferences in Canvas&lt;/a&gt; so you can be updated whenever there is a new announcement, comment or grade on your assignment, discussion update, etc.&amp;nbsp;&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;Image Explanation&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;The green bell means you will be notified immediately.&lt;/li&gt;
&lt;li&gt;The green page means you will be notified at the end of the day.&lt;/li&gt;
&lt;li&gt;&lt;span&gt;The green calendar means you will be notified at the end of the week.&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;The white bell means you do not want this notification.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;img id="60347678" src="$IMS-CC-FILEBASE$/media/W01%20Quiz:%20Syllabus%20Notifications.JPG" alt="Course Notifications screenshot showing a green calendar icon for Due dates and Grading Polices and showing a green bell icon for announcements." width="350" height="325" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;T/F: I can set notifications individually for each course.&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="296">
                <material>
                  <mattext texttype="text/plain">True</mattext>
                </material>
              </response_label>
              <response_label ident="479">
                <material>
                  <mattext texttype="text/plain">False</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">296</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
