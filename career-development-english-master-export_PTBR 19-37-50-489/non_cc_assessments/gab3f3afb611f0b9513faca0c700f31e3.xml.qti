    <item ident="g844306a27145f27a0bfad146aafb0ed6" title="Question 1">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>42240,23013,98462,78536</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What are the three steps in the Career Thinking Process?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="42240">
              <material>
                <mattext texttype="text/plain">Identify the skills required, Recognize skill transfer, Present skills professionally</mattext>
              </material>
            </response_label>
            <response_label ident="23013">
              <material>
                <mattext texttype="text/plain">List activities, Compare experiences, Write resumes</mattext>
              </material>
            </response_label>
            <response_label ident="98462">
              <material>
                <mattext texttype="text/plain">Find jobs, Apply online, Follow up</mattext>
              </material>
            </response_label>
            <response_label ident="78536">
              <material>
                <mattext texttype="text/plain">Research employers, Practice interviews, Accept offers</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">23013</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="23013_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">98462</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="98462_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">78536</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="78536_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">42240</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="23013_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">These steps do not match the Career Thinking Process described in the text. The process includes identifying skills required, recognizing skill transfer, and presenting skills professionally.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="98462_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">These are job search activities, not the Career Thinking Process steps. The text identifies the three steps as identifying skills required, recognizing skill transfer, and presenting skills professionally.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="78536_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">These represent later job search stages than the Career Thinking Process. The text outlines three specific steps: identifying skills required, recognizing skill transfer, and presenting skills professionally.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g3a0e583d2c6349dadff4206d822649d4" title="Question 10">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>63600,24133,41176,25244</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;According to Elder Uchtdorf, how does growth happen in the world God created?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="63600">
              <material>
                <mattext texttype="text/plain">Gradually and patiently, but consistently and unrelentingly</mattext>
              </material>
            </response_label>
            <response_label ident="24133">
              <material>
                <mattext texttype="text/plain">Through sudden breakthroughs and dramatic changes</mattext>
              </material>
            </response_label>
            <response_label ident="41176">
              <material>
                <mattext texttype="text/plain">Only through formal education programs</mattext>
              </material>
            </response_label>
            <response_label ident="25244">
              <material>
                <mattext texttype="text/plain">By waiting for perfect opportunities</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">24133</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="24133_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">41176</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="41176_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">25244</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="25244_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">63600</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="24133_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This contradicts Elder Uchtdorf's teaching. The text quotes him teaching that growth happens gradually and patiently, but consistently and unrelentingly.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="41176_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Elder Uchtdorf's teaching applies to all growth, not just formal education. The text emphasizes gradual, patient, consistent, and unrelenting progress.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="25244_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This misrepresents the teaching about active, consistent effort. The text quotes Elder Uchtdorf explaining that growth happens gradually and patiently, but consistently and unrelentingly.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gdbda632a0e10b9c9d5e7a2d90f924e63" title="Question 11">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>88574,75994,72943,51396</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does Elder L. Tom Perry teach about independence and self-reliance?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="88574">
              <material>
                <mattext texttype="text/plain">They are critical to spiritual and temporal growth</mattext>
              </material>
            </response_label>
            <response_label ident="75994">
              <material>
                <mattext texttype="text/plain">They only matter for financial success</mattext>
              </material>
            </response_label>
            <response_label ident="72943">
              <material>
                <mattext texttype="text/plain">They threaten our connection to God</mattext>
              </material>
            </response_label>
            <response_label ident="51396">
              <material>
                <mattext texttype="text/plain">They should be avoided in favor of dependence</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">75994</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="75994_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">72943</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="72943_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">51396</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="51396_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">88574</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="75994_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Elder Perry's teaching extends beyond finances. The text quotes him saying independence and self-reliance are critical to spiritual and temporal growth.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="72943_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This contradicts Elder Perry's teaching. He taught that independence and self-reliance are critical to spiritual and temporal growth.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="51396_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This is opposite to Elder Perry's message. The text emphasizes that independence and self-reliance are critical to spiritual and temporal growth.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
