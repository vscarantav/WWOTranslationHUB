    </item>
    <item ident="g1d15d35ce4465a156a599f677bac2a31" title="Question 16">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9129,51206,96267,4268</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What type of culture values building personal relationships before discussing business?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9129">
              <material>
                <mattext texttype="text/plain">Relationship-first cultures</mattext>
              </material>
            </response_label>
            <response_label ident="51206">
              <material>
                <mattext texttype="text/plain">Direct communication cultures</mattext>
              </material>
            </response_label>
            <response_label ident="96267">
              <material>
                <mattext texttype="text/plain">Egalitarian cultures</mattext>
              </material>
            </response_label>
            <response_label ident="4268">
              <material>
                <mattext texttype="text/plain">Fast-paced cultures</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">51206</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="51206_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">96267</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="96267_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4268</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4268_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">9129</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="51206_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Direct cultures move quickly to business discussions. The text identifies relationship-first cultures as those that build personal connections before business.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="96267_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This describes hierarchy structure, not communication timing. The text defines relationship-first cultures as those building personal connections before business.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4268_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Fast-paced cultures expect quick transitions. The text explains that relationship-first cultures establish trust before discussing business.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
