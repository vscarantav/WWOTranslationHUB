          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="79846_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Waiting is not appropriate. You should immediately seek guidance from supervisors or mentors rather than hoping problems will resolve themselves.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="8151_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Blaming damages reputation. You should immediately seek guidance from supervisors or mentors to address performance struggles.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="18963_fb">
        <flow_mat>
          <material>
