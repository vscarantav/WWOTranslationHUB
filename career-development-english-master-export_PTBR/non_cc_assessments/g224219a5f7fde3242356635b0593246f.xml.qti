              </material>
            </response_label>
            <response_label ident="79846">
              <material>
                <mattext texttype="text/plain">Wait for the problem to resolve itself</mattext>
              </material>
            </response_label>
            <response_label ident="8151">
              <material>
                <mattext texttype="text/plain">Blame others for the difficulties</mattext>
              </material>
            </response_label>
            <response_label ident="18963">
              <material>
                <mattext texttype="text/plain">Post about frustrations on social media</mattext>
              </material>
            </response_label>
