                <mattext texttype="text/plain">Gather Complete Information</mattext>
              </material>
            </response_label>
            <response_label ident="35844">
              <material>
                <mattext texttype="text/plain">Apply Weighted Decision Framework</mattext>
              </material>
            </response_label>
            <response_label ident="93395">
              <material>
                <mattext texttype="text/plain">Test Through Service</mattext>
              </material>
            </response_label>
          </render_choice>
