      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What should you do first when mastering basic professional competencies?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="34949">
              <material>
                <mattext texttype="text/plain">Show up on time, every time</mattext>
              </material>
            </response_label>
            <response_label ident="92599">
              <material>
                <mattext texttype="text/plain">Seek advancement opportunities</mattext>
              </material>
            </response_label>
            <response_label ident="55669">
              <material>
                <mattext texttype="text/plain">Negotiate for higher compensation</mattext>
              </material>
            </response_label>
            <response_label ident="89595">
              <material>
                <mattext texttype="text/plain">Build an extensive professional network</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">92599</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="92599_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">55669</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="55669_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">89595</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="89595_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">34949</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="92599_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Advancement comes after mastering basics. You must first demonstrate consistent excellence in fundamental behaviors like showing up on time.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="55669_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Negotiation comes after demonstrating competence. First, you must master basic expectations like punctuality and deadline completion.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="89595_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Networking is important but comes after basics. You must first demonstrate fundamental workplace behaviors like consistent punctuality.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gd33c8772127f21181b5e2765e0a189e7" title="Question 15">
      <itemmetadata>
        <qtimetadata>
