          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;How would a theater manager use accounting information when determining profitability?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="63387">
              <material>
                <mattext texttype="text/plain">Compare ticket revenue against production costs and expenses</mattext>
              </material>
            </response_label>
            <response_label ident="38555">
              <material>
                <mattext texttype="text/plain">Count the number of audience members each night</mattext>
              </material>
            </response_label>
            <response_label ident="45864">
              <material>
                <mattext texttype="text/plain">Review critic reviews and audience feedback</mattext>
              </material>
            </response_label>
            <response_label ident="22529">
              <material>
                <mattext texttype="text/plain">Analyze competitor theater schedules</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">38555</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="38555_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">45864</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="45864_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">22529</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="22529_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">63387</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="38555_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Simply counting audience members does not provide profitability information. A theater manager needs to compare ticket revenue against production costs and expenses to determine profitability.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="45864_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Reviews and feedback measure artistic success but not financial profitability. Profitability requires comparing ticket revenue against production costs and expenses.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="22529_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Competitor analysis might inform future decisions but does not determine current profitability. This requires comparing ticket revenue against production costs and expenses.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
