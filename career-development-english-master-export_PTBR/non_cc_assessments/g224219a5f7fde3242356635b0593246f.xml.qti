    <item ident="g5519b8d6376450494986b6d84fdb0694" title="Question 1">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9236,35941,73489,8380</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does the five-step job offer evaluation process begin with?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9236">
              <material>
                <mattext texttype="text/plain">Gathering complete information about each opportunity</mattext>
              </material>
            </response_label>
            <response_label ident="35941">
              <material>
                <mattext texttype="text/plain">Applying a weighted decision framework</mattext>
              </material>
            </response_label>
            <response_label ident="73489">
              <material>
                <mattext texttype="text/plain">Seeking spiritual confirmation</mattext>
              </material>
            </response_label>
            <response_label ident="8380">
              <material>
                <mattext texttype="text/plain">Testing through service</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">35941</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="35941_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">73489</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="73489_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">8380</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="8380_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">9236</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="35941_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The weighted decision framework is the second step in the process. The evaluation begins with gathering complete information about each opportunity, including compensation, benefits, growth opportunities, work environment, and cultural fit factors.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="73489_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Spiritual confirmation comes after initial analysis. The process begins with gathering complete information about each opportunity before moving to spiritual seeking.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="8380_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Testing through service is a later step when possible. The evaluation process starts with gathering complete information about each opportunity.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g30058ed608978d361be81a8dfc1bfa40" title="Question 12">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>2790,20060,5134,18245</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What percentage of time is allocated to the Confirmation Phase in revelation-based decisions?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="2790">
              <material>
                <mattext texttype="text/plain">20% of decision-making time</mattext>
              </material>
            </response_label>
            <response_label ident="20060">
              <material>
                <mattext texttype="text/plain">40% of decision-making time</mattext>
              </material>
            </response_label>
            <response_label ident="5134">
              <material>
                <mattext texttype="text/plain">60% of decision-making time</mattext>
              </material>
            </response_label>
            <response_label ident="18245">
              <material>
                <mattext texttype="text/plain">80% of decision-making time</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">20060</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="20060_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5134</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5134_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">18245</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="18245_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">2790</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="20060_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Both Study Phase and Spiritual Seeking Phase receive 40% each. The Confirmation Phase receives 20% of decision-making time for identifying multiple witnesses.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5134_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">No single phase receives 60% of time. The Confirmation Phase is allocated 20% of decision-making time for looking for spiritual impressions and external confirmations.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="18245_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">No phase receives 80% of time. The Confirmation Phase uses 20% of decision-making time to identify multiple witnesses through spiritual impressions.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gf4e9531ecb97e8566679757ebdfa9b0e" title="Question 13">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>10189,95643,26372,89061</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the second step in the Four-Step Professional Negotiation Method?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="10189">
              <material>
                <mattext texttype="text/plain">Frame as Problem-Solving</mattext>
              </material>
            </response_label>
            <response_label ident="95643">
              <material>
                <mattext texttype="text/plain">Research and Prepare</mattext>
              </material>
            </response_label>
            <response_label ident="26372">
              <material>
                <mattext texttype="text/plain">Propose Specific Value Exchange</mattext>
              </material>
            </response_label>
            <response_label ident="89061">
              <material>
                <mattext texttype="text/plain">Maintain Relationship Focus</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">95643</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="95643_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">26372</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="26372_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">89061</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="89061_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">10189</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="95643_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Research and Prepare is the first step. The second step is Frame as Problem-Solving, presenting negotiations as collaborative solutions.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="26372_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Proposing value exchange is the third step. The second step is Frame as Problem-Solving to present negotiations collaboratively.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="89061_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Maintaining relationship focus is the fourth step. The second step is Frame as Problem-Solving rather than making adversarial demands.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ge32eb57841c2157cb47466cff0cd5b47" title="Question 14">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
