        </respcondition>
      </resprocessing>
      <itemfeedback ident="61247_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Gathering information is the first step. The third step is Seek Spiritual Confirmation through fasting and temple worship after initial analysis.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="35844_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Applying the framework is the second step. The third step is Seek Spiritual Confirmation after practical analysis is complete.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="93395_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Testing through service is the fourth step when possible. The third step is Seek Spiritual Confirmation after completing practical analysis.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g532e53c0f58daa8a52664ca4281726c4" title="Question 16">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>15714,98321,13988,9708</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What approach should you take when negotiations do not go your way?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="15714">
              <material>
                <mattext texttype="text/plain">Respond professionally and ask what would need to change</mattext>
              </material>
            </response_label>
            <response_label ident="98321">
              <material>
                <mattext texttype="text/plain">Accuse employers of unfair treatment</mattext>
              </material>
            </response_label>
            <response_label ident="13988">
              <material>
                <mattext texttype="text/plain">Post complaints on social media</mattext>
              </material>
            </response_label>
            <response_label ident="9708">
              <material>
                <mattext texttype="text/plain">Argue with decision makers</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">98321</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="98321_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">13988</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="13988_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9708</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9708_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">15714</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="98321_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Accusations damage professional reputation permanently. You should respond professionally and ask what would need to change for future consideration.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="13988_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Social media complaints harm your career prospects. You should respond professionally and ask about conditions for revisiting the request.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9708_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Arguing destroys professional relationships. You should respond professionally, thank them for considering your request, and ask about future possibilities.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g41bddb4a19f4a930c7dfe69fa31b7ea8" title="Question 17">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
