          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What defines Value-Creating Negotiation?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="49356">
              <material>
                <mattext texttype="text/plain">Professional negotiation that focuses on creating mutual benefits</mattext>
              </material>
            </response_label>
            <response_label ident="52228">
              <material>
                <mattext texttype="text/plain">Negotiation that extracts maximum personal advantage</mattext>
              </material>
            </response_label>
            <response_label ident="22943">
              <material>
                <mattext texttype="text/plain">Negotiation that avoids discussing compensation</mattext>
              </material>
            </response_label>
            <response_label ident="60068">
              <material>
                <mattext texttype="text/plain">Negotiation that applies only to senior positions</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">52228</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="52228_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">22943</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="22943_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">60068</varequal>
          </conditionvar>
