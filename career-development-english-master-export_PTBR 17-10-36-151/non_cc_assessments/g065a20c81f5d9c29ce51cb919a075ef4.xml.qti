    <item ident="g97dfbdff037500fb67f5577f0cf42ab9" title="Question 6">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>62563,2426,53244,19984</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does cultural adaptation in professional content mean according to the text?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="62563">
              <material>
                <mattext texttype="text/plain">Presenting truthful achievements using different emphasis based on cultural preferences</mattext>
              </material>
            </response_label>
            <response_label ident="2426">
              <material>
                <mattext texttype="text/plain">Creating different facts about your experience for different cultures</mattext>
              </material>
            </response_label>
            <response_label ident="53244">
              <material>
                <mattext texttype="text/plain">Using completely different resume content for each country</mattext>
              </material>
            </response_label>
            <response_label ident="19984">
              <material>
                <mattext texttype="text/plain">Removing experiences that might not translate culturally</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">2426</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="2426_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">53244</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="53244_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">19984</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="19984_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">62563</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="2426_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Cultural adaptation never involves changing facts or being dishonest. The text states it means presenting the same truthful achievements using different emphasis based on what each cultural context values.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="53244_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">You present the same honest experience with different emphasis, not completely different content. Cultural adaptation means emphasizing different aspects of truthful achievements based on cultural preferences.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="19984_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Cultural adaptation does not require removing experiences. The text explains it means presenting the same truthful achievements using language and emphasis that connects with specific cultural expectations.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
