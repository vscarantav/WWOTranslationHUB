          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>59900,89878,68450,50877</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;How much time does Phase 1 of portfolio development recommend spending on listing experiences?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="59900">
              <material>
                <mattext texttype="text/plain">Thirty minutes writing one sentence for each experience describing how you served others</mattext>
              </material>
            </response_label>
            <response_label ident="89878">
              <material>
                <mattext texttype="text/plain">Five hours creating detailed narratives</mattext>
              </material>
            </response_label>
            <response_label ident="68450">
              <material>
                <mattext texttype="text/plain">One full day reviewing all past activities</mattext>
              </material>
            </response_label>
            <response_label ident="50877">
              <material>
                <mattext texttype="text/plain">Fifteen minutes only</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">89878</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="89878_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">68450</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="68450_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">50877</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="50877_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">59900</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="89878_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Phase 1 requires focused, concise documentation. The text states you should spend thirty minutes writing one sentence for each experience describing how you served others.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="68450_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Phase 1 uses a structured, efficient approach. The text recommends spending thirty minutes writing one sentence for each experience describing how you served others.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="50877_fb">
        <flow_mat>
