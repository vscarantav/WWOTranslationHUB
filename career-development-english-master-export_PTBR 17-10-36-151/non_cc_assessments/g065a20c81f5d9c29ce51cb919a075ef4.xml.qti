    <item ident="g36f10a792ef737411d3f10624df6156b" title="Question 1">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>17769,41774,56599,23830</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does professional content creation document according to the faithful stewardship principle?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="17769">
              <material>
                <mattext texttype="text/plain">Evidence of how you have used God-given talents to serve others and create positive change</mattext>
              </material>
            </response_label>
            <response_label ident="41774">
              <material>
                <mattext texttype="text/plain">Your ability to compete successfully against other job candidates</mattext>
              </material>
            </response_label>
            <response_label ident="56599">
              <material>
                <mattext texttype="text/plain">Your superior qualifications compared to other professionals</mattext>
              </material>
            </response_label>
            <response_label ident="23830">
              <material>
                <mattext texttype="text/plain">Your work history and job titles over time</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">41774</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="41774_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">56599</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="56599_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">23830</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="23830_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">17769</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="41774_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Professional content creation focuses on documenting faithful stewardship over talents received from God, not on competing against others. The text emphasizes creating evidence of how you used abilities to serve others and create positive change.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="56599_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The text states that professional content is not about self-promotion or comparing yourself to others. It documents how you have used God-given talents to serve others and create measurable value.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="23830_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Professional content goes beyond simple work history listings. The text explains it documents faithful stewardship by showing how you used abilities to serve others and create positive impact.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gec8c73d65ccf364e2bfb660885c70b3a" title="Question 10">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>30421,23983,67350,60466</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What type of language should professional communications use when describing achievements?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="30421">
              <material>
                <mattext texttype="text/plain">Service-oriented language that emphasizes contributions to others' welfare</mattext>
              </material>
            </response_label>
            <response_label ident="23983">
              <material>
                <mattext texttype="text/plain">Competitive language that shows superiority over other candidates</mattext>
              </material>
            </response_label>
            <response_label ident="67350">
              <material>
                <mattext texttype="text/plain">Technical jargon to demonstrate expertise</mattext>
              </material>
            </response_label>
            <response_label ident="60466">
              <material>
                <mattext texttype="text/plain">Passive voice to appear modest</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">23983</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="23983_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">67350</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="67350_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">60466</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="60466_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">30421</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="23983_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Professional communications should not focus on competition. The text emphasizes using service-oriented language that shows how abilities contribute to others' welfare and organizational success.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="67350_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">While technical competence matters, communications should use service-oriented language. The text states you should emphasize how abilities contribute to others' welfare while demonstrating competence.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="60466_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The text recommends active voice and clear language. Professional communications should use service-oriented language that emphasizes contributions to others' welfare while demonstrating capabilities.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
