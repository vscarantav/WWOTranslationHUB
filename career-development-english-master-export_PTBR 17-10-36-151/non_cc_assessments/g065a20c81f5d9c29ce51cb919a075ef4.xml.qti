            <fieldentry>13615,1729,34590,66316</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does the parable of the talents teach about professional content creation?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="13615">
              <material>
                <mattext texttype="text/plain">Show specific evidence of how you used gifts to create value for others</mattext>
              </material>
            </response_label>
            <response_label ident="1729">
              <material>
                <mattext texttype="text/plain">Keep your achievements private to remain humble</mattext>
              </material>
            </response_label>
            <response_label ident="34590">
              <material>
                <mattext texttype="text/plain">Compare your talents to those of other servants</mattext>
              </material>
            </response_label>
            <response_label ident="66316">
              <material>
                <mattext texttype="text/plain">Focus on effort expended rather than results achieved</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1729</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1729_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">34590</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="34590_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">66316</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="66316_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">13615</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="1729_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The faithful servant openly presented his achievements. The parable teaches that you should show specific evidence of how you used God-given gifts to create value for others.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="34590_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The text states God does not want us to compare abilities to others. The parable teaches showing specific evidence of how you used gifts to create value.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="66316_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The faithful servant showed concrete results, not just effort. The parable teaches showing specific evidence of how you used gifts to create measurable value for others.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
