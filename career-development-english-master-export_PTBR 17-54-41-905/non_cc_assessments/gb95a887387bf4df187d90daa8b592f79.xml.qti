      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which type of hiring culture values community trust and stakeholder management skills?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="28313">
              <material>
                <mattext texttype="text/plain">Relationship-based cultures</mattext>
              </material>
            </response_label>
            <response_label ident="50901">
              <material>
                <mattext texttype="text/plain">Merit-based cultures</mattext>
              </material>
            </response_label>
            <response_label ident="36222">
              <material>
                <mattext texttype="text/plain">Individualist cultures</mattext>
              </material>
            </response_label>
            <response_label ident="61187">
              <material>
                <mattext texttype="text/plain">Formal business cultures</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">50901</varequal>
          </conditionvar>
