              </material>
            </response_label>
            <response_label ident="67035">
              <material>
                <mattext texttype="text/plain">Tuesday</mattext>
              </material>
            </response_label>
            <response_label ident="52916">
              <material>
                <mattext texttype="text/plain">Friday</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
