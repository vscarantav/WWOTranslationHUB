          <conditionvar>
            <varequal respident="response1">48105</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="48105_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">98448</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="98448_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">45143</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="45143_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">51009</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="48105_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Elder Maxwell did not teach conditional submission. He taught that submitting one's will is the only uniquely personal thing we have to place on God's altar.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="98448_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Elder Maxwell emphasized its unique importance. He taught that submitting one's will is the only uniquely personal thing we have to place on God's altar.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="45143_fb">
        <flow_mat>
