          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="71991_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">73058</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="73058_fb"/>
