    <item ident="g599c9689f337bc4cee1ce7de6cc9de57" title="Question 1">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>47914,86614,33776,64201</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What are the three main channels through which employment opportunities flow worldwide?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="47914">
              <material>
                <mattext texttype="text/plain">Visible job market, hidden job market, informal economy</mattext>
              </material>
            </response_label>
            <response_label ident="86614">
              <material>
                <mattext texttype="text/plain">Online applications, newspaper ads, recruitment agencies</mattext>
              </material>
            </response_label>
            <response_label ident="33776">
              <material>
                <mattext texttype="text/plain">Corporate hiring, government positions, family businesses</mattext>
              </material>
            </response_label>
            <response_label ident="64201">
              <material>
                <mattext texttype="text/plain">Digital platforms, networking events, career fairs</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">86614</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="86614_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">33776</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="33776_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">64201</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="64201_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">47914</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="86614_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">These are specific methods within job search channels rather than the three distinct channels themselves. The text identifies the visible job market, hidden job market, and informal economy as the three main employment channels.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="33776_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">These are types of employers rather than the three employment channels. The text describes the visible job market, hidden job market, and informal economy as the three channels through which opportunities flow.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="64201_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">These are tools used within job search channels rather than the channels themselves. The text identifies the visible job market, hidden job market, and informal economy as the three main channels.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g86d5e25dfc487716de39b193f2ec5d24" title="Question 10">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>68092,67675,90997,14520</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does the text recommend tracking to maintain motivation during job searching?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="68092">
              <material>
                <mattext texttype="text/plain">Multiple progress indicators including applications, relationships, and skills developed</mattext>
              </material>
            </response_label>
            <response_label ident="67675">
              <material>
                <mattext texttype="text/plain">Only job offers received</mattext>
              </material>
            </response_label>
            <response_label ident="90997">
              <material>
                <mattext texttype="text/plain">Just the number of interviews scheduled</mattext>
              </material>
            </response_label>
            <response_label ident="14520">
              <material>
                <mattext texttype="text/plain">Only responses from employers</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">67675</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="67675_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">90997</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="90997_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">14520</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="14520_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">68092</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="67675_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Tracking only job offers creates discouragement because offers represent just one outcome. The text recommends tracking multiple progress indicators.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="90997_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Interviews are only one indicator of progress. The text recommends tracking multiple progress indicators including applications, relationships, and skills developed.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="14520_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Employer responses are just one measure of progress. The text recommends tracking multiple indicators to maintain motivation through evidence of advancement.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g1ac25346472c51b17f92ebbf2a0d7f12" title="Question 11">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>55657,95326,11019,58048</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What scripture does the text reference regarding doing things in wisdom and order?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="55657">
              <material>
                <mattext texttype="text/plain">Mosiah 4:27</mattext>
              </material>
            </response_label>
            <response_label ident="95326">
              <material>
                <mattext texttype="text/plain">Matthew 13:3-23</mattext>
              </material>
            </response_label>
            <response_label ident="11019">
              <material>
                <mattext texttype="text/plain">Doctrine and Covenants 88:119</mattext>
              </material>
            </response_label>
            <response_label ident="58048">
              <material>
                <mattext texttype="text/plain">2 Nephi 2:25</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">95326</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="95326_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">11019</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="11019_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">58048</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="58048_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">55657</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="95326_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Matthew 13:3-23 contains the parable of the sower, which is referenced later in the text. The scripture about doing things in wisdom and order is Mosiah 4:27.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="11019_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This scripture is not mentioned in the text. The scripture about doing things in wisdom and order is Mosiah 4:27.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="58048_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This scripture is not mentioned in the text. The scripture about doing things in wisdom and order is Mosiah 4:27.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g53f51b0af3c8bfd339393cf9516e1e06" title="Question 12">
