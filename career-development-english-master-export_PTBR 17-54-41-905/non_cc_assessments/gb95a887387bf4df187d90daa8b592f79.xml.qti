        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="51009">
              <material>
                <mattext texttype="text/plain">It is the only uniquely personal thing we have to place on God's altar</mattext>
              </material>
            </response_label>
            <response_label ident="48105">
              <material>
                <mattext texttype="text/plain">It should be done only when comfortable</mattext>
              </material>
            </response_label>
            <response_label ident="98448">
              <material>
                <mattext texttype="text/plain">It is less important than other offerings</mattext>
              </material>
            </response_label>
            <response_label ident="45143">
              <material>
                <mattext texttype="text/plain">It requires no effort or sacrifice</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
