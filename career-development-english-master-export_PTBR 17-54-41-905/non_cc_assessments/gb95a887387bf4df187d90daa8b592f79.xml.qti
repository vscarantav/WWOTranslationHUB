    </item>
    <item ident="gc3c9392397d74c5eafe0ef4dab660855" title="Question 13">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>45099,16503,86530,5465</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What type of cultures emphasize group harmony, elder respect, and gradual relationship building?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="45099">
              <material>
                <mattext texttype="text/plain">Collectivist cultures</mattext>
              </material>
            </response_label>
            <response_label ident="16503">
              <material>
                <mattext texttype="text/plain">Individualist cultures</mattext>
              </material>
            </response_label>
            <response_label ident="86530">
              <material>
                <mattext texttype="text/plain">Merit-based cultures</mattext>
              </material>
            </response_label>
            <response_label ident="5465">
              <material>
                <mattext texttype="text/plain">Formal business cultures</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">16503</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="16503_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">86530</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="86530_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5465</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5465_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">45099</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="16503_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Individualist cultures highlight personal achievements and direct communication. Collectivist cultures emphasize group harmony, elder respect, and gradual relationship building.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="86530_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Merit-based cultures focus on measurable achievements and objective qualifications. Collectivist cultures emphasize group harmony, elder respect, and gradual relationship building.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5465_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Formal business cultures maintain professional boundaries and structured communication. Collectivist cultures emphasize group harmony, elder respect, and gradual relationship building.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gab9357866e9da032302217882879d838" title="Question 14">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>45551,30267,27852,50986</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which communication style uses direct language, explicit information, and clear expectations?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="45551">
              <material>
                <mattext texttype="text/plain">Low-context communication</mattext>
              </material>
            </response_label>
            <response_label ident="30267">
              <material>
                <mattext texttype="text/plain">High-context communication</mattext>
              </material>
            </response_label>
            <response_label ident="27852">
              <material>
                <mattext texttype="text/plain">Hierarchical communication</mattext>
              </material>
            </response_label>
            <response_label ident="50986">
              <material>
                <mattext texttype="text/plain">Relationship-first communication</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">30267</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="30267_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">27852</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="27852_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">50986</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="50986_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">45551</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="30267_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">High-context communication pays attention to nonverbal cues and indirect communication. Low-context communication uses direct language and explicit information.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="27852_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This describes a cultural structure rather than a communication style. Low-context communication uses direct language, explicit information, and clear expectations.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="50986_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This describes a networking approach rather than a communication style. Low-context communication uses direct language, explicit information, and clear expectations.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gafde2d7444b683215667317552cec426" title="Question 15">
