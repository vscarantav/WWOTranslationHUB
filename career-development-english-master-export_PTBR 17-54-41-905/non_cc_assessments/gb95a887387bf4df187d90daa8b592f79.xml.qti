    <item ident="g44bf8b1c567379a7c7e0ab1767515d1a" title="Question 18">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>36578,14348,13904,26949</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does the parable of the sower teach about job searching according to the text?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="36578">
              <material>
                <mattext texttype="text/plain">Success requires planting many seeds with faith and patience</mattext>
              </material>
            </response_label>
            <response_label ident="14348">
              <material>
                <mattext texttype="text/plain">All applications will result in job offers</mattext>
              </material>
            </response_label>
            <response_label ident="13904">
              <material>
                <mattext texttype="text/plain">Job searching should be done only when perfect opportunities appear</mattext>
              </material>
            </response_label>
            <response_label ident="26949">
              <material>
                <mattext texttype="text/plain">External factors are more important than personal effort</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">14348</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="14348_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">13904</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="13904_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">26949</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="26949_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">36578</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="14348_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This is unrealistic and not the teaching of the parable. The text explains that the parable teaches success requires planting many seeds with faith and patience, recognizing some will not grow.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="13904_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This contradicts the parable's teaching. The text explains that the parable teaches consistent effort and planting many seeds with faith and patience.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="26949_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This misinterprets the parable's message. The text teaches that success requires planting many seeds with faith and patience, emphasizing both effort and faith.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
