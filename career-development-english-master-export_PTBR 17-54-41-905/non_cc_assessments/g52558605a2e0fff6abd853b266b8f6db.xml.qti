            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>689,162,5605,3532,972</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Considerando o que torna uma boa foto de perfil do LinkedIn, examine cada imagem e relacione-a com o motivo pelo qual ela funciona bem ou mal como uma foto de perfil.&lt;/p&gt;
&lt;table style="border-collapse: collapse; width: 60%; height: auto;" border="1"&gt;
&lt;tbody&gt;
&lt;tr style="height: 361.891px;"&gt;
&lt;td style="width: 49.9643%; height: 361.891px;"&gt;
&lt;p&gt;&lt;strong&gt;&lt;img style="display: block; margin-left: auto; margin-right: auto;" src="$IMS-CC-FILEBASE$/assessment_questions/Image1.png?canvas_download=1" alt="Foto de perfil de uma mulher sob iluminação escura" width="320" height="297" loading="lazy"&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style="text-align: center;"&gt;&lt;strong&gt;Imagem 1&lt;/strong&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 49.9643%; height: 361.891px; text-align: center;"&gt;
&lt;p&gt;&lt;strong&gt;&lt;img src="$IMS-CC-FILEBASE$/assessment_questions/Image2.png?canvas_download=1" alt="Foto de perfil de uma mulher em pé em frente a um prédio" width="320" height="213" loading="lazy"&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Imagem 2&lt;/strong&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29px; text-align: center;"&gt;
&lt;td style="width: 49.9643%; height: 29px;"&gt;
&lt;p&gt;&lt;strong&gt;&lt;img src="$IMS-CC-FILEBASE$/assessment_questions/Image3.png?canvas_download=1" alt="Foto de perfil de uma mulher com um grupo de colegas de trabalho" width="320" height="213" loading="lazy"&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Imagem 3&lt;/strong&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 49.9643%; height: 29px;"&gt;
&lt;p&gt;&lt;strong&gt;&lt;img src="$IMS-CC-FILEBASE$/assessment_questions/Image4.png?canvas_download=1" alt="Foto de perfil de uma mulher em trajes profissionais" width="320" height="320" loading="lazy"&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Imagem 4&lt;/strong&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29px; text-align: center;"&gt;
&lt;td style="width: 49.9643%; height: 29px;"&gt;
&lt;p&gt;&lt;strong&gt;&lt;img src="$IMS-CC-FILEBASE$/assessment_questions/Image5.png?canvas_download=1" alt="Foto de perfil de uma mulher com roupas casuais" width="320" height="320" loading="lazy"&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Imagem 5&lt;/strong&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 49.9643%; height: 29px;"&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response_689">
          <material>
            <mattext texttype="text/plain">Imagem 1</mattext>
          </material>
          <render_choice>
            <response_label ident="8347">
              <material>
                <mattext>Foto de perfil ruim – Ela parece profissional. No entanto, a iluminação é ruim.</mattext>
              </material>
            </response_label>
            <response_label ident="4210">
              <material>
                <mattext>Foto de perfil ruim – Ela parece profissional, mas a foto foi tirada de muito longe; deveria ser um retrato de rosto mais próximo (headshot).</mattext>
