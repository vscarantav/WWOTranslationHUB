          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;(Consulte o vídeo &lt;strong&gt;Etiqueta no Zoom&lt;/strong&gt;.)&lt;/p&gt;
&lt;p&gt;Quais das seguintes opções são consistentes com boas práticas em sala de aula no Zoom? (Selecione todas as que se aplicam.)&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Multiple">
          <render_choice>
            <response_label ident="8741">
              <material>
                <mattext texttype="text/plain">Ser profissional e respeitoso</mattext>
              </material>
            </response_label>
            <response_label ident="5867">
              <material>
                <mattext texttype="text/plain">Assistir à aula ainda na cama e de pijama</mattext>
              </material>
            </response_label>
            <response_label ident="7018">
              <material>
                <mattext texttype="text/plain">Ligar a câmera</mattext>
              </material>
            </response_label>
            <response_label ident="329">
              <material>
                <mattext texttype="text/plain">Manter o microfone ligado o tempo todo</mattext>
              </material>
            </response_label>
            <response_label ident="5746">
              <material>
                <mattext texttype="text/plain">Configurar seu espaço para ser profissional e focado no aprendizado</mattext>
              </material>
            </response_label>
            <response_label ident="4317">
              <material>
                <mattext texttype="text/plain">Ser um participante ativo</mattext>
              </material>
            </response_label>
            <response_label ident="2650">
              <material>
                <mattext texttype="text/plain">Posicionar a câmera na altura dos olhos com uma luz forte atrás de você</mattext>
              </material>
