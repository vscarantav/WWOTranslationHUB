      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Preencha a lacuna: Neste curso, os alunos desenvolvem recursos, conexões profissionais e habilidades essenciais de empregabilidade para ____________________ em uma área relacionada ao seu certificado universitário.&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6592">
              <material>
                <mattext texttype="text/plain">diminuir o emprego</mattext>
              </material>
            </response_label>
            <response_label ident="1817">
              <material>
                <mattext texttype="text/plain">obter ou melhorar o emprego</mattext>
              </material>
            </response_label>
            <response_label ident="4264">
              <material>
                <mattext texttype="text/plain">manter o mesmo emprego</mattext>
              </material>
            </response_label>
            <response_label ident="6879">
              <material>
                <mattext texttype="text/plain">Nenhuma das opções</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">1817</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item><item ident="gde27bae964c50bf349061222c22bc405" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>matching_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
