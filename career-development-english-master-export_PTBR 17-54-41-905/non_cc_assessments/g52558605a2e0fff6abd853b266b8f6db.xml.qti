      </itemfeedback>
    </item>
    <item ident="gf94255951000c9126d0f659d9deddb7d" title="Pergunta">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>4916,5947</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;div&gt;Este é o primeiro curso do &lt;strong&gt;Certificado de Programação Web e de Computadores&lt;/strong&gt;.&lt;/div&gt;
&lt;div&gt;Os certificados do BYU-Pathway listam um nível de tecnologia (consulte os &lt;a class="inline_disabled" href="https://www.byupathway.edu/technology-requirements" target="_blank"&gt;Requisitos de Tecnologia do BYU-Pathway&lt;/a&gt; para obter todos os detalhes):&lt;/div&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Dispositivo Móvel&lt;/strong&gt;&lt;span&gt;: Smartphone (Android 9+ ou iOS 14+)&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Computação Leve&lt;/strong&gt;&lt;span style="font-family: inherit; font-size: 1rem;"&gt;: Notebook que possa executar o Microsoft Office (Word, Excel)&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Computação Pesada&lt;/strong&gt;: Notebook que possa executar softwares mais exigentes&lt;/li&gt;
&lt;/ul&gt;
&lt;div&gt;Todos os cursos do &lt;strong&gt;Certificado de Programação Web e de Computadores&lt;/strong&gt; exigem &lt;strong&gt;Computação Pesada&lt;/strong&gt; (um notebook que possa executar softwares mais exigentes).&lt;/div&gt;
&lt;h2&gt;&lt;strong&gt;Verificação rápida&lt;/strong&gt;&lt;/h2&gt;
&lt;div&gt;Você tem acesso a um notebook que atende ao requisito de &lt;strong&gt;Computação Pesada&lt;/strong&gt;?&lt;/div&gt;
&lt;div&gt;(Se tiver mais dúvidas, entre em contato com o seu instrutor.)&lt;/div&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="4916">
              <material>
                <mattext texttype="text/plain">Sim, eu tenho acesso a um notebook que pode executar softwares mais exigentes.</mattext>
              </material>
            </response_label>
            <response_label ident="5947">
              <material>
                <mattext texttype="text/plain">Não, eu não tenho acesso a um notebook que possa executar softwares mais exigentes.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5947</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5947_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">4916</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="5947_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Se você respondeu que não tem acesso a um notebook que possa executar softwares mais exigentes, entre em contato com o seu instrutor para obter ajuda.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
