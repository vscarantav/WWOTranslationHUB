            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>6188,4476,9899,9986</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;Quais duas opções abaixo o programa do curso apresentou sobre trabalhos atrasados?&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Multiple">
            <render_choice>
              <response_label ident="6188">
                <material>
                  <mattext texttype="text/plain">Como sinal de profissionalismo e respeito, os trabalhos devem ser enviados no prazo.</mattext>
                </material>
              </response_label>
              <response_label ident="4476">
                <material>
                  <mattext texttype="text/plain">Trabalhos atrasados nunca são aceitos.</mattext>
                </material>
              </response_label>
              <response_label ident="9899">
                <material>
                  <mattext texttype="text/plain">Trabalhos atrasados receberão nota 0, embora ainda possam ser enviados para obter pontos.</mattext>
                </material>
              </response_label>
              <response_label ident="9986">
                <material>
                  <mattext texttype="text/plain">Trabalhos atrasados não são avaliados.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
