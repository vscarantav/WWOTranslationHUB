  <assessment ident="ge621ffad72e4106026b463a6de547d38" title="Quiz S01: WhatsApp">
    <qtimetadata>
      <qtimetadatafield>
        <fieldlabel>cc_maxattempts</fieldlabel>
        <fieldentry>1</fieldentry>
      </qtimetadatafield>
    </qtimetadata>
    <section ident="root_section">
      <item ident="g6be224d0166ef1b3ca8cb463c98fd35e" title="Pergunta">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_answers_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>8163,4591</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;Eu baixei o WhatsApp.&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Multiple">
            <render_choice>
              <response_label ident="8163">
                <material>
                  <mattext texttype="text/plain">Sim</mattext>
                </material>
              </response_label>
              <response_label ident="4591">
                <material>
                  <mattext texttype="text/plain">Não</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <varequal respident="response1">8163</varequal>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="8163_fb"/>
          </respcondition>
          <respcondition continue="Yes">
            <conditionvar>
              <varequal respident="response1">4591</varequal>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="4591_fb"/>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <and>
                <varequal respident="response1">8163</varequal>
                <not>
                  <varequal respident="response1">4591</varequal>
                </not>
              </and>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="8163_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/plain">Bom trabalho.</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
        <itemfeedback ident="4591_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/plain">Por favor, pare aqui e siga as instruções antes de tentar concluir este quiz.</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
