    <item ident="gf57a091e542638e2e2dd5c478e948aae" title="Question 26">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>28838,88281,81751,92341</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does direct communication mean in cultural contexts?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="28838">
              <material>
                <mattext texttype="text/plain">Straightforward, explicit communication where people say exactly what they mean without expecting listeners to interpret subtle implications</mattext>
              </material>
            </response_label>
            <response_label ident="88281">
              <material>
                <mattext texttype="text/plain">Speaking loudly and forcefully to make points clear</mattext>
              </material>
            </response_label>
            <response_label ident="81751">
              <material>
                <mattext texttype="text/plain">Communicating only through face-to-face meetings</mattext>
              </material>
            </response_label>
            <response_label ident="92341">
              <material>
                <mattext texttype="text/plain">Always using formal business language in professional settings</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">88281</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="88281_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">81751</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="81751_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">92341</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="92341_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">28838</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="88281_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Direct communication refers to explicitness, not volume or force. It means saying exactly what you mean without relying on subtle implications or context.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="81751_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Direct communication describes the explicitness of the language, not the medium. It means stating intentions clearly rather than relying on subtle cues or implications.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="92341_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Direct communication refers to explicitness of meaning, not formality level. It describes saying exactly what you mean without expecting interpretation of subtle implications.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g87d68f94527bb0d8ac2a4679400dd16c" title="Question 27">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>2267,88156,45029,18269</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What was Sarah's key learning from her networking journey?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="2267">
              <material>
                <mattext texttype="text/plain">Her deep understanding of community health dynamics was exactly what international organizations needed for successful program implementation</mattext>
              </material>
            </response_label>
            <response_label ident="88156">
              <material>
                <mattext texttype="text/plain">She needed to move to another country for better opportunities</mattext>
              </material>
            </response_label>
            <response_label ident="45029">
              <material>
                <mattext texttype="text/plain">Local experience never translates to international opportunities</mattext>
              </material>
            </response_label>
            <response_label ident="18269">
              <material>
                <mattext texttype="text/plain">She should have pursued different work instead of health programs</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">88156</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="88156_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">45029</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="45029_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">18269</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="18269_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">2267</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="88156_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Sarah discovered the value of her local expertise, not the need to relocate. Her Philippine community health understanding became her competitive advantage for international opportunities.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="45029_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Sarah learned the opposite. Her local Philippine health experience became valuable international expertise when she presented it as bridge-building capability.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="18269_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Sarah stayed in health work and reframed her experience. She discovered that her community health expertise was exactly what international organizations needed.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g989105c5097e5f67664491de0d8d6c28" title="Question 28">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>59539,25167,8645,71898</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is indirect communication in cultural contexts?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="59539">
              <material>
                <mattext texttype="text/plain">Communication that relies on context, implication, and subtle cues to convey meaning</mattext>
              </material>
            </response_label>
            <response_label ident="25167">
              <material>
                <mattext texttype="text/plain">Communicating through written messages instead of speaking</mattext>
              </material>
            </response_label>
            <response_label ident="8645">
              <material>
                <mattext texttype="text/plain">Avoiding all professional communication whenever possible</mattext>
              </material>
            </response_label>
            <response_label ident="71898">
              <material>
                <mattext texttype="text/plain">Deliberately confusing messages to hide intentions</mattext>
              </material>
            </response_label>
          </render_choice>
