              </material>
            </response_label>
            <response_label ident="11499">
              <material>
                <mattext texttype="text/plain">40% to 50%</mattext>
              </material>
            </response_label>
            <response_label ident="64218">
              <material>
                <mattext texttype="text/plain">95% to 100%</mattext>
              </material>
