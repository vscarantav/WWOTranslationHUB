                <mattext texttype="text/plain">Phone calls, emails, text messages, and social media posts</mattext>
              </material>
            </response_label>
            <response_label ident="29068">
              <material>
                <mattext texttype="text/plain">Daily, weekly, monthly, and annual contact schedules</mattext>
              </material>
            </response_label>
            <response_label ident="47333">
              <material>
                <mattext texttype="text/plain">Formal meetings, casual conversations, written correspondence, and virtual calls</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
