        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">41428</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="41428_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">52016</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="86950_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Task-first cultures do build relationships. They focus on competence first and develop relationships through work collaboration rather than extensive personal conversation before business.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4579_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Task-first cultures value people but approach relationships differently. They build trust through demonstrated expertise and reliable performance rather than extensive personal conversation first.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="41428_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Task-first cultures allow friendships. They prefer developing relationships through work collaboration rather than extensive personal discussion before addressing business topics.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
