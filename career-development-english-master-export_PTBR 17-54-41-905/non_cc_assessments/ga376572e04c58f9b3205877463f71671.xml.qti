              <material>
                <mattext texttype="text/plain">Complete absence of any organizational structure</mattext>
              </material>
            </response_label>
            <response_label ident="65704">
              <material>
                <mattext texttype="text/plain">Informal communication only between same-level employees</mattext>
              </material>
            </response_label>
            <response_label ident="16305">
              <material>
                <mattext texttype="text/plain">Leadership positions that rotate frequently among all employees</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
