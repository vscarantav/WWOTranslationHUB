        </respcondition>
      </resprocessing>
      <itemfeedback ident="65999_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Hierarchy-focused cultures have clear structure, not absence of it. They emphasize formal communication rules and respect for titles, positions, and organizational authority.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="65704_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Hierarchy-focused cultures have formal cross-level communication rules, not restrictions. They emphasize following chain-of-command procedures and respecting organizational authority.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="16305_fb">
        <flow_mat>
          <material>
