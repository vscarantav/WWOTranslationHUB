      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What are task-first cultures?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="52016">
              <material>
                <mattext texttype="text/plain">Cultures that focus on competence first, with relationships developing through work collaboration</mattext>
              </material>
            </response_label>
            <response_label ident="86950">
              <material>
                <mattext texttype="text/plain">Cultures that never build personal relationships</mattext>
              </material>
            </response_label>
            <response_label ident="4579">
              <material>
                <mattext texttype="text/plain">Cultures that only value efficiency and ignore people</mattext>
              </material>
            </response_label>
            <response_label ident="41428">
              <material>
                <mattext texttype="text/plain">Cultures that prohibit workplace friendships</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
