      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What principle distinguishes hierarchy-focused cultures?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="23624">
              <material>
