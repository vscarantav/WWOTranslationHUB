          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g8cc3e216015b12d1a8168de155fbeda7" title="Question 23">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>46747,21956,49777,10506</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What cultural principle describes how some cultures view strict organizational hierarchies?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="46747">
              <material>
                <mattext texttype="text/plain">Hierarchy and authority respect</mattext>
              </material>
            </response_label>
            <response_label ident="21956">
              <material>
                <mattext texttype="text/plain">Personal and professional integration</mattext>
              </material>
            </response_label>
            <response_label ident="49777">
              <material>
                <mattext texttype="text/plain">Individual versus collective achievement focus</mattext>
              </material>
            </response_label>
            <response_label ident="10506">
              <material>
                <mattext texttype="text/plain">Relationship versus task orientation</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">21956</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="21956_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">49777</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="49777_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">10506</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="10506_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">46747</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="21956_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Personal and professional integration addresses how much personal information belongs in work relationships. Hierarchy and authority respect describes cultural approaches to organizational structure and communication.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="49777_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Individual versus collective achievement addresses celebration of personal or group success. Hierarchy and authority respect describes how cultures approach organizational structure and formal communication.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="10506_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Relationship versus task orientation addresses whether cultures prioritize personal connection or efficiency first. Hierarchy and authority respect describes cultural approaches to organizational structure.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g02864a28aff1ab3303d2dc04c2bf37b2" title="Question 24">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
