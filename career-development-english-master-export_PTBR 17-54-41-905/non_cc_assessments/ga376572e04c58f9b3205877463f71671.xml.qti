      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does collective achievement focus mean in cultural contexts?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="32679">
              <material>
                <mattext texttype="text/plain">Emphasis on team success, group harmony, and shared accomplishments rather than individual contributions</mattext>
              </material>
            </response_label>
            <response_label ident="42979">
              <material>
                <mattext texttype="text/plain">Requiring all work to be completed by committees only</mattext>
              </material>
            </response_label>
            <response_label ident="57542">
              <material>
                <mattext texttype="text/plain">Prohibiting any recognition of individual performance</mattext>
              </material>
            </response_label>
            <response_label ident="87788">
              <material>
                <mattext texttype="text/plain">Paying all employees exactly the same salary regardless of role</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">42979</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="42979_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">57542</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="57542_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">87788</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="87788_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">32679</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="42979_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Collective achievement focus describes cultural values about celebrating team success, not work structure requirements. It emphasizes group harmony and shared accomplishments over individual self-promotion.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="57542_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Collective achievement focus emphasizes team success and group harmony, not prohibition of individual recognition. It values shared accomplishments and views excessive self-promotion as inappropriate.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="87788_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Collective achievement focus describes cultural values about success celebration, not compensation structure. It emphasizes team accomplishments and group harmony over individual self-promotion.</mattext>
          </material>
