          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="13848_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This percentage is far too low. Estimates indicate that 70% to 85% of job opportunities come through personal connections in the hidden job market.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="11499_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This percentage underestimates the hidden job market. Research shows that 70% to 85% of job opportunities fill through personal connections rather than public postings.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="64218_fb">
        <flow_mat>
          <material>
