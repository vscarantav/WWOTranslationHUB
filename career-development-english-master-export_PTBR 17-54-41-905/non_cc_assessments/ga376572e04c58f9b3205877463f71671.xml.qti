          <conditionvar>
            <varequal respident="response1">45077</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="11090_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Ana had strong professional development skills. Her challenge was that traditional networking events occurred during times when she needed to prioritize parenting responsibilities.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="24306_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Ana's challenge was timing, not transportation. Most networking happened during evening and weekend hours when she needed to be present for her daughter.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="43664_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Ana's industry had networking opportunities. Her challenge was that traditional networking events occurred during times when she needed to fulfill parenting responsibilities.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
