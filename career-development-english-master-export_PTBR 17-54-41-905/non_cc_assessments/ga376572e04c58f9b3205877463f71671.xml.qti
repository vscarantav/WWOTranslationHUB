      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the hidden job market's primary operating principle?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="77632">
              <material>
                <mattext texttype="text/plain">Trust, reputation, and personal recommendations rather than formal application processes</mattext>
              </material>
            </response_label>
            <response_label ident="50207">
              <material>
                <mattext texttype="text/plain">Secret job listings available only to privileged candidates</mattext>
              </material>
            </response_label>
            <response_label ident="40231">
              <material>
                <mattext texttype="text/plain">Illegal hiring practices that avoid proper procedures</mattext>
              </material>
            </response_label>
            <response_label ident="83650">
              <material>
                <mattext texttype="text/plain">Jobs that require security clearances and background investigations</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">50207</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="50207_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">40231</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="40231_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">83650</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="83650_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">77632</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="50207_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The hidden job market operates on trust and recommendations, not secret privileged access. It fills positions through personal connections rather than formal applications.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="40231_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The hidden job market uses trust-based recommendations within legal hiring, not illegal practices. It operates on personal connections and reputation rather than public formal applications.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="83650_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The hidden job market describes trust-based hiring through connections, not security clearance requirements. It operates on personal recommendations rather than formal application processes.</mattext>
          </material>
        </flow_mat>
