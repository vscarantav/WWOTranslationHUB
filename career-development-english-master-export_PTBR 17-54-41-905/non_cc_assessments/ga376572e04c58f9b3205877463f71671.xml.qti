    <item ident="g54e47498cdd77800106ba9d698253ea1" title="Question 1">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>10167,29355,9575,25493</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What percentage of job opportunities come through personal connections rather than public job postings?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="10167">
              <material>
                <mattext texttype="text/plain">70-85%</mattext>
              </material>
            </response_label>
            <response_label ident="29355">
              <material>
                <mattext texttype="text/plain">30-40%</mattext>
              </material>
            </response_label>
            <response_label ident="9575">
              <material>
                <mattext texttype="text/plain">50-60%</mattext>
              </material>
            </response_label>
            <response_label ident="25493">
              <material>
                <mattext texttype="text/plain">90-95%</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">29355</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="29355_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9575</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9575_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">25493</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="25493_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">10167</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="29355_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This percentage is too low. Research shows that 70-85% of positions fill through personal networks, making relationship building essential for career success.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9575_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This percentage underestimates the importance of networking. Research consistently demonstrates that 70-85% of job opportunities come through personal connections rather much than public postings.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="25493_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This percentage is too high. Research indicates that 70-85% of positions fill through networks, which is substantial but not quite this extreme.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g329c2196e5f1eccaf50ba400a85ef0d4" title="Question 10">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>77257,78880,60217,72981</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the 4-Touch System?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="77257">
              <material>
                <mattext texttype="text/plain">Four key types of professional contact that create ongoing value through information sharing, introductions, achievement recognition, and service opportunities</mattext>
              </material>
            </response_label>
            <response_label ident="78880">
              <material>
                <mattext texttype="text/plain">Four required meetings per year with each professional contact</mattext>
              </material>
            </response_label>
            <response_label ident="60217">
              <material>
                <mattext texttype="text/plain">Four social media platforms for professional networking</mattext>
              </material>
            </response_label>
            <response_label ident="72981">
              <material>
                <mattext texttype="text/plain">Four steps for requesting job interviews from contacts</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">78880</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="78880_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">60217</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="60217_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">72981</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="72981_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">77257</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="78880_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The 4-Touch System describes types of contact, not a meeting schedule. It focuses on value-added information sharing, strategic introductions, achievement recognition, and service opportunities.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="60217_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The 4-Touch System refers to types of valuable contact, not platforms. It includes information sharing, strategic introductions, achievement recognition, and service opportunities.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="72981_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The 4-Touch System maintains relationships through value creation, not interview requests. It involves information sharing, strategic introductions, achievement recognition, and service opportunities.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g6c2b37c84a035433738aaede546b9787" title="Question 11">
      <itemmetadata>
