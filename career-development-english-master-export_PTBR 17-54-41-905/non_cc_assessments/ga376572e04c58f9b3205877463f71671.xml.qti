      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What was Emmanuel's initial networking challenge?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="36384">
              <material>
                <mattext texttype="text/plain">His technical community contributions felt separate from career networking without appearing to use people for personal gain</mattext>
              </material>
            </response_label>
            <response_label ident="47097">
              <material>
                <mattext texttype="text/plain">He did not know any other programmers in Ghana</mattext>
              </material>
            </response_label>
            <response_label ident="63395">
              <material>
                <mattext texttype="text/plain">He lacked technical skills to contribute to discussions</mattext>
              </material>
            </response_label>
            <response_label ident="72289">
              <material>
                <mattext texttype="text/plain">He could not afford internet access for online networking</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">47097</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="47097_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">63395</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="63395_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">72289</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="72289_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">36384</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="47097_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Emmanuel participated in both local and online developer communities. His challenge was integrating his community service with career networking without appearing transactional.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="63395_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Emmanuel had strong technical skills. His challenge was connecting his community contributions with career networking while maintaining authentic service orientation.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="72289_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Emmanuel accessed online forums and contributed to open-source projects. His challenge was integrating service with networking without compromising authenticity.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g4ca02c37ddee1ec64c52deaa5c0d457f" title="Question 15">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>61863,89885,52724,61872</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is direct communication in cultural contexts?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="61863">
              <material>
                <mattext texttype="text/plain">Straightforward, explicit communication where people say exactly what they mean without expecting listeners to interpret subtle implications</mattext>
              </material>
            </response_label>
            <response_label ident="89885">
              <material>
                <mattext texttype="text/plain">Communication that only happens in person rather than through technology</mattext>
              </material>
            </response_label>
            <response_label ident="52724">
              <material>
                <mattext texttype="text/plain">Communication that uses formal titles and hierarchical language</mattext>
              </material>
            </response_label>
            <response_label ident="61872">
              <material>
                <mattext texttype="text/plain">Communication that happens immediately without any delay</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">89885</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="89885_fb"/>
        </respcondition>
        <respcondition continue="Yes">
