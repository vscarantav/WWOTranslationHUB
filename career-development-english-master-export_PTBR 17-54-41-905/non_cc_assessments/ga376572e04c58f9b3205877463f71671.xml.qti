      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What was Ana's primary challenge with traditional networking?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="45077">
              <material>
                <mattext texttype="text/plain">Most networking happened during evening and weekend times when she needed to be present as a parent for her daughter</mattext>
              </material>
            </response_label>
            <response_label ident="11090">
              <material>
                <mattext texttype="text/plain">She did not have any professional skills to offer</mattext>
              </material>
            </response_label>
            <response_label ident="24306">
              <material>
                <mattext texttype="text/plain">She could not afford transportation to networking events</mattext>
              </material>
            </response_label>
            <response_label ident="43664">
              <material>
                <mattext texttype="text/plain">She worked in an industry with no networking opportunities</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
