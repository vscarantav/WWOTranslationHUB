              </material>
            </response_label>
            <response_label ident="87422">
              <material>
                <mattext texttype="text/plain">Matthew 7:16-17</mattext>
              </material>
            </response_label>
            <response_label ident="6697">
              <material>
                <mattext texttype="text/plain">Proverbs 3:5-6</mattext>
              </material>
            </response_label>
            <response_label ident="15106">
              <material>
                <mattext texttype="text/plain">John 15:12</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">87422</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="87422_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6697</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6697_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">15106</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="15106_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">78825</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="87422_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Matthew 7:16-17 discusses knowing people by their fruits. Doctrine and Covenants 84:88 promises that the Lord will go before you and be on your right and left hand as you build relationships.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6697_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Proverbs discusses trusting in the Lord. Doctrine and Covenants 84:88 specifically promises that the Lord will go before you as you build professional relationships.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="15106_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">John 15:12 discusses loving one another. Doctrine and Covenants 84:88 promises that the Lord will go before you and prepare hearts as you build relationships.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g4e0dcde27e7ec380c89c5edbf20e3392" title="Question 12">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>18312,58602,38730,63402</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What was Ana's primary responsibility that affected her networking approach?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="18312">
              <material>
                <mattext texttype="text/plain">Parenting her daughter Sofia</mattext>
              </material>
            </response_label>
            <response_label ident="58602">
              <material>
                <mattext texttype="text/plain">Completing her university degree</mattext>
              </material>
            </response_label>
            <response_label ident="38730">
              <material>
                <mattext texttype="text/plain">Managing a large development team</mattext>
              </material>
            </response_label>
            <response_label ident="63402">
              <material>
                <mattext texttype="text/plain">Teaching programming classes at a university</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">58602</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="58602_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">38730</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="38730_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">63402</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="63402_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">18312</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="58602_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Ana's primary responsibility was parenting her daughter Sofia. This responsibility shaped her networking approach because traditional networking events conflicted with parenting schedules.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="38730_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Ana was a developer, not a manager. Her primary responsibility was parenting her daughter Sofia, which required her to adapt her networking approach.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="63402_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Ana was a developer and parent, not a university teacher. Her primary responsibility was parenting her daughter Sofia, which influenced her networking strategies.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g9a629341788d642e4f30710a8de0ff66" title="Question 13">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>87838,83643,11391,90554</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What cultural factor influenced Sarah's career decisions in the Philippines?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="87838">
              <material>
                <mattext texttype="text/plain">Extended family financial obligations</mattext>
              </material>
            </response_label>
            <response_label ident="83643">
              <material>
                <mattext texttype="text/plain">Government employment restrictions</mattext>
              </material>
            </response_label>
            <response_label ident="11391">
              <material>
                <mattext texttype="text/plain">Language barriers in professional settings</mattext>
              </material>
            </response_label>
            <response_label ident="90554">
              <material>
                <mattext texttype="text/plain">Limited access to health education programs</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">83643</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="83643_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">11391</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="11391_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">90554</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="90554_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">87838</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="83643_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Sarah's career decisions were influenced by extended family financial obligations, not government restrictions. Filipino cultural values emphasize supporting parents, siblings, and extended family financially.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="11391_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Sarah's career decisions were shaped by extended family financial obligations rather than language barriers. Cultural expectations required balancing personal advancement with family support.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="90554_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Sarah's career decisions were influenced by extended family financial obligations, not education access. Filipino cultural values emphasize supporting extended family members financially.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g93180f4a9b1184755fc457973e674195" title="Question 14">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
