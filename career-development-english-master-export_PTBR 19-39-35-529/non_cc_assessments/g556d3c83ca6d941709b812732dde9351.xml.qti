        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">25499</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="25499_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">27414</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="27414_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">20162</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="20162_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">24647</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="25499_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The process integrates both elements. The text emphasizes researching thoroughly to ask meaningful questions while maintaining genuine networking connections.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="27414_fb">
