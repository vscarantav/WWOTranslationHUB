            <response_label ident="24647">
              <material>
                <mattext texttype="text/plain">You research thoroughly enough to ask meaningful questions while maintaining genuine connections built through networking</mattext>
              </material>
            </response_label>
            <response_label ident="25499">
              <material>
                <mattext texttype="text/plain">Preparation replaces the need for authentic relationships</mattext>
              </material>
            </response_label>
            <response_label ident="27414">
              <material>
                <mattext texttype="text/plain">Authenticity eliminates the need for research</mattext>
              </material>
            </response_label>
            <response_label ident="20162">
              <material>
                <mattext texttype="text/plain">The steps focus only on technical qualifications</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
