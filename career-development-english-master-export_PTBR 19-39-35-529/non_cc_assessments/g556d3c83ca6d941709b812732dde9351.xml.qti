    <item ident="g40840e5a1296b898a757726be71a1574" title="Question 1">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>42951,25891,86859,24365</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;How does the enhanced STAR method differ from basic STAR storytelling?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="42951">
              <material>
                <mattext texttype="text/plain">It provides specific timing guidelines and cultural adaptation strategies for more compelling stories</mattext>
              </material>
            </response_label>
            <response_label ident="25891">
              <material>
                <mattext texttype="text/plain">It eliminates the need for specific examples</mattext>
              </material>
            </response_label>
            <response_label ident="86859">
              <material>
                <mattext texttype="text/plain">It focuses only on results without context</mattext>
              </material>
            </response_label>
            <response_label ident="24365">
              <material>
                <mattext texttype="text/plain">It removes the Action component to save time</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">25891</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="25891_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">86859</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="86859_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">24365</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="24365_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">42951</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="25891_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The enhanced STAR method requires more detailed examples, not fewer. The text emphasizes that enhancement adds timing guidelines and cultural adaptation strategies to create more compelling stories.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="86859_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The enhanced method maintains all four components while adding timing structure. The text indicates enhancement provides timing guidelines and cultural adaptation strategies for each component.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="24365_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The enhanced method allocates more time to Action, not less. The text specifies that enhancement adds timing guidelines while maintaining all four STAR components.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g605aabd5c28aa69a9ce3d8e7c18e7062" title="Question 10">
