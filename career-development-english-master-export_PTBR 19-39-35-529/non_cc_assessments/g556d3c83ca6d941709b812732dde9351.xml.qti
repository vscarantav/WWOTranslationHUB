              </material>
            </response_label>
            <response_label ident="92522">
              <material>
                <mattext texttype="text/plain">Only technical skills matter for virtual interviews</mattext>
              </material>
            </response_label>
            <response_label ident="41598">
              <material>
                <mattext texttype="text/plain">Virtual preparation is identical to in-person preparation</mattext>
