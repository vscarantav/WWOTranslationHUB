      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What relationship exists between cultural adaptation and authentic identity in interview contexts?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="13200">
              <material>
                <mattext texttype="text/plain">Adaptation adjusts how you present capabilities while your core values and capabilities remain constant</mattext>
              </material>
            </response_label>
            <response_label ident="62990">
              <material>
                <mattext texttype="text/plain">Adaptation requires changing your core identity</mattext>
              </material>
            </response_label>
            <response_label ident="82785">
              <material>
                <mattext texttype="text/plain">Authentic identity prevents any cultural adaptation</mattext>
              </material>
            </response_label>
            <response_label ident="6944">
              <material>
                <mattext texttype="text/plain">They are completely separate concepts</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">62990</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="62990_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
