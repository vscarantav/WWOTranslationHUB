          <render_choice>
            <response_label ident="2288">
              <material>
                <mattext texttype="text/plain">Week 1 identity provides authentic foundation, Week 2 skills demonstrate competence, and Week 3 networking creates opportunities</mattext>
              </material>
            </response_label>
            <response_label ident="95315">
              <material>
                <mattext texttype="text/plain">Previous weeks have no relevance to interviews</mattext>
