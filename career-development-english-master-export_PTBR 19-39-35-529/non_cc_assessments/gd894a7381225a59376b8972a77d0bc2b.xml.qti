  <assessment ident="gd894a7381225a59376b8972a77d0bc2b" title="W01 Quiz: Syllabus">
    <qtimetadata>
      <qtimetadatafield>
        <fieldlabel>cc_maxattempts</fieldlabel>
        <fieldentry>2</fieldentry>
      </qtimetadatafield>
