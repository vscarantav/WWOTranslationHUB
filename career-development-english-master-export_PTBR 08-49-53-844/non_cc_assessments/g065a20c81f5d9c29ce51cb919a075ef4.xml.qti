<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que a parábola dos talentos ensina sobre a criação de conteúdo profissional?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="13615">
<material>
<mattext texttype="text/plain">Mostre evidências específicas de como você usou os dons para criar valor para os outros</mattext>
</material>
</response_label>
<response_label ident="1729">
<material>
<mattext texttype="text/plain">Mantenha suas conquistas privadas para permanecer humilde</mattext>
</material>
</response_label>
<response_label ident="34590">
<material>
<mattext texttype="text/plain">Compare seus talentos com os de outros servos</mattext>
</material>
</response_label>
<response_label ident="66316">
<material>
<mattext texttype="text/plain">Focus on effort expended rather than results achieved</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">1729</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="1729_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">34590</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="34590_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">66316</varequal>
</conditionvar>
