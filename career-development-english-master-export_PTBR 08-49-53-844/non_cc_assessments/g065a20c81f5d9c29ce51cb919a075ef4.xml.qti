<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que significa adaptação cultural em conteúdo profissional de acordo com o texto?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="62563">
<material>
<mattext texttype="text/plain">Apresentar conquistas verdadeiras usando ênfases diferentes com base em preferências culturais</mattext>
</material>
</response_label>
<response_label ident="2426">
<material>
<mattext texttype="text/plain">Criar fatos diferentes sobre sua experiência para culturas diferentes</mattext>
</material>
</response_label>
<response_label ident="53244">
<material>
<mattext texttype="text/plain">Usar conteúdo de currículo completamente diferente para cada país</mattext>
</material>
</response_label>
<response_label ident="19984">
<material>
<mattext texttype="text/plain">Remover experiências que possam não se traduzir culturalmente</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
