</material>
</response_label>
<response_label ident="23983">
<material>
<mattext texttype="text/plain">Linguagem competitiva que demonstra superioridade sobre outros candidatos</mattext>
</material>
</response_label>
<response_label ident="67350">
<material>
<mattext texttype="text/plain">Jargão técnico para demonstrar expertise</mattext>
</material>
</response_label>
<response_label ident="60466">
<material>
<mattext texttype="text/plain">Voz passiva para parecer modesto</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
