<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="58132">
<material>
<mattext texttype="text/plain">Processo de modificar a apresentação do conteúdo profissional para respeitar diferentes contextos de negócios, mantendo total honestidade sobre as capacidades</mattext>
</material>
