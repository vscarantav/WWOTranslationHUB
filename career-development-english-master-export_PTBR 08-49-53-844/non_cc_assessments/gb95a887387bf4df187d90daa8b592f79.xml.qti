</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="33216_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">21818</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="21818_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">94379</varequal>
</conditionvar>
