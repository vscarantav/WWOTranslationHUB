<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual estilo de comunicação usa linguagem direta, informações explícitas e expectativas claras?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="45551">
<material>
<mattext texttype="text/plain">Comunicação de baixo contexto</mattext>
</material>
</response_label>
<response_label ident="30267">
<material>
<mattext texttype="text/plain">Comunicação de alto contexto</mattext>
</material>
</response_label>
<response_label ident="27852">
<material>
<mattext texttype="text/plain">Comunicação hierárquica</mattext>
</material>
</response_label>
<response_label ident="50986">
<material>
<mattext texttype="text/plain">Comunicação que prioriza os relacionamentos</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">30267</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="30267_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">27852</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="27852_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">50986</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="50986_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">45551</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="30267_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A comunicação de alto contexto presta atenção a pistas não verbais e à comunicação indireta. A comunicação de baixo contexto usa linguagem direta e informações explícitas.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="27852_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Isso descreve uma estrutura cultural em vez de um estilo de comunicação. A comunicação de baixo contexto usa linguagem direta, informações explícitas e expectativas claras.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="50986_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Isso descreve uma abordagem de networking em vez de um estilo de comunicação. A comunicação de baixo contexto usa linguagem direta, informações explícitas e expectativas claras.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
