<item ident="g599c9689f337bc4cee1ce7de6cc9de57" title="Question 1">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>47914,86614,33776,64201</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Quais são os três principais canais pelos quais as oportunidades de emprego fluem em todo o mundo?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="47914">
<material>
<mattext texttype="text/plain">Mercado de trabalho visível, mercado de trabalho oculto, economia informal</mattext>
</material>
</response_label>
<response_label ident="86614">
<material>
<mattext texttype="text/plain">Candidaturas online, anúncios de jornal, agências de recrutamento</mattext>
</material>
</response_label>
<response_label ident="33776">
<material>
<mattext texttype="text/plain">Contratação corporativa, cargos governamentais, empresas familiares</mattext>
</material>
</response_label>
<response_label ident="64201">
<material>
<mattext texttype="text/plain">Plataformas digitais, eventos de networking, feiras de emprego</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">86614</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="86614_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">33776</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="33776_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">64201</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="64201_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">47914</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="86614_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Estes são métodos específicos dentro dos canais de busca de emprego, e não os três canais distintos em si. O texto identifica o mercado de trabalho visível, o mercado de trabalho oculto e a economia informal como os três principais canais de emprego.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="33776_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Estes são tipos de empregadores, e não os três canais de emprego. O texto descreve o mercado de trabalho visível, o mercado de trabalho oculto e a economia informal como os três canais através dos quais as oportunidades fluem.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="64201_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Estas são ferramentas usadas dentro dos canais de busca de emprego, e não os canais em si. O texto identifica o mercado de trabalho visível, o mercado de trabalho oculto e a economia informal como os três principais canais.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g86d5e25dfc487716de39b193f2ec5d24" title="Question 10">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
