</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que o texto recomenda acompanhar para manter a motivação durante a busca de emprego?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="68092">
<material>
<mattext texttype="text/plain">Múltiplos indicadores de progresso, incluindo candidaturas, relacionamentos e habilidades desenvolvidas</mattext>
</material>
</response_label>
<response_label ident="67675">
<material>
<mattext texttype="text/plain">Apenas ofertas de emprego recebidas</mattext>
</material>
</response_label>
<response_label ident="90997">
<material>
<mattext texttype="text/plain">Apenas o número de entrevistas agendadas</mattext>
</material>
</response_label>
<response_label ident="14520">
<material>
<mattext texttype="text/plain">Apenas respostas de empregadores</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">67675</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="67675_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">90997</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="90997_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">14520</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="14520_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">68092</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="67675_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Acompanhar apenas ofertas de emprego gera desânimo porque as ofertas representam apenas um resultado. O texto recomenda acompanhar múltiplos indicadores de progresso.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="90997_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">As entrevistas são apenas um indicador de progresso. O texto recomenda acompanhar múltiplos indicadores de progresso, incluindo candidaturas, relacionamentos e habilidades desenvolvidas.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="14520_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">As respostas dos empregadores são apenas uma medida de progresso. O texto recomenda acompanhar múltiplos indicadores para manter a motivação por meio de evidências de avanço.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
