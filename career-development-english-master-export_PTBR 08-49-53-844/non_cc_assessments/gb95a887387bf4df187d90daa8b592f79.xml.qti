</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Que tipo de culturas investem um tempo significativo em conexão pessoal antes de discutir tópicos de negócios?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="96879">
<material>
<mattext texttype="text/plain">Culturas de relacionamento em primeiro lugar</mattext>
</material>
</response_label>
<response_label ident="33216">
<material>
<mattext texttype="text/plain">Culturas de negócios formais</mattext>
</material>
</response_label>
<response_label ident="21818">
<material>
<mattext texttype="text/plain">Culturas igualitárias</mattext>
</material>
</response_label>
<response_label ident="94379">
<material>
<mattext texttype="text/plain">Culturas individualistas</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
