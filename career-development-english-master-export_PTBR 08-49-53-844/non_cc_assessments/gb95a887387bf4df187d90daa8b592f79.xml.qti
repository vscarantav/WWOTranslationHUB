<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Que tipo de cultura de contratação valoriza a confiança da comunidade e as habilidades de gestão de stakeholders?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="28313">
<material>
<mattext texttype="text/plain">Culturas baseadas em relacionamentos</mattext>
</material>
</response_label>
<response_label ident="50901">
<material>
<mattext texttype="text/plain">Culturas baseadas no mérito</mattext>
</material>
</response_label>
<response_label ident="36222">
<material>
<mattext texttype="text/plain">Culturas individualistas</mattext>
</material>
</response_label>
<response_label ident="61187">
<material>
<mattext texttype="text/plain">Culturas de negócios formais</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">50901</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="50901_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">36222</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="36222_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">61187</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="61187_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">28313</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="50901_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Culturas baseadas no mérito enfatizam qualificações documentadas e conquistas mensuráveis. Culturas baseadas em relacionamentos valorizam a confiança da comunidade e as habilidades de gestão de stakeholders.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="36222_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Culturas individualistas focam em conquistas pessoais e vantagens competitivas. Culturas baseadas em relacionamentos valorizam a confiança da comunidade e as habilidades de gestão de stakeholders.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="61187_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Culturas de negócios formais mantêm limites profissionais e comunicação estruturada. Culturas baseadas em relacionamentos valorizam a confiança da comunidade e as habilidades de gestão de stakeholders.</mattext>
</material>
</flow_mat>
</itemfeedback>
