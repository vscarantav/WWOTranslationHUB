<response_label ident="14348">
<material>
<mattext texttype="text/plain">Todas as candidaturas resultarão em ofertas de emprego</mattext>
</material>
</response_label>
<response_label ident="13904">
<material>
<mattext texttype="text/plain">A busca por emprego deve ser feita apenas quando surgirem oportunidades perfeitas</mattext>
</material>
</response_label>
<response_label ident="26949">
<material>
<mattext texttype="text/plain">Fatores externos são mais importantes do que o esforço pessoal</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
