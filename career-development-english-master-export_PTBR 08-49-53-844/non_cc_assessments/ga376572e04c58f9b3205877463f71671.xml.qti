</material>
</response_label>
<response_label ident="65704">
<material>
<mattext texttype="text/plain">Comunicação informal apenas entre funcionários do mesmo nível</mattext>
</material>
</response_label>
<response_label ident="16305">
<material>
<mattext texttype="text/plain">Cargos de liderança que rotacionam frequentemente entre todos os funcionários</mattext>
</material>
</response_label>
