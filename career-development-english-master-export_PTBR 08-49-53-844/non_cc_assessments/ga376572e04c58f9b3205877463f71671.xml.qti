<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que é uma proposta de valor?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="89474">
<material>
<mattext texttype="text/plain">Uma declaração clara que explica como sua trajetória específica poderia ajudar alguém a atingir seus objetivos profissionais atuais</mattext>
</material>
</response_label>
<response_label ident="97569">
