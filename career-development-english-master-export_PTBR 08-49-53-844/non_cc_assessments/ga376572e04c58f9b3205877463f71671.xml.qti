</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual fator cultural influenciou as decisões de carreira de Sarah nas Filipinas?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="87838">
<material>
<mattext texttype="text/plain">Obrigações financeiras com a família estendida</mattext>
</material>
</response_label>
<response_label ident="83643">
<material>
<mattext texttype="text/plain">Restrições de emprego do governo</mattext>
</material>
</response_label>
<response_label ident="11391">
<material>
<mattext texttype="text/plain">Barreiras linguísticas em ambientes profissionais</mattext>
</material>
</response_label>
<response_label ident="90554">
<material>
<mattext texttype="text/plain">Acesso limitado a programas de educação em saúde</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">83643</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="83643_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">11391</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="11391_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">90554</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="90554_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">87838</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="83643_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">As decisões de carreira de Sarah foram influenciadas por obrigações financeiras com a família estendida, não por restrições governamentais. Os valores culturais filipinos enfatizam o apoio financeiro a pais, irmãos e à família estendida.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="11391_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">As decisões de carreira de Sarah foram moldadas por obrigações financeiras com a família estendida, e não por barreiras linguísticas. As expectativas culturais exigiam equilibrar o progresso pessoal com o apoio à família.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="90554_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">As decisões de carreira de Sarah foram influenciadas por obrigações financeiras com a família estendida, não pelo acesso à educação. Os valores culturais filipinos enfatizam o apoio financeiro aos membros da família estendida.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g93180f4a9b1184755fc457973e674195" title="Question 14">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
