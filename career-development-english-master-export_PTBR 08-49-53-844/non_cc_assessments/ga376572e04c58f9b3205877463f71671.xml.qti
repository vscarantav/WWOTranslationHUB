<mattext texttype="text/plain">Comunicar-se por meio de mensagens escritas em vez da fala</mattext>
</material>
</response_label>
<response_label ident="8645">
<material>
<mattext texttype="text/plain">Evitar toda comunicação profissional sempre que possível</mattext>
</material>
</response_label>
<response_label ident="71898">
<material>
<mattext texttype="text/plain">Confundir mensagens deliberadamente para ocultar intenções</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
