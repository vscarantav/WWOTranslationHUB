</material>
</response_label>
<response_label ident="87425">
<material>
<mattext texttype="text/plain">Suas pretensões salariais para potenciais oportunidades de emprego</mattext>
</material>
</response_label>
<response_label ident="43737">
<material>
<mattext texttype="text/plain">Uma proposta comercial formal solicitando financiamento de projeto</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
