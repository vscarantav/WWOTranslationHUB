</material>
</response_label>
<response_label ident="39313">
<material>
<mattext texttype="text/plain">Eles só precisavam de ajuda com linguagens de programação avançadas</mattext>
</material>
</response_label>
<response_label ident="23582">
<material>
<mattext texttype="text/plain">Eles preferiam aprender sem qualquer mentoria ou orientação</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
