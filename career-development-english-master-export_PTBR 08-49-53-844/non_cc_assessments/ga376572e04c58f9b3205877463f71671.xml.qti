<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual escritura promete que o Senhor irá adiante de você ao construir relacionamentos profissionais?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="78825">
<material>
<mattext texttype="text/plain">Doutrina e Convênios 84:88</mattext>
</material>
</response_label>
<response_label ident="87422">
<material>
<mattext texttype="text/plain">Mateus 7:16-17</mattext>
</material>
</response_label>
<response_label ident="6697">
<material>
<mattext texttype="text/plain">Provérbios 3:5-6</mattext>
</material>
</response_label>
<response_label ident="15106">
<material>
<mattext texttype="text/plain">João 15:12</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">87422</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="87422_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">6697</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="6697_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">15106</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="15106_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">78825</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="87422_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Mateus 7:16-17 trata de conhecer as pessoas por seus frutos. Doutrina e Convênios 84:88 promete que o Senhor irá adiante de você e estará à sua direita e à sua esquerda à medida que você constrói relacionamentos.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="6697_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Provérbios trata de confiar no Senhor. Doutrina e Convênios 84:88 promete especificamente que o Senhor irá adiante de você à medida que você constrói relacionamentos profissionais.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="15106_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">João 15:12 trata de amar uns aos outros. Doutrina e Convênios 84:88 promete que o Senhor irá adiante de você e preparará os corações à medida que você constrói relacionamentos.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g4e0dcde27e7ec380c89c5edbf20e3392" title="Question 12">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
