</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que significa o foco na conquista coletiva em contextos culturais?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="32679">
<material>
<mattext texttype="text/plain">Ênfase no sucesso da equipe, na harmonia do grupo e nas realizações compartilhadas, em vez de contribuições individuais</mattext>
</material>
</response_label>
<response_label ident="42979">
<material>
<mattext texttype="text/plain">Exigir que todo o trabalho seja realizado apenas por comitês</mattext>
</material>
</response_label>
<response_label ident="57542">
<material>
<mattext texttype="text/plain">Proibir qualquer reconhecimento de desempenho individual</mattext>
</material>
</response_label>
<response_label ident="87788">
<material>
<mattext texttype="text/plain">Pagar a todos os funcionários exatamente o mesmo salário, independentemente da função</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
