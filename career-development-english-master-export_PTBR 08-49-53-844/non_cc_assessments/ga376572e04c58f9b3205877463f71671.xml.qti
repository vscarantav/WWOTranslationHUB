<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual foi o desafio inicial de networking de Emmanuel?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="36384">
<material>
<mattext texttype="text/plain">Suas contribuições para a comunidade técnica pareciam separadas do networking profissional, sem parecer que ele estava usando as pessoas para ganho pessoal</mattext>
</material>
</response_label>
<response_label ident="47097">
<material>
<mattext texttype="text/plain">Ele não conhecia nenhum outro programador em Gana</mattext>
</material>
</response_label>
<response_label ident="63395">
<material>
<mattext texttype="text/plain">Ele não tinha as habilidades técnicas para contribuir com as discussões</mattext>
</material>
</response_label>
<response_label ident="72289">
<material>
<mattext texttype="text/plain">Ele não tinha condições financeiras de pagar pelo acesso à internet para fazer networking online</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
