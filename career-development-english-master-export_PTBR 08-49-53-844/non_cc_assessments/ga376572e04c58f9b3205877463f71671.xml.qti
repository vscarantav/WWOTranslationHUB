<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que é comunicação indireta em contextos culturais?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="75500">
<material>
<mattext texttype="text/plain">Comunicação que depende de contexto, implicações e pistas sutis para transmitir significado</mattext>
</material>
