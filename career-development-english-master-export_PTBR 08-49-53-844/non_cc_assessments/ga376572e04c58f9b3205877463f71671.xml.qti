</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual porcentagem representa as estimativas de oportunidades de trabalho no mercado oculto de trabalho?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="31641">
<material>
<mattext texttype="text/plain">70% a 85%</mattext>
</material>
</response_label>
<response_label ident="13848">
<material>
<mattext texttype="text/plain">20% a 30%</mattext>
</material>
</response_label>
<response_label ident="11499">
<material>
<mattext texttype="text/plain">40% a 50%</mattext>
</material>
</response_label>
<response_label ident="64218">
<material>
<mattext texttype="text/plain">95% a 100%</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
