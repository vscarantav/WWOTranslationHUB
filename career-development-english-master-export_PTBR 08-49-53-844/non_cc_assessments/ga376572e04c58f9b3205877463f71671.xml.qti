<mattext texttype="text/plain">Comunicação por meio de intermediários, em vez de falar diretamente</mattext>
</material>
</response_label>
<response_label ident="28238">
<material>
<mattext texttype="text/plain">Comunicação que evita qualquer interação face a face</mattext>
</material>
</response_label>
<response_label ident="95339">
<material>
<mattext texttype="text/plain">Comunicação que nunca aborda tópicos difíceis</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
