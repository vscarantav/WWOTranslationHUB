<mattext texttype="text/plain">Eliminação completa de todos os cargos de liderança</mattext>
</material>
</response_label>
<response_label ident="9907">
<material>
<mattext texttype="text/plain">Comunicação formal apenas por meio de documentação escrita</mattext>
</material>
</response_label>
<response_label ident="78334">
<material>
<mattext texttype="text/plain">Separação entre funcionários em diferentes níveis organizacionais</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
