<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que é comunicação indireta em contextos culturais?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="59539">
<material>
<mattext texttype="text/plain">Comunicação que se apoia no contexto, em subentendidos e em pistas sutis para transmitir significado</mattext>
</material>
</response_label>
<response_label ident="25167">
