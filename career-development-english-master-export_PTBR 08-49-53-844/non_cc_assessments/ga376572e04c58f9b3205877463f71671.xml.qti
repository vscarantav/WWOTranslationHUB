<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que é o mercado de trabalho oculto?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="43434">
<material>
<mattext texttype="text/plain">Oportunidades de emprego que operam com base na confiança, reputação e recomendações pessoais, em vez de processos formais de candidatura</mattext>
</material>
</response_label>
<response_label ident="63328">
<material>
<mattext texttype="text/plain">Empregos que exigem autorização de segurança e verificação de antecedentes</mattext>
</material>
</response_label>
<response_label ident="22499">
<material>
<mattext texttype="text/plain">Vagas anunciadas apenas em portais de vagas especializados</mattext>
</material>
</response_label>
<response_label ident="2753">
<material>
<mattext texttype="text/plain">Oportunidades de emprego internacional em outros países</mattext>
</material>
</response_label>
</render_choice>
