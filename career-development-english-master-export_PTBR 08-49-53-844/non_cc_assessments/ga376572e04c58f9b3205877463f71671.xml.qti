</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="39428_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">53532</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="53532_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">69891</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="69891_fb"/>
</respcondition>
<respcondition continue="No">
