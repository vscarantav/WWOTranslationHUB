<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que são culturas focadas primeiro nas tarefas?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="52016">
<material>
<mattext texttype="text/plain">Culturas que focam primeiro na competência, com relacionamentos se desenvolvendo por meio da colaboração no trabalho</mattext>
</material>
</response_label>
<response_label ident="86950">
<material>
<mattext texttype="text/plain">Culturas que nunca constroem relacionamentos pessoais</mattext>
</material>
</response_label>
<response_label ident="4579">
<material>
<mattext texttype="text/plain">Culturas que apenas valorizam a eficiência e ignoram as pessoas</mattext>
</material>
</response_label>
<response_label ident="41428">
<material>
<mattext texttype="text/plain">Culturas que proíbem amizades no local de trabalho</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
