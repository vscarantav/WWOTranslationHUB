</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que é o foco na conquista individual em contextos culturais?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="30486">
<material>
<mattext texttype="text/plain">Culturas que celebram o sucesso pessoal, incentivam a autopromoção e esperam que as pessoas destaquem suas contribuições individuais</mattext>
</material>
</response_label>
<response_label ident="2652">
<material>
