<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual era a principal responsabilidade de Ana que afetou sua abordagem de networking?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="18312">
<material>
<mattext texttype="text/plain">A criação de sua filha Sofia</mattext>
</material>
</response_label>
<response_label ident="58602">
<material>
<mattext texttype="text/plain">Concluir seu curso universitário</mattext>
</material>
</response_label>
<response_label ident="38730">
<material>
<mattext texttype="text/plain">Gerenciar uma grande equipe de desenvolvimento</mattext>
</material>
</response_label>
<response_label ident="63402">
<material>
<mattext texttype="text/plain">Dar aulas de programação em uma universidade</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">58602</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="58602_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">38730</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="38730_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">63402</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="63402_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">18312</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="58602_fb">
<flow_mat>
<material>
<mattext texttype="text/html">A principal responsabilidade de Ana era a criação de sua filha Sofia. Essa responsabilidade moldou sua abordagem de networking porque os eventos tradicionais de networking conflitavam com a rotina de cuidados com a filha.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="38730_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Ana era uma desenvolvedora, não uma gerente. Sua principal responsabilidade era a criação de sua filha Sofia, o que exigiu que ela adaptasse sua abordagem de networking.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="63402_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Ana era uma desenvolvedora e mãe, não uma professora universitária. Sua principal responsabilidade era a criação de sua filha Sofia, o que influenciou suas estratégias de networking.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g9a629341788d642e4f30710a8de0ff66" title="Question 13">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
