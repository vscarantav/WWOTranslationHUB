</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que significa comunicação direta em contextos culturais?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="28838">
<material>
<mattext texttype="text/plain">Comunicação direta e explícita na qual as pessoas dizem exatamente o que querem dizer, sem esperar que os ouvintes interpretem implicações sutis</mattext>
</material>
</response_label>
<response_label ident="88281">
<material>
<mattext texttype="text/plain">Falar alto e com firmeza para deixar os pontos claros</mattext>
</material>
</response_label>
<response_label ident="81751">
<material>
<mattext texttype="text/plain">Comunicar-se apenas através de reuniões presenciais</mattext>
</material>
</response_label>
<response_label ident="92341">
<material>
<mattext texttype="text/plain">Sempre usar linguagem de negócios formal em ambientes profissionais</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
