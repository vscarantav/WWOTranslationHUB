<fieldentry>31098,39428,53532,69891</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que é networking baseado em serviço?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="31098">
<material>
<mattext texttype="text/plain">Construção de relacionamentos que prioriza contribuir com valor para o sucesso profissional dos outros, em vez de se concentrar principalmente no avanço da carreira pessoal</mattext>
</material>
</response_label>
<response_label ident="39428">
<material>
<mattext texttype="text/plain">Networking que só ocorre por meio de organizações voluntárias</mattext>
</material>
</response_label>
<response_label ident="53532">
<material>
<mattext texttype="text/plain">Coleta de cartões de visita em eventos de serviço comunitário</mattext>
</material>
</response_label>
<response_label ident="69891">
<material>
<mattext texttype="text/plain">Pedir doações a profissionais para causas de caridade</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
