<material>
<mattext texttype="text/plain">Não ter nenhuma experiência de trabalho</mattext>
</material>
</response_label>
<response_label ident="77283">
<material>
<mattext texttype="text/plain">Esconder intencionalmente a experiência dos empregadores</mattext>
</material>
</response_label>
<response_label ident="95002">
<material>
<mattext texttype="text/plain">Credenciais ausentes em um currículo</mattext>
</material>
</response_label>
</render_choice>
