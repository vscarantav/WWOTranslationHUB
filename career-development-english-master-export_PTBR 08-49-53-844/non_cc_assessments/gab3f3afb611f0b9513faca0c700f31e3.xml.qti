</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que o Élder L. Tom Perry ensina sobre independência e autossuficiência?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="88574">
<material>
<mattext texttype="text/plain">Eles são cruciais para o crescimento espiritual e temporal</mattext>
</material>
</response_label>
<response_label ident="75994">
<material>
<mattext texttype="text/plain">Eles só importam para o sucesso financeiro</mattext>
</material>
</response_label>
<response_label ident="72943">
<material>
<mattext texttype="text/plain">Eles ameaçam nossa conexão com Deus</mattext>
</material>
</response_label>
<response_label ident="51396">
<material>
<mattext texttype="text/plain">Eles devem ser evitados em favor da dependência</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">75994</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="75994_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">72943</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="72943_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">51396</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="51396_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">88574</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="75994_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">O ensinamento do Élder Perry vai além das finanças. O texto o cita dizendo que a independência e a autossuficiência são fundamentais para o crescimento espiritual e temporal.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="72943_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Isso contradiz o ensinamento do Élder Perry. Ele ensinou que a independência e a autossuficiência são fundamentais para o crescimento espiritual e temporal.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="51396_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Isso é o oposto da mensagem do Élder Perry. O texto enfatiza que a independência e a autossuficiência são fundamentais para o crescimento espiritual e temporal.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
