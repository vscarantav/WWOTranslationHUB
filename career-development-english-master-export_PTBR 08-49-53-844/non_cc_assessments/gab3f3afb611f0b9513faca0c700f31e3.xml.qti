</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Que tipo de cultura valoriza a construção de relacionamentos pessoais antes de discutir negócios?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="9129">
<material>
<mattext texttype="text/plain">Culturas que priorizam relacionamentos</mattext>
</material>
</response_label>
<response_label ident="51206">
<material>
<mattext texttype="text/plain">Culturas de comunicação direta</mattext>
</material>
</response_label>
<response_label ident="96267">
<material>
<mattext texttype="text/plain">Culturas igualitárias</mattext>
</material>
</response_label>
<response_label ident="4268">
<material>
<mattext texttype="text/plain">Culturas de ritmo acelerado</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">51206</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="51206_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">96267</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="96267_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">4268</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="4268_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">9129</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="51206_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Culturas diretas passam rapidamente para as discussões de negócios. O texto identifica culturas que priorizam relacionamentos como aquelas que constroem conexões pessoais antes dos negócios.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="96267_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Isso descreve a estrutura hierárquica, não o momento da comunicação. O texto define culturas que priorizam relacionamentos como aquelas que constroem conexões pessoais antes dos negócios.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="4268_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Culturas de ritmo acelerado esperam transições rápidas. O texto explica que culturas que priorizam relacionamentos estabelecem confiança antes de discutir negócios.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
