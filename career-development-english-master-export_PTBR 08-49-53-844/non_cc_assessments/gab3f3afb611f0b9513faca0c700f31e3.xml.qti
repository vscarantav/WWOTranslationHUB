<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que o texto identifica como "invisibilidade da experiência"?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="96007">
<material>
<mattext texttype="text/plain">Ter desenvolvido capacidades, mas ser incapaz de vê-las porque ocorreram fora de ambientes corporativos tradicionais</mattext>
</material>
</response_label>
