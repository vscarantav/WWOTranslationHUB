<item ident="g844306a27145f27a0bfad146aafb0ed6" title="Question 1">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>42240,23013,98462,78536</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Quais são as três etapas do Processo de Pensamento de Carreira?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="42240">
<material>
<mattext texttype="text/plain">Identificar as habilidades necessárias, Reconhecer a transferência de habilidades, Apresentar as habilidades profissionalmente</mattext>
</material>
</response_label>
<response_label ident="23013">
<material>
<mattext texttype="text/plain">Listar atividades, Comparar experiências, Escrever currículos</mattext>
</material>
</response_label>
<response_label ident="98462">
<material>
<mattext texttype="text/plain">Encontrar empregos, Candidatar-se online, Fazer o acompanhamento</mattext>
</material>
</response_label>
<response_label ident="78536">
<material>
<mattext texttype="text/plain">Pesquisar empregadores, Praticar entrevistas, Aceitar ofertas</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">23013</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="23013_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">98462</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="98462_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">78536</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="78536_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">42240</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="23013_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Essas etapas não correspondem ao Processo de Pensamento de Carreira descrito no texto. O processo inclui identificar as habilidades necessárias, reconhecer a transferência de habilidades e apresentar as habilidades profissionalmente.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="98462_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Essas são atividades de busca de emprego, não as etapas do Processo de Pensamento de Carreira. O texto identifica as três etapas como identificar as habilidades necessárias, reconhecer a transferência de habilidades e apresentar as habilidades profissionalmente.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="78536_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Essas representam etapas de busca de emprego posteriores ao Processo de Pensamento de Carreira. O texto descreve três etapas específicas: identificar as habilidades necessárias, reconhecer a transferência de habilidades e apresentar as habilidades profissionalmente.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g3a0e583d2c6349dadff4206d822649d4" title="Question 10">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>63600,24133,41176,25244</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;De acordo com o Élder Uchtdorf, como ocorre o crescimento no mundo que Deus criou?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="63600">
<material>
<mattext texttype="text/plain">Gradual e pacientemente, mas de forma consistente e implacável</mattext>
</material>
</response_label>
<response_label ident="24133">
<material>
<mattext texttype="text/plain">Por meio de avanços repentinos e mudanças dramáticas</mattext>
</material>
</response_label>
<response_label ident="41176">
<material>
<mattext texttype="text/plain">Apenas por meio de programas de educação formal</mattext>
</material>
</response_label>
<response_label ident="25244">
<material>
<mattext texttype="text/plain">Ao esperar por oportunidades perfeitas</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">24133</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="24133_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">41176</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="41176_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">25244</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="25244_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">63600</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="24133_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Isso contradiz o ensinamento do Élder Uchtdorf. O texto o cita ensinando que o crescimento acontece de forma gradual e paciente, mas de maneira consistente e incansável.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="41176_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">O ensinamento do Élder Uchtdorf se aplica a todo crescimento, não apenas à educação formal. O texto enfatiza o progresso gradual, paciente, consistente e incansável.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="25244_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Isso descaracteriza o ensinamento sobre o esforço ativo e consistente. O texto cita o Élder Uchtdorf explicando que o crescimento acontece de forma gradual e paciente, mas de maneira consistente e incansável.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="gdbda632a0e10b9c9d5e7a2d90f924e63" title="Question 11">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
