</material>
</response_label>
<response_label ident="86384">
<material>
<mattext texttype="text/plain">Elaboração de currículo com prática de entrevista</mattext>
</material>
</response_label>
<response_label ident="7061">
<material>
<mattext texttype="text/plain">Networking com envio de candidaturas</mattext>
</material>
</response_label>
<response_label ident="78376">
<material>
<mattext texttype="text/plain">Pesquisa salarial com análise de empresas</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
