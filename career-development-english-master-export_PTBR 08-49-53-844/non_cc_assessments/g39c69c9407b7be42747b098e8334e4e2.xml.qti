<mattext texttype="text/html">&lt;div&gt;Como o networking deve ser abordado de acordo com o texto?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="50290">
<material>
<mattext texttype="text/plain">Construir relacionamentos autênticos focados no serviço mútuo e no apoio de longo prazo</mattext>
</material>
</response_label>
<response_label ident="4539">
<material>
<mattext texttype="text/plain">Coletar o maior número possível de cartões de visita</mattext>
</material>
</response_label>
<response_label ident="70482">
<material>
<mattext texttype="text/plain">Entrar em contato apenas com pessoas que possam oferecer empregos imediatamente</mattext>
</material>
</response_label>
<response_label ident="49914">
<material>
<mattext texttype="text/plain">Pedir indicações de emprego a todas as pessoas que você encontrar</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
