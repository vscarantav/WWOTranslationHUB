<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Como a preparação para entrevistas virtuais difere da preparação para entrevistas presenciais?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="99660">
<material>
<mattext texttype="text/plain">A preparação virtual requer configuração técnica adicional, conscientização sobre fusos horários interculturais e manutenção da presença digital</mattext>
</material>
</response_label>
<response_label ident="12065">
<material>
<mattext texttype="text/plain">Entrevistas virtuais eliminam a necessidade de preparação</mattext>
</material>
</response_label>
<response_label ident="92522">
<material>
<mattext texttype="text/plain">Apenas habilidades técnicas importam para entrevistas virtuais</mattext>
</material>
</response_label>
<response_label ident="41598">
<material>
<mattext texttype="text/plain">A preparação virtual é idêntica à preparação presencial</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
