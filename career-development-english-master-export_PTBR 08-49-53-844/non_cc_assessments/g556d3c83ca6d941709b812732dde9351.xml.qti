</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual relação existe entre a adaptação cultural e a identidade autêntica em contextos de entrevista?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="13200">
<material>
<mattext texttype="text/plain">A adaptação ajusta a forma como você apresenta suas capacidades, enquanto seus valores e capacidades fundamentais permanecem constantes</mattext>
</material>
</response_label>
<response_label ident="62990">
<material>
