<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="66892">
<material>
<mattext texttype="text/plain">A reflexão imediata captura impressões, a análise identifica padrões e o planejamento de desenvolvimento cria melhorias acionáveis</mattext>
</material>
</response_label>
<response_label ident="76574">
<material>
<mattext texttype="text/plain">Cada etapa repete as mesmas atividades</mattext>
</material>
</response_label>
<response_label ident="34797">
<material>
<mattext texttype="text/plain">As etapas podem ser concluídas em qualquer ordem</mattext>
</material>
</response_label>
<response_label ident="67924">
<material>
<mattext texttype="text/plain">Apenas a primeira etapa importa para a melhoria</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
