</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">26372</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="26372_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">89061</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="89061_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">10189</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="95643_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Pesquisar e Preparar é o primeiro passo. O segundo passo é Enquadrar como Resolução de Problemas, apresentando as negociações como soluções colaborativas.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="26372_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Propor troca de valor é o terceiro passo. O segundo passo é Enquadrar como Resolução de Problemas para apresentar as negociações de forma colaborativa.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="89061_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Manter o foco no relacionamento é o quarto passo. O segundo passo é Enquadrar como Resolução de Problemas, em vez de fazer exigências adversariais.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
