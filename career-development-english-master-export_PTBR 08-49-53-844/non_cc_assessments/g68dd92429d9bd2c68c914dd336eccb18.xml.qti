<fieldentry>g41bddb4a19f4a930c7dfe69fa31b7ea8</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que define uma Negociação de Criação de Valor?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="49356">
<material>
<mattext texttype="text/plain">Negociação profissional que se concentra em gerar benefícios mútuos</mattext>
</material>
</response_label>
<response_label ident="52228">
<material>
<mattext texttype="text/plain">Negociação que extrai o máximo de vantagem pessoal</mattext>
</material>
</response_label>
<response_label ident="22943">
<material>
<mattext texttype="text/plain">Negociação que evita discutir remuneração</mattext>
</material>
</response_label>
<response_label ident="60068">
<material>
