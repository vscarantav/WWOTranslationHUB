<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual porcentagem de tempo é alocada para a Fase de Confirmação em decisões baseadas em revelação?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="2790">
<material>
<mattext texttype="text/plain">20% do tempo de tomada de decisão</mattext>
</material>
</response_label>
<response_label ident="20060">
<material>
<mattext texttype="text/plain">40% do tempo de tomada de decisão</mattext>
</material>
</response_label>
<response_label ident="5134">
<material>
<mattext texttype="text/plain">60% do tempo de tomada de decisão</mattext>
</material>
</response_label>
<response_label ident="18245">
<material>
<mattext texttype="text/plain">80% do tempo de tomada de decisão</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
