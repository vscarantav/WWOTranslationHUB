<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Com o que começa o processo de cinco etapas de avaliação de propostas de emprego?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="9236">
<material>
<mattext texttype="text/plain">Coletar informações completas sobre cada oportunidade</mattext>
</material>
</response_label>
<response_label ident="35941">
<material>
<mattext texttype="text/plain">Aplicar uma estrutura de decisão ponderada</mattext>
</material>
</response_label>
<response_label ident="73489">
<material>
<mattext texttype="text/plain">Buscar confirmação espiritual</mattext>
</material>
</response_label>
<response_label ident="8380">
<material>
<mattext texttype="text/plain">Testar por meio do serviço</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">35941</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="35941_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">73489</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="73489_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">8380</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="8380_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">9236</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="35941_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A estrutura de decisão ponderada é a segunda etapa do processo. A avaliação começa com a coleta de informações completas sobre cada oportunidade, incluindo remuneração, benefícios, oportunidades de crescimento, ambiente de trabalho e fatores de ajuste cultural.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="73489_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A confirmação espiritual vem após a análise inicial. O processo começa com a coleta de informações completas sobre cada oportunidade antes de passar para a busca espiritual.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="8380_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">O teste por meio do serviço é uma etapa posterior, quando possível. O processo de avaliação começa com a coleta de informações completas sobre cada oportunidade.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
