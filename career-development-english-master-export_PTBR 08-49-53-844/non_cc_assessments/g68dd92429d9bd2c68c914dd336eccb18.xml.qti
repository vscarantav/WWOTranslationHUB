<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual é o segundo passo no Método de Negociação Profissional de Quatro Passos?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="10189">
<material>
<mattext texttype="text/plain">Enquadrar como Resolução de Problemas</mattext>
</material>
</response_label>
<response_label ident="95643">
<material>
<mattext texttype="text/plain">Pesquisar e Preparar</mattext>
</material>
</response_label>
<response_label ident="26372">
<material>
<mattext texttype="text/plain">Propor Troca de Valor Específica</mattext>
</material>
</response_label>
<response_label ident="89061">
<material>
<mattext texttype="text/plain">Manter o Foco no Relacionamento</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
