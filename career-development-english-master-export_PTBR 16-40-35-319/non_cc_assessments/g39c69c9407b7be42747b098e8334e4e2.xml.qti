        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">78297</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="78297_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">60207</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="60207_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">99179</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="73976_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">These are practical job considerations, not the Gospel-Centered framework questions. The text identifies four questions: spiritual alignment, service potential, family impact, and personal growth.</mattext>
