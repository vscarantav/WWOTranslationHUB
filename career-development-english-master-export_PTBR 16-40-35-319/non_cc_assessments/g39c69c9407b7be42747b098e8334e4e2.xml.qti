    <item ident="gc7111413a95bbd0392c23e6c3f198965" title="Question 1">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>51031,86384,7061,78376</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What two types of preparation does the job search foundation combine?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="51031">
              <material>
                <mattext texttype="text/plain">Spiritual preparation with practical goal-setting</mattext>
              </material>
            </response_label>
            <response_label ident="86384">
              <material>
                <mattext texttype="text/plain">Resume writing with interview practice</mattext>
              </material>
            </response_label>
            <response_label ident="7061">
              <material>
                <mattext texttype="text/plain">Networking with application submissions</mattext>
              </material>
            </response_label>
            <response_label ident="78376">
              <material>
                <mattext texttype="text/plain">Salary research with company analysis</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">86384</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="86384_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7061</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7061_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">78376</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="78376_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">51031</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="86384_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Resume writing and interview practice are job search activities, not the foundational elements. The text states the foundation combines spiritual preparation with practical goal-setting.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7061_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Networking and applications are job search methods, not foundational elements. The text identifies spiritual preparation and practical goal-setting as the components of the job search foundation.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="78376_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">These are research activities within the job search process. The text explains that the foundation combines spiritual preparation with practical goal-setting.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gabf513f279de54054f5a2216debda181" title="Question 10">
