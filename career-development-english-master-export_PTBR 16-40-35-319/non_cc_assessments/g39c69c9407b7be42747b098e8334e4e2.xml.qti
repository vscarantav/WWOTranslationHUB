    <item ident="g65a0a8b84a1c945aacd107005e31a688" title="Question 11">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>69822,22345,160,92358</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What did Nephi do when his steel bow broke during his family's wilderness journey?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="69822">
              <material>
                <mattext texttype="text/plain">Made a new bow and asked his father where to hunt</mattext>
              </material>
            </response_label>
            <response_label ident="22345">
              <material>
                <mattext texttype="text/plain">Waited for the Lord to provide food without taking action</mattext>
              </material>
            </response_label>
            <response_label ident="160">
              <material>
                <mattext texttype="text/plain">Complained about the difficulty of the journey</mattext>
              </material>
            </response_label>
            <response_label ident="92358">
              <material>
                <mattext texttype="text/plain">Asked his brothers to share their food</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">22345</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="22345_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">160</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="160_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">92358</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="92358_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">69822</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="22345_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Nephi combined faith with practical action. The text states that Nephi made a new bow and asked his father where to hunt, demonstrating initiative and resourcefulness.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="160_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Nephi took constructive action instead of complaining. The text shows that Nephi made a new bow and asked his father where to hunt.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="92358_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Nephi created his own solution. The text explains that Nephi made a new bow and asked his father where to hunt.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
