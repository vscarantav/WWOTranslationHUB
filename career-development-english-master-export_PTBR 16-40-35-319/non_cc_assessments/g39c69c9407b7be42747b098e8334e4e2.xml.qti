    <item ident="g9a2c1a94d4da87e1c3353f7b6eb952bd" title="Question 13">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>81128,76989,74288,3735</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;How long do entry-level positions typically require for active job searching?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="81128">
              <material>
                <mattext texttype="text/plain">3-4 months</mattext>
              </material>
            </response_label>
            <response_label ident="76989">
              <material>
                <mattext texttype="text/plain">1-2 weeks</mattext>
              </material>
            </response_label>
            <response_label ident="74288">
              <material>
                <mattext texttype="text/plain">6-12 months</mattext>
              </material>
            </response_label>
            <response_label ident="3735">
              <material>
                <mattext texttype="text/plain">12-18 months</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">76989</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="76989_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">74288</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="74288_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3735</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3735_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">81128</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="76989_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Entry-level searches take longer than this timeframe. The text states that entry-level positions typically require 3-4 months of active searching.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="74288_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This timeframe applies to specialized or senior roles. The text indicates that entry-level positions typically require 3-4 months of active searching.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3735_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Entry-level searches are shorter than this timeframe. The text states that entry-level positions typically require 3-4 months of active searching.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g1cb0ab703742125cf14eb0ee56912a3b" title="Question 14">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>60626,34279,5710,89196</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What should you do if you are not meeting your job search activity targets?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="60626">
              <material>
                <mattext texttype="text/plain">Evaluate whether your goals are realistic or if you need to modify your approach</mattext>
              </material>
            </response_label>
            <response_label ident="34279">
              <material>
                <mattext texttype="text/plain">Give up on your job search completely</mattext>
              </material>
            </response_label>
            <response_label ident="5710">
              <material>
                <mattext texttype="text/plain">Continue the same activities without making changes</mattext>
              </material>
            </response_label>
            <response_label ident="89196">
              <material>
                <mattext texttype="text/plain">Blame external circumstances for lack of progress</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">34279</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="34279_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5710</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5710_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">89196</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="89196_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">60626</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="34279_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">You should adjust rather than abandon your search. The text recommends evaluating whether your goals are realistic or if you need to modify your approach.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5710_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">You should evaluate and adjust your approach. The text states that you should evaluate whether your goals are realistic or if you need to modify your approach.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="89196_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">You should take constructive action. The text explains that you should evaluate whether your goals are realistic or if you need to modify your approach.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
