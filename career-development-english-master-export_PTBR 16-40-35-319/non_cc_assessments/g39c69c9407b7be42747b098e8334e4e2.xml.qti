      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;How should networking be approached according to the text?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="50290">
              <material>
                <mattext texttype="text/plain">Building authentic relationships focused on mutual service and long-term support</mattext>
              </material>
            </response_label>
            <response_label ident="4539">
              <material>
                <mattext texttype="text/plain">Collecting as many business cards as possible</mattext>
              </material>
            </response_label>
            <response_label ident="70482">
              <material>
                <mattext texttype="text/plain">Only contacting people who can immediately offer jobs</mattext>
              </material>
            </response_label>
            <response_label ident="49914">
              <material>
                <mattext texttype="text/plain">Asking everyone you meet for job leads</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
