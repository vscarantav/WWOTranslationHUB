    <item ident="g5dd10fc0da651fe748f4c8b5492a12f2" title="Question 40">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>20720,76483,70074,33314</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What are the four essential questions in the Gospel-Centered Job Decision Framework?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="20720">
              <material>
                <mattext texttype="text/plain">Does this align with divine purposes? How can this help me serve others? Does this support family responsibilities? Will this develop my divine gifts?</mattext>
              </material>
            </response_label>
            <response_label ident="76483">
              <material>
                <mattext texttype="text/plain">What is the salary? Where is the office? When can I start? Who is the manager?</mattext>
              </material>
            </response_label>
            <response_label ident="70074">
              <material>
                <mattext texttype="text/plain">Is the commute convenient? Are benefits good? Is the title impressive? Is parking free?</mattext>
              </material>
            </response_label>
            <response_label ident="33314">
              <material>
                <mattext texttype="text/plain">Will colleagues be friendly? Is the work easy? Can I leave early? Are dress codes relaxed?</mattext>
