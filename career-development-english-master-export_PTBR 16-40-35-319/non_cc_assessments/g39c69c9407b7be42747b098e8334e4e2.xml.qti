            <response_label ident="99179">
              <material>
                <mattext texttype="text/plain">Spiritual alignment, service potential, family impact, and personal growth</mattext>
              </material>
            </response_label>
            <response_label ident="73976">
              <material>
                <mattext texttype="text/plain">Salary level, commute time, benefits package, and vacation days</mattext>
              </material>
            </response_label>
            <response_label ident="78297">
              <material>
                <mattext texttype="text/plain">Company reputation, job title, office location, and work hours</mattext>
              </material>
            </response_label>
            <response_label ident="60207">
              <material>
                <mattext texttype="text/plain">Interview difficulty, application requirements, starting date, and dress code</mattext>
              </material>
            </response_label>
