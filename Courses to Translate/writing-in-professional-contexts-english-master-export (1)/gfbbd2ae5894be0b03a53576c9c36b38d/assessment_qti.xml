      <item ident="g8c48f127c4767aa352558d4f4fb5d488" title="Question 3">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_response.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;As part of the Church Educational System Honor Code, you are expected to complete your own work for each course.&lt;/p&gt;
&lt;p&gt;If you choose to participate in&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;strong&gt;any&lt;/strong&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;actions which violate the Academic Honesty policy, the university has the right to&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;strong&gt;change your course grade to an F now or at any time in the future&lt;/strong&gt;. This means that even if your dishonesty is not discovered until after you complete your certificate or degree, the university still has the right to change your grade and&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;strong&gt;revoke your certificate or degree&lt;/strong&gt;.&lt;/p&gt;
&lt;p&gt;Which of the following are violations of the Honor Code or Academic Honesty Policy? Note that this list is not exhaustive (see Jacob 6:12).&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;strong&gt;Mark all that apply.&lt;/strong&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Multiple">
            <render_choice>
              <response_label ident="181">
                <material>
                  <mattext texttype="text/plain">Posting or sharing your coursework (projects, assignments, and so on) to any online website, through electronic communication, or any other means.</mattext>
                </material>
              </response_label>
              <response_label ident="2401">
                <material>
                  <mattext texttype="text/plain">Obtaining another person's work and submitting all or part of it as if it was your own work.</mattext>
                </material>
              </response_label>
              <response_label ident="9462">
                <material>
                  <mattext texttype="text/plain">Giving your assignment to another student or accepting theirs.</mattext>
                </material>
              </response_label>
              <response_label ident="3085">
                <material>
                  <mattext texttype="text/plain">Using a search engine like Google to find an Excel formula that would solve your project.</mattext>
                </material>
              </response_label>
              <response_label ident="2471">
                <material>
                  <mattext texttype="text/plain">Obtaining course documents from Course Hero or other similar websites.</mattext>
                </material>
              </response_label>
              <response_label ident="2692">
                <material>
                  <mattext texttype="text/plain">Asking questions about the projects on the instructor's weekly announcement which everyone can see.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <and>
                <varequal respident="response1">181</varequal>
                <varequal respident="response1">2401</varequal>
                <varequal respident="response1">9462</varequal>
                <not>
                  <varequal respident="response1">3085</varequal>
                </not>
                <varequal respident="response1">2471</varequal>
                <not>
                  <varequal respident="response1">2692</varequal>
                </not>
              </and>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
