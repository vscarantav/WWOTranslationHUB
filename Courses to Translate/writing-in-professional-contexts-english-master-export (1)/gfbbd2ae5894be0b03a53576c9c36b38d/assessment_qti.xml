      <item ident="gbab16d17b7497ace466692f4ab1fa2aa" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.true_false.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;&lt;span style="color: #000000;"&gt;Turnitin is a program that lets you and your teachers know how much your work reflects other peoples work. After you have submitted your work there will be a color flag appear next to your submission in the grades tab. The different color flags will indicate the percentage of your submission that Turnitin has found to be copied. &lt;strong&gt;NOTE&lt;/strong&gt;: Assignments that use templates will have some copying and Turnitin will flag the assignment questions—do not worry about this. Make sure your answers to the questions have not been copied.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style="color: #000000;"&gt;If the color of your flag is red, you must rework your assignment and resubmit it until your flag is no longer red. An assignment that is turned in with the red flag will not be graded and will be given a 0.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;table style="border-collapse: collapse; width: 45.2639%; height: 271px; border-color: #000000; border-style: solid;" border="1"&gt;
&lt;tbody&gt;
&lt;tr style="height: 29px;"&gt;
&lt;td style="width: 25.1206%; height: 29px;"&gt;&lt;/td&gt;
&lt;td style="width: 74.8819%; height: 29px;"&gt;&lt;span style="color: #000000;"&gt;Turnitin Score Icons&lt;/span&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 53px;"&gt;
&lt;td style="width: 25.1206%; height: 53px;"&gt;&lt;img id="6042618" src="$IMS-CC-FILEBASE$/media/W01%20Quiz:%20Syllabus%20GrayFlag.PNG" alt="W01 Quiz: Syllabus GrayFlag.PNG" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 74.8819%; height: 53px;"&gt;&lt;span style="color: #000000;"&gt;&lt;strong&gt;Gray&lt;/strong&gt;&amp;nbsp;(originality report has not been generated)&lt;/span&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 44px;"&gt;
&lt;td style="width: 25.1206%; height: 44px;"&gt;&lt;img id="6042617" src="$IMS-CC-FILEBASE$/media/W01%20Quiz:%20Syllabus%20BlueFlag.PNG" alt="W01 Quiz: Syllabus BlueFlag.PNG" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 74.8819%; height: 44px;"&gt;&lt;span style="color: #000000;"&gt;&lt;strong&gt;Blue&lt;/strong&gt;&amp;nbsp;(no matching words)&lt;/span&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29px;"&gt;
&lt;td style="width: 25.1206%; height: 29px;"&gt;&lt;img id="6042621" src="$IMS-CC-FILEBASE$/media/W01%20Quiz:%20Syllabus%20GreenFlag.PNG" alt="W01 Quiz: Syllabus GreenFlag.PNG" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 74.8819%; height: 29px;"&gt;&lt;span style="color: #000000;"&gt;&lt;strong&gt;Green&lt;/strong&gt;&amp;nbsp;(1-24% similarity index)&lt;/span&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29px;"&gt;
&lt;td style="width: 25.1206%; height: 29px;"&gt;&lt;img id="6042603" src="$IMS-CC-FILEBASE$/media/W01%20Quiz:%20Syllabus%20YellowFlag.PNG" alt="W01 Quiz: Syllabus YellowFlag.PNG" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 74.8819%; height: 29px;"&gt;&lt;span style="color: #000000;"&gt;&lt;strong&gt;Yellow&lt;/strong&gt;&amp;nbsp;(25-49% similarity index)&lt;/span&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29px;"&gt;
&lt;td style="width: 25.1206%; height: 29px;"&gt;&lt;img id="6042619" src="$IMS-CC-FILEBASE$/media/W01%20Quiz:%20Syllabus%20OrangeFlag.PNG" alt="W01 Quiz: Syllabus OrangeFlag.PNG" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 74.8819%; height: 29px;"&gt;&lt;span style="color: #000000;"&gt;&lt;strong&gt;Orange&lt;/strong&gt;&amp;nbsp;(50-74% similarity index)&lt;/span&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29px;"&gt;
&lt;td style="width: 25.1206%; height: 29px;"&gt;&lt;img id="6042620" src="$IMS-CC-FILEBASE$/media/W01%20Quiz:%20Syllabus%20RedFlag.PNG" alt="W01 Quiz: Syllabus RedFlag.PNG" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 74.8819%; height: 29px;"&gt;&lt;span style="color: #000000;"&gt;&lt;strong&gt;&amp;nbsp;Red&lt;/strong&gt;&amp;nbsp;(75-100% similarity index)&lt;/span&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29px;"&gt;
&lt;td style="width: 25.1206%; height: 29px;"&gt;&lt;img id="6042616" src="$IMS-CC-FILEBASE$/media/W01%20Quiz:%20Syllabus%20Clock.PNG" alt="W01 Quiz: Syllabus Clock.PNG" loading="lazy"&gt;&lt;/td&gt;
