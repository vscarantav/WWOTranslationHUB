          <mattext texttype="text/html">&lt;div&gt;According to the chapter, what is the primary difference between a personal narrative and an argumentative essay in terms of structure?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="54187">
              <material>
                <mattext texttype="text/plain">A personal narrative builds toward a moment of insight, while an argumentative essay states the thesis upfront</mattext>
              </material>
            </response_label>
            <response_label ident="75166">
              <material>
                <mattext texttype="text/plain">A personal narrative states the thesis in the introduction, while an argumentative essay builds to a conclusion</mattext>
              </material>
            </response_label>
            <response_label ident="80686">
              <material>
                <mattext texttype="text/plain">A personal narrative uses evidence and citations, while an argumentative essay uses personal stories</mattext>
              </material>
            </response_label>
            <response_label ident="87612">
              <material>
                <mattext texttype="text/plain">A personal narrative follows a five-paragraph format, while an argumentative essay does not</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
