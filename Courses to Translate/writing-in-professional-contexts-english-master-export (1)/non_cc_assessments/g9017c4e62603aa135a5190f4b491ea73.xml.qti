    <item ident="gd2410af8cac9bbbf08b535a9e3201da4" title="Question 18">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>55442,14789,77427,21980</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;According to the chapter, what is the role of the climax or turning point in a personal narrative?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="55442">
              <material>
                <mattext texttype="text/plain">A key moment where something important happens or changes</mattext>
              </material>
            </response_label>
            <response_label ident="14789">
              <material>
                <mattext texttype="text/plain">The opening that sets the scene and introduces the main people</mattext>
              </material>
            </response_label>
            <response_label ident="77427">
              <material>
                <mattext texttype="text/plain">The section that connects the story to a broader insight or lesson</mattext>
              </material>
            </response_label>
            <response_label ident="21980">
              <material>
                <mattext texttype="text/plain">The part that builds tension through a series of specific events</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">14789</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="14789_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">77427</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="77427_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">21980</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="21980_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">55442</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="14789_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The opening that sets the scene describes the introduction.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="77427_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Connecting to a broader insight describes the conclusion.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="21980_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Building tension through specific events describes the rising action.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gc8023766894d4a77bd800f19c66aef9f" title="Question 19">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>35054,29161,26609,36166</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;According to the chapter, what is the Rogerian method of argumentation?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="35054">
              <material>
                <mattext texttype="text/plain">A method that acknowledges opposing views early in the essay before stating your own position</mattext>
              </material>
            </response_label>
            <response_label ident="29161">
              <material>
                <mattext texttype="text/plain">A method that presents your strongest argument in the opening paragraph</mattext>
              </material>
            </response_label>
            <response_label ident="26609">
              <material>
                <mattext texttype="text/plain">A method that saves all counterarguments for the final paragraph</mattext>
              </material>
            </response_label>
            <response_label ident="36166">
              <material>
                <mattext texttype="text/plain">A method that avoids addressing opposing views to keep the argument focused</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">29161</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="29161_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">26609</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="26609_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">36166</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="36166_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">35054</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="29161_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Presenting the strongest argument first describes a different approach.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="26609_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Saving counterarguments for the final paragraph is a common but less persuasive strategy.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="36166_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Avoiding opposing views entirely weakens rather than strengthens an argument.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
