          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;According to the chapter, what do content revisions involve?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="75299">
              <material>
                <mattext texttype="text/plain">Adding or removing information to strengthen the message</mattext>
              </material>
            </response_label>
            <response_label ident="39517">
              <material>
                <mattext texttype="text/plain">Correcting spelling, punctuation, and grammar errors</mattext>
              </material>
            </response_label>
            <response_label ident="85512">
              <material>
                <mattext texttype="text/plain">Varying sentence lengths and adjusting tone for the audience</mattext>
              </material>
            </response_label>
            <response_label ident="84752">
              <material>
                <mattext texttype="text/plain">Reordering paragraphs and improving transitions</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
