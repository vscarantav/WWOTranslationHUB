              <material>
                <mattext texttype="text/plain">Big picture issues such as thesis clarity and overall structure</mattext>
              </material>
            </response_label>
            <response_label ident="51579">
              <material>
                <mattext texttype="text/plain">Sentence-level issues such as awkward phrasing and vague words</mattext>
              </material>
            </response_label>
            <response_label ident="82513">
              <material>
                <mattext texttype="text/plain">Mechanical issues such as spelling, punctuation, and formatting</mattext>
