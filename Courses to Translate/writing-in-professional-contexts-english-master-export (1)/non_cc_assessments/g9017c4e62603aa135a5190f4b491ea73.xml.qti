              </material>
            </response_label>
            <response_label ident="53209">
              <material>
                <mattext texttype="text/plain">Cause and effect order</mattext>
              </material>
            </response_label>
            <response_label ident="64710">
              <material>
                <mattext texttype="text/plain">Order of importance</mattext>
              </material>
            </response_label>
            <response_label ident="96282">
              <material>
                <mattext texttype="text/plain">Compare and contrast structure</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
