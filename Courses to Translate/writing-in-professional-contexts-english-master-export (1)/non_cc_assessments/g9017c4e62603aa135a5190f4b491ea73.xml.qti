    <item ident="gf2bb9d456fc4f541b90adec216f33a9d" title="Question 31">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>35593,64600,61593,31689</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;According to the chapter, what is one common formatting mistake students make?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="35593">
              <material>
                <mattext texttype="text/plain">Formatting their paper too early before content revisions are complete</mattext>
              </material>
            </response_label>
            <response_label ident="64600">
              <material>
                <mattext texttype="text/plain">Submitting their paper before reading through it themselves</mattext>
              </material>
            </response_label>
            <response_label ident="61593">
              <material>
                <mattext texttype="text/plain">Using too many transitional words between paragraphs</mattext>
              </material>
            </response_label>
            <response_label ident="31689">
              <material>
                <mattext texttype="text/plain">Writing a thesis statement that is too specific</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">64600</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="64600_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">61593</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="61593_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">31689</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="31689_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">35593</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="64600_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Submitting without a personal review is a mistake related to the proofreading stage, not formatting.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="61593_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Using too many transitional words is a style concern.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="31689_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Writing an overly specific thesis is a content concern addressed during big picture revision.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g7a639fdeb2831fd4f9f5b4a2a97be2df" title="Question 32">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
