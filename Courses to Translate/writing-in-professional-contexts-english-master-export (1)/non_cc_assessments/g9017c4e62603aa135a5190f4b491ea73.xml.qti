          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does the prefix &lt;span class="TextRun SCXW237822251 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW237822251 BCX8"&gt;"re" mean in the word "revision"?&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="50363">
              <material>
                <mattext texttype="text/plain">Again</mattext>
              </material>
            </response_label>
            <response_label ident="32024">
              <material>
                <mattext texttype="text/plain">Change</mattext>
              </material>
            </response_label>
            <response_label ident="11604">
              <material>
                <mattext texttype="text/plain">Improve</mattext>
              </material>
            </response_label>
            <response_label ident="60696">
              <material>
                <mattext texttype="text/plain">Back</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">32024</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="32024_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">11604</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="11604_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">60696</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="60696_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">50363</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="32024_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The other options do not reflect the standard definition of this prefix.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="11604_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The other options do not reflect the standard definition of this prefix.</mattext>
