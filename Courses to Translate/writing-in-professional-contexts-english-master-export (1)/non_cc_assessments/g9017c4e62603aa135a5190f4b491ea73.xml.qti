    <item ident="g22fbed90c504d0e295ced559f76b6999" title="Question 20">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>51947,30087,22069,10046</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;According to the chapter, what is &lt;span class="TextRun SCXW229163650 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun ContextualSpellingAndGrammarErrorV2Themed SCXW229163650 BCX8"&gt;"formal&lt;/span&gt;&lt;span class="NormalTextRun SCXW229163650 BCX8"&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;tone" in academic writing?&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW229163650 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:false,&amp;quot;134233118&amp;quot;:false,&amp;quot;335559738&amp;quot;:240,&amp;quot;335559739&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="51947">
              <material>
                <mattext texttype="text/plain">A writer's voice that uses precise language and avoids conversational phrasing</mattext>
              </material>
            </response_label>
            <response_label ident="30087">
              <material>
                <mattext texttype="text/plain">A writing style that uses short sentences and simple vocabulary</mattext>
              </material>
            </response_label>
            <response_label ident="22069">
              <material>
                <mattext texttype="text/plain">A tone that relies on personal stories and emotional language</mattext>
              </material>
            </response_label>
            <response_label ident="10046">
              <material>
                <mattext texttype="text/plain">A voice that uses slang and informal expressions to connect with readers</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">30087</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="30087_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">22069</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="22069_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">10046</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="10046_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">51947</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="30087_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Short sentences and simple vocabulary describe plain language, not formal tone specifically.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="22069_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Personal stories and emotional language describe narrative or informal writing styles.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="10046_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Using slang to connect with readers is the opposite of formal academic tone.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g65163f33966ddfb3a2752c5fd533b646" title="Question 21">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>29334,77616,24496,48903</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;According to the chapter, what should a writer do with the conclusion of a rough draft during big picture revision?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="29334">
              <material>
                <mattext texttype="text/plain">Check it for a clearer or more focused thesis that may have emerged during drafting</mattext>
              </material>
            </response_label>
            <response_label ident="77616">
              <material>
                <mattext texttype="text/plain">Delete it and replace it with a summary of the main points</mattext>
              </material>
            </response_label>
            <response_label ident="24496">
              <material>
                <mattext texttype="text/plain">Move it to the beginning of the essay as the new introduction</mattext>
              </material>
            </response_label>
            <response_label ident="48903">
              <material>
                <mattext texttype="text/plain">Leave it unchanged and focus revision efforts on the body paragraphs</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">77616</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="77616_fb"/>
