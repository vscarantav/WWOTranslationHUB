        </respcondition>
      </resprocessing>
      <itemfeedback ident="13821_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A draft that has not been changed suggests it has not been revised at all.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="36436_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Meeting a word count does not indicate the quality or completeness of the content.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="86653_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The chapter mentions asking others to proofread as one optional strategy, but does not set a specific number of readers as a readiness standard.</mattext>
          </material>
