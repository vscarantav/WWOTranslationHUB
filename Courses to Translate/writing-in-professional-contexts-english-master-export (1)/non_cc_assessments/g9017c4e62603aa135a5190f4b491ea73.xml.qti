            <fieldentry>37412,90355,93265,99013</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following is the definition of &lt;span class="NormalTextRun SCXW102593689 BCX8"&gt;"clarity&lt;/span&gt;&lt;span class="NormalTextRun ContextualSpellingAndGrammarErrorV2Themed SCXW102593689 BCX8"&gt;" as&lt;/span&gt;&lt;span class="NormalTextRun SCXW102593689 BCX8"&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;used in this chapter?&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="37412">
              <material>
                <mattext texttype="text/plain">Being clear and concise in your writing for your intended audience</mattext>
              </material>
            </response_label>
            <response_label ident="90355">
              <material>
                <mattext texttype="text/plain">Using formal language and precise vocabulary in academic writing</mattext>
              </material>
            </response_label>
            <response_label ident="93265">
              <material>
                <mattext texttype="text/plain">Checking for spelling, punctuation, and grammar errors</mattext>
              </material>
            </response_label>
            <response_label ident="99013">
              <material>
                <mattext texttype="text/plain">Varying sentence length and structure throughout a paragraph</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">90355</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="90355_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">93265</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="93265_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">99013</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="99013_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">37412</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="90355_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Using formal language describes academic style or formal tone.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="93265_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Checking for errors describes proofreading.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="99013_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Varying sentence structure is a style technique, not the definition of clarity.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
