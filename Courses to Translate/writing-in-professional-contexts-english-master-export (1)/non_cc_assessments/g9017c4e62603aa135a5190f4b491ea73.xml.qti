          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="11516_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">84414</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="84414_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">26076</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="26076_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">46848</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="11516_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Understanding an argument relates to analytical or persuasive writing, not personal narrative.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="84414_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Following the logical order of evidence relates to argumentative writing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="26076_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Identifying a thesis statement relates to academic essay structure, not the primary purpose of sensory detail.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gcda63ba5adf649fdd7a77d5eb95b6ae6" title="Question 33">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>52704,94021,63635,24206</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;According to the chapter, what is one sign that a writer should keep revising?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="52704">
              <material>
                <mattext texttype="text/plain">Readers report confusion about the main point of the paper</mattext>
              </material>
            </response_label>
            <response_label ident="94021">
              <material>
                <mattext texttype="text/plain">The paper meets the minimum required length for the assignment</mattext>
              </material>
            </response_label>
            <response_label ident="63635">
              <material>
                <mattext texttype="text/plain">The writer has completed all four revision priorities</mattext>
              </material>
            </response_label>
            <response_label ident="24206">
              <material>
                <mattext texttype="text/plain">The paper includes an introduction, body paragraphs, and a conclusion</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">94021</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="94021_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">63635</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="63635_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">24206</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="24206_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">52704</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="94021_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Meeting a minimum length requirement does not indicate the paper is strong or clear.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="63635_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Completing all four revision priorities is a sign the draft may be ready, not a reason to keep revising.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="24206_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Having an introduction, body, and conclusion reflects basic structure but does not guarantee the paper communicates clearly.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g9b3fbd709ffc59e66eaa2fb6a105edf2" title="Question 34">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>19021,15676,73244,16132</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;According to the chapter, what does &lt;span class="TextRun SCXW123308712 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun CommentStart SCXW123308712 BCX8"&gt;"formal academic writing" require in terms of adjectives and adverbs?&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW123308712 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:false,&amp;quot;134233118&amp;quot;:false,&amp;quot;335559738&amp;quot;:240,&amp;quot;335559739&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="19021">
              <material>
                <mattext texttype="text/plain">Use adjectives sparingly and adverbs rarely, letting nouns and verbs do the work</mattext>
              </material>
            </response_label>
            <response_label ident="15676">
              <material>
                <mattext texttype="text/plain">Use adjectives and adverbs frequently to make writing more descriptive</mattext>
              </material>
            </response_label>
            <response_label ident="73244">
              <material>
                <mattext texttype="text/plain">Replace all adjectives with specific nouns to improve clarity</mattext>
              </material>
            </response_label>
            <response_label ident="16132">
              <material>
                <mattext texttype="text/plain">Use adverbs to modify every verb for greater precision</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
