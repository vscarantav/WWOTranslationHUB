    <item ident="g7b8ec5563f3842d3f1c618390c536997" title="Question 10">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>88830,58325,44383,94858</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the definition of&lt;span class="TextRun SCXW201429381 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW201429381 BCX8"&gt;&amp;nbsp;"structure" as presented in the key terms of this chapter?&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="88830">
              <material>
                <mattext texttype="text/plain">The way an author orders and arranges a paper to create overall meaning</mattext>
              </material>
            </response_label>
            <response_label ident="58325">
              <material>
                <mattext texttype="text/plain">The precise words an author selects to express an idea</mattext>
              </material>
            </response_label>
            <response_label ident="44383">
              <material>
                <mattext texttype="text/plain">The process of checking a draft for grammatical errors</mattext>
              </material>
            </response_label>
            <response_label ident="94858">
              <material>
                <mattext texttype="text/plain">The tone a writer uses in formal academic writing</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">58325</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="58325_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">44383</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="44383_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">94858</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="94858_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">88830</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="58325_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Word selection describes diction or style.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="44383_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Checking for errors describes proofreading.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="94858_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The tone used in formal writing describes formal tone, which is a separate concept.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gd5658f2791ceb63520164bd9f33707bf" title="Question 11">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>90509,43197,39317,33854</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following describes the &lt;span class="TextRun SCXW8047058 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW8047058 BCX8"&gt;"style" of a piece of writing?&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="90509">
              <material>
                <mattext texttype="text/plain">The way a writer constructs sentences, chooses words, and uses tone</mattext>
              </material>
            </response_label>
            <response_label ident="43197">
              <material>
                <mattext texttype="text/plain">The logical order in which a writer arranges paragraphs</mattext>
              </material>
            </response_label>
            <response_label ident="39317">
              <material>
                <mattext texttype="text/plain">The process of correcting grammar and punctuation errors</mattext>
              </material>
            </response_label>
            <response_label ident="33854">
              <material>
                <mattext texttype="text/plain">The background information provided at the start of an essay</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">43197</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="43197_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">39317</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="39317_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">33854</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="33854_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">90509</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="43197_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Logical paragraph order describes structure.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="39317_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Correcting grammar and punctuation describes proofreading.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="33854_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Background information at the start of an essay is part of the introduction.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g922f7e9a8534d12f88da4f302cdc5f0b" title="Question 12">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>32709,59472,65451,892</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;According to the chapter, what is &lt;span class="TextRun SCXW23291067 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW23291067 BCX8"&gt;"drafting"?&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="32709">
              <material>
                <mattext texttype="text/plain">Writing the words of a paper</mattext>
              </material>
            </response_label>
            <response_label ident="59472">
              <material>
                <mattext texttype="text/plain">Checking a completed paper for spelling errors</mattext>
              </material>
            </response_label>
            <response_label ident="65451">
              <material>
                <mattext texttype="text/plain">Reorganizing paragraphs after receiving feedback</mattext>
              </material>
            </response_label>
            <response_label ident="892">
              <material>
                <mattext texttype="text/plain">Selecting sources to support an argument</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">59472</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="59472_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">65451</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="65451_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">892</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="892_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">32709</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="59472_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Checking for spelling errors is proofreading.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="65451_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Reorganizing paragraphs after feedback is revision.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="892_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Selecting sources happens during the research and planning stages before drafting.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g81a510bf66006c0fcc60a0460435616b" title="Question 13">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>82897,13740,24019,29655</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;According to the chapter, when should a writer take a break to improve proofreading?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="82897">
              <material>
                <mattext texttype="text/plain">Before proofreading, so fresh eyes catch more errors</mattext>
              </material>
            </response_label>
            <response_label ident="13740">
              <material>
                <mattext texttype="text/plain">After submitting the final draft to the instructor</mattext>
              </material>
            </response_label>
            <response_label ident="24019">
              <material>
                <mattext texttype="text/plain">Before writing the first draft to gather ideas</mattext>
              </material>
            </response_label>
            <response_label ident="29655">
              <material>
                <mattext texttype="text/plain">After receiving feedback from a peer reviewer</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">13740</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="13740_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">24019</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="24019_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">29655</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="29655_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">82897</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="13740_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Taking a break after submission has no benefit to the writing process.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="24019_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A break before drafting relates to planning, not proofreading.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="29655_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A break after peer review relates to revision, not the proofreading stage.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g945a30a874858cbfa005cf223d395db2" title="Question 14">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>69752,10182,92003,76194</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;According to the chapter, what is the first priority a writer should address when revising a draft?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="69752">
              <material>
                <mattext texttype="text/plain">Big picture issues such as thesis clarity and logical organization</mattext>
              </material>
            </response_label>
            <response_label ident="10182">
              <material>
                <mattext texttype="text/plain">Sentence-level issues such as awkward phrasing</mattext>
              </material>
            </response_label>
            <response_label ident="92003">
              <material>
                <mattext texttype="text/plain">Mechanical issues such as spelling and punctuation</mattext>
              </material>
            </response_label>
            <response_label ident="76194">
              <material>
                <mattext texttype="text/plain">Paragraph-level issues such as topic sentences</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">10182</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="10182_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">92003</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="92003_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">76194</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="76194_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">69752</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="10182_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Sentence-level issues are the third priority.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="92003_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Mechanical issues such as spelling and punctuation are the fourth and final priority.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="76194_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Paragraph-level issues are the second priority.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gfe12d00d4c41e230870526a53a0ec3d1" title="Question 15">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
