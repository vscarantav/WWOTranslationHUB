          <render_choice>
            <response_label ident="77846">
              <material>
                <mattext texttype="text/plain">A form of revision that involves carefully rewriting and condensing a written work</mattext>
              </material>
            </response_label>
            <response_label ident="49297">
              <material>
                <mattext texttype="text/plain">A proofreading technique that checks for surface errors in a final draft</mattext>
              </material>
            </response_label>
            <response_label ident="83805">
              <material>
                <mattext texttype="text/plain">A strategy for adding more evidence and detail to underdeveloped paragraphs</mattext>
              </material>
            </response_label>
            <response_label ident="42881">
              <material>
                <mattext texttype="text/plain">A method of reorganizing paragraphs to improve logical flow</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
