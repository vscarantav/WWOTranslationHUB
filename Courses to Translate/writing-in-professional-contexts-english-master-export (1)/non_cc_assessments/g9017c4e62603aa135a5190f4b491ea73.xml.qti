              </material>
            </response_label>
            <response_label ident="11516">
              <material>
                <mattext texttype="text/plain">Understand the argument the writer is making</mattext>
              </material>
            </response_label>
            <response_label ident="84414">
              <material>
                <mattext texttype="text/plain">Follow the logical order of the writer's evidence</mattext>
              </material>
            </response_label>
            <response_label ident="26076">
              <material>
                <mattext texttype="text/plain">Identify the thesis statement of the narrative</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
