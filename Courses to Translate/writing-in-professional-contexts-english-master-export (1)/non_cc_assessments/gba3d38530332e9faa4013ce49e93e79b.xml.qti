          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does the source evaluation criterion &lt;strong&gt;Purpose&lt;/strong&gt; ask readers to examine?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="49302">
              <material>
                <mattext texttype="text/plain">Why the content was created and whether it is informational, persuasive, or commercial</mattext>
              </material>
            </response_label>
            <response_label ident="9467">
              <material>
                <mattext texttype="text/plain">Who wrote the content and what their credentials are</mattext>
              </material>
            </response_label>
            <response_label ident="76161">
              <material>
                <mattext texttype="text/plain">When the content was published and whether it is current</mattext>
              </material>
            </response_label>
            <response_label ident="51164">
              <material>
                <mattext texttype="text/plain">Whether the facts in the content can be verified through other sources</mattext>
              </material>
            </response_label>
          </render_choice>
