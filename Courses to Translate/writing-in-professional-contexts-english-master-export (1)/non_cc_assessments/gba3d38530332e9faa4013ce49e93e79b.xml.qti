              <material>
                <mattext texttype="text/plain">Using Ctrl+F to search for key terms in the text</mattext>
              </material>
            </response_label>
            <response_label ident="55005">
              <material>
                <mattext texttype="text/plain">Writing questions in the margins as you read</mattext>
              </material>
            </response_label>
          </render_choice>
