                <mattext texttype="text/plain">Examining headings and subheadings before detailed reading begins</mattext>
              </material>
            </response_label>
            <response_label ident="320">
              <material>
                <mattext texttype="text/plain">Marking important passages and writing notes in the margins</mattext>
              </material>
            </response_label>
            <response_label ident="3500">
              <material>
                <mattext texttype="text/plain">Reflecting on what you learned after completing a reading assignment</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
