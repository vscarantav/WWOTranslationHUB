            <varequal respident="response1">38198</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="38198_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">320</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="320_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3500</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3500_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">63717</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="63717_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Questioning means actively thinking about and interacting with the text by creating a dialogue with the author. It involves asking about the author's main point, evaluating evidence, and forming your own thoughts about what you read.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="38198_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Examining headings and subheadings before detailed reading begins describes previewing, the first step in the reading process loop. Questioning involves engaging critically with the text during reading.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="320_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Marking important passages and writing notes in the margins describes annotating, the third step in the reading process loop. Questioning involves thinking critically and forming a dialogue with the author.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3500_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Reflecting on what you learned after completing a reading assignment describes reviewing, the fourth step in the reading process loop. Questioning takes place during reading.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g03f3ca367ebef9650b0a5cfff4154614" title="Question 29">
      <itemmetadata>
