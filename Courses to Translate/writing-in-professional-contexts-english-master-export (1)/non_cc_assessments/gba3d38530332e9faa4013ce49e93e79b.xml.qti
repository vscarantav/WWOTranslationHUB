          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;According to the reading, when does reading for education require you to engage with a text?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="3899">
              <material>
                <mattext texttype="text/plain">Multiple times to gain a deeper understanding of the concepts</mattext>
              </material>
            </response_label>
            <response_label ident="23386">
              <material>
                <mattext texttype="text/plain">One time before moving on to the next assignment</mattext>
              </material>
            </response_label>
            <response_label ident="56457">
              <material>
                <mattext texttype="text/plain">Only during class discussions and group activities</mattext>
              </material>
            </response_label>
            <response_label ident="32358">
              <material>
                <mattext texttype="text/plain">Only when preparing for an exam or written assignment</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3899</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3899_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">23386</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="23386_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">56457</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="56457_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">32358</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="32358_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">3899</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="3899_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">According to the reading, reading for education requires engaging with a text multiple times to gain a deeper understanding of the concepts. This is different from reading for pleasure, which typically involves reading a text once.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="23386_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Reading a text one time before moving on describes passive reading and is not recommended for academic reading. The reading states that successful academic reading requires engaging with a text multiple times.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="56457_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The reading does not limit text engagement to class discussions and group activities. Academic reading requires engaging with a text multiple times in any context where deep understanding is needed.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="32358_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The reading does not limit text engagement to exam or assignment preparation only. Academic reading requires engaging with a text multiple times whenever deep comprehension is the goal.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gf3ca65f0048df4e9d1b3279f2dccfdec" title="Question 49">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
