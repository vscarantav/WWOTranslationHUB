            <varequal respident="response1">9467</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9467_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">76161</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="76161_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">51164</varequal>
