      <itemfeedback ident="63254_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">A growth accelerator prompt uses AI to deepen your engagement with a text you have already read. An example is asking AI to explain an unfamiliar term you encountered during your own reading.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="36545_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;A dependence trap prompt skips the reading process entirely and hands comprehension work over to AI. A growth accelerator prompt is the opposite—it supports your reading after you have engaged with the text yourself.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="23810_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">A reviewing prompt is not a term used in the reading. A growth accelerator prompt is the specific term used to describe an AI prompt that deepens engagement after you have already read the text.</mattext>
