      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which of the following is listed as a tip for effective skimming?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="15893">
              <material>
