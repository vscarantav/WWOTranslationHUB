            <fieldentry>49892,89573,83926,85846</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the term for the reading strategy that involves running your eyes over text in a zigzag or S-pattern to find specific information?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="49892">
              <material>
                <mattext texttype="text/plain">Scanning</mattext>
              </material>
            </response_label>
            <response_label ident="89573">
              <material>
                <mattext texttype="text/plain">Skimming</mattext>
              </material>
            </response_label>
            <response_label ident="83926">
              <material>
                <mattext texttype="text/plain">Previewing</mattext>
              </material>
            </response_label>
            <response_label ident="85846">
              <material>
                <mattext texttype="text/plain">Annotating</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">49892</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="49892_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">89573</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="89573_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">83926</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="83926_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">85846</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="85846_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">49892</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="49892_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Scanning is the reading strategy that involves running your eyes over text in a zigzag or S-pattern to find specific information such as a name, date, or statistic. You read only what is needed to locate the target information.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="89573_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Skimming is used to get a general overview of a text, not to locate specific information. Scanning uses a zigzag or S-pattern to find a specific piece of information quickly.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="83926_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Previewing is the first step in the reading process loop and involves examining text features before detailed reading. Scanning uses a zigzag or S-pattern to find specific information.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="85846_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Annotating involves marking up a text and adding notes during reading. Scanning uses a zigzag or S-pattern to find a specific piece of information quickly.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g80008400d504fbc80b0fdf3eec8472ed" title="Question 28">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
