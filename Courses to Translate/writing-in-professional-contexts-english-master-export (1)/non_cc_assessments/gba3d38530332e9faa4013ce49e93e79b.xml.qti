        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">28230</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="28230_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9985</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9985_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">21902</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="21902_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Annotating means actively engaging with a text by pausing to reflect, mark up, and add notes while reading. Effective annotation goes beyond highlighting to include writing questions, summarizing key points, and making connections with the author's ideas.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="58907_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Reading quickly over a text to gather the most important information describes skimming. Annotating involves physically marking up a text and adding notes during reading.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="28230_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Examining text features such as headings and images before reading in detail describes previewing, the first step in the reading process loop. Annotating takes place during detailed reading.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9985_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Reflecting on and consolidating what you learned after finishing a text describes reviewing, the fourth step in the reading process loop. Annotating takes place during reading, not after.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g0854d9633ebe92992ac55457445a602b" title="Question 31">
