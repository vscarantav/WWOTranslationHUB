          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;According to the reading, what makes reading for education so valuable?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="26309">
              <material>
                <mattext texttype="text/plain">The thinking you do as you move through the text</mattext>
              </material>
            </response_label>
            <response_label ident="87701">
