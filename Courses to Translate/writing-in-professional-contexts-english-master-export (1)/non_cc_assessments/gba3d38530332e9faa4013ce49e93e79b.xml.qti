        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">86254</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="86254_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">94964</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="94964_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">26309</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="26309_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">According to the reading, the value of reading for education is in the thinking you do as you move through the text. The reading process itself builds comprehension skills that cannot be replaced by receiving a summary.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="87701_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The reading does not state that the value is in memorizing a summary of a text. Memorizing a summary after finishing does not capture the thinking that takes place during the reading process.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="86254_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The number of pages read in a single session is not identified as the value of reading for education. The reading emphasizes that the value lies in the thinking you do as you move through the text.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="94964_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The speed at which you complete a reading assignment is not identified as the value of reading for education. The reading emphasizes that the value lies in the thinking you do as you move through the text.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ga901bef75ea435211b1317c9c65fef7f" title="Question 5">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>53997,2566,3220,90098</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is skimming used for?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="53997">
              <material>
                <mattext texttype="text/plain">To quickly gather the most important information from a text</mattext>
              </material>
            </response_label>
            <response_label ident="2566">
              <material>
                <mattext texttype="text/plain">To find a specific name or date in a text</mattext>
              </material>
            </response_label>
            <response_label ident="3220">
              <material>
                <mattext texttype="text/plain">To write questions in the margins of a text</mattext>
              </material>
            </response_label>
            <response_label ident="90098">
              <material>
                <mattext texttype="text/plain">To reflect on what you learned after reading</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">53997</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="53997_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">2566</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="2566_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3220</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3220_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">90098</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="90098_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">53997</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="53997_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Skimming is used to quickly gather the most important information from a text. You read the first paragraph, last paragraph, and any headings or summaries to get a general overview.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="2566_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Finding a specific name or date in a text describes scanning, not skimming. Skimming gives you a general overview of the content.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3220_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Writing questions in the margins is part of annotating, the third step in the reading process loop. Skimming is used to quickly gather key information.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="90098_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Reflecting on what you learned after reading describes the reviewing step. Skimming is used to quickly gather key information before or during reading.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
