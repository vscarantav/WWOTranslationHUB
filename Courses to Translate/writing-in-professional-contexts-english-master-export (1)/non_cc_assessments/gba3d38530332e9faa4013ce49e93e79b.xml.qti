            <varequal respident="response1">46863</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="46863_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">96279</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="96279_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The reading process loop is a systematic approach to reading that involves four interconnected strategies: previewing, questioning, annotating, and reviewing. This recursive process allows readers to move back and forth between strategies to achieve deep understanding.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="60197_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Reading a text one time to gather key information describes passive reading. The reading process loop involves four interconnected strategies applied across multiple passes through a text.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3561_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Locating specific information in a digital document describes scanning. The reading process loop is a complete framework for achieving deep comprehension through four interconnected strategies.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="46863_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Summarizing a text after reading it is one part of the reviewing step. The reading process loop is a broader framework that includes previewing, questioning, annotating, and reviewing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gf9296aaf794da7d00e9d9003da9ce755" title="Question 26">
      <itemmetadata>
