    <item ident="gf4f3dcd9e56319b7b07caa959a0eab91" title="Question 1">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>73238,33626,52477,48750</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the first step in the reading process loop?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="73238">
              <material>
                <mattext texttype="text/plain">Previewing</mattext>
              </material>
            </response_label>
            <response_label ident="33626">
              <material>
                <mattext texttype="text/plain">Questioning</mattext>
              </material>
            </response_label>
            <response_label ident="52477">
              <material>
                <mattext texttype="text/plain">Annotating</mattext>
              </material>
            </response_label>
            <response_label ident="48750">
              <material>
                <mattext texttype="text/plain">Reviewing</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">73238</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="73238_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">33626</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="33626_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">52477</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="52477_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">48750</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="48750_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">73238</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="73238_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Previewing is the first step in the reading process loop. Previewing means examining text features before detailed reading begins. It helps you recall prior knowledge and set a purpose for reading.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="33626_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Questioning is the second step, not the first. The correct order is previewing, questioning, annotating, and reviewing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="52477_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Annotating is the third step, not the first. The correct order is previewing, questioning, annotating, and reviewing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="48750_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Reviewing is the fourth and final step, not the first. The correct order is previewing, questioning, annotating, and reviewing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ge064c044050a6352b1f9606206485b91" title="Question 10">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>42368,95255,29968,85890</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the purpose of the reviewing step in the reading process loop?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="42368">
              <material>
                <mattext texttype="text/plain">To consolidate and reflect on what you learned after reading</mattext>
              </material>
            </response_label>
            <response_label ident="95255">
              <material>
                <mattext texttype="text/plain">To examine headings and subheadings before reading</mattext>
              </material>
            </response_label>
            <response_label ident="29968">
              <material>
                <mattext texttype="text/plain">To locate specific information such as names and dates</mattext>
              </material>
            </response_label>
            <response_label ident="85890">
              <material>
                <mattext texttype="text/plain">To highlight key sentences during reading</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">42368</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="42368_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">95255</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="95255_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">29968</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="29968_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">85890</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="85890_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">42368</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="42368_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Reviewing is the fourth and final step in the reading process loop. Its purpose is to consolidate and reflect on what you learned after reading. You ask yourself questions such as "What did I learn?" and "How does this connect to other things I am learning?"</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="95255_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Examining headings and subheadings before reading describes previewing, the first step in the reading process loop. Reviewing happens after you have finished reading.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="29968_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Locating specific information such as names and dates describes scanning. Reviewing is about reflecting on and consolidating what you learned from the text.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="85890_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Highlighting key sentences during reading is part of annotating, the third step. Reviewing happens after reading and focuses on reflection and consolidation.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
