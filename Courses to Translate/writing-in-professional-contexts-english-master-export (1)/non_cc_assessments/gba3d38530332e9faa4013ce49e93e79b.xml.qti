      <itemfeedback ident="94896_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Questioning involves actively thinking about and interacting with the text as you read. It creates a dialogue between you and the author and helps you think critically about the content.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="69528_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Locating a specific statistic or date describes scanning. Questioning is about creating a dialogue with the author by thinking critically about the content.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="45381_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Examining headings and subheadings before reading describes previewing, the first step in the reading process loop. Questioning takes place during reading.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="53536_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Highlighting the most important sentences is part of annotating. Questioning involves actively thinking about and engaging with the author's ideas.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
