      <itemfeedback ident="95727_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Professional reading involves reading to make informed decisions, solve problems, or stay current in a career field. It includes reports, emails, industry publications, and technical documents.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="30314_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Personal reading is done for spiritual growth, entertainment, or personal development. Professional reading is specifically focused on career-related decisions and staying current in a professional field.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="90286_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Civic reading is done to understand community issues and make informed decisions as a citizen. Professional reading is specifically focused on career-related decisions and staying current in a professional field.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="67866_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Academic reading is done to learn, analyze, and apply new concepts in educational settings. Professional reading is specifically focused on career-related decisions and staying current in a professional field.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g2d0a59ddcc9ba48e8e8d446433fcdf6e" title="Question 32">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>7127,60430,93024,27304</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does the annotation symbol &lt;strong&gt;C&lt;/strong&gt; represent when used during reading?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="7127">
              <material>
                <mattext texttype="text/plain">A connection to another concept</mattext>
              </material>
            </response_label>
            <response_label ident="60430">
              <material>
                <mattext texttype="text/plain">A confusing section that needs further review</mattext>
              </material>
            </response_label>
            <response_label ident="93024">
              <material>
                <mattext texttype="text/plain">An important point worth remembering</mattext>
              </material>
            </response_label>
            <response_label ident="27304">
              <material>
                <mattext texttype="text/plain">A definition of a new term</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7127</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7127_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">60430</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="60430_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">93024</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="93024_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">27304</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="27304_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">7127</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="7127_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The annotation symbol &lt;em&gt;C&lt;/em&gt; is used to mark connections to other concepts. This helps readers build relationships between ideas within and across texts.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="60430_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Marking a confusing section is represented by the symbol &lt;em&gt;?&lt;/em&gt; not &lt;em&gt;C&lt;/em&gt;. The &lt;em&gt;C&lt;/em&gt; symbol is specifically used to flag connections to other concepts.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="93024_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Marking an important point worth remembering is represented by the symbol&lt;em&gt; !&lt;/em&gt; not &lt;em&gt;C&lt;/em&gt;. The &lt;em&gt;C&lt;/em&gt; symbol is specifically used to flag connections to other concepts.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="27304_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Marking a definition of a new term is represented by the symbol &lt;em&gt;D&lt;/em&gt; not &lt;em&gt;C&lt;/em&gt;. The &lt;em&gt;C&lt;/em&gt; symbol is specifically used to flag connections to other concepts.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g8e2ac5eecbff30e234c7b01b40ff1393" title="Question 33">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
