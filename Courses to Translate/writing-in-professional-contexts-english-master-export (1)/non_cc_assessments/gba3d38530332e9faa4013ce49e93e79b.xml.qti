          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which of the following questions is listed as an example of a question to ask during the questioning step of the reading process loop?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="56653">
              <material>
                <mattext texttype="text/plain">What is the author's main point?</mattext>
              </material>
            </response_label>
            <response_label ident="75592">
              <material>
                <mattext texttype="text/plain">What are the headings and subheadings of this text?</mattext>
              </material>
            </response_label>
            <response_label ident="43644">
              <material>
                <mattext texttype="text/plain">What symbols should I use to annotate this text?</mattext>
              </material>
            </response_label>
            <response_label ident="78969">
              <material>
                <mattext texttype="text/plain">What did I learn from this reading assignment?</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
