        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">75592</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="75592_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">43644</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="43644_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">78969</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="78969_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">56653</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="56653_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">"What is the author's main point?" is listed as an example of a question to ask during the questioning step. Asking this type of question helps you engage critically with the text and think about the author's argument.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="75592_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Examining headings and subheadings is part of previewing, the first step in the reading process loop. Questioning involves engaging critically with the author's ideas during reading.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="43644_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Deciding which symbols to use for annotation is part of the annotating step. Questioning involves engaging critically with the author's ideas and forming your own thoughts about the content.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="78969_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Asking what you learned from a reading assignment describes the reviewing step. Questioning takes place during reading and focuses on engaging critically with the author's ideas.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g4b2ab97c5d1c400e5df3149e5c28b26e" title="Question 34">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>61701,46308,34063,62401</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which of the following is listed as a tip for effective scanning?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="61701">
              <material>
                <mattext texttype="text/plain">Scanning the first sentence after each heading</mattext>
              </material>
            </response_label>
            <response_label ident="46308">
              <material>
                <mattext texttype="text/plain">Reading the first and last paragraphs of the text</mattext>
              </material>
            </response_label>
            <response_label ident="34063">
              <material>
                <mattext texttype="text/plain">Writing summaries and questions in the margins</mattext>
              </material>
            </response_label>
            <response_label ident="62401">
              <material>
                <mattext texttype="text/plain">Reading the abstract if one is provided</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">61701</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="61701_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">46308</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="46308_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">34063</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="34063_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">62401</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="62401_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">61701</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="61701_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Scanning the first sentence after each heading is listed as a tip for effective scanning. This helps you quickly locate relevant sections without reading the full text.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="46308_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Reading the first and last paragraphs of a text is a tip for skimming, not scanning. Scanning focuses on locating specific information quickly using targeted eye movements.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="34063_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Writing summaries and questions in the margins is part of annotating, the third step in the reading process loop. Scanning is used to locate specific information quickly.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="62401_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Reading the abstract if one is provided is a tip for skimming, not scanning. Scanning focuses on locating specific information quickly using targeted eye movements.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g1514b4305dfae005c223532fbeb09400" title="Question 35">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>17596,66435,83854,65613</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does the source evaluation criterion &lt;strong&gt;Authority&lt;/strong&gt; ask readers to examine?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="17596">
              <material>
                <mattext texttype="text/plain">Who wrote the content and what their credentials are</mattext>
              </material>
            </response_label>
            <response_label ident="66435">
              <material>
                <mattext texttype="text/plain">When the content was published and whether it is current</mattext>
              </material>
            </response_label>
            <response_label ident="83854">
              <material>
                <mattext texttype="text/plain">Why the content was created and whether it is informational or persuasive</mattext>
              </material>
            </response_label>
            <response_label ident="65613">
              <material>
                <mattext texttype="text/plain">Whether the facts in the content can be verified through other sources</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">17596</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="17596_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">66435</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="66435_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">83854</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="83854_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">65613</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="65613_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">17596</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="17596_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The authority criterion asks readers to examine who wrote the content and what their credentials are. Checking the author's background helps readers determine whether a source is trustworthy and reliable.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="66435_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Examining when the content was published describes the currency criterion, not authority. Authority focuses specifically on who wrote the content and their qualifications.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="83854_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Examining why the content was created describes the purpose criterion, not authority. Authority focuses specifically on who wrote the content and their qualifications.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="65613_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Examining whether facts can be verified through other sources describes the accuracy criterion, not authority. Authority focuses specifically on who wrote the content and their qualifications.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g853771e63a4d8d5cd9b41183e977de37" title="Question 36">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
