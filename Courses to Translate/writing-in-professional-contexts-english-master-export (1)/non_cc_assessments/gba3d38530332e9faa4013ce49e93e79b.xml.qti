      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What criterion should readers check when evaluating the currency of an online source?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="90699">
              <material>
                <mattext texttype="text/plain">When the content was published and whether the information is up to date</mattext>
              </material>
            </response_label>
            <response_label ident="22727">
              <material>
                <mattext texttype="text/plain">Who wrote the content and what their credentials are</mattext>
              </material>
            </response_label>
            <response_label ident="70948">
              <material>
                <mattext texttype="text/plain">Why the content was created and whether it is informational or persuasive</mattext>
              </material>
            </response_label>
            <response_label ident="17141">
              <material>
                <mattext texttype="text/plain">Whether the facts can be verified through other sources</mattext>
              </material>
            </response_label>
