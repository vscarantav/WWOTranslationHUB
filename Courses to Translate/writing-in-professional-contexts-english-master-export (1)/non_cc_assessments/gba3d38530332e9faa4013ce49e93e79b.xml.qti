          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What keyboard shortcut can readers use to scan for specific information in a digital text?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="7231">
              <material>
                <mattext texttype="text/plain">Ctrl+F</mattext>
              </material>
            </response_label>
            <response_label ident="32850">
              <material>
                <mattext texttype="text/plain">Ctrl+C</mattext>
              </material>
            </response_label>
            <response_label ident="43662">
              <material>
                <mattext texttype="text/plain">Ctrl+Z</mattext>
              </material>
            </response_label>
            <response_label ident="3012">
              <material>
                <mattext texttype="text/plain">Ctrl+S</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7231</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7231_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">32850</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="32850_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">43662</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="43662_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3012</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3012_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">7231</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="7231_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Ctrl+F opens a search function in most digital tools and browsers, allowing you to locate specific words or phrases quickly. This is a useful scanning tool for digital texts.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="32850_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Ctrl+C is the keyboard shortcut for copying selected text. Ctrl+F is the correct shortcut for searching within a digital document.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="43662_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Ctrl+Z is the keyboard shortcut for undoing an action. Ctrl+F is the correct shortcut for searching within a digital document.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3012_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Ctrl+S is the keyboard shortcut for saving a document. Ctrl+F is the correct shortcut for searching within a digital document.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gb0cf31ddc348cf919218bd8a858f986a" title="Question 19">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>99850,8647,48448,22128</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;How is the reading process loop structured?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="99850">
              <material>
                <mattext texttype="text/plain">Recursive, meaning readers can move back and forth between steps as needed</mattext>
              </material>
            </response_label>
            <response_label ident="8647">
              <material>
                <mattext texttype="text/plain">Linear, meaning readers must complete each step once in order</mattext>
              </material>
            </response_label>
            <response_label ident="48448">
              <material>
                <mattext texttype="text/plain">Optional, meaning readers choose only the steps that apply to them</mattext>
              </material>
            </response_label>
            <response_label ident="22128">
              <material>
                <mattext texttype="text/plain">Fixed, meaning readers must spend equal time on each step</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">99850</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="99850_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">8647</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="8647_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">48448</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="48448_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">22128</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="22128_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">99850</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="99850_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The reading process loop is described as recursive, meaning readers can move back and forth between steps as needed. For example, a reader might preview a section, annotate it, and then preview the next section before continuing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="8647_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The reading process loop is not linear. It is recursive, meaning readers move back and forth between steps rather than completing each step exactly once in order.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="48448_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The reading process loop is not optional. All four steps work together to build deep comprehension, and skipping steps reduces the effectiveness of the process.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="22128_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The reading process loop is not fixed in terms of time spent on each step. It is recursive, meaning readers move between steps based on their needs and the demands of the text.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g80406108eb050a943234a9ccf14ab46b" title="Question 2">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
