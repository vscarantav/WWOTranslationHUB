          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="64478_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Web browser extensions such as Hypothesis or Diigo are listed as digital annotation tools. These tools allow readers to highlight and add notes directly onto web pages without changing the original content.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6607_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A printed index at the back of a textbook is a navigational feature of print texts, not a digital annotation tool. Digital annotation tools allow readers to mark and add notes directly within digital texts.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="46336_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A search engine is used to find information online, not to annotate a text. Digital annotation tools allow readers to mark and add notes directly within digital texts.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="38986_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A physical highlighter is used to mark printed pages, not digital texts. Digital annotation tools such as browser extensions allow readers to annotate content directly within a digital environment.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g68d693117b1b229569de7fb18b329021" title="Question 38">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>79318,84790,56030,4650</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the term used in the reading to describe an AI prompt that skips the reading process and hands over comprehension work to AI?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="79318">
              <material>
                <mattext texttype="text/plain">A dependence trap prompt</mattext>
              </material>
            </response_label>
            <response_label ident="84790">
              <material>
                <mattext texttype="text/plain">A growth accelerator prompt</mattext>
              </material>
            </response_label>
            <response_label ident="56030">
              <material>
                <mattext texttype="text/plain">A scanning prompt</mattext>
              </material>
            </response_label>
            <response_label ident="4650">
              <material>
                <mattext texttype="text/plain">A previewing prompt</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">79318</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="79318_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">84790</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="84790_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">56030</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="56030_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4650</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4650_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">79318</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="79318_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">A dependence trap prompt is a prompt that skips the reading process entirely and hands over comprehension work to AI. An example is asking AI to summarize a chapter before you have read it yourself.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="84790_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;A growth accelerator prompt uses AI to deepen your engagement with a text you have already read. A dependence trap prompt is the opposite—it skips the reading process entirely.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="56030_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">A scanning prompt is not a term used in the reading. A dependence trap prompt is the specific term used to describe an AI prompt that replaces the reading process rather than supporting it.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4650_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">A previewing prompt is not a term used in the reading. A dependence trap prompt is the specific term used to describe an AI prompt that skips the reading process and hands over comprehension work to AI.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
