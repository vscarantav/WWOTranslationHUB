      <itemfeedback ident="49302_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The purpose criterion asks readers to examine why the content was created and whether it is informational, persuasive, or commercial. Understanding an author's purpose helps readers evaluate potential bias in a source.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9467_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Examining who wrote the content and their credentials describes the authority criterion, not purpose. Purpose focuses specifically on why the content was created.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="76161_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Examining when the content was published describes the currency criterion, not purpose. Purpose focuses specifically on why the content was created and what it is designed to do.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="51164_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Examining whether facts can be verified through other sources describes the accuracy criterion, not purpose. Purpose focuses specifically on why the content was created.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g8be995f1c929ed69384c7611e194d288" title="Question 37">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
