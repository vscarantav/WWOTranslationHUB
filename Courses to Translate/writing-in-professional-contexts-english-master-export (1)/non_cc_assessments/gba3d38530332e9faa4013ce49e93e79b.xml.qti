      <itemfeedback ident="90699_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Currency refers to when content was published and whether the information is up to date. Checking the publication date helps readers determine if a source reflects current knowledge on a topic.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="22727_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Checking who wrote the content and their credentials describes the authority criterion, not currency. Currency specifically refers to when the content was published.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="70948_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Checking why the content was created describes the purpose criterion, not currency. Currency specifically refers to when the content was published and whether it is current.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="17141_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Checking whether facts can be verified through other sources describes the accuracy criterion, not currency. Currency specifically refers to when the content was published.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g4693c6465bc0a12cada61bb099deeb75" title="Question 27">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
