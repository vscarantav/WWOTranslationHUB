            <varequal respident="response1">86087</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="86087_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">47723</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="47723_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">38360</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="38360_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">10504</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="10504_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">86087</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="86087_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The reading process loop has four steps: previewing, questioning, annotating, and reviewing. Each step builds on the one before it.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="47723_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The reading process loop has four steps, not two. The four steps are previewing, questioning, annotating, and reviewing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="38360_fb">
        <flow_mat>
          <material>
