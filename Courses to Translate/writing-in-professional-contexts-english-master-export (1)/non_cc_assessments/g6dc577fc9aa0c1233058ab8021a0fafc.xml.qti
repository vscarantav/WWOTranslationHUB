      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which of the five senses does the phrase "the rough bark bit into my palms" engage?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="89263">
              <material>
                <mattext texttype="text/plain">Touch</mattext>
              </material>
            </response_label>
            <response_label ident="23764">
              <material>
                <mattext texttype="text/plain">Sight</mattext>
              </material>
            </response_label>
            <response_label ident="53853">
              <material>
                <mattext texttype="text/plain">Smell</mattext>
              </material>
            </response_label>
            <response_label ident="33713">
              <material>
                <mattext texttype="text/plain">Sound</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">23764</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="23764_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">53853</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="53853_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">33713</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="33713_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">89263</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="23764_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Sight describes what something looks like.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="53853_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Smell refers to scents and odors.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="33713_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Sound refers to what is heard.</mattext>
