      </itemfeedback>
    </item>
    <item ident="g1a3f5f7721414f844bf3f0ef417c819c" title="Question 7">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>59425,62717,20639,22744</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is a memoir?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="59425">
              <material>
                <mattext texttype="text/plain">A first-person account of a significant time period or event in the author's life</mattext>
              </material>
            </response_label>
            <response_label ident="62717">
              <material>
                <mattext texttype="text/plain">A third-person biography of a historical figure</mattext>
              </material>
            </response_label>
            <response_label ident="20639">
              <material>
                <mattext texttype="text/plain">A nonfiction essay that argues a position using evidence</mattext>
              </material>
            </response_label>
            <response_label ident="22744">
              <material>
                <mattext texttype="text/plain">A short story written about a fictional character</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">62717</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="62717_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">20639</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="20639_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">22744</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="22744_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">59425</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="62717_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A biography is written in third person about another person.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="20639_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A nonfiction argumentative essay presents a claim supported by evidence.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="22744_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A short story features fictional characters.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gfbeb942413281267c4ac8b3946e77be6" title="Question 8">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>20079,94884,57111,64584</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the purpose of reflection in a personal narrative?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="20079">
              <material>
                <mattext texttype="text/plain">To connect the specific experience to broader meaning and show how the author's perspective changed</mattext>
              </material>
            </response_label>
            <response_label ident="94884">
              <material>
                <mattext texttype="text/plain">To introduce the setting and characters at the start of the story</mattext>
              </material>
            </response_label>
            <response_label ident="57111">
              <material>
                <mattext texttype="text/plain">To provide background information before the main events begin</mattext>
              </material>
            </response_label>
            <response_label ident="64584">
              <material>
                <mattext texttype="text/plain">To describe sensory details so readers can visualize the scene</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">94884</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="94884_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">57111</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="57111_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">64584</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="64584_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">20079</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="94884_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Introducing setting and characters is the purpose of the beginning.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="57111_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Background information belongs in the beginning, as well.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="64584_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Sensory details are a technique used throughout the narrative.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gcded7cf58182cb0f9b6ad181120ecba2" title="Question 9">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>66587,89477,81123,38779</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the definition of a personal narrative's deeper story?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="66587">
              <material>
                <mattext texttype="text/plain">The meaning behind the events and why the experience matters</mattext>
              </material>
            </response_label>
            <response_label ident="89477">
              <material>
                <mattext texttype="text/plain">The sequence of events that occurred during the experience</mattext>
              </material>
            </response_label>
            <response_label ident="81123">
              <material>
                <mattext texttype="text/plain">The sensory details the author uses to describe the scene</mattext>
              </material>
            </response_label>
            <response_label ident="38779">
              <material>
                <mattext texttype="text/plain">The background information provided at the start of the narrative</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">89477</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="89477_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">81123</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="81123_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">38779</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="38779_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">66587</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="89477_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The sequence of events is the surface story.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="81123_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Sensory details are a writing technique used throughout the narrative.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="38779_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Background information belongs to the exposition.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
