        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="57756">
              <material>
                <mattext texttype="text/plain">What did you learn, what strengths did you discover, and what will you continue to develop?</mattext>
              </material>
            </response_label>
            <response_label ident="37108">
              <material>
                <mattext texttype="text/plain">What sources did you use, how did you cite them, and what did you learn from them?</mattext>
              </material>
            </response_label>
            <response_label ident="38926">
              <material>
                <mattext texttype="text/plain">What was your strongest essay, what grade did you receive, and why did you succeed?</mattext>
              </material>
            </response_label>
            <response_label ident="41883">
              <material>
                <mattext texttype="text/plain">What writing strategies did you use, how long did each assignment take, and what would you change?</mattext>
              </material>
            </response_label>
