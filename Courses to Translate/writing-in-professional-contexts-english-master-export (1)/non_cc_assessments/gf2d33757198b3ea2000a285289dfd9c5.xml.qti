          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the main purpose of the exploration stage in reflective writing?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5461">
              <material>
                <mattext texttype="text/plain">To describe what happened and establish context.</mattext>
              </material>
            </response_label>
            <response_label ident="4053">
              <material>
                <mattext texttype="text/plain">To evaluate the quality of your writing.</mattext>
              </material>
            </response_label>
            <response_label ident="50479">
              <material>
                <mattext texttype="text/plain">To plan future improvements to your writing.</mattext>
              </material>
            </response_label>
            <response_label ident="71540">
              <material>
                <mattext texttype="text/plain">To analyze grammar and spelling errors.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4053</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4053_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">50479</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="50479_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">71540</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="71540_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">5461</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="4053_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Exploration is the first stage, and its purpose is to look at the basic facts of what occurred. Evaluating writing quality, planning improvements, and correcting grammar are tasks that belong to later stages or to the editing process. Without first establishing what happened, meaningful reflection cannot take place.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="50479_fb">
