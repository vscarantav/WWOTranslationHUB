          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What do Northern European educational systems use as a reflective practice, according to the reading?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="32953">
              <material>
                <mattext texttype="text/plain">Learning journals that connect theoretical knowledge with practical applications and personal growth.</mattext>
              </material>
            </response_label>
            <response_label ident="21948">
              <material>
                <mattext texttype="text/plain">Yarning circles where students share experiences in a communal setting.</mattext>
              </material>
            </response_label>
            <response_label ident="43939">
              <material>
                <mattext texttype="text/plain">Hansei-kai meetings where students analyze what went wrong in a project.</mattext>
              </material>
            </response_label>
            <response_label ident="42895">
              <material>
                <mattext texttype="text/plain">Testimonios that connect personal experience to social and political realities.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
