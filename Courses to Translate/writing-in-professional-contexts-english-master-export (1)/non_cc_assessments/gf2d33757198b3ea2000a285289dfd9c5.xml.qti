        <material>
          <mattext texttype="text/html">&lt;div&gt;What are the three stages of reflective writing?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="49241">
              <material>
                <mattext texttype="text/plain">Exploration, reflection, and action.</mattext>
              </material>
            </response_label>
            <response_label ident="46841">
              <material>
                <mattext texttype="text/plain">Research, drafting, and editing.</mattext>
              </material>
            </response_label>
            <response_label ident="23589">
              <material>
                <mattext texttype="text/plain">Introduction, body, and conclusion.</mattext>
              </material>
            </response_label>
            <response_label ident="63720">
              <material>
                <mattext texttype="text/plain">Summarizing, quoting, and paraphrasing.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
