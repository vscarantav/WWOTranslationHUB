      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does the reading identify as the key difference between bullet points and paragraphs in reflective writing?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="93637">
              <material>
                <mattext texttype="text/plain">Bullet points stand alone, while paragraphs connect ideas together with transitions.</mattext>
              </material>
            </response_label>
            <response_label ident="86848">
              <material>
                <mattext texttype="text/plain">Bullet points are more formal, while paragraphs are more conversational.</mattext>
              </material>
            </response_label>
            <response_label ident="23229">
              <material>
                <mattext texttype="text/plain">Bullet points are required for action plans, while paragraphs are required for reflections.</mattext>
              </material>
            </response_label>
            <response_label ident="5992">
              <material>
                <mattext texttype="text/plain">Bullet points show analysis, while paragraphs show summary.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
