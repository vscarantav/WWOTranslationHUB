        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="7295">
              <material>
                <mattext texttype="text/plain">Exploratory and contemplative.</mattext>
              </material>
            </response_label>
            <response_label ident="67073">
              <material>
                <mattext texttype="text/plain">Assertive and authoritative.</mattext>
              </material>
            </response_label>
            <response_label ident="99278">
              <material>
                <mattext texttype="text/plain">Formal and persuasive.</mattext>
              </material>
            </response_label>
            <response_label ident="42848">
              <material>
                <mattext texttype="text/plain">Neutral and objective.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
