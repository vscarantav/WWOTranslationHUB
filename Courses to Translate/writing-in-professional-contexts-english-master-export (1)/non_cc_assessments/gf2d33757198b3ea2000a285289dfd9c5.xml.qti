      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does the term "self-assessment" mean?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="404">
              <material>
                <mattext texttype="text/plain">Evaluation of one's own performance or abilities.</mattext>
              </material>
            </response_label>
            <response_label ident="2753">
              <material>
                <mattext texttype="text/plain">Feedback received from an instructor on an assignment.</mattext>
              </material>
            </response_label>
            <response_label ident="25630">
              <material>
                <mattext texttype="text/plain">A review of outside sources used in a research paper.</mattext>
              </material>
            </response_label>
            <response_label ident="18068">
              <material>
                <mattext texttype="text/plain">A checklist used to correct grammar errors before submitting work.</mattext>
              </material>
