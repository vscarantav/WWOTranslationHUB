    <item ident="gf0365da8768568e403e5f8d24c2b1af6" title="Question 8">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>74759,39697,16956,21949</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the difference between a summary and a true reflection?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="74759">
              <material>
                <mattext texttype="text/plain">A summary describes what happened, while a true reflection explores why it happened, how it affected you, and what you learned.</mattext>
              </material>
            </response_label>
            <response_label ident="39697">
              <material>
                <mattext texttype="text/plain">A summary is longer than a reflection.</mattext>
              </material>
            </response_label>
            <response_label ident="16956">
              <material>
                <mattext texttype="text/plain">A summary includes personal feelings, while a reflection focuses only on facts.</mattext>
              </material>
            </response_label>
            <response_label ident="21949">
              <material>
                <mattext texttype="text/plain">A summary is written in first person, while a reflection is written in third person.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">39697</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="39697_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">16956</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="16956_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">21949</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="21949_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">74759</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="39697_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Many writers confuse a reflection with a summary. A summary only records what was done. A true reflection goes further by exploring why it happened, how the experience affected the writer, and what was learned. Length does not distinguish the two. Personal feelings are a feature of reflection, not summary. Both reflective writing and summaries can use first person.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="16956_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Many writers confuse a reflection with a summary. A summary only records what was done. A true reflection goes further by exploring why it happened, how the experience affected the writer, and what was learned. Length does not distinguish the two. Personal feelings are a feature of reflection, not summary. Both reflective writing and summaries can use first person.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="21949_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Many writers confuse a reflection with a summary. A summary only records what was done. A true reflection goes further by exploring why it happened, how the experience affected the writer, and what was learned. Length does not distinguish the two. Personal feelings are a feature of reflection, not summary. Both reflective writing and summaries can use first person.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
