        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">46841</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="46841_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">23589</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="23589_fb"/>
