    <item ident="g0226b08e606e5401adbf984445fe7528" title="Question 16">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>74036,93907,91883,86141</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the purpose of using transition words in reflective writing paragraphs?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="74036">
              <material>
                <mattext texttype="text/plain">To connect ideas so they flow together smoothly.</mattext>
              </material>
            </response_label>
            <response_label ident="93907">
              <material>
                <mattext texttype="text/plain">To provide evidence from outside sources and citations.</mattext>
              </material>
            </response_label>
            <response_label ident="91883">
              <material>
                <mattext texttype="text/plain">To replace topic sentences at the start of each paragraph.</mattext>
              </material>
            </response_label>
            <response_label ident="86141">
              <material>
                <mattext texttype="text/plain">To restate the main idea of the essay in different words for emphasis.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">93907</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="93907_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">91883</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="91883_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">86141</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="86141_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">74036</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="93907_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Transition words serve the purpose of connecting ideas and helping the reader follow the writer's thinking from one point to the next. Providing evidence from outside sources is a function of support and research, not transitions. Topic sentences introduce the main idea of a paragraph and cannot be replaced by transitions. Restating the main idea in different words is a strategy used for emphasis, often in conclusions, rather than a function of transition words.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="91883_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Transition words serve the purpose of connecting ideas and helping the reader follow the writer's thinking from one point to the next. Providing evidence from outside sources is a function of support and research, not transitions. Topic sentences introduce the main idea of a paragraph and cannot be replaced by transitions. Restating the main idea in different words is a strategy used for emphasis, often in conclusions, rather than a function of transition words.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="86141_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Transition words serve the purpose of connecting ideas and helping the reader follow the writer's thinking from one point to the next. Providing evidence from outside sources is a function of support and research, not transitions. Topic sentences introduce the main idea of a paragraph and cannot be replaced by transitions. Restating the main idea in different words is a strategy used for emphasis, often in conclusions, rather than a function of transition words.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
