          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="99278_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">42848</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="42848_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">7295</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="67073_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The reading states that reflective writing uses an exploratory and contemplative tone because the writer is musing and wondering rather than arguing. An assertive and authoritative tone belongs to argumentative writing. A formal and persuasive tone is associated with academic argument. A neutral and objective tone is typical of informational or research writing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
