          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does the conclusion of a reflective essay typically present, according to the reading?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="50882">
              <material>
                <mattext texttype="text/plain">Insights or realizations.</mattext>
              </material>
            </response_label>
            <response_label ident="10972">
              <material>
                <mattext texttype="text/plain">A restatement of the thesis and main arguments.</mattext>
              </material>
            </response_label>
            <response_label ident="46123">
              <material>
                <mattext texttype="text/plain">A list of sources used throughout the essay.</mattext>
              </material>
            </response_label>
            <response_label ident="94112">
              <material>
                <mattext texttype="text/plain">A summary of the opposing viewpoint.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">10972</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="10972_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">46123</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="46123_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">94112</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="94112_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">50882</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="10972_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The reading states that the conclusion in reflective writing may present insights or realizations. This differs from argumentative writing, where the conclusion reinforces the thesis and main arguments. Listing sources is a research writing practice. Summarizing an opposing viewpoint is part of argumentative writing structure.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="46123_fb">
        <flow_mat>
