    <item ident="g99a7607623ce0bb469946d03f7d7c75c" title="Question 20">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>38184,16523,76296,53273</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the purpose of the SMART goal framework in reflective writing?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="38184">
              <material>
                <mattext texttype="text/plain">To help writers create improvement goals that lead to real progress.</mattext>
              </material>
            </response_label>
            <response_label ident="16523">
              <material>
                <mattext texttype="text/plain">To help writers locate credible sources for a research paper.</mattext>
              </material>
            </response_label>
            <response_label ident="76296">
              <material>
                <mattext texttype="text/plain">To help writers organize the paragraphs of their essay.</mattext>
              </material>
            </response_label>
            <response_label ident="53273">
              <material>
                <mattext texttype="text/plain">To help writers identify the main argument of their essay.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
