    <item ident="g9a69e9c5454d3d3c27b90ded4d12a1a4" title="Question 45">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>95070,26726,3245,79341</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What type of information should you record for each person when using standard genealogical format?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="95070">
              <material>
                <mattext texttype="text/plain">Full name, birth date and location, marriage date and location, death date and location, and parents' names</mattext>
              </material>
            </response_label>
            <response_label ident="26726">
              <material>
                <mattext texttype="text/plain">Physical description, personality traits, occupation, and hobbies</mattext>
              </material>
            </response_label>
            <response_label ident="3245">
              <material>
                <mattext texttype="text/plain">Only the information that can be verified through official government documents</mattext>
              </material>
            </response_label>
            <response_label ident="79341">
              <material>
                <mattext texttype="text/plain">Current address, telephone number, and email address</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">95070</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="95070_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">26726</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="26726_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3245</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3245_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">79341</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="79341_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">95070</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="95070_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Standard genealogical format records each person's full name, birth date and location, marriage date and location if applicable, death date and location if deceased, and parents' full names. This systematic approach ensures your family history is organized and complete.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="26726_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Physical descriptions and personality traits are storytelling elements that add depth to a family narrative but are not part of the standard genealogical data format. Limiting records only to officially verified documents is unnecessarily restrictive—family history research regularly works with incomplete or informal sources. Current addresses and contact information are private details that should not be included, particularly for living relatives. Standard genealogical format focuses on the key life events that define a person's documented history.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3245_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Physical descriptions and personality traits are storytelling elements that add depth to a family narrative but are not part of the standard genealogical data format. Limiting records only to officially verified documents is unnecessarily restrictive—family history research regularly works with incomplete or informal sources. Current addresses and contact information are private details that should not be included, particularly for living relatives. Standard genealogical format focuses on the key life events that define a person's documented history.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="79341_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Physical descriptions and personality traits are storytelling elements that add depth to a family narrative but are not part of the standard genealogical data format. Limiting records only to officially verified documents is unnecessarily restrictive—family history research regularly works with incomplete or informal sources. Current addresses and contact information are private details that should not be included, particularly for living relatives. Standard genealogical format focuses on the key life events that define a person's documented history.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g74accb2841621bc242f8dc149f24ad11" title="Question 46">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>3187,29898,5350,78443</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;According to the W04 reading, when is it appropriate to use direct quotations in a research paper?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="3187">
              <material>
                <mattext texttype="text/plain">When the author's exact wording is especially vivid, memorable, or significant</mattext>
              </material>
            </response_label>
            <response_label ident="29898">
              <material>
                <mattext texttype="text/plain">Whenever you want to add length to your paper</mattext>
              </material>
            </response_label>
            <response_label ident="5350">
              <material>
                <mattext texttype="text/plain">When you do not have enough time to paraphrase the source material</mattext>
              </material>
            </response_label>
            <response_label ident="78443">
              <material>
                <mattext texttype="text/plain">As the primary method for incorporating all source material into your paper</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3187</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3187_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">29898</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="29898_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5350</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5350_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">78443</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="78443_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">3187</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="3187_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Direct quotations are appropriate when the author's exact wording is especially vivid, memorable, or significant—such as when analyzing a historical speech or when a direct quote from an interview helps personalize an issue for readers. Quotations should be used sparingly for greatest impact.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="29898_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Using quotations to add length to a paper is not a valid reason and results in a paper that feels haphazardly pasted together from outside sources. Lack of time to paraphrase is not an acceptable reason to quote directly—paraphrasing demonstrates genuine understanding of the material. Direct quotation should not be the primary method of incorporating sources; most source material should be summarized or paraphrased. Quoting too frequently reduces the effectiveness of the quotations and weakens your paper overall.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5350_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Using quotations to add length to a paper is not a valid reason and results in a paper that feels haphazardly pasted together from outside sources. Lack of time to paraphrase is not an acceptable reason to quote directly—paraphrasing demonstrates genuine understanding of the material. Direct quotation should not be the primary method of incorporating sources; most source material should be summarized or paraphrased. Quoting too frequently reduces the effectiveness of the quotations and weakens your paper overall.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="78443_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Using quotations to add length to a paper is not a valid reason and results in a paper that feels haphazardly pasted together from outside sources. Lack of time to paraphrase is not an acceptable reason to quote directly—paraphrasing demonstrates genuine understanding of the material. Direct quotation should not be the primary method of incorporating sources; most source material should be summarized or paraphrased. Quoting too frequently reduces the effectiveness of the quotations and weakens your paper overall.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g4f9af7750367cac70534b7203f9daf77" title="Question 47">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>28027,79646,27426,42011</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;According to the W04 reading, when can approximate dates be used in family history writing?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="28027">
              <material>
                <mattext texttype="text/plain">When exact dates are unavailable or uncertain for a family member</mattext>
              </material>
            </response_label>
            <response_label ident="79646">
              <material>
                <mattext texttype="text/plain">When exact dates are available but the writer prefers shorter text</mattext>
              </material>
            </response_label>
            <response_label ident="27426">
              <material>
                <mattext texttype="text/plain">When writing about events that occurred before the year 1900</mattext>
              </material>
            </response_label>
            <response_label ident="42011">
              <material>
                <mattext texttype="text/plain">When the family member has requested that their information remain private</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">28027</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="28027_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">79646</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="79646_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">27426</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="27426_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">42011</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="42011_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">28027</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="28027_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The W04 reading recommends using approximate dates when exact dates are unavailable or uncertain for a family member. Phrases such as &lt;strong&gt;circa 1950&lt;/strong&gt;, &lt;strong&gt;early 1960s&lt;/strong&gt;, or &lt;strong&gt;around 1945&lt;/strong&gt; clearly communicate that the date is an estimate while still providing useful historical context.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="79646_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Approximate dates should not be used when exact dates are available—accuracy is always preferred when the information is known. There is no rule limiting approximate dates to events before a specific year. When a family member requests privacy, the appropriate response is to omit or limit their information entirely, not simply to approximate their dates. Approximate dates are specifically a tool for handling genuinely incomplete or uncertain records.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="27426_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Approximate dates should not be used when exact dates are available—accuracy is always preferred when the information is known. There is no rule limiting approximate dates to events before a specific year. When a family member requests privacy, the appropriate response is to omit or limit their information entirely, not simply to approximate their dates. Approximate dates are specifically a tool for handling genuinely incomplete or uncertain records.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="42011_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Approximate dates should not be used when exact dates are available—accuracy is always preferred when the information is known. There is no rule limiting approximate dates to events before a specific year. When a family member requests privacy, the appropriate response is to omit or limit their information entirely, not simply to approximate their dates. Approximate dates are specifically a tool for handling genuinely incomplete or uncertain records.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g4637b671335b8a76283094765841b85e" title="Question 48">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>77835,7154,97465,72989</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the purpose of section headings in a personal history project?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="77835">
              <material>
                <mattext texttype="text/plain">To organize the narrative and help readers find the information they need</mattext>
              </material>
            </response_label>
            <response_label ident="7154">
              <material>
                <mattext texttype="text/plain">To replace the need for full sentences and paragraphs in each section</mattext>
              </material>
            </response_label>
            <response_label ident="97465">
              <material>
                <mattext texttype="text/plain">To list sources cited in each section of the paper</mattext>
              </material>
            </response_label>
            <response_label ident="72989">
              <material>
                <mattext texttype="text/plain">To indicate which parts of the paper were written using AI tools</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">77835</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="77835_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7154</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7154_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">97465</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="97465_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">72989</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="72989_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">77835</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="77835_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The purpose of section headings in a personal history project is to organize the narrative and help readers find the information they need. Clear headings divide the project into distinct sections such as &lt;strong&gt;Your Family&lt;/strong&gt;, &lt;strong&gt;Your Ancestors&lt;/strong&gt;, and &lt;strong&gt;Advice for Future Generations&lt;/strong&gt;.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7154_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Section headings do not replace the need for full sentences and paragraphs—each section must still be written in complete narrative prose. Headings do not list sources; citations appear within the text and in a reference list. Headings have no role in identifying AI-assisted content. Their sole purpose is to provide clear organizational structure that guides the reader through the document.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="97465_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Section headings do not replace the need for full sentences and paragraphs—each section must still be written in complete narrative prose. Headings do not list sources; citations appear within the text and in a reference list. Headings have no role in identifying AI-assisted content. Their sole purpose is to provide clear organizational structure that guides the reader through the document.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="72989_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Section headings do not replace the need for full sentences and paragraphs—each section must still be written in complete narrative prose. Headings do not list sources; citations appear within the text and in a reference list. Headings have no role in identifying AI-assisted content. Their sole purpose is to provide clear organizational structure that guides the reader through the document.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g09c74cf33fe8887d0f0b46b464e0af33" title="Question 49">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>35316,80613,73544,97269</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the term for knowledge passed down through generations by word of mouth rather than written records?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="35316">
              <material>
                <mattext texttype="text/plain">Oral tradition</mattext>
              </material>
            </response_label>
            <response_label ident="80613">
              <material>
                <mattext texttype="text/plain">Secondary source</mattext>
              </material>
            </response_label>
            <response_label ident="73544">
              <material>
                <mattext texttype="text/plain">Informal citation</mattext>
              </material>
            </response_label>
            <response_label ident="97269">
              <material>
                <mattext texttype="text/plain">Experiential research</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">35316</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="35316_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">80613</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="80613_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">73544</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="73544_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">97269</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="97269_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">35316</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="35316_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Oral tradition refers to knowledge passed down through generations by word of mouth rather than written records. As the opening case study in the Week 4 reading illustrates, oral tradition holds deep value in many cultures, though Western academic writing requires this knowledge to be supported by documented sources.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="80613_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;A secondary source is a written document that interprets or analyzes primary materials—it is not a term for spoken knowledge passed between generations. Informal citation is not a defined term in the W04 reading. Experiential research refers to knowledge gained through direct personal experience, which is related to but distinct from oral tradition. Oral tradition specifically describes the cultural practice of transmitting history, values, and knowledge through spoken storytelling across generations.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="73544_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;A secondary source is a written document that interprets or analyzes primary materials—it is not a term for spoken knowledge passed between generations. Informal citation is not a defined term in the W04 reading. Experiential research refers to knowledge gained through direct personal experience, which is related to but distinct from oral tradition. Oral tradition specifically describes the cultural practice of transmitting history, values, and knowledge through spoken storytelling across generations.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="97269_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;A secondary source is a written document that interprets or analyzes primary materials—it is not a term for spoken knowledge passed between generations. Informal citation is not a defined term in the W04 reading. Experiential research refers to knowledge gained through direct personal experience, which is related to but distinct from oral tradition. Oral tradition specifically describes the cultural practice of transmitting history, values, and knowledge through spoken storytelling across generations.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g42175033997e843bdadbdf6fe53f71c1" title="Question 5">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>30840,9541,58443,35231</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which of the following is an example of a secondary source?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="30840">
              <material>
                <mattext texttype="text/plain">A magazine article analyzing a scientific study</mattext>
              </material>
            </response_label>
            <response_label ident="9541">
              <material>
                <mattext texttype="text/plain">A diary written by a soldier during a war</mattext>
              </material>
            </response_label>
            <response_label ident="58443">
              <material>
                <mattext texttype="text/plain">A survey conducted by a researcher</mattext>
              </material>
            </response_label>
            <response_label ident="35231">
              <material>
                <mattext texttype="text/plain">A transcript of an in-person interview</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">30840</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="30840_fb"/>
