      <itemfeedback ident="19266_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">There is no rule based on a specific word count for paraphrases. Citations are not limited to direct quotations. Changing the words of a source does not remove the obligation to cite it. The source of the idea must always be credited, regardless of how it is expressed.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
