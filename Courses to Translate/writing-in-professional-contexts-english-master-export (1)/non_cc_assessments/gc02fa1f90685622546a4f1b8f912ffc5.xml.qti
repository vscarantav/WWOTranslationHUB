          <conditionvar>
            <varequal respident="response1">12804</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="12804_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">42730</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="42730_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Paraphrasing is restating information from a source using your own words and original sentence structure. It maintains the same level of detail as the original passage while demonstrating your understanding of the material.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="97024_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Copying text directly and placing it in quotation marks describes a direct quotation, not a paraphrase. Condensing a source to only its most essential ideas describes summarizing. Listing sources at the end of a paper describes a reference list. Each of these is a distinct skill with its own specific purpose and rules.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="87502_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Copying text directly and placing it in quotation marks describes a direct quotation, not a paraphrase. Condensing a source to only its most essential ideas describes summarizing. Listing sources at the end of a paper describes a reference list. Each of these is a distinct skill with its own specific purpose and rules.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="12804_fb">
