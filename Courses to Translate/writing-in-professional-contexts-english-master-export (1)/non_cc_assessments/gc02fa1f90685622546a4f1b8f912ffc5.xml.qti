        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="95725">
              <material>
                <mattext texttype="text/plain">Organize research and ideas</mattext>
              </material>
            </response_label>
            <response_label ident="307">
              <material>
                <mattext texttype="text/plain">Choose a topic</mattext>
              </material>
            </response_label>
            <response_label ident="51147">
              <material>
                <mattext texttype="text/plain">Conduct research</mattext>
              </material>
            </response_label>
            <response_label ident="99792">
              <material>
                <mattext texttype="text/plain">Plan and schedule</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
