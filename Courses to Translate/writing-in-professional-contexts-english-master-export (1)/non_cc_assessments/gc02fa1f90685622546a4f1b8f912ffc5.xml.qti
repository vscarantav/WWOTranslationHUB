    <item ident="gcb37239f68ab6e2013490a3b037e02d6" title="Question 1">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>44441,37891,72290,78086</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the first step in the six-step research writing process?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="44441">
              <material>
                <mattext texttype="text/plain">Choose a topic</mattext>
              </material>
            </response_label>
            <response_label ident="37891">
              <material>
                <mattext texttype="text/plain">Conduct research</mattext>
              </material>
            </response_label>
            <response_label ident="72290">
              <material>
                <mattext texttype="text/plain">Draft your paper</mattext>
              </material>
            </response_label>
            <response_label ident="78086">
              <material>
                <mattext texttype="text/plain">Plan and schedule</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">44441</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="44441_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">37891</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="37891_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">72290</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="72290_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">78086</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="78086_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">44441</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="44441_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Choose a topic is the first step in the six-step research writing process. The steps must be followed in order, beginning with topic selection before any planning, research, or writing can take place.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="37891_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Conduct research is Step 3, not Step 1. Research cannot begin until a topic has been chosen and a plan has been made. Drafting your paper is Step 5. Planning and scheduling is Step 2. Each step builds on the one before it, so the process always begins with choosing a topic.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="72290_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Conduct research is Step 3, not Step 1. Research cannot begin until a topic has been chosen and a plan has been made. Drafting your paper is Step 5. Planning and scheduling is Step 2. Each step builds on the one before it, so the process always begins with choosing a topic.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="78086_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Conduct research is Step 3, not Step 1. Research cannot begin until a topic has been chosen and a plan has been made. Drafting your paper is Step 5. Planning and scheduling is Step 2. Each step builds on the one before it, so the process always begins with choosing a topic.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gc0c262d357f87909dee257faf8be1aa8" title="Question 10">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>99685,29953,97866,56708</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the purpose of a summary in research writing?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="99685">
              <material>
                <mattext texttype="text/plain">To condense a source to its main ideas in your own words</mattext>
              </material>
            </response_label>
            <response_label ident="29953">
              <material>
                <mattext texttype="text/plain">To reproduce the exact words of a source within quotation marks</mattext>
              </material>
            </response_label>
            <response_label ident="97866">
              <material>
                <mattext texttype="text/plain">To restate a source at the same level of detail using new wording</mattext>
              </material>
            </response_label>
            <response_label ident="56708">
              <material>
                <mattext texttype="text/plain">To list every source used in a research paper</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">99685</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="99685_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">29953</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="29953_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">97866</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="97866_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">56708</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="56708_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">99685</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="99685_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The purpose of a summary is to condense a source to its main ideas using your own words. Summarizing works well when only the major ideas are relevant to your paper or when complex information needs to be reduced to a few key points for your readers.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="29953_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Reproducing the exact words of a source within quotation marks describes a direct quotation. Restating a source at the same level of detail using new wording describes paraphrasing. Listing every source used in a paper describes a reference list. Each method—summarizing, paraphrasing, and quoting—serves a different purpose and is appropriate in different situations.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="97866_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Reproducing the exact words of a source within quotation marks describes a direct quotation. Restating a source at the same level of detail using new wording describes paraphrasing. Listing every source used in a paper describes a reference list. Each method—summarizing, paraphrasing, and quoting—serves a different purpose and is appropriate in different situations.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="56708_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Reproducing the exact words of a source within quotation marks describes a direct quotation. Restating a source at the same level of detail using new wording describes paraphrasing. Listing every source used in a paper describes a reference list. Each method—summarizing, paraphrasing, and quoting—serves a different purpose and is appropriate in different situations.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g191703a53d65713342bd7dc0f6f0ac08" title="Question 11">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>28123,34663,6140,68772</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is a research question?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="28123">
              <material>
                <mattext texttype="text/plain">A broad, open-ended question that guides your research</mattext>
              </material>
            </response_label>
            <response_label ident="34663">
              <material>
                <mattext texttype="text/plain">The final conclusion you reach at the end of your paper</mattext>
              </material>
            </response_label>
            <response_label ident="6140">
              <material>
                <mattext texttype="text/plain">A list of topics you plan to write about</mattext>
              </material>
            </response_label>
            <response_label ident="68772">
              <material>
                <mattext texttype="text/plain">A specific question you ask to collect data during an interview</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">28123</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="28123_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">34663</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="34663_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6140</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6140_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">68772</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="68772_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">28123</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="28123_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A research question is a broad, open-ended question that guides your research. It is developed after you have identified a general area of interest and helps you move from a broad subject to a specific, researchable focus.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="34663_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A final conclusion is the outcome of completed research, not the question that begins with it. A list of topics is a brainstorming tool, not a research question. A question asked during an interview is part of the data-gathering process, not the guiding focus of your paper. A research question is the starting point that shapes every step of your research process.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6140_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A final conclusion is the outcome of completed research, not the question that begins with it. A list of topics is a brainstorming tool, not a research question. A question asked during an interview is part of the data-gathering process, not the guiding focus of your paper. A research question is the starting point that shapes every step of your research process.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="68772_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A final conclusion is the outcome of completed research, not the question that begins with it. A list of topics is a brainstorming tool, not a research question. A question asked during an interview is part of the data-gathering process, not the guiding focus of your paper. A research question is the starting point that shapes every step of your research process.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g3dfaa7b72c7342027d3e09841a78949b" title="Question 12">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>77559,91085,10650,85395</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which of the following is an example of a primary source for family history research?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="77559">
              <material>
                <mattext texttype="text/plain">A grandmother's personal diary</mattext>
              </material>
            </response_label>
            <response_label ident="91085">
              <material>
                <mattext texttype="text/plain">A published family genealogy book</mattext>
              </material>
            </response_label>
            <response_label ident="10650">
              <material>
                <mattext texttype="text/plain">A genealogy website entry</mattext>
              </material>
            </response_label>
            <response_label ident="85395">
              <material>
                <mattext texttype="text/plain">A biography written about a family member</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">77559</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="77559_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">91085</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="91085_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">10650</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="10650_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">85395</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="85395_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">77559</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="77559_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A grandmother's personal diary is a primary source because it is a firsthand account written directly by the person who experienced the events described. Primary sources provide direct, unfiltered information from the original person or time period.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="91085_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A published family genealogy book, a genealogy website entry, and a biography are all secondary sources. They interpret, compile, or analyze information gathered from primary materials rather than providing firsthand accounts. For family history research, diaries, letters, birth certificates, and personal photographs are examples of primary sources.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="10650_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A published family genealogy book, a genealogy website entry, and a biography are all secondary sources. They interpret, compile, or analyze information gathered from primary materials rather than providing firsthand accounts. For family history research, diaries, letters, birth certificates, and personal photographs are examples of primary sources.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="85395_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A published family genealogy book, a genealogy website entry, and a biography are all secondary sources. They interpret, compile, or analyze information gathered from primary materials rather than providing firsthand accounts. For family history research, diaries, letters, birth certificates, and personal photographs are examples of primary sources.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g5085c7748ca932903125ea7c48fc70d8" title="Question 13">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
