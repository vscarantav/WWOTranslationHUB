        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">58443</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="58443_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">35231</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="35231_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">30840</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="30840_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A magazine article analyzing a scientific study is a secondary source. Secondary sources discuss, interpret, analyze, or rework information from primary materials. They are one step removed from the original source of information.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9541_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A diary written by a soldier, a survey conducted by a researcher, and a transcript of an in-person interview are all primary sources because they provide firsthand, direct accounts of events or data. Secondary sources always involve some level of interpretation or analysis of primary material.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="58443_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A diary written by a soldier, a survey conducted by a researcher, and a transcript of an in-person interview are all primary sources because they provide firsthand, direct accounts of events or data. Secondary sources always involve some level of interpretation or analysis of primary material.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="35231_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A diary written by a soldier, a survey conducted by a researcher, and a transcript of an in-person interview are all primary sources because they provide firsthand, direct accounts of events or data. Secondary sources always involve some level of interpretation or analysis of primary material.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g5d366088be6dbef2203e5c714c7628b8" title="Question 6">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>31694,99755,40842,71230</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is a working thesis?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="31694">
              <material>
                <mattext texttype="text/plain">A proposed answer to your research question</mattext>
              </material>
            </response_label>
            <response_label ident="99755">
              <material>
                <mattext texttype="text/plain">The final conclusion of your research paper</mattext>
              </material>
            </response_label>
            <response_label ident="40842">
              <material>
                <mattext texttype="text/plain">A list of sources you plan to use</mattext>
              </material>
            </response_label>
            <response_label ident="71230">
              <material>
                <mattext texttype="text/plain">The broad topic area you have chosen to study</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">31694</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="31694_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">99755</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="99755_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">40842</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="40842_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">71230</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="71230_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">31694</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="31694_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A working thesis is a proposed answer to your main research question. It gives you a clear direction before you begin researching and may be adjusted as new information emerges through research.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="99755_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A final conclusion appears at the end of a completed paper, not at the beginning of the research process. A list of sources describes a reference list or bibliography. A broad topic area is the starting point for developing a research question, not a thesis. A working thesis is a specific, arguable statement that guides your entire research process.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="40842_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A final conclusion appears at the end of a completed paper, not at the beginning of the research process. A list of sources describes a reference list or bibliography. A broad topic area is the starting point for developing a research question, not a thesis. A working thesis is a specific, arguable statement that guides your entire research process.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="71230_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A final conclusion appears at the end of a completed paper, not at the beginning of the research process. A list of sources describes a reference list or bibliography. A broad topic area is the starting point for developing a research question, not a thesis. A working thesis is a specific, arguable statement that guides your entire research process.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g1900557a8b56bfcdb8a22eae1c91b93b" title="Question 7">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>1198,59230,46376,44650</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is a hallucination in the context of artificial intelligence (AI)?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="1198">
              <material>
                <mattext texttype="text/plain">The production of false or invented information stated as though it were accurate</mattext>
              </material>
            </response_label>
            <response_label ident="59230">
              <material>
                <mattext texttype="text/plain">A tool AI uses to search library databases</mattext>
              </material>
            </response_label>
            <response_label ident="46376">
              <material>
                <mattext texttype="text/plain">A method for formatting APA citations correctly</mattext>
              </material>
            </response_label>
            <response_label ident="44650">
              <material>
                <mattext texttype="text/plain">A strategy for evaluating the reliability of online sources</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1198</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1198_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">59230</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="59230_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">46376</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="46376_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">44650</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="44650_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">1198</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="1198_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;In the context of AI, a hallucination is the production of false or invented information—such as a fabricated citation or a source that does not exist—stated with confidence as though it were accurate. This is particularly dangerous in research writing because fabricated citations look identical to accurate ones.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="59230_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;AI hallucination has nothing to do with searching library databases, formatting citations, or evaluating sources. It specifically refers to AI generating information that appears credible but cannot be verified. Every AI-suggested citation must be located independently in a library database before it is used in a paper.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="46376_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">AI hallucination has nothing to do with searching library databases, formatting citations, or evaluating sources. It specifically refers to AI generating information that appears credible but cannot be verified. Every AI-suggested citation must be located independently in a library database before it is used in a paper.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="44650_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">AI hallucination has nothing to do with searching library databases, formatting citations, or evaluating sources. It specifically refers to AI generating information that appears credible but cannot be verified. Every AI-suggested citation must be located independently in a library database before it is used in a paper.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gc56b8da4a99e9161c4b2cbeaa7714588" title="Question 8">
      <itemmetadata>
