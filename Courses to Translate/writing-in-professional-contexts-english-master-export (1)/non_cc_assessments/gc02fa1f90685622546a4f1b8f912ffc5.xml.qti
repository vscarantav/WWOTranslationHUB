          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;How many steps are in the research writing process?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="3122">
              <material>
                <mattext texttype="text/plain">Six</mattext>
              </material>
            </response_label>
            <response_label ident="57071">
              <material>
                <mattext texttype="text/plain">Three</mattext>
              </material>
            </response_label>
            <response_label ident="75960">
              <material>
                <mattext texttype="text/plain">Eight</mattext>
              </material>
            </response_label>
            <response_label ident="92689">
              <material>
                <mattext texttype="text/plain">Four</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3122</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3122_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">57071</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="57071_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">75960</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="75960_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">92689</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="92689_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">3122</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="3122_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">There are six steps in the research writing process. They are: choose a topic, plan and schedule, conduct research, organize research and ideas, draft your paper, and revise and edit your paper.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="57071_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Three, eight, and four are all incorrect. The research writing process has exactly six steps, each of which builds on the one before it. Skipping or combining steps can lead to disorganized papers and missed deadlines.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="75960_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Three, eight, and four are all incorrect. The research writing process has exactly six steps, each of which builds on the one before it. Skipping or combining steps can lead to disorganized papers and missed deadlines.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="92689_fb">
        <flow_mat>
          <material>
