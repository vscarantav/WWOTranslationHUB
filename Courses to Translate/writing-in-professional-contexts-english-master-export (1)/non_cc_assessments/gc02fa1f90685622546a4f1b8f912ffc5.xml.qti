      <itemfeedback ident="19196_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A primary source is a firsthand, direct source of information or data. Examples include surveys, personal interviews, diaries, and historical documents that come directly from the time or event being studied.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="39545_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A magazine article written about a historical event, a biography, and a literary review are all secondary sources. Secondary sources discuss or interpret primary materials rather than providing firsthand information. The key distinction is that primary sources come directly from the original event or person.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="50452_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A magazine article written about a historical event, a biography, and a literary review are all secondary sources. Secondary sources discuss or interpret primary materials rather than providing firsthand information. The key distinction is that primary sources come directly from the original event or person.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="28953_fb">
