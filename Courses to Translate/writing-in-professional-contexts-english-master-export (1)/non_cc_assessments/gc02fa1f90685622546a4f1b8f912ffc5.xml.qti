      <itemfeedback ident="16116_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">APA stands for American Psychological Association. APA is the documentation and formatting style that the majority of classes at BYU-Idaho require students to follow when completing research projects.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="65385_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Academic Paper Association, Advanced Publication Authority, and American Publishing Association are not real organizations. APA is a well-established professional organization that developed a widely used system for formatting academic papers and citing sources.</mattext>
