    <item ident="g5a8e99c87ec83d7c58ac622b11bec4dd" title="Question 30">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>70731,34806,7045,72997</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the ethical principle that guides family history writing, according to the W04 reading?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="70731">
              <material>
                <mattext texttype="text/plain">Your family history should honor your family, maintain academic integrity, and respect privacy.</mattext>
              </material>
            </response_label>
            <response_label ident="34806">
              <material>
                <mattext texttype="text/plain">Your family history should include every detail available about all family members.</mattext>
              </material>
            </response_label>
            <response_label ident="7045">
              <material>
                <mattext texttype="text/plain">Your family history should focus only on achievements and avoid difficult stories.</mattext>
              </material>
            </response_label>
            <response_label ident="72997">
              <material>
                <mattext texttype="text/plain">Your family history should be reviewed and approved by family members before submission.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">70731</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="70731_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">34806</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="34806_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7045</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7045_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">72997</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="72997_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">70731</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="70731_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The ethical principle guiding family history writing is that your family history should honor your family, maintain academic integrity, and respect privacy. This means obtaining permission before including personal information about living relatives and handling sensitive family stories with care.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="34806_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Including every available detail about all family members does not respect privacy, particularly for living relatives whose full birth dates, addresses, and sensitive personal information should be protected. Focusing only on achievements and avoiding difficult stories does not reflect honest, accurate research. Submitting work for family approval before turning it in is not required and could compromise academic integrity. The guiding principle balances honesty, respect, and accuracy .</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7045_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Including every available detail about all family members does not respect privacy, particularly for living relatives whose full birth dates, addresses, and sensitive personal information should be protected. Focusing only on achievements and avoiding difficult stories does not reflect honest, accurate research. Submitting work for family approval before turning it in is not required and could compromise academic integrity. The guiding principle balances honesty, respect, and accuracy .</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="72997_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Including every available detail about all family members does not respect privacy, particularly for living relatives whose full birth dates, addresses, and sensitive personal information should be protected. Focusing only on achievements and avoiding difficult stories does not reflect honest, accurate research. Submitting work for family approval before turning it in is not required and could compromise academic integrity. The guiding principle balances honesty, respect, and accuracy .</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gf48255dfa803a665545a1d829fb6a50d" title="Question 31">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>41692,73093,44376,30297</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is a topic in research writing?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="41692">
              <material>
                <mattext texttype="text/plain">A subject or theme that serves as the focus of your research</mattext>
              </material>
            </response_label>
            <response_label ident="73093">
              <material>
                <mattext texttype="text/plain">The proposed answer to your main research question</mattext>
              </material>
            </response_label>
            <response_label ident="44376">
              <material>
                <mattext texttype="text/plain">The list of sources you plan to use in your paper</mattext>
              </material>
            </response_label>
            <response_label ident="30297">
              <material>
                <mattext texttype="text/plain">The final conclusion you reach after completing your research</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">41692</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="41692_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">73093</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="73093_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">44376</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="44376_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">30297</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="30297_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">41692</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="41692_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A topic is a subject or theme that serves as the focus of your research. Choosing a topic is the first step in the research writing process, and the goal is to move from a broad general area of interest to a specific, researchable question.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="73093_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The proposed answer to your main research question describes a working thesis, not a topic. A list of sources describes a reference list or research plan. A final conclusion is the outcome of completed research. A topic is simply the subject area you have chosen to explore before any research or writing begins.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="44376_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The proposed answer to your main research question describes a working thesis, not a topic. A list of sources describes a reference list or research plan. A final conclusion is the outcome of completed research. A topic is simply the subject area you have chosen to explore before any research or writing begins.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="30297_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The proposed answer to your main research question describes a working thesis, not a topic. A list of sources describes a reference list or research plan. A final conclusion is the outcome of completed research. A topic is simply the subject area you have chosen to explore before any research or writing begins.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g0e72b683081cbad01bb6f913e6661c20" title="Question 32">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>19633,58929,29427,24029</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the purpose of creating a research schedule during Step 2 of the research writing process?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="19633">
              <material>
                <mattext texttype="text/plain">To break the project into smaller tasks and avoid feeling overwhelmed</mattext>
              </material>
            </response_label>
            <response_label ident="58929">
              <material>
                <mattext texttype="text/plain">To identify which sources you will quote directly in your paper</mattext>
              </material>
            </response_label>
            <response_label ident="29427">
              <material>
                <mattext texttype="text/plain">To determine the final structure of your paper before researching</mattext>
              </material>
            </response_label>
            <response_label ident="24029">
              <material>
                <mattext texttype="text/plain">To select the research question that will guide your writing</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">19633</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="19633_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">58929</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="58929_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">29427</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="29427_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">24029</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="24029_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">19633</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="19633_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The purpose of creating a research schedule is to break the project into smaller tasks and avoid feeling overwhelmed. Research projects can take days, weeks, or even months to complete, and a realistic schedule helps you manage your time effectively from start to finish.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="58929_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Identifying which sources to quote directly happens during Step 4, when you organize your research. Determining the final structure of your paper comes after research is gathered and organized. Selecting your research question is part of Step 1, not Step 2. Planning and scheduling focuses specifically on managing your time and identifying the organizational tools that will keep you on track throughout the project.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="29427_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Identifying which sources to quote directly happens during Step 4, when you organize your research. Determining the final structure of your paper comes after research is gathered and organized. Selecting your research question is part of Step 1, not Step 2. Planning and scheduling focuses specifically on managing your time and identifying the organizational tools that will keep you on track throughout the project.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="24029_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Identifying which sources to quote directly happens during Step 4, when you organize your research. Determining the final structure of your paper comes after research is gathered and organized. Selecting your research question is part of Step 1, not Step 2. Planning and scheduling focuses specifically on managing your time and identifying the organizational tools that will keep you on track throughout the project.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g73b54e8626569c5686db4e3094fe2b79" title="Question 33">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>49307,54969,89933,97895</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following is a genealogy website recommended in the W04 reading for family history research?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="49307">
              <material>
                <mattext texttype="text/plain">FamilySearch</mattext>
              </material>
            </response_label>
            <response_label ident="54969">
              <material>
                <mattext texttype="text/plain">EBSCOhost</mattext>
              </material>
            </response_label>
            <response_label ident="89933">
              <material>
                <mattext texttype="text/plain">Google Scholar</mattext>
              </material>
            </response_label>
            <response_label ident="97895">
              <material>
                <mattext texttype="text/plain">PubMed</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">49307</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="49307_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">54969</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="54969_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">89933</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="89933_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">97895</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="97895_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">49307</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="49307_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;FamilySearch is a genealogy website recommended in the W04 reading for family history research. It is one example of a secondary family source that can help you locate census records, immigration documents, and other historical records about your ancestors.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="54969_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">EBSCOhost, Google Scholar, and PubMed are academic research databases used to locate peer-reviewed scholarly articles and scientific studies. They are valuable tools for academic research but are not designed for genealogical searches. FamilySearch is specifically built to help people trace family history and locate historical records.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="89933_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">EBSCOhost, Google Scholar, and PubMed are academic research databases used to locate peer-reviewed scholarly articles and scientific studies. They are valuable tools for academic research but are not designed for genealogical searches. FamilySearch is specifically built to help people trace family history and locate historical records.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="97895_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">EBSCOhost, Google Scholar, and PubMed are academic research databases used to locate peer-reviewed scholarly articles and scientific studies. They are valuable tools for academic research but are not designed for genealogical searches. FamilySearch is specifically built to help people trace family history and locate historical records.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g0220488c2534a2b0f43e209f567ef8a5" title="Question 34">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>90611,25065,65073,59137</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does the term &lt;strong&gt;ethics&lt;/strong&gt; mean as defined in the W04 reading?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="90611">
              <material>
                <mattext texttype="text/plain">Beliefs and principles about what is right and wrong</mattext>
              </material>
            </response_label>
            <response_label ident="25065">
              <material>
                <mattext texttype="text/plain">The formatting rules followed when writing a research paper</mattext>
              </material>
            </response_label>
            <response_label ident="65073">
              <material>
                <mattext texttype="text/plain">The process of evaluating the reliability of a source</mattext>
              </material>
            </response_label>
            <response_label ident="59137">
              <material>
                <mattext texttype="text/plain">A strategy for organizing genealogical data</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">90611</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="90611_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">25065</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="25065_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">65073</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="65073_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">59137</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="59137_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">90611</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="90611_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Ethics refers to beliefs and principles about what is right and wrong. In the context of research writing, ethics guides decisions about how to use sources honestly, how to protect the privacy of living relatives, and how to maintain academic integrity throughout the research process.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="25065_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Formatting rules for research papers describe citation style, such as APA. The process of evaluating source reliability describes source evaluation. A strategy for organizing genealogical data describes a research organization method. Ethics is the broader set of principles that shapes all responsible research behavior, from honest citation to respectful handling of personal information.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="65073_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Formatting rules for research papers describe citation style, such as APA. The process of evaluating source reliability describes source evaluation. A strategy for organizing genealogical data describes a research organization method. Ethics is the broader set of principles that shapes all responsible research behavior, from honest citation to respectful handling of personal information.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="59137_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Formatting rules for research papers describe citation style, such as APA. The process of evaluating source reliability describes source evaluation. A strategy for organizing genealogical data describes a research organization method. Ethics is the broader set of principles that shapes all responsible research behavior, from honest citation to respectful handling of personal information.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gc6e7a4a9f2c2a79e210ca7647b34f9db" title="Question 35">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>21871,61126,86747,14374</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;How should direct quotations be integrated into your writing?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="21871">
              <material>
                <mattext texttype="text/plain">Woven into your own complete sentences, never standing alone</mattext>
              </material>
            </response_label>
            <response_label ident="61126">
              <material>
                <mattext texttype="text/plain">Listed as separate sentences at the end of each paragraph</mattext>
              </material>
            </response_label>
            <response_label ident="86747">
              <material>
                <mattext texttype="text/plain">Placed at the beginning of each paragraph to introduce the topic</mattext>
              </material>
            </response_label>
            <response_label ident="14374">
              <material>
                <mattext texttype="text/plain">Used as frequently as possible to support your thesis</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">21871</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="21871_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">61126</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="61126_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">86747</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="86747_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">14374</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="14374_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">21871</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="21871_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Direct quotations should be woven into your own complete sentences and never stand alone. Integrating quotes into your own sentences creates a more professional and readable paper and ensures that the quoted material is properly contextualized for the reader.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="61126_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Listing quotations as separate sentences at the end of paragraphs creates a disconnected, unprofessional reading experience. Placing quotes only at the beginning of paragraphs is not a standard practice and limits how effectively you can use source material. Direct quotations should be used sparingly, not as frequently as possible—overusing them reduces their impact and can make a paper feel pasted together from outside sources rather than written with original analysis.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="86747_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Listing quotations as separate sentences at the end of paragraphs creates a disconnected, unprofessional reading experience. Placing quotes only at the beginning of paragraphs is not a standard practice and limits how effectively you can use source material. Direct quotations should be used sparingly, not as frequently as possible—overusing them reduces their impact and can make a paper feel pasted together from outside sources rather than written with original analysis.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="14374_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Listing quotations as separate sentences at the end of paragraphs creates a disconnected, unprofessional reading experience. Placing quotes only at the beginning of paragraphs is not a standard practice and limits how effectively you can use source material. Direct quotations should be used sparingly, not as frequently as possible—overusing them reduces their impact and can make a paper feel pasted together from outside sources rather than written with original analysis.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ge19461ab3a4a503e203ee26fa5287e72" title="Question 36">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>11365,80694,81800,63556</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the generational numbering system used in standard genealogical organization?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="11365">
              <material>
                <mattext texttype="text/plain">You are Generation 1, your parents are Generation 2, and your grandparents are Generation 3</mattext>
              </material>
            </response_label>
            <response_label ident="80694">
              <material>
                <mattext texttype="text/plain">Your grandparents are Generation 1, your parents are Generation 2, and you are Generation 3</mattext>
              </material>
            </response_label>
            <response_label ident="81800">
              <material>
                <mattext texttype="text/plain">You are Generation 1, your grandparents are Generation 2, and your great-grandparents are Generation 3</mattext>
              </material>
            </response_label>
            <response_label ident="63556">
              <material>
                <mattext texttype="text/plain">Your parents are Generation 1, you are Generation 2, and your children are Generation 3</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">11365</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="11365_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">80694</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="80694_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">81800</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="81800_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">63556</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="63556_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">11365</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="11365_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">In standard genealogical organization, you are Generation 1, your parents are Generation 2, your grandparents are Generation 3, and your great-grandparents are Generation 4. This numbering system begins with yourself and moves backward through your family history.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="80694_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The other options reverse or skip generations incorrectly. Standard genealogical numbering always begins with the researcher as Generation 1 and counts backward through time. Starting with grandparents or parents as Generation 1 would create confusion when tracking multiple family branches across many generations.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="81800_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The other options reverse or skip generations incorrectly. Standard genealogical numbering always begins with the researcher as Generation 1 and counts backward through time. Starting with grandparents or parents as Generation 1 would create confusion when tracking multiple family branches across many generations.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="63556_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The other options reverse or skip generations incorrectly. Standard genealogical numbering always begins with the researcher as Generation 1 and counts backward through time. Starting with grandparents or parents as Generation 1 would create confusion when tracking multiple family branches across many generations.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gf989e8435a42c4a20c7bb2cdd9a9c7b1" title="Question 37">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>58765,48036,44387,70211</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is a working thesis?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="58765">
              <material>
                <mattext texttype="text/plain">A possible answer to your research question that may be adjusted as research continues</mattext>
              </material>
            </response_label>
            <response_label ident="48036">
              <material>
                <mattext texttype="text/plain">The final, polished argument stated in the conclusion of your paper</mattext>
              </material>
            </response_label>
            <response_label ident="44387">
              <material>
                <mattext texttype="text/plain">A broad topic area you have identified before developing a research question</mattext>
              </material>
            </response_label>
            <response_label ident="70211">
              <material>
                <mattext texttype="text/plain">A summary of the main sources you plan to use in your paper</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">58765</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="58765_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">48036</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="48036_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">44387</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="44387_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">70211</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="70211_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">58765</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="58765_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">A working thesis is a possible answer to your research question that may be adjusted as new information emerges through research. It gives you a clear direction before you begin researching in earnest while remaining open to revision.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="48036_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;A final, polished argument in a conclusion describes the thesis in its completed form, after all research and drafting is finished. A broad topic area is the starting point before a research question is developed. A summary of planned sources describes a research plan, not a thesis. The word &lt;em&gt;working&lt;/em&gt; signals that this thesis is a starting point, not a fixed final statement.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="44387_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;A final, polished argument in a conclusion describes the thesis in its completed form, after all research and drafting is finished. A broad topic area is the starting point before a research question is developed. A summary of planned sources describes a research plan, not a thesis. The word &lt;em&gt;working&lt;/em&gt; signals that this thesis is a starting point, not a fixed final statement.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="70211_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;A final, polished argument in a conclusion describes the thesis in its completed form, after all research and drafting is finished. A broad topic area is the starting point before a research question is developed. A summary of planned sources describes a research plan, not a thesis. The word &lt;em&gt;working&lt;/em&gt; signals that this thesis is a starting point, not a fixed final statement.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gf0f4297225a05eee48eba21b659dd0fe" title="Question 38">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>21782,36879,6749,71363</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following privacy guidelines applies to living relatives in a family history project?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="21782">
              <material>
                <mattext texttype="text/plain">Avoid including full birth dates; using the year only is acceptable</mattext>
              </material>
            </response_label>
            <response_label ident="36879">
              <material>
                <mattext texttype="text/plain">Include full names, birth dates, and current addresses for accuracy</mattext>
              </material>
            </response_label>
            <response_label ident="6749">
              <material>
                <mattext texttype="text/plain">Share all available medical and financial information to create a complete record</mattext>
              </material>
            </response_label>
            <response_label ident="71363">
              <material>
                <mattext texttype="text/plain">Publish sensitive family stories without permission to preserve historical accuracy</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">21782</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="21782_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">36879</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="36879_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6749</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6749_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">71363</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="71363_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">21782</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="21782_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;When writing about living relatives, you should avoid including full birth dates—using the year only is acceptable. Protecting the personal information of living family members is an important ethical responsibility in family history writing.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="36879_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Including full birth dates and current addresses puts living relatives at risk and violates their privacy. Sharing medical and financial information is specifically identified as information to avoid in a family history project. Publishing sensitive stories without permission disrespects the people involved and violates the ethical principles that guide responsible family history writing. Privacy protection is always required when writing about living individuals.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6749_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Including full birth dates and current addresses puts living relatives at risk and violates their privacy. Sharing medical and financial information is specifically identified as information to avoid in a family history project. Publishing sensitive stories without permission disrespects the people involved and violates the ethical principles that guide responsible family history writing. Privacy protection is always required when writing about living individuals.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="71363_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Including full birth dates and current addresses puts living relatives at risk and violates their privacy. Sharing medical and financial information is specifically identified as information to avoid in a family history project. Publishing sensitive stories without permission disrespects the people involved and violates the ethical principles that guide responsible family history writing. Privacy protection is always required when writing about living individuals.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g7eedea8e061cca792353306e4cf50aee" title="Question 39">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9217,8212,89756,90448</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the difference between the paternal line and the maternal line in family history research?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9217">
              <material>
                <mattext texttype="text/plain">The paternal line refers to the father's family and the maternal line refers to the mother's family</mattext>
              </material>
            </response_label>
            <response_label ident="8212">
              <material>
                <mattext texttype="text/plain">The paternal line refers to older generations and the maternal line refers to younger generations</mattext>
              </material>
            </response_label>
            <response_label ident="89756">
              <material>
                <mattext texttype="text/plain">The paternal line refers to living relatives and the maternal line refers to deceased relatives</mattext>
              </material>
            </response_label>
            <response_label ident="90448">
              <material>
                <mattext texttype="text/plain">The paternal line refers to male relatives and the maternal line refers to female relatives</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
