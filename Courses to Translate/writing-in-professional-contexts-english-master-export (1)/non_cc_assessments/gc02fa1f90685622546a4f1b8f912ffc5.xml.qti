          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>42730,97024,87502,12804</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is paraphrasing?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="42730">
              <material>
                <mattext texttype="text/plain">Restating information from a source using your own words and sentence structure</mattext>
              </material>
            </response_label>
            <response_label ident="97024">
              <material>
                <mattext texttype="text/plain">Copying text directly from a source and placing it in quotation marks</mattext>
              </material>
            </response_label>
            <response_label ident="87502">
              <material>
                <mattext texttype="text/plain">Condensing a source to only its most essential main ideas</mattext>
              </material>
            </response_label>
            <response_label ident="12804">
              <material>
                <mattext texttype="text/plain">Listing the sources you used at the end of your paper</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">42730</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="42730_fb"/>
