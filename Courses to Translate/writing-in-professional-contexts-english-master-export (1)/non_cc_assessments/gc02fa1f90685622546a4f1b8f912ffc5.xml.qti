    </item>
    <item ident="gdc3af757421693007b8a33cf90a8de2c" title="Question 15">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>65924,9268,91366,91785</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What type of question generates the most useful information during a research interview?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="65924">
              <material>
                <mattext texttype="text/plain">An open-ended question that cannot be answered with yes or no</mattext>
              </material>
            </response_label>
            <response_label ident="9268">
              <material>
                <mattext texttype="text/plain">A closed question that requires only a yes or no answer</mattext>
              </material>
            </response_label>
            <response_label ident="91366">
              <material>
                <mattext texttype="text/plain">A question that confirms facts the researcher already knows</mattext>
              </material>
            </response_label>
            <response_label ident="91785">
              <material>
                <mattext texttype="text/plain">A question that asks the subject to choose between two options</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">65924</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="65924_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9268</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9268_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">91366</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="91366_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">91785</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="91785_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">65924</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="65924_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">An open-ended question that cannot be answered with yes or no generates the most useful information during a research interview. These questions invite detailed, thoughtful responses that provide richer information for your research.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9268_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Closed yes-or-no questions, fact-confirmation questions, and forced-choice questions all limit the depth of the response. For example, asking "Do you think technology helps students?" produces far less useful information than asking "How has technology changed the way students learn?" Detailed responses give researchers more material to work with when writing their interview write-up.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="91366_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Closed yes-or-no questions, fact-confirmation questions, and forced-choice questions all limit the depth of the response. For example, asking "Do you think technology helps students?" produces far less useful information than asking "How has technology changed the way students learn?" Detailed responses give researchers more material to work with when writing their interview write-up.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="91785_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Closed yes-or-no questions, fact-confirmation questions, and forced-choice questions all limit the depth of the response. For example, asking "Do you think technology helps students?" produces far less useful information than asking "How has technology changed the way students learn?" Detailed responses give researchers more material to work with when writing their interview write-up.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gf7dacf601b7d7b5590f4ecfe891c72cc" title="Question 16">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
