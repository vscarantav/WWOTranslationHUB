    <item ident="g5e4e85f329bac39e0acad713acd56faf" title="Question 34">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>21232,37172,74723,14803</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the three-part structure of a professional email body?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="21232">
              <material>
                <mattext texttype="text/plain">Context, request, and appreciation</mattext>
              </material>
            </response_label>
            <response_label ident="37172">
              <material>
                <mattext texttype="text/plain">Subject, greeting, and closing</mattext>
              </material>
            </response_label>
            <response_label ident="74723">
              <material>
                <mattext texttype="text/plain">Introduction, evidence, and conclusion</mattext>
              </material>
            </response_label>
            <response_label ident="14803">
              <material>
                <mattext texttype="text/plain">Claim, counterclaim, and rebuttal</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">37172</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="37172_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">74723</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="74723_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">14803</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="14803_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">21232</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="37172_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Subject, greeting, and closing are separate structural elements of the full email. Introduction, evidence, and conclusion describe essay structure. Claim, counterclaim, and rebuttal describe argument structure. The body of a professional email follows a three-part structure: Context (who you are and why you are writing), request (your specific ask), and appreciation (a thank-you to the reader).&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="74723_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Subject, greeting, and closing are separate structural elements of the full email. Introduction, evidence, and conclusion describe essay structure. Claim, counterclaim, and rebuttal describe argument structure. The body of a professional email follows a three-part structure: Context (who you are and why you are writing), request (your specific ask), and appreciation (a thank-you to the reader).&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
