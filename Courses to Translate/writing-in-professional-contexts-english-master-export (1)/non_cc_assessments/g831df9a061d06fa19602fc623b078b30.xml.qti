                <mattext texttype="text/plain">The greeting</mattext>
              </material>
            </response_label>
            <response_label ident="58503">
              <material>
                <mattext texttype="text/plain">The closing</mattext>
              </material>
            </response_label>
            <response_label ident="1194">
              <material>
                <mattext texttype="text/plain">The signature</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
