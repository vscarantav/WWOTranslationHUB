          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the purpose of the body of a professional email?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="51075">
              <material>
                <mattext texttype="text/plain">To provide context, state a specific request, and express appreciation</mattext>
              </material>
            </response_label>
            <response_label ident="66531">
              <material>
                <mattext texttype="text/plain">To list the sender's academic credentials and course history</mattext>
              </material>
            </response_label>
            <response_label ident="21998">
              <material>
                <mattext texttype="text/plain">To restate the subject line in full sentences</mattext>
              </material>
            </response_label>
            <response_label ident="28081">
              <material>
                <mattext texttype="text/plain">To explain the rules of professional email formatting</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
