            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>94394,33833,79950,53308</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is a simile?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="94394">
              <material>
                <mattext texttype="text/plain">A comparison of two unlike things using the words "like" or "as"</mattext>
              </material>
            </response_label>
            <response_label ident="33833">
              <material>
                <mattext texttype="text/plain">The repetition of a word or phrase to build emphasis in writing</mattext>
              </material>
            </response_label>
            <response_label ident="79950">
              <material>
                <mattext texttype="text/plain">A statement that presents something as less important than it is</mattext>
              </material>
            </response_label>
            <response_label ident="53308">
              <material>
                <mattext texttype="text/plain">The use of human characteristics to describe a non-human object</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">33833</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="33833_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">79950</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="79950_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">53308</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="53308_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">94394</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="33833_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Repetition, understatement, and personification are each separate literary devices. A simile is a figure of speech that compares two unlike things by using the connecting words &lt;em&gt;like&lt;/em&gt; or &lt;em&gt;as&lt;/em&gt; to highlight a shared quality between them.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="79950_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Repetition, understatement, and personification are each separate literary devices. A simile is a figure of speech that compares two unlike things by using the connecting words &lt;em&gt;like&lt;/em&gt; or &lt;em&gt;as&lt;/em&gt; to highlight a shared quality between them.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
