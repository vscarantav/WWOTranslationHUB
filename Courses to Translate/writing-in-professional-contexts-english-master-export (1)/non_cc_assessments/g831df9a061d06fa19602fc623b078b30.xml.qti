            <fieldentry>99601,97986,91068,41145</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is a rhetorical question?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="99601">
              <material>
                <mattext texttype="text/plain">A question asked for dramatic effect that does not expect an answer</mattext>
              </material>
            </response_label>
            <response_label ident="97986">
              <material>
                <mattext texttype="text/plain">A question that asks the reader to provide factual information</mattext>
              </material>
            </response_label>
            <response_label ident="91068">
              <material>
                <mattext texttype="text/plain">A question used to test the reader's knowledge of a topic</mattext>
              </material>
            </response_label>
            <response_label ident="41145">
              <material>
                <mattext texttype="text/plain">A question that introduces new evidence to support an argument</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">97986</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="97986_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">91068</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="91068_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">41145</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="41145_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">99601</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="97986_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Questions that request facts, test knowledge, or introduce evidence serve informational purposes. A rhetorical question is asked purely for dramatic or persuasive effect—it creates emphasis or provokes thought without expecting the reader to respond directly.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="91068_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Questions that request facts, test knowledge, or introduce evidence serve informational purposes. A rhetorical question is asked purely for dramatic or persuasive effect—it creates emphasis or provokes thought without expecting the reader to respond directly.&lt;/p&gt;</mattext>
