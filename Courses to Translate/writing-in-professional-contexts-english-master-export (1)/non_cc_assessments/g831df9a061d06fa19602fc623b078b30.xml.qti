          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the greeting in a professional email?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="10750">
              <material>
