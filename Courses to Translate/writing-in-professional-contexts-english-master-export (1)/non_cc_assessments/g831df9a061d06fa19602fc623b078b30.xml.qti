      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does the term &lt;strong&gt;audience&lt;/strong&gt; mean in the context of writing?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="76392">
              <material>
                <mattext texttype="text/plain">The people who will read or receive a written message</mattext>
              </material>
            </response_label>
            <response_label ident="3966">
              <material>
                <mattext texttype="text/plain">The format and structure used to organize a document</mattext>
              </material>
            </response_label>
            <response_label ident="27288">
              <material>
                <mattext texttype="text/plain">The main argument or claim made in a piece of writing</mattext>
              </material>
            </response_label>
            <response_label ident="36749">
              <material>
                <mattext texttype="text/plain">The channel used to deliver a written message</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
