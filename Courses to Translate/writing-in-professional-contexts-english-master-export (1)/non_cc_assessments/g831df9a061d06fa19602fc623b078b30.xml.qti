          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="42039_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">58801</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="58801_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">41621</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="21295_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Strong evidence-based arguments, rhetorical questions, and data-driven conclusions are all valid rhetorical tools. A logical fallacy is a flawed argument where invalid or irrelevant reasoning is used, which can make an argument sound convincing even though the logic is unsound.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="42039_fb">
