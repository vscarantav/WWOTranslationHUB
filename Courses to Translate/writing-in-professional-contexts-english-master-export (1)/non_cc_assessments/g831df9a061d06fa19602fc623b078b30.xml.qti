        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">20530</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="20530_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">12647</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="12647_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">45052</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="7388_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Thanking the reader describes the appreciation section, stating a specific request describes the request section, and providing your name and ID describes the signature. The context section opens the email body by briefly explaining who you are and why you are writing—this gives the recipient the background they need to understand your message before reading your request.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
