      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which literary device gives human characteristics to a non-human object or idea?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="3133">
              <material>
                <mattext texttype="text/plain">Personification</mattext>
              </material>
            </response_label>
            <response_label ident="40639">
              <material>
                <mattext texttype="text/plain">Simile</mattext>
              </material>
            </response_label>
            <response_label ident="5361">
              <material>
                <mattext texttype="text/plain">Hyperbole</mattext>
              </material>
            </response_label>
            <response_label ident="53789">
              <material>
                <mattext texttype="text/plain">Parallel structure</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">40639</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="40639_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5361</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5361_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">53789</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="53789_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">3133</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="40639_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A simile compares two unlike things using "like" or "as," hyperbole exaggerates for dramatic effect, and parallel structure repeats a grammatical pattern. Personification is the literary device that assigns human characteristics to a non-human object or idea to make it seem alive and relatable.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5361_fb">
        <flow_mat>
          <material>
