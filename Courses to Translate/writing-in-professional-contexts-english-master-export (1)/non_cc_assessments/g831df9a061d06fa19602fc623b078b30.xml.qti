          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the first step in creating a persuasive message?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="95794">
              <material>
                <mattext texttype="text/plain">Define your rhetorical situation by identifying your audience, purpose, and channel</mattext>
              </material>
            </response_label>
            <response_label ident="836">
              <material>
                <mattext texttype="text/plain">Choose which rhetorical appeals—ethos, pathos, or logos—to include</mattext>
              </material>
            </response_label>
            <response_label ident="56079">
              <material>
                <mattext texttype="text/plain">Draft the message using the appeals you find most persuasive</mattext>
              </material>
            </response_label>
            <response_label ident="73379">
              <material>
                <mattext texttype="text/plain">Evaluate your draft using an ethos, pathos, logos, and kairos checklist</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">836</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="836_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">56079</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="56079_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">73379</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="73379_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">95794</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="836_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Choosing appeals, drafting, and evaluating are all important steps, but they come after the first step. Before any writing begins, a communicator must define the rhetorical situation—identifying the specific audience, the purpose of the message, and the channel through which it will be delivered.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="56079_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Choosing appeals, drafting, and evaluating are all important steps, but they come after the first step. Before any writing begins, a communicator must define the rhetorical situation—identifying the specific audience, the purpose of the message, and the channel through which it will be delivered.&lt;/p&gt;</mattext>
