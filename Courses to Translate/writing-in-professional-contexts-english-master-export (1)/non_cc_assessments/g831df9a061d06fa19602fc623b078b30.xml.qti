          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is persuasion?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="91220">
              <material>
                <mattext texttype="text/plain">The act of convincing someone to do something or to believe that something is true</mattext>
              </material>
            </response_label>
            <response_label ident="65312">
              <material>
                <mattext texttype="text/plain">The process of organizing ideas into a logical sequence of paragraphs</mattext>
              </material>
            </response_label>
            <response_label ident="41616">
              <material>
                <mattext texttype="text/plain">The practice of identifying errors in grammar and punctuation</mattext>
              </material>
            </response_label>
            <response_label ident="46712">
              <material>
                <mattext texttype="text/plain">The method of summarizing information from multiple sources</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
