      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does &lt;strong&gt;purpose &lt;/strong&gt;mean in the context of writing?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="69817">
              <material>
                <mattext texttype="text/plain">The specific goal or intention a writer wants to achieve with a message</mattext>
              </material>
            </response_label>
            <response_label ident="83169">
              <material>
                <mattext texttype="text/plain">The audience who will read or receive the written message</mattext>
              </material>
            </response_label>
            <response_label ident="68331">
              <material>
                <mattext texttype="text/plain">The format or medium used to deliver the written message</mattext>
              </material>
            </response_label>
            <response_label ident="39307">
              <material>
                <mattext texttype="text/plain">The literary devices used to make the writing more persuasive</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
