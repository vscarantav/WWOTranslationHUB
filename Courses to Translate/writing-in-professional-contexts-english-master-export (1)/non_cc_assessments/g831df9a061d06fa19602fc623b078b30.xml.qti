        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">14728</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="14728_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">40274</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="40274_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">83145</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="79461_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Pathos appeals to emotion, ethos builds credibility, and kairos focuses on timing. Logos is the rhetorical appeal that relies on facts, evidence, and logical reasoning to persuade an audience.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="14728_fb">
        <flow_mat>
