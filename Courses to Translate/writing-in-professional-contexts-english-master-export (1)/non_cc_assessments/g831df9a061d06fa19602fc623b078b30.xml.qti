        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="23546">
              <material>
                <mattext texttype="text/plain">Directness, thoroughness, and demonstrated expertise</mattext>
              </material>
            </response_label>
            <response_label ident="65161">
              <material>
                <mattext texttype="text/plain">Relationship-building before addressing the main topic</mattext>
              </material>
            </response_label>
            <response_label ident="34598">
              <material>
                <mattext texttype="text/plain">Storytelling and narrative to persuade through principles</mattext>
              </material>
            </response_label>
            <response_label ident="5511">
              <material>
                <mattext texttype="text/plain">Indirect communication that gradually builds toward the main point</mattext>
              </material>
            </response_label>
