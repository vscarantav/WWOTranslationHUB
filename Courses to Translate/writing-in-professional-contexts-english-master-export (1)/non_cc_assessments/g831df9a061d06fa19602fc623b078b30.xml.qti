          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g7f27f6026e9967bef52fc62a7ec13895" title="Question 37">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>40397,30000,48188,47896</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which professional email greeting is most appropriate for a formal academic context?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="40397">
              <material>
                <mattext texttype="text/plain">Dear Professor [Last Name]</mattext>
              </material>
            </response_label>
            <response_label ident="30000">
              <material>
                <mattext texttype="text/plain">Hey [First Name]</mattext>
              </material>
            </response_label>
            <response_label ident="48188">
              <material>
                <mattext texttype="text/plain">To Whom It May Concern</mattext>
              </material>
            </response_label>
            <response_label ident="47896">
              <material>
                <mattext texttype="text/plain">Hi there</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">30000</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="30000_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">48188</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="48188_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">47896</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="47896_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">40397</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="30000_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">"Hey" and "Hi there" are casual greetings not appropriate for professional or academic communication. "To Whom It May Concern" is used when the recipient's name is unknown, but when the recipient is known, a personalized greeting is more appropriate. "Dear Professor [Last Name]" is the most formal and appropriate greeting for academic email communication.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="48188_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">"Hey" and "Hi there" are casual greetings not appropriate for professional or academic communication. "To Whom It May Concern" is used when the recipient's name is unknown, but when the recipient is known, a personalized greeting is more appropriate. "Dear Professor [Last Name]" is the most formal and appropriate greeting for academic email communication.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="47896_fb">
