      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is a logical fallacy?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="41621">
              <material>
                <mattext texttype="text/plain">A flawed argument that uses invalid or irrelevant reasoning</mattext>
              </material>
            </response_label>
            <response_label ident="21295">
              <material>
                <mattext texttype="text/plain">A strong argument supported by reliable evidence</mattext>
              </material>
            </response_label>
            <response_label ident="42039">
              <material>
                <mattext texttype="text/plain">A rhetorical question used to create a dramatic effect</mattext>
              </material>
            </response_label>
            <response_label ident="58801">
              <material>
                <mattext texttype="text/plain">A logical conclusion drawn from statistical data</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
