            <mattext texttype="text/plain">Grammar, formatting details, and structural elements are tools used after the communication strategy is set. Before writing, a communicator must identify the audience (who will read the message), the purpose (what the message should accomplish), and the channel (how the message will be delivered).</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gcf5aeddb47f0bef4559c253e311dad6b" title="Question 12">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>87721,18523,37254,78416</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which rhetorical appeal connects with readers by targeting their feelings and emotions?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="87721">
              <material>
                <mattext texttype="text/plain">Pathos</mattext>
              </material>
            </response_label>
            <response_label ident="18523">
              <material>
                <mattext texttype="text/plain">Logos</mattext>
              </material>
            </response_label>
            <response_label ident="37254">
              <material>
                <mattext texttype="text/plain">Ethos</mattext>
              </material>
            </response_label>
            <response_label ident="78416">
              <material>
                <mattext texttype="text/plain">Kairos</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">18523</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="18523_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">37254</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="37254_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">78416</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="78416_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">87721</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="18523_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Logos uses logic and evidence, ethos builds credibility, and kairos focuses on timing. Pathos is the rhetorical appeal that connects with an audience by targeting their emotions, such as fear, hope, love, or a sense of justice.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="37254_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Logos uses logic and evidence, ethos builds credibility, and kairos focuses on timing. Pathos is the rhetorical appeal that connects with an audience by targeting their emotions, such as fear, hope, love, or a sense of justice.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="78416_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Logos uses logic and evidence, ethos builds credibility, and kairos focuses on timing. Pathos is the rhetorical appeal that connects with an audience by targeting their emotions, such as fear, hope, love, or a sense of justice.</mattext>
