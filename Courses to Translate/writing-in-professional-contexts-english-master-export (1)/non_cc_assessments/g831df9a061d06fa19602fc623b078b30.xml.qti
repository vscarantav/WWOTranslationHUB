    <item ident="gd5ebdebf2ec7589c2b0ee30b4bc931ff" title="Question 18">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
