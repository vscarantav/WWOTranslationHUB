      <itemfeedback ident="29498_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Logos uses logic and evidence, pathos appeals to emotion, and kairos relates to timing. Ethos is the rhetorical appeal that builds trust by establishing the writer's credibility, expertise, or good character.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
