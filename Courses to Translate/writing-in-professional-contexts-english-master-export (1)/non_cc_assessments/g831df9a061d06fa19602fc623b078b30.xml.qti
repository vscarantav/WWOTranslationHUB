          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="83169_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The audience refers to who reads the message, the channel refers to the format or medium, and literary devices are tools used to achieve the purpose. In writing, purpose is the specific goal or intention behind a message—such as persuading readers to act, informing them about a topic, or motivating them to change their behavior.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
