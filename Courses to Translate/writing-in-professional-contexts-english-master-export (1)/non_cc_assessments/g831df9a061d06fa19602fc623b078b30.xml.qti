    <item ident="gd75932ad2441ab3184f8d9b2c08d0f7a" title="Question 44">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>65525,51951,32527,57081</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What common email mistake involves using informal language in a professional message?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="65525">
              <material>
                <mattext texttype="text/plain">Using casual greetings such as "Hey" or "What's up" instead of a professional salutation</mattext>
              </material>
            </response_label>
            <response_label ident="51951">
              <material>
                <mattext texttype="text/plain">Including your full name and course section in the email signature</mattext>
              </material>
            </response_label>
            <response_label ident="32527">
              <material>
                <mattext texttype="text/plain">Stating your request clearly and specifically in the body of the email</mattext>
              </material>
            </response_label>
            <response_label ident="57081">
              <material>
                <mattext texttype="text/plain">Using "Best regards" as the closing phrase of the email</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">51951</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="51951_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">32527</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="32527_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">57081</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="57081_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">65525</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="51951_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Including your name and course section, stating your request clearly, and using "Best regards" are all correct professional email practices. Using casual greetings like "Hey" or "What's up" is a tone problem that damages professional communication—it signals a lack of respect for the recipient and undermines the credibility of the message.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="32527_fb">
        <flow_mat>
          <material>
