    <item ident="gc2672cfcd96cfef48d2c364079dbe42c" title="Question 23">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>39816,29057,44237,89252</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the causal fallacy?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="39816">
              <material>
                <mattext texttype="text/plain">Claiming that one event caused another without proving a real connection</mattext>
              </material>
            </response_label>
            <response_label ident="29057">
              <material>
                <mattext texttype="text/plain">Arguing that something is true because many people believe it</mattext>
              </material>
            </response_label>
            <response_label ident="44237">
              <material>
                <mattext texttype="text/plain">Attacking the personal character of the person making an argument</mattext>
              </material>
            </response_label>
            <response_label ident="89252">
              <material>
                <mattext texttype="text/plain">Assuming one action will lead to a series of extreme outcomes</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">29057</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="29057_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">44237</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="44237_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">89252</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="89252_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">39816</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="29057_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Using popularity to argue truth describes the bandwagon fallacy, attacking personal character describes ad hominem, and assuming extreme chain reactions describes the slippery slope fallacy. The causal fallacy claims that because one event followed another, the first must have caused the second—without providing evidence of a real connection between the two.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="44237_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Using popularity to argue truth describes the bandwagon fallacy, attacking personal character describes ad hominem, and assuming extreme chain reactions describes the slippery slope fallacy. The causal fallacy claims that because one event followed another, the first must have caused the second—without providing evidence of a real connection between the two.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="89252_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Using popularity to argue truth describes the bandwagon fallacy, attacking personal character describes ad hominem, and assuming extreme chain reactions describes the slippery slope fallacy. The causal fallacy claims that because one event followed another, the first must have caused the second—without providing evidence of a real connection between the two.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gf3e4ebbeda47a8ba70a55789fd8c8254" title="Question 24">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
