    <item ident="g2b37c9a9f7201b45729997fc93769dc7" title="Question 38">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>16551,36937,7726,56446</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does Smokey Bear's personification accomplish in the wildfire prevention campaign?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="16551">
              <material>
                <mattext texttype="text/plain">It establishes credibility by making Smokey a believable and trustworthy figure</mattext>
              </material>
            </response_label>
            <response_label ident="36937">
              <material>
                <mattext texttype="text/plain">It uses logical data and statistics to argue that forest fires are dangerous</mattext>
              </material>
            </response_label>
            <response_label ident="7726">
              <material>
                <mattext texttype="text/plain">It relies on kairos by connecting the campaign to a current news event</mattext>
              </material>
            </response_label>
            <response_label ident="56446">
              <material>
                <mattext texttype="text/plain">It presents two extreme choices to motivate the audience to prevent fires</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">36937</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="36937_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7726</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7726_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">56446</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="56446_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">16551</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="36937_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The campaign does not primarily rely on data and statistics, a current news event, or a false dilemma. Smokey Bear's personification establishes credibility—transforming a wild animal into a trusted, familiar father figure removes any sense of danger and makes Smokey a believable voice for the message of fire prevention.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7726_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The campaign does not primarily rely on data and statistics, a current news event, or a false dilemma. Smokey Bear's personification establishes credibility—transforming a wild animal into a trusted, familiar father figure removes any sense of danger and makes Smokey a believable voice for the message of fire prevention.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
