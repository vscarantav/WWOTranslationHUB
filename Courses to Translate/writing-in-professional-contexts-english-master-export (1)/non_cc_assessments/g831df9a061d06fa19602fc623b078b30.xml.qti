      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is one way a writer supports claims with convincing evidence in persuasive writing?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5597">
              <material>
                <mattext texttype="text/plain">Citing appropriate statistics, facts, or expert opinions</mattext>
              </material>
            </response_label>
            <response_label ident="68838">
              <material>
                <mattext texttype="text/plain">Repeating the main claim multiple times throughout the message</mattext>
              </material>
            </response_label>
            <response_label ident="62928">
              <material>
                <mattext texttype="text/plain">Using casual language to make the argument feel more relatable</mattext>
              </material>
            </response_label>
            <response_label ident="27480">
              <material>
                <mattext texttype="text/plain">Avoiding specific details so the argument applies to more readers</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">68838</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="68838_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">62928</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="62928_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">27480</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="27480_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">5597</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="68838_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Repeating claims does not constitute evidence, casual language reduces credibility rather than strengthening arguments, and avoiding specific details weakens rather than strengthens a persuasive case. Writers support claims with convincing evidence by citing statistics, facts, expert opinions, or relevant examples—these provide the logical foundation that makes an argument credible and trustworthy.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="62928_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Repeating claims does not constitute evidence, casual language reduces credibility rather than strengthening arguments, and avoiding specific details weakens rather than strengthens a persuasive case. Writers support claims with convincing evidence by citing statistics, facts, expert opinions, or relevant examples—these provide the logical foundation that makes an argument credible and trustworthy.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
