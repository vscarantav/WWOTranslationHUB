    <item ident="gbb2887abca31ce4eefc446bcb6ce8f13" title="Question 28">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>62857,81961,70645,56824</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is repetition as a literary device?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="62857">
              <material>
                <mattext texttype="text/plain">Repeating a word or group of words to build emphasis on an idea</mattext>
              </material>
            </response_label>
            <response_label ident="81961">
              <material>
                <mattext texttype="text/plain">Giving human characteristics to a non-human object or idea</mattext>
              </material>
            </response_label>
            <response_label ident="70645">
              <material>
                <mattext texttype="text/plain">Presenting a claim using an exaggerated overstatement</mattext>
              </material>
            </response_label>
            <response_label ident="56824">
              <material>
                <mattext texttype="text/plain">Comparing two unlike things to highlight a shared quality</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">81961</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="81961_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">70645</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="70645_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">56824</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="56824_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">62857</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="81961_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Giving human characteristics to objects describes personification, overstating claims describes hyperbole, and comparing unlike things describes a simile or metaphor. Repetition is a literary device that deliberately repeats a word or group of words to draw attention to an idea and make it more memorable for the reader.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="70645_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Giving human characteristics to objects describes personification, overstating claims describes hyperbole, and comparing unlike things describes a simile or metaphor. Repetition is a literary device that deliberately repeats a word or group of words to draw attention to an idea and make it more memorable for the reader.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="56824_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Giving human characteristics to objects describes personification, overstating claims describes hyperbole, and comparing unlike things describes a simile or metaphor. Repetition is a literary device that deliberately repeats a word or group of words to draw attention to an idea and make it more memorable for the reader.</mattext>
          </material>
