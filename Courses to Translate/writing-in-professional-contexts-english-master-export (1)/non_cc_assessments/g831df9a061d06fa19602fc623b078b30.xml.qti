      </itemfeedback>
    </item>
    <item ident="g66280000e85000ec2bea942a501b71e8" title="Question 35">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
