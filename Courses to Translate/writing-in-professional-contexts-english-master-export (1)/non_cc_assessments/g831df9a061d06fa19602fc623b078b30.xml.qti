    <item ident="g6020f69d8ea0ba67f58ca2f10099996c" title="Question 33">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>39613,45969,95469,36602</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does ethos mean as a rhetorical appeal?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="39613">
              <material>
                <mattext texttype="text/plain">Using credibility and good character to build trust with an audience</mattext>
              </material>
            </response_label>
            <response_label ident="45969">
              <material>
                <mattext texttype="text/plain">Using facts and statistics to support a logical argument</mattext>
              </material>
            </response_label>
            <response_label ident="95469">
              <material>
                <mattext texttype="text/plain">Using emotional language to connect with a reader's feelings</mattext>
              </material>
            </response_label>
            <response_label ident="36602">
              <material>
                <mattext texttype="text/plain">Using the right timing to deliver a message to a receptive audience</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">45969</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="45969_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">95469</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="95469_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">36602</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="36602_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">39613</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="45969_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Facts and statistics describe logos, emotional language describes pathos, and timing describes kairos. Ethos is the rhetorical appeal that builds trust by demonstrating the writer's credibility, expertise, or good character—showing the audience why they should believe and respect the communicator.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="95469_fb">
        <flow_mat>
          <material>
