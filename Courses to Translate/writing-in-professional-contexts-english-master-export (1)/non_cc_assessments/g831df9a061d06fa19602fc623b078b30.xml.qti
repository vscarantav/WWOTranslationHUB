          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What communication style do many Kenyan and West African communities use as a persuasive technique?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="42392">
              <material>
                <mattext texttype="text/plain">Storytelling and narrative to illustrate principles</mattext>
              </material>
            </response_label>
            <response_label ident="75863">
              <material>
                <mattext texttype="text/plain">Presenting detailed credentials before making a request</mattext>
              </material>
            </response_label>
            <response_label ident="440">
              <material>
                <mattext texttype="text/plain">Using direct statements and data to support arguments</mattext>
              </material>
            </response_label>
            <response_label ident="27817">
              <material>
                <mattext texttype="text/plain">Beginning with personal conversation before addressing business</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">75863</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="75863_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">440</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="440_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">27817</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="27817_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">42392</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="75863_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Presenting detailed credentials first describes the German rhetorical approach, using direct statements and data describes Western academic communication, and beginning with personal conversation describes Brazilian business communication. Many Kenyan communities and the West African Griot tradition use storytelling and narrative as a persuasive technique—presenting arguments through stories that illustrate principles rather than through direct statements or data alone.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="440_fb">
        <flow_mat>
