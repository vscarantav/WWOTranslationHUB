    <item ident="g908d6e51e812096cea0761dd87bc86d2" title="Question 45">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>38903,37703,76067,66741</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the purpose of sharing personal experience in persuasive writing?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="38903">
              <material>
                <mattext texttype="text/plain">To enhance the writer's credibility and appeal to the reader's emotions</mattext>
              </material>
            </response_label>
            <response_label ident="37703">
              <material>
                <mattext texttype="text/plain">To provide numerical data that supports the writer's main argument</mattext>
              </material>
            </response_label>
            <response_label ident="76067">
              <material>
                <mattext texttype="text/plain">To present two contrasting viewpoints for the reader to evaluate</mattext>
              </material>
            </response_label>
            <response_label ident="66741">
              <material>
                <mattext texttype="text/plain">To repeat key ideas throughout the text for added emphasis</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">37703</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="37703_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">76067</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="76067_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">66741</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="66741_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">38903</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="37703_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Numerical data supports arguments through logos, presenting contrasting viewpoints relates to acknowledging the opposition, and repeating ideas for emphasis describes the literary device of repetition. Sharing personal experience serves two persuasive purposes at once—it enhances the writer's credibility (ethos) by showing firsthand knowledge, and it can also appeal to the reader's emotions (pathos) by making the topic relatable and human.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="76067_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Numerical data supports arguments through logos, presenting contrasting viewpoints relates to acknowledging the opposition, and repeating ideas for emphasis describes the literary device of repetition. Sharing personal experience serves two persuasive purposes at once—it enhances the writer's credibility (ethos) by showing firsthand knowledge, and it can also appeal to the reader's emotions (pathos) by making the topic relatable and human.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="66741_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Numerical data supports arguments through logos, presenting contrasting viewpoints relates to acknowledging the opposition, and repeating ideas for emphasis describes the literary device of repetition. Sharing personal experience serves two persuasive purposes at once—it enhances the writer's credibility (ethos) by showing firsthand knowledge, and it can also appeal to the reader's emotions (pathos) by making the topic relatable and human.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g777ddc7eb3fc7d01bcedb0329acd9772" title="Question 46">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>4039,18198,8769,22962</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does it mean to establish credibility in persuasive writing?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="4039">
              <material>
                <mattext texttype="text/plain">Demonstrating expertise or good character so the audience trusts and respects the writer</mattext>
              </material>
            </response_label>
            <response_label ident="18198">
              <material>
                <mattext texttype="text/plain">Using emotional language to connect with the audience's feelings and values</mattext>
              </material>
            </response_label>
            <response_label ident="8769">
              <material>
                <mattext texttype="text/plain">Providing statistics and facts that support the writer's main claim</mattext>
              </material>
            </response_label>
            <response_label ident="22962">
              <material>
                <mattext texttype="text/plain">Choosing the right moment to deliver a message to a receptive audience</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">18198</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="18198_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">8769</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="8769_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">22962</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="22962_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">4039</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="18198_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Emotional language describes pathos, statistics and facts describe logos, and choosing the right moment describes kairos. Establishing credibility means demonstrating expertise, experience, or good character—it is the foundation of ethos and helps the audience trust that the writer knows what they are talking about.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="8769_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Emotional language describes pathos, statistics and facts describe logos, and choosing the right moment describes kairos. Establishing credibility means demonstrating expertise, experience, or good character—it is the foundation of ethos and helps the audience trust that the writer knows what they are talking about.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
