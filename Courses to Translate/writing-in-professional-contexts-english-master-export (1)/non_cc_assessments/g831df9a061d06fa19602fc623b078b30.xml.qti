      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which rhetorical appeal uses facts, data, and logical reasoning to persuade an audience?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="83145">
              <material>
                <mattext texttype="text/plain">Logos</mattext>
              </material>
            </response_label>
            <response_label ident="79461">
              <material>
                <mattext texttype="text/plain">Pathos</mattext>
              </material>
            </response_label>
            <response_label ident="14728">
              <material>
                <mattext texttype="text/plain">Ethos</mattext>
              </material>
            </response_label>
            <response_label ident="40274">
              <material>
                <mattext texttype="text/plain">Kairos</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
