    <item ident="gcce5479e237da4f522b24b315c272171" title="Question 36">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>40074,73569,18748,30500</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the purpose of acknowledging the opposition in persuasive writing?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="40074">
              <material>
                <mattext texttype="text/plain">To show the audience that the writer has considered opposing views</mattext>
              </material>
            </response_label>
            <response_label ident="73569">
              <material>
                <mattext texttype="text/plain">To confuse readers by introducing conflicting information</mattext>
              </material>
            </response_label>
            <response_label ident="18748">
              <material>
                <mattext texttype="text/plain">To avoid addressing the weaknesses in the writer's argument</mattext>
              </material>
            </response_label>
            <response_label ident="30500">
              <material>
                <mattext texttype="text/plain">To attack the credibility of those who disagree with the writer</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">73569</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="73569_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">18748</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="18748_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">30500</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="30500_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">40074</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="73569_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Introducing conflicting information to confuse, avoiding weaknesses, and attacking opponents' credibility are not legitimate persuasive strategies. Acknowledging the opposition shows readers that the writer has carefully considered other viewpoints—this makes the writer appear fair and thorough, and it strengthens the overall argument by demonstrating why the writer's position is preferable.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="18748_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Introducing conflicting information to confuse, avoiding weaknesses, and attacking opponents' credibility are not legitimate persuasive strategies. Acknowledging the opposition shows readers that the writer has carefully considered other viewpoints—this makes the writer appear fair and thorough, and it strengthens the overall argument by demonstrating why the writer's position is preferable.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="30500_fb">
        <flow_mat>
