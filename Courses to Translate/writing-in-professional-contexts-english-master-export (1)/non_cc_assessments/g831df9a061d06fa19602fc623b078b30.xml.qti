    <item ident="gc990035d34210c36564f26facb730e6f" title="Question 30">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>65264,84917,12616,14316</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is a metaphor?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="65264">
              <material>
                <mattext texttype="text/plain">A direct comparison of two unlike things without using "like" or "as"</mattext>
              </material>
            </response_label>
            <response_label ident="84917">
              <material>
                <mattext texttype="text/plain">A comparison of two unlike things using the words "like" or "as"</mattext>
              </material>
            </response_label>
            <response_label ident="12616">
              <material>
                <mattext texttype="text/plain">The repetition of a grammatical pattern across a series of phrases</mattext>
              </material>
            </response_label>
            <response_label ident="14316">
              <material>
                <mattext texttype="text/plain">A question that creates a dramatic effect without requiring an answer</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">84917</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="84917_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">12616</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="12616_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">14316</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="14316_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">65264</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="84917_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Using "like" or "as" to compare things describes a simile, repeating grammatical patterns describes parallel structure, and dramatic unanswered questions describe rhetorical questions. A metaphor directly states that one thing is another—comparing two unlike things without using connecting words like "like" or "as"—to highlight a shared quality in a more direct and vivid way.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="12616_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Using "like" or "as" to compare things describes a simile, repeating grammatical patterns describes parallel structure, and dramatic unanswered questions describe rhetorical questions. A metaphor directly states that one thing is another—comparing two unlike things without using connecting words like "like" or "as"—to highlight a shared quality in a more direct and vivid way.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="14316_fb">
        <flow_mat>
