            <fieldentry>14149,44737,80125,21230</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the role of numerical data in persuasive writing?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="14149">
              <material>
                <mattext texttype="text/plain">To strengthen an argument by providing accurate facts and figures</mattext>
              </material>
            </response_label>
            <response_label ident="44737">
              <material>
                <mattext texttype="text/plain">To appeal to the reader's emotions through vivid descriptions</mattext>
              </material>
            </response_label>
            <response_label ident="80125">
              <material>
                <mattext texttype="text/plain">To establish the writer's personal credibility and expertise</mattext>
              </material>
            </response_label>
            <response_label ident="21230">
              <material>
                <mattext texttype="text/plain">To create emphasis by repeating key ideas throughout the text</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">44737</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="44737_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">80125</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="80125_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">21230</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="21230_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">14149</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="44737_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Appealing through vivid emotional descriptions describes pathos, establishing personal credibility describes ethos, and repeating key ideas for emphasis describes repetition. Numerical data—such as statistics and figures—strengthens a persuasive argument by providing concrete, accurate evidence that supports the writer's claims through logos.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="80125_fb">
        <flow_mat>
          <material>
