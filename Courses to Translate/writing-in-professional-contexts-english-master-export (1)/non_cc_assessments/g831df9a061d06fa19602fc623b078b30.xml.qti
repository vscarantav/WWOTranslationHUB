        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the purpose of the context section in a professional email body?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="45052">
              <material>
                <mattext texttype="text/plain">To briefly explain who you are and why you are writing</mattext>
              </material>
            </response_label>
            <response_label ident="7388">
              <material>
                <mattext texttype="text/plain">To thank the reader for their time and consideration</mattext>
              </material>
            </response_label>
            <response_label ident="20530">
              <material>
                <mattext texttype="text/plain">To state your specific request clearly and directly</mattext>
              </material>
            </response_label>
            <response_label ident="12647">
              <material>
                <mattext texttype="text/plain">To provide your full name, student ID, and course section</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7388</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7388_fb"/>
