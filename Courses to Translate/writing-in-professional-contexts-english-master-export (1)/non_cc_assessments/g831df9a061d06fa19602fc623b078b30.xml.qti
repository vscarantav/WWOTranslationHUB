          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is hyperbole as a rhetorical device?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="11325">
              <material>
                <mattext texttype="text/plain">An exaggerated claim that overstates the truth to create a dramatic effect</mattext>
              </material>
            </response_label>
            <response_label ident="33461">
              <material>
                <mattext texttype="text/plain">A comparison of two unlike things using the words "like" or "as"</mattext>
              </material>
            </response_label>
            <response_label ident="10222">
              <material>
                <mattext texttype="text/plain">The repetition of a grammatical pattern to give ideas equal weight</mattext>
              </material>
            </response_label>
            <response_label ident="85554">
              <material>
                <mattext texttype="text/plain">A question asked for dramatic effect that does not require an answer</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">33461</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="33461_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">10222</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="10222_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">85554</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="85554_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">11325</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="33461_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Comparing unlike things describes a simile, repeating grammatical patterns describes parallel structure, and dramatic unanswered questions describe rhetorical questions. Hyperbole is an overstatement so dramatic that it distorts the truth—it is used for emphasis or persuasive effect but can undermine credibility when used as a logical fallacy.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="10222_fb">
        <flow_mat>
