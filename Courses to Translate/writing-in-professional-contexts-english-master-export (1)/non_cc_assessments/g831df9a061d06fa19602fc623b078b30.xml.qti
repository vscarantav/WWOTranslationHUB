        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the false dilemma logical fallacy?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="1023">
              <material>
                <mattext texttype="text/plain">Presenting only two extreme options as if no other alternatives exist</mattext>
              </material>
            </response_label>
            <response_label ident="34971">
              <material>
                <mattext texttype="text/plain">Repeating a claim many times to make it seem true</mattext>
              </material>
            </response_label>
            <response_label ident="11079">
              <material>
                <mattext texttype="text/plain">Overstating a claim so dramatically that it distorts the truth</mattext>
              </material>
            </response_label>
            <response_label ident="25679">
              <material>
                <mattext texttype="text/plain">Blaming one event for causing another without sufficient evidence</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">34971</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="34971_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">11079</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="11079_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">25679</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="25679_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">1023</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="34971_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Repeating claims to imply truth, overstating claims, and falsely linking cause and effect are each separate logical fallacies. The false dilemma fallacy presents only two extreme options as if no middle ground or other alternatives exist, forcing an unnecessary choice.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="11079_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Repeating claims to imply truth, overstating claims, and falsely linking cause and effect are each separate logical fallacies. The false dilemma fallacy presents only two extreme options as if no middle ground or other alternatives exist, forcing an unnecessary choice.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="25679_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Repeating claims to imply truth, overstating claims, and falsely linking cause and effect are each separate logical fallacies. The false dilemma fallacy presents only two extreme options as if no middle ground or other alternatives exist, forcing an unnecessary choice.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ge616b26f60c80fd8ff3aff14b8fc51f4" title="Question 16">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>92278,93160,14233,45551</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the purpose of a professional email closing?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="92278">
              <material>
                <mattext texttype="text/plain">To end the email with a professional phrase before the sender's signature</mattext>
              </material>
            </response_label>
            <response_label ident="93160">
              <material>
                <mattext texttype="text/plain">To restate the main request of the email in one sentence</mattext>
              </material>
            </response_label>
            <response_label ident="14233">
              <material>
                <mattext texttype="text/plain">To provide the recipient's name and contact information</mattext>
              </material>
            </response_label>
            <response_label ident="45551">
              <material>
                <mattext texttype="text/plain">To summarize all the key points made in the email body</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">93160</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="93160_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">14233</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="14233_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">45551</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="45551_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">92278</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="93160_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Restating requests, providing recipient contact details, and summarizing key points are not the function of a closing. A professional email closing ends the message with an appropriate phrase—such as "Sincerely," "Best regards," or "Thank you"—before the sender's full signature.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="14233_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Restating requests, providing recipient contact details, and summarizing key points are not the function of a closing. A professional email closing ends the message with an appropriate phrase—such as "Sincerely," "Best regards," or "Thank you"—before the sender's full signature.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
