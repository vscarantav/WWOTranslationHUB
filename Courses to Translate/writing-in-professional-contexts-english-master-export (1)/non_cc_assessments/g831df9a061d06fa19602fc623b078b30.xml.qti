            <fieldentry>80862,69638,25460,61654</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is kairos in rhetorical communication?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="80862">
              <material>
                <mattext texttype="text/plain">Recognizing the right timing to deliver a message to a receptive audience</mattext>
              </material>
            </response_label>
            <response_label ident="69638">
              <material>
                <mattext texttype="text/plain">Using emotional language to connect with a reader's feelings</mattext>
              </material>
            </response_label>
            <response_label ident="25460">
              <material>
                <mattext texttype="text/plain">Citing expert sources to support a claim</mattext>
              </material>
            </response_label>
            <response_label ident="61654">
              <material>
                <mattext texttype="text/plain">Repeating key words to build emphasis in a message</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">69638</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="69638_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">25460</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="25460_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">61654</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="61654_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">80862</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="69638_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Emotional language describes pathos, citing experts relates to logos or ethos, and repetition is a literary device. Kairos is the rhetorical concept of recognizing when the timing is right—delivering a message when the audience is most receptive to it.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="25460_fb">
        <flow_mat>
          <material>
