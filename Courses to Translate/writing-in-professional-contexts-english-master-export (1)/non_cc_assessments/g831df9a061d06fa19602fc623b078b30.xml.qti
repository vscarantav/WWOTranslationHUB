      </resprocessing>
      <itemfeedback ident="48054_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Comparing unlike things with &lt;em&gt;like&lt;/em&gt; or &lt;em&gt;as&lt;/em&gt; describes a simile, giving human qualities to objects describes personification, and downplaying a claim describes understatement. Parallel structure repeats the same grammatical pattern across a series of words or phrases to signal that the ideas carry equal importance and to make the writing more memorable.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
