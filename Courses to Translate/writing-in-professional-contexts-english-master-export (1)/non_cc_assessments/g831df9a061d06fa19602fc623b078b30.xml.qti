    <item ident="gea3098fec96aaefe82a62fef59a99fda" title="Question 1">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>63768,74702,55232,85988</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does the term &lt;strong&gt;rhetoric&lt;/strong&gt; mean in the context of writing and communication?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="63768">
              <material>
                <mattext texttype="text/plain">The craft of using language to persuade an audience</mattext>
              </material>
            </response_label>
            <response_label ident="74702">
              <material>
                <mattext texttype="text/plain">The study of grammar and punctuation rules</mattext>
              </material>
            </response_label>
            <response_label ident="55232">
              <material>
                <mattext texttype="text/plain">The process of organizing ideas into paragraphs</mattext>
              </material>
            </response_label>
            <response_label ident="85988">
              <material>
                <mattext texttype="text/plain">The practice of summarizing information from sources</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">74702</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="74702_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">55232</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="55232_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">85988</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="85988_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">63768</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="74702_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Rhetoric is not about grammar, summarizing, or paragraph organization. It refers to the craft of using language to motivate and persuade an audience to think or act in a certain way.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="55232_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Rhetoric is not about grammar, summarizing, or paragraph organization. It refers to the craft of using language to motivate and persuade an audience to think or act in a certain way.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="85988_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Rhetoric is not about grammar, summarizing, or paragraph organization. It refers to the craft of using language to motivate and persuade an audience to think or act in a certain way.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g49a038e8ce60d89b04fc977057e9a719" title="Question 10">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>52687,18992,77190,33184</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the ad hominem logical fallacy?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="52687">
              <material>
                <mattext texttype="text/plain">Attacking the character of a person instead of addressing their argument</mattext>
              </material>
            </response_label>
            <response_label ident="18992">
              <material>
                <mattext texttype="text/plain">Claiming that one event caused another without proving a connection</mattext>
              </material>
            </response_label>
            <response_label ident="77190">
              <material>
                <mattext texttype="text/plain">Presenting only two extreme options when other choices exist</mattext>
              </material>
            </response_label>
            <response_label ident="33184">
              <material>
                <mattext texttype="text/plain">Using exaggerated claims that distort the truth of an argument</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">18992</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="18992_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">77190</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="77190_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">33184</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="33184_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">52687</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="18992_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Claiming a false cause-and-effect connection describes a causal fallacy, presenting only two options describes a false dilemma, and exaggerating claims describes hyperbole. Ad hominem is the fallacy of attacking the character or identity of the person making an argument instead of addressing the argument itself.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="77190_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Claiming a false cause-and-effect connection describes a causal fallacy, presenting only two options describes a false dilemma, and exaggerating claims describes hyperbole. Ad hominem is the fallacy of attacking the character or identity of the person making an argument instead of addressing the argument itself.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="33184_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Claiming a false cause-and-effect connection describes a causal fallacy, presenting only two options describes a false dilemma, and exaggerating claims describes hyperbole. Ad hominem is the fallacy of attacking the character or identity of the person making an argument instead of addressing the argument itself.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g40d9364525eac9fb0bbaf690ff3350ef" title="Question 11">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>27193,10610,31578,97334</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What are the three components a writer must consider before choosing a communication strategy?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="27193">
              <material>
                <mattext texttype="text/plain">Audience, purpose, and channel</mattext>
              </material>
            </response_label>
            <response_label ident="10610">
              <material>
                <mattext texttype="text/plain">Grammar, punctuation, and spelling</mattext>
              </material>
            </response_label>
            <response_label ident="31578">
              <material>
                <mattext texttype="text/plain">Length, format, and font size</mattext>
              </material>
            </response_label>
            <response_label ident="97334">
              <material>
                <mattext texttype="text/plain">Topic, title, and word count</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">10610</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="10610_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">31578</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="31578_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">97334</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="97334_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">27193</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="10610_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Grammar, formatting details, and structural elements are tools used after the communication strategy is set. Before writing, a communicator must identify the audience (who will read the message), the purpose (what the message should accomplish), and the channel (how the message will be delivered).</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="31578_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Grammar, formatting details, and structural elements are tools used after the communication strategy is set. Before writing, a communicator must identify the audience (who will read the message), the purpose (what the message should accomplish), and the channel (how the message will be delivered).</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="97334_fb">
        <flow_mat>
