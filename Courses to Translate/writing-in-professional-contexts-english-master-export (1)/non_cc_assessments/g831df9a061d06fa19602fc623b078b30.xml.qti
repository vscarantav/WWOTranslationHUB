          <mattext texttype="text/html">&lt;div&gt;Which element of a professional email states the specific topic of the message before the reader opens it?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="17646">
              <material>
                <mattext texttype="text/plain">The subject line</mattext>
              </material>
            </response_label>
            <response_label ident="81821">
