      <itemfeedback ident="45651_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Exaggerating a claim describes hyperbole, repetition of words describes the device of repetition, and comparing unlike things describes a simile or metaphor. Understatement deliberately presents something as less significant than it is, often used for ironic or distancing effect.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
