          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="46712_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">91220</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="65312_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Organizing ideas, correcting grammar, and summarizing sources are writing tasks, but they are not persuasion. Persuasion is the act of convincing someone to do something or to believe that something is true—it is the central goal of rhetoric and the foundation of the communication strategies studied in this chapter.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
