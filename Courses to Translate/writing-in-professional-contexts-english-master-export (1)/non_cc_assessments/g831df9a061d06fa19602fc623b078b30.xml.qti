      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is understatement as a literary device?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="76383">
              <material>
                <mattext texttype="text/plain">Presenting something as less important or significant than it actually is</mattext>
              </material>
            </response_label>
            <response_label ident="45651">
              <material>
                <mattext texttype="text/plain">Exaggerating a claim so dramatically that it distorts the truth</mattext>
              </material>
            </response_label>
            <response_label ident="59635">
              <material>
                <mattext texttype="text/plain">Repeating a word or phrase to draw attention to an idea</mattext>
              </material>
            </response_label>
            <response_label ident="60734">
              <material>
                <mattext texttype="text/plain">Comparing two unlike things to highlight a shared quality</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
