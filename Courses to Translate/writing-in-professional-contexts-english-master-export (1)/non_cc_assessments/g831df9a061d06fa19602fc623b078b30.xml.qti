      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is parallel structure as a literary device?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="74592">
              <material>
                <mattext texttype="text/plain">Repeating the same grammatical pattern of words to give ideas equal emphasis</mattext>
              </material>
            </response_label>
            <response_label ident="48054">
              <material>
                <mattext texttype="text/plain">Comparing two unlike things using the words "like" or "as"</mattext>
              </material>
            </response_label>
            <response_label ident="42521">
              <material>
                <mattext texttype="text/plain">Giving human qualities to a non-human object or idea</mattext>
              </material>
            </response_label>
            <response_label ident="87141">
              <material>
                <mattext texttype="text/plain">Presenting a claim as less significant than it actually is</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">48054</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="48054_fb"/>
