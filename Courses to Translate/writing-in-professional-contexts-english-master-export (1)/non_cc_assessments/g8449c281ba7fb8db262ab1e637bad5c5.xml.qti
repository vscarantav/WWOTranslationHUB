<?xml version="1.0" encoding="UTF-8"?>
<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/xsd/ims_qtiasiv1p2p1.xsd">
  <objectbank ident="g8449c281ba7fb8db262ab1e637bad5c5">
    <qtimetadata>
      <qtimetadatafield>
        <fieldlabel>bank_title</fieldlabel>
        <fieldentry>W00 Academic Integrity Part 2</fieldentry>
      </qtimetadatafield>
      <qtimetadatafield>
        <fieldlabel>bank_type</fieldlabel>
        <fieldentry>Course</fieldentry>
      </qtimetadatafield>
      <qtimetadatafield>
        <fieldlabel>bank_context_uuid</fieldlabel>
        <fieldentry>Pm3b1l08woeaShX88bZnIytohG4NMS2LDA11YkWJ</fieldentry>
      </qtimetadatafield>
      <qtimetadatafield>
        <fieldlabel>bank_state</fieldlabel>
        <fieldentry>active</fieldentry>
      </qtimetadatafield>
    </qtimetadata>
    <item ident="g97ea8c1dfc905d0a5f2b0604a161dd1a" title="Question 1">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>83547,58614,90095,72315</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student copies three sentences from a website into her personal history project. She changes two words in each sentence but does not add quotation marks or a citation. Which type of integrity violation has she committed?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="83547">
              <material>
                <mattext texttype="text/plain">Mosaic plagiarism, because she kept the original sentence structure while only replacing individual words</mattext>
              </material>
            </response_label>
            <response_label ident="58614">
              <material>
                <mattext texttype="text/plain">Direct plagiarism, because she copied the sentences without any changes</mattext>
              </material>
            </response_label>
            <response_label ident="90095">
              <material>
                <mattext texttype="text/plain">Fabrication, because she altered the original content of the source</mattext>
              </material>
            </response_label>
            <response_label ident="72315">
              <material>
                <mattext texttype="text/plain">Insufficient citation, because she used the source's ideas without crediting it</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">58614</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="58614_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">90095</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="90095_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">72315</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="72315_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">83547</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="58614_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The violation is not direct plagiarism because the student made changes, but those changes were not enough to constitute true paraphrasing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="90095_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Fabrication means creating false information, not altering a source.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="72315_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Insufficient citation occurs when a paraphrased or summarized idea lacks a citation—this student's problem is the structural imitation of the original, not just a missing citation.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g3d1885f90503a618e39c29017332918c" title="Question 10">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>10778,14767,82433,85889</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student writes a personal narrative for W05. After submitting it, he posts the completed assignment in a WhatsApp group with other WRIT 101 students, intending it only as a helpful model. Which integrity rule does this violate?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="10778">
              <material>
                <mattext texttype="text/plain">Content sharing, because distributing completed assignments to other students is a violation regardless of intent</mattext>
              </material>
            </response_label>
            <response_label ident="14767">
              <material>
                <mattext texttype="text/plain">Voice integrity, because sharing his narrative exposes his personal writing style to others</mattext>
              </material>
            </response_label>
            <response_label ident="82433">
              <material>
                <mattext texttype="text/plain">Fabrication, because other students may use his narrative to invent details in their own assignments</mattext>
              </material>
            </response_label>
            <response_label ident="85889">
              <material>
                <mattext texttype="text/plain">Self-plagiarism, because he submitted the work and then shared it for further use</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">14767</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="14767_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">82433</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="82433_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">85889</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="85889_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">10778</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="14767_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Voice integrity applies to the authenticity of writing submitted for assessment, not to sharing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="82433_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Fabrication refers to creating false information, not to the risk that others might do so.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="85889_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Self-plagiarism involves resubmitting your own previous work, not distributing it to others.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g648f45cb43b7a2c2e1a810f2a3147547" title="Question 11">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>31835,14582,52631,70023</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student is writing her W04 Family History Research Interview summary. She cannot reach her grandmother by phone, so she writes down responses she believes her grandmother would have given based on past conversations. She submits the summary as a real interview. Which violation has she committed?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="31835">
              <material>
                <mattext texttype="text/plain">Fabrication, because she invented interview content that did not actually occur</mattext>
              </material>
            </response_label>
            <response_label ident="14582">
              <material>
                <mattext texttype="text/plain">Mosaic plagiarism, because she used her grandmother's past words without proper attribution</mattext>
              </material>
            </response_label>
            <response_label ident="52631">
              <material>
                <mattext texttype="text/plain">Self-plagiarism, because she drew on previous conversations she had already documented</mattext>
              </material>
            </response_label>
            <response_label ident="70023">
              <material>
                <mattext texttype="text/plain">Cheating, because she completed the assignment without following the required interview process</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">14582</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="14582_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">52631</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="52631_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">70023</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="70023_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">31835</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="14582_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Mosaic plagiarism involves imitating a written source's structure, not reconstructing spoken conversations.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="52631_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Self-plagiarism involves resubmitting previously submitted academic work, not drawing on memory.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="70023_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Cheating involves unauthorized assistance or methods, not the invention of false content.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ga7f43c344e53169696cfccf668c811ad" title="Question 12">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>69815,31401,5999,25228</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student applies the Explainability Test after using AI to help with her assignment. She realizes she cannot explain the rhetorical choices in her draft or reproduce them on her own. What does this result tell her?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="69815">
              <material>
                <mattext texttype="text/plain">AI completed the task for her, which means the assignment did not build the skills it was designed to develop.</mattext>
              </material>
            </response_label>
            <response_label ident="31401">
              <material>
                <mattext texttype="text/plain">She needs more practice with the assignment topic before submitting her work.</mattext>
              </material>
            </response_label>
            <response_label ident="5999">
              <material>
                <mattext texttype="text/plain">She should ask her instructor to clarify the assignment requirements before resubmitting.</mattext>
              </material>
            </response_label>
            <response_label ident="25228">
              <material>
                <mattext texttype="text/plain">She used AI appropriately but needs to review her draft more carefully before submitting.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">31401</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="31401_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5999</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5999_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">25228</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="25228_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">69815</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="31401_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Needing more practice or instructor clarification are separate issues not indicated by the test result.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5999_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Needing more practice or instructor clarification are separate issues not indicated by the test result.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="25228_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The test result does not indicate appropriate AI use—it signals the opposite.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g2f60425084098caefd056224aa03acb0" title="Question 13">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>99189,85389,93101,93691</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;A student writes the following AI disclosure statement at the top of his assignment: "Claude was used to identify grammar errors. All ideas, content, and rhetorical choices are my own." He used AI only to check for grammar errors and made all corrections himself. Which principle does his statement fulfill?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="99189">
              <material>
                <mattext texttype="text/plain">Transparency, because he named the AI tool and described its specific function accurately</mattext>
              </material>
            </response_label>
            <response_label ident="85389">
              <material>
                <mattext texttype="text/plain">Competence, because he demonstrated the ability to use AI as a learning tool</mattext>
              </material>
            </response_label>
            <response_label ident="93101">
              <material>
                <mattext texttype="text/plain">Agency, because he made all final decisions about which corrections to accept</mattext>
              </material>
            </response_label>
            <response_label ident="93691">
              <material>
                <mattext texttype="text/plain">Privacy, because he did not include any personal information in his AI prompt</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">85389</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="85389_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">93101</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="93101_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">93691</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="93691_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">99189</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="85389_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Competence relates to building skills through effort, not to disclosure.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="93101_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Agency relates to preserving the student's decision-making role, which is a separate principle.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="93691_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Privacy relates to protecting sensitive personal information entered into AI tools, which is unrelated to the disclosure statement.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gc7c8606f58da9514c6ee6d2ae271c029" title="Question 14">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>46131,46368,73401,66944</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;A student wants to write about a business practice common in her home country. She knows this practice well from personal experience but cannot find a published source that documents it. What is the most appropriate next step according to the module?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="46131">
              <material>
                <mattext texttype="text/plain">Ask her instructor whether her personal knowledge requires a citation before submitting</mattext>
              </material>
            </response_label>
            <response_label ident="46368">
              <material>
                <mattext texttype="text/plain">Omit the information entirely because it cannot be supported with a published source</mattext>
              </material>
            </response_label>
            <response_label ident="73401">
              <material>
                <mattext texttype="text/plain">Submit the information without a citation and explain the cultural context in a footnote</mattext>
              </material>
            </response_label>
            <response_label ident="66944">
              <material>
                <mattext texttype="text/plain">Search for any published source on a related topic and cite it in place of her personal knowledge</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">46368</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="46368_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">73401</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="73401_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">66944</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="66944_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">46131</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="46368_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Omitting the information discards potentially valuable and authentic content.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="73401_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Submitting without a citation and adding a footnote does not resolve the citation question and is not the guidance the module gives.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="66944_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Substituting an unrelated published source misrepresents the actual basis for the claim and does not honor the student's genuine knowledge.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ge4833d65654d2595fe4aa1de62d3a9ce" title="Question 15">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>87824,72099,17732,38271</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student receives his graded W03 assignment back with instructor feedback. Before starting W04, he reads through all of the feedback carefully and uses it to plan his next draft. He does not share the feedback with any classmates. Which integrity principle does this behavior reflect?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="87824">
              <material>
                <mattext texttype="text/plain">This behavior does not raise any integrity concerns — reviewing personal instructor feedback is an appropriate academic practice</mattext>
              </material>
            </response_label>
            <response_label ident="72099">
              <material>
                <mattext texttype="text/plain">Competence, because the student is using feedback to develop his writing skills independently</mattext>
              </material>
            </response_label>
            <response_label ident="17732">
              <material>
                <mattext texttype="text/plain">Transparency, because the student is openly acknowledging the weaknesses in his previous work</mattext>
              </material>
            </response_label>
            <response_label ident="38271">
              <material>
                <mattext texttype="text/plain">Agency, because the student is making his own decisions about how to apply the feedback</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">72099</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="72099_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">17732</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="17732_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">38271</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="38271_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">87824</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="72099_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;While the behavior does support competence development, the question asks which principle the behavior reflects in terms of integrity—and the correct answer is that no integrity issue is present.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="17732_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Transparency and agency are integrity principles tied to AI use and decision-making, not to reviewing personal feedback.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="38271_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Transparency and agency are integrity principles tied to AI use and decision-making, not to reviewing personal feedback.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ga7e6166c89c4c2fb2f247a69221c6357" title="Question 16">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>88180,93837,81529,5037</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;A student asks AI the following question: "What details should I include in my personal narrative to make it more engaging?" She then builds her narrative around AI's suggestions. Which principle does this violate?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="88180">
              <material>
                <mattext texttype="text/plain">Agency, because she allowed AI to make rhetorical decisions that belonged to her</mattext>
              </material>
            </response_label>
            <response_label ident="93837">
              <material>
                <mattext texttype="text/plain">Transparency, because she did not disclose that AI suggested the narrative details</mattext>
              </material>
            </response_label>
            <response_label ident="81529">
              <material>
                <mattext texttype="text/plain">Privacy, because she may have shared personal story details with an AI tool</mattext>
              </material>
            </response_label>
            <response_label ident="5037">
              <material>
                <mattext texttype="text/plain">Competence, because she should have researched narrative techniques before writing</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">93837</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="93837_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">81529</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="81529_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5037</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5037_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">88180</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="93837_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Transparency is a secondary concern, but the primary violation is the surrender of decision-making.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="81529_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Privacy is relevant when sensitive identifying information is entered into AI, not when story concepts are discussed.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5037_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Competence relates to skill development through effort, not to research habits.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ge2b2aec6dbe51d7d725fc595b54c591c" title="Question 17">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>93136,13074,56207,25528</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student copies a paragraph from a published essay into her assignment and places it inside quotation marks with a full citation. She uses three more quoted paragraphs from the same source in the same assignment. Her instructor flags the submission for an integrity issue. What is the most likely concern?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="93136">
              <material>
                <mattext texttype="text/plain">Overuse of direct quotation, which suggests the student is avoiding the harder work of understanding and restating the material</mattext>
              </material>
            </response_label>
            <response_label ident="13074">
              <material>
                <mattext texttype="text/plain">Mosaic plagiarism, because the student altered some words within the quoted paragraphs</mattext>
              </material>
            </response_label>
            <response_label ident="56207">
              <material>
                <mattext texttype="text/plain">Fabrication, because the student may have modified the source content inside the quotation marks</mattext>
              </material>
            </response_label>
            <response_label ident="25528">
              <material>
                <mattext texttype="text/plain">Insufficient citation, because multiple quotations from one source require separate reference list entries</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">13074</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="13074_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">56207</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="56207_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">25528</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="25528_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">93136</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="13074_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Mosaic plagiarism involves changing words while keeping structure—this student used exact quotations.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="56207_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Fabrication involves creating false information.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="25528_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Multiple quotations from one source do not require separate reference entries—one reference list entry covers all citations from that source.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g908f4dee95b8b8a8085ed2183e434a7c" title="Question 18">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>10037,49311,9615,9597</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;A student completes his personal narrative entirely on his own. Before submitting, he asks his older sister, who is an experienced writer, to rewrite two paragraphs she thinks are weak. He submits the assignment with his sister's rewritten paragraphs included. Which violation has he committed?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="10037">
              <material>
                <mattext texttype="text/plain">Cheating, because he allowed someone else to substantially revise his work</mattext>
              </material>
            </response_label>
            <response_label ident="49311">
              <material>
                <mattext texttype="text/plain">Self-plagiarism, because the rewritten paragraphs are no longer entirely his own original writing</mattext>
              </material>
            </response_label>
            <response_label ident="9615">
              <material>
                <mattext texttype="text/plain">Fabrication, because the rewritten paragraphs may not accurately reflect his personal experience</mattext>
              </material>
            </response_label>
            <response_label ident="9597">
              <material>
                <mattext texttype="text/plain">Voice integrity violation only, because the rewritten paragraphs no longer reflect his authentic voice</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">49311</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="49311_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9615</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9615_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9597</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9597_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">10037</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="49311_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Self-plagiarism involves resubmitting previously submitted work.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9615_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Fabrication involves creating false content.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9597_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Voice integrity is affected, but the primary and more serious violation is cheating, not a voice concern alone.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g4c31de324a6f2ba6dda4d7cf5f84d6ee" title="Question 19">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>91441,89318,57955,49816</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student generates a list of five APA references using AI for her assignment. She includes them in her reference list without checking whether the sources exist. Her instructor finds that two of the references do not correspond to any real publication. Which violation has occurred?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="91441">
              <material>
                <mattext texttype="text/plain">Fabrication, because she submitted false citations she had not verified</mattext>
              </material>
            </response_label>
            <response_label ident="89318">
              <material>
                <mattext texttype="text/plain">Mosaic plagiarism, because she used AI-generated text in her reference list</mattext>
              </material>
            </response_label>
            <response_label ident="57955">
              <material>
                <mattext texttype="text/plain">Cheating, because she used unauthorized AI assistance to complete a required part of her assignment</mattext>
              </material>
            </response_label>
            <response_label ident="49816">
              <material>
                <mattext texttype="text/plain">Insufficient citation, because the fabricated references do not correctly credit the original sources</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">89318</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="89318_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">57955</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="57955_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">49816</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="49816_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">91441</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="89318_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Mosaic plagiarism involves imitating sentence structure, not generating reference lists.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="57955_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">While AI use policies are relevant, the specific violation named in the module for false citations is fabrication.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="49816_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Insufficient citation means using a real idea without crediting it—not submitting a nonexistent source.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g0a5d472c3435b34623b04500a6632b46" title="Question 2">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>75771,33150,25564,38289</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student finishes his W05 personal narrative draft. He then types his draft into an AI tool and asks, "Which sentences are unclear?" He revises the unclear sentences himself without accepting any AI-suggested rewrites. Which principle does this approach follow?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="75771">
              <material>
                <mattext texttype="text/plain">It follows the feedback prompt principle, because the student asked AI to identify problems and made all revisions himself</mattext>
              </material>
            </response_label>
            <response_label ident="33150">
              <material>
                <mattext texttype="text/plain">It violates the transparency principle, because the student used AI without disclosing it in a statement at the top of the assignment</mattext>
              </material>
            </response_label>
            <response_label ident="25564">
              <material>
                <mattext texttype="text/plain">It violates the competence principle, because the student should have identified unclear sentences without AI assistance</mattext>
              </material>
            </response_label>
            <response_label ident="38289">
              <material>
                <mattext texttype="text/plain">It follows the product task principle, because the student used AI to produce a clean, usable result</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">33150</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="33150_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">25564</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="25564_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">38289</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="38289_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">75771</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="33150_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The transparency principle requires disclosure, which the student should include in the submission statement, but the approach itself is not a violation.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="25564_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The competence principle is not violated by asking AI to identify weaknesses after completing a draft.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="38289_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">This is a process task, not a product task, because the goal is skill development through writing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g6ce0692ab20ffb1fcef892843ad9a3ce" title="Question 20">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>77873,9909,85413,38228</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student wrote a personal narrative two years ago for a creative writing class at another institution. She believes it is her best work. She submits it for her W05 WRIT 101 assignment without telling her instructor. Which violation has she committed?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="77873">
              <material>
                <mattext texttype="text/plain">Self-plagiarism, because she submitted previously completed work without instructor permission</mattext>
              </material>
            </response_label>
            <response_label ident="9909">
              <material>
                <mattext texttype="text/plain">Direct plagiarism, because the narrative was written under different course conditions</mattext>
              </material>
            </response_label>
            <response_label ident="85413">
              <material>
                <mattext texttype="text/plain">Fabrication, because the narrative was not written in response to the current assignment</mattext>
              </material>
            </response_label>
            <response_label ident="38228">
              <material>
                <mattext texttype="text/plain">Cheating, because she used work completed outside of the WRIT 101 course structure</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9909</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9909_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">85413</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="85413_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">38228</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="38228_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">77873</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="9909_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Direct plagiarism involves presenting someone else's work as your own—this student's work is genuinely hers.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="85413_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Fabrication means creating false information, not reusing authentic previous writing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="38228_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Cheating involves unauthorized assistance or methods during completion of an assignment, not resubmission of prior work.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g1bfb25c04758079a2206e01abe348342" title="Question 21">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>86235,55249,99906,35599</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student reads a scholar's argument about the role of storytelling in his culture. He writes a paraphrase of the argument in his own words and sentence structure, then adds an in-text citation. He does not include the source in his reference list. Has he fulfilled his citation responsibilities?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="86235">
              <material>
                <mattext texttype="text/plain">No, because both an in-text citation and a reference list entry are required to fully credit a source</mattext>
              </material>
            </response_label>
            <response_label ident="55249">
              <material>
                <mattext texttype="text/plain">Yes, because restating the idea in his own words with an in-text citation is sufficient</mattext>
              </material>
            </response_label>
            <response_label ident="99906">
              <material>
                <mattext texttype="text/plain">No, because paraphrased ideas require a direct quotation alongside the paraphrase</mattext>
              </material>
            </response_label>
            <response_label ident="35599">
              <material>
                <mattext texttype="text/plain">Yes, because the reference list is only required for direct quotations, not paraphrases</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">55249</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="55249_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">99906</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="99906_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">35599</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="35599_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">86235</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="55249_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">An in-text citation alone does not fulfill the full citation requirement.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="99906_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Paraphrased ideas do not require an accompanying direct quotation—paraphrase with a citation is a complete and accepted method.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="35599_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The reference list is required for all sources used, including those that are summarized or paraphrased, not only those that are directly quoted.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g2005f95570d3c75f25f8a666d9d362e0" title="Question 22">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>29311,57638,46147,25519</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student is writing her spiritual reflection for the Week 7 Invitation Reflection assignment. She asks AI to write a paragraph describing what she learned spiritually during the course. She edits the paragraph slightly and submits it. What does the module say is the specific harm of this action beyond the integrity violation?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="29311">
              <material>
                <mattext texttype="text/plain">It robs her of the genuine encounter with God the assignment is designed to create.</mattext>
              </material>
            </response_label>
            <response_label ident="57638">
              <material>
                <mattext texttype="text/plain">It produces a reflection that lacks the academic vocabulary her instructor expects.</mattext>
              </material>
            </response_label>
            <response_label ident="46147">
              <material>
                <mattext texttype="text/plain">It prevents her from meeting the word count requirement with her own ideas.</mattext>
              </material>
            </response_label>
            <response_label ident="25519">
              <material>
                <mattext texttype="text/plain">It creates a mismatch between her reflection and the earlier assignments her instructor has read.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">57638</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="57638_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">46147</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="46147_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">25519</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="25519_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">29311</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="57638_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The harm the module identifies is spiritual, not academic in terms of vocabulary, word count, or consistency with earlier work.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="46147_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The harm the module identifies is spiritual, not academic in terms of vocabulary, word count, or consistency with earlier work.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="25519_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The harm the module identifies is spiritual, not academic in terms of vocabulary, word count, or consistency with earlier work.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ge66951258f37de9b833ca79b7a3f6f18" title="Question 23">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>90243,22833,12924,72422</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student asks AI the following: "Rewrite this sentence to be clearer." AI returns a cleaner version. The student copies it directly into his draft. Before submitting, he adds the disclosure statement: "Claude was used to rewrite one sentence for clarity. All ideas and content are my own." Has the disclosure statement resolved the integrity concern?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="90243">
              <material>
                <mattext texttype="text/plain">No, because asking AI to rewrite content is an edit request that transfers the work to AI, which the disclosure statement does not correct</mattext>
              </material>
            </response_label>
            <response_label ident="22833">
              <material>
                <mattext texttype="text/plain">Yes, because the disclosure statement transparently identifies exactly how AI was used</mattext>
              </material>
            </response_label>
            <response_label ident="12924">
              <material>
                <mattext texttype="text/plain">Yes, because one rewritten sentence is too minor a change to constitute a violation</mattext>
              </material>
            </response_label>
            <response_label ident="72422">
              <material>
                <mattext texttype="text/plain">No, because the disclosure statement should have been submitted to the instructor before using AI</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">22833</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="22833_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">12924</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="12924_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">72422</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="72422_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">90243</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="22833_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Disclosing the use does not change the fact that AI made a writing decision that belonged to the student.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="12924_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;There is no threshold at which a rewrite becomes too minor to matter—the principle applies regardless of length.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="72422_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Disclosure statements are submitted with the assignment, not before AI is used.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g825a60a0465146c60aa7f13b7272ef6e" title="Question 24">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>80801,65347,69522,67877</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student is preparing her W04 Family History Research Interview. She plans to enter her grandmother's full name, birth date, and immigration history into an AI tool to help her draft interview questions. What should she do instead?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="80801">
              <material>
                <mattext texttype="text/plain">Use initials or "family member" in the AI prompt instead of entering identifying personal information</mattext>
              </material>
            </response_label>
            <response_label ident="65347">
              <material>
                <mattext texttype="text/plain">Ask her instructor for permission before entering any family information into AI</mattext>
              </material>
            </response_label>
            <response_label ident="69522">
              <material>
                <mattext texttype="text/plain">Use a different AI tool that has stronger privacy protections for personal data</mattext>
              </material>
            </response_label>
            <response_label ident="67877">
              <material>
                <mattext texttype="text/plain">Complete the interview questions without using AI to protect her grandmother's information</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">65347</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="65347_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">69522</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="69522_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">67877</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="67877_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">80801</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="65347_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The module does not require instructor permission specifically for AI prompts involving family members—the guidance is to replace identifying details.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="69522_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Seeking a more private AI tool is not the module's recommended solution.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="67877_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Avoiding AI entirely is one option, but the module provides a specific approved method that allows AI use while protecting privacy.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g96ebb0510f77db6ae893ebd1aeb504e8" title="Question 25">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>92306,96596,19272,49301</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student reads the following sentence in a published article: "Narrative writing transforms lived experience into shared meaning through deliberate craft." He writes this in his draft: "Through careful craft, narrative writing turns lived experience into meaning that can be shared." He adds a citation. Which integrity issue is present?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="92306">
              <material>
                <mattext texttype="text/plain">Mosaic plagiarism, because he kept the core structure and ideas of the original sentence while only rearranging the words</mattext>
              </material>
            </response_label>
            <response_label ident="96596">
              <material>
                <mattext texttype="text/plain">No issue, because he changed the word order and added a citation</mattext>
              </material>
            </response_label>
            <response_label ident="19272">
              <material>
                <mattext texttype="text/plain">Insufficient citation, because he should have used a direct quotation instead of paraphrasing</mattext>
              </material>
            </response_label>
            <response_label ident="49301">
              <material>
                <mattext texttype="text/plain">Direct plagiarism, because the meaning of the sentence is identical to the original</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">96596</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="96596_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">19272</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="19272_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">49301</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="49301_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">92306</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="96596_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;There is no rule requiring a direct quotation in place of a paraphrase—paraphrasing is an accepted method when done correctly.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="19272_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;There is no rule requiring a direct quotation in place of a paraphrase—paraphrasing is an accepted method when done correctly.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="49301_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Direct plagiarism involves copying exact words without quotation marks, which is not what occurred here.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gb58feefabbd55fe2afb22ac162fa7945" title="Question 26">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>35620,68261,43852,15144</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student completes his draft for W03. He then asks AI: "Which paragraphs in my draft could be clearer? Point them out without rewriting them." AI identifies two paragraphs and explains why they are unclear. The student rewrites both paragraphs himself. What type of AI use has the student demonstrated?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="35620">
              <material>
                <mattext texttype="text/plain">An approved feedback prompt, because he asked AI to identify problems and made all revisions himself</mattext>
              </material>
            </response_label>
            <response_label ident="68261">
              <material>
                <mattext texttype="text/plain">An inappropriate edit request, because he asked AI to evaluate the quality of his writing</mattext>
              </material>
            </response_label>
            <response_label ident="43852">
              <material>
                <mattext texttype="text/plain">A transparency violation, because he did not include a disclosure statement before using AI</mattext>
              </material>
            </response_label>
            <response_label ident="15144">
              <material>
                <mattext texttype="text/plain">A competence violation, because he should have identified the unclear paragraphs without AI assistance</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">68261</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="68261_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">43852</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="43852_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">15144</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="15144_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">35620</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="68261_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Asking AI to evaluate writing is not inherently inappropriate—the distinction is between identifying problems and fixing them.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="43852_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The disclosure statement concern is separate from whether the AI use was appropriate; the student should include a statement at submission.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="15144_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Using AI to identify weaknesses after completing a draft does not violate the competence principle.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g1be2227b313a62f9f49895a8f24ee7ee" title="Question 27">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>19749,72430,56567,55848</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student receives this response after asking AI to check her paraphrase: "Here is a clearer version of your paraphrase: [rewritten sentence]." What should she do?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="19749">
              <material>
                <mattext texttype="text/plain">Disregard the rewritten sentence and use only AI's explanation of what was unclear to revise it herself</mattext>
              </material>
            </response_label>
            <response_label ident="72430">
              <material>
                <mattext texttype="text/plain">Accept the rewritten sentence because AI was responding to a feedback prompt, not an edit request</mattext>
              </material>
            </response_label>
            <response_label ident="56567">
              <material>
                <mattext texttype="text/plain">Accept the rewritten sentence because it is clearer than her original version</mattext>
              </material>
            </response_label>
            <response_label ident="55848">
              <material>
                <mattext texttype="text/plain">Ask AI to rewrite the sentence one more time before deciding whether to accept it</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">72430</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="72430_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">56567</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="56567_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">55848</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="55848_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">19749</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="72430_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Returning a rewrite does not transform the interaction into an approved edit request—the student's prompt was appropriate, but she must still reject the unsolicited rewrite.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="56567_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Accepting a clearer version still transfers the writing decision to AI.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="55848_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Asking AI to rewrite again compounds the problem rather than resolving it.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gc474b6d63b444c601bb0b351ea985aa6" title="Question 28">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>41433,70312,24926,21531</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student asks AI to explain what showing vs. telling means in narrative writing. AI gives a clear explanation with examples. The student reads the explanation and then applies the technique in her own draft without copying any of AI's examples. Which category does this AI use fall into?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="41433">
              <material>
                <mattext texttype="text/plain">Appropriate use, because she asked AI to explain a concept and applied it independently</mattext>
              </material>
            </response_label>
            <response_label ident="70312">
              <material>
                <mattext texttype="text/plain">Inappropriate use, because narrative techniques must be learned through instructor guidance only</mattext>
              </material>
            </response_label>
            <response_label ident="24926">
              <material>
                <mattext texttype="text/plain">Inappropriate use, because she used AI before attempting the technique on her own first</mattext>
              </material>
            </response_label>
            <response_label ident="21531">
              <material>
                <mattext texttype="text/plain">Appropriate use only if she includes AI's examples in her draft to demonstrate understanding</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">70312</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="70312_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">24926</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="24926_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">21531</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="21531_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">41433</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="70312_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Narrative techniques are not restricted to instructor-only guidance.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="24926_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">There is no requirement in the module that students attempt a technique independently before asking AI for an explanation.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="21531_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Including AI's examples in the draft would create a different integrity concern, not satisfy one.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gcc6fe466761188ad52183f2a85f316ed" title="Question 29">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>45548,47374,80029,81677</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student finishes a draft and applies the Explainability Test. He confirms he can explain every sentence and could reproduce the work independently. He submits the assignment with the disclosure statement: "Claude was used to identify grammar errors. All ideas, content, and rhetorical choices are my own." Which two principles has he fulfilled?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="45548">
              <material>
                <mattext texttype="text/plain">Competence and transparency, because he can demonstrate independent mastery and he disclosed AI use accurately</mattext>
              </material>
            </response_label>
            <response_label ident="47374">
              <material>
                <mattext texttype="text/plain">Agency and privacy, because he made his own decisions and did not share sensitive information with AI</mattext>
              </material>
            </response_label>
            <response_label ident="80029">
              <material>
                <mattext texttype="text/plain">Transparency and fabrication prevention, because he disclosed AI use and verified all sources</mattext>
              </material>
            </response_label>
            <response_label ident="81677">
              <material>
                <mattext texttype="text/plain">Competence and agency, because he completed the work independently and retained all decision-making</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">47374</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="47374_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">80029</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="80029_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">81677</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="81677_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">45548</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="47374_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Agency and privacy are not the principles most directly demonstrated by these two specific actions.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="80029_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Fabrication prevention relates to verifying sources and citations, not to the Explainability Test or disclosure statements.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="81677_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Competence and agency overlap in this scenario, but transparency—not agency—is the principle fulfilled by the disclosure statement.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gb71a90af20a9cb4cbf7aec64348c25f3" title="Question 3">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>53386,98357,88887,77403</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student paraphrases a scholar's argument about storytelling in her own words. She includes the paraphrase in her essay but does not add an in-text citation because she believes restating the idea in her own words means she no longer needs to credit the source. What has she misunderstood?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="53386">
              <material>
                <mattext texttype="text/plain">The idea belongs to its originator regardless of how it is expressed, so a citation is still required</mattext>
              </material>
            </response_label>
            <response_label ident="98357">
              <material>
                <mattext texttype="text/plain">Paraphrasing without a citation is only necessary if the passage is longer than one paragraph</mattext>
              </material>
            </response_label>
            <response_label ident="88887">
              <material>
                <mattext texttype="text/plain">A citation is only required when using an author's exact words inside quotation marks</mattext>
              </material>
            </response_label>
            <response_label ident="77403">
              <material>
                <mattext texttype="text/plain">Restating an idea in your own words transfers ownership of the idea to the student</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">98357</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="98357_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">88887</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="88887_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">77403</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="77403_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">53386</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="98357_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">There is no length threshold that determines whether a citation is needed.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="88887_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Citations are not limited to direct quotations.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="77403_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Restating an idea in your own words does not transfer intellectual ownership—it only changes the form of expression.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g927f5b61e4d40c715769c4d2f8d46acf" title="Question 30">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>12947,61812,19758,70948</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student struggling with English fluency asks AI: "Rewrite my paragraph so it sounds more natural in English." AI returns a fully rewritten paragraph. The student submits it. Which guidance from the module did she fail to follow?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="12947">
              <material>
                <mattext texttype="text/plain">The approved prompt for multilingual students asks AI to help express a specific idea more clearly while keeping the student's original meaning and personal voice—not to rewrite entire paragraphs.</mattext>
              </material>
            </response_label>
            <response_label ident="61812">
              <material>
                <mattext texttype="text/plain">Multilingual students are not permitted to use AI for language assistance under any circumstances.</mattext>
              </material>
            </response_label>
            <response_label ident="19758">
              <material>
                <mattext texttype="text/plain">The student should have asked her instructor to rewrite the paragraph instead of using AI.</mattext>
              </material>
            </response_label>
            <response_label ident="70948">
              <material>
                <mattext texttype="text/plain">The student needed to apply the Explainability Test before asking AI for language help.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">61812</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="61812_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">19758</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="19758_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">70948</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="70948_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">12947</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="61812_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Multilingual students are permitted to use AI for language help within the approved boundaries.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="19758_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The instructor is not the prescribed alternative for language assistance.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="70948_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The Explainability Test applies after AI use, not before deciding which prompt to use.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gfe1c3b8f5775477ff2729abee1d6c4fe" title="Question 31">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>58231,7201,19297,24587</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student pays a classmate twenty dollars to write his W03 personal narrative. He submits the narrative as his own work. Which violation has he committed?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="58231">
              <material>
                <mattext texttype="text/plain">Contract cheating, because he paid someone else to complete his assignment</mattext>
              </material>
            </response_label>
            <response_label ident="7201">
              <material>
                <mattext texttype="text/plain">Content sharing, because another student's writing was used in his submission</mattext>
              </material>
            </response_label>
            <response_label ident="19297">
              <material>
                <mattext texttype="text/plain">Fabrication, because the narrative does not reflect his actual personal experiences</mattext>
              </material>
            </response_label>
            <response_label ident="24587">
              <material>
                <mattext texttype="text/plain">Voice integrity violation, because the submitted narrative does not reflect his authentic voice</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7201</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7201_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">19297</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="19297_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">24587</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="24587_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">58231</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="7201_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Content sharing involves distributing or obtaining completed assignments, not commissioning new work for payment.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="19297_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Fabrication means creating false information such as invented events or false citations—having someone write about the student's real experiences is a different violation.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="24587_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Voice integrity is affected, but it describes a characteristic of the submission, not the act of paying for work. The primary and most precise violation is contract cheating.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g63d9e793d95b74b177d3865396b724ac" title="Question 32">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>38804,25817,89655,4053</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student finds a statistic in an AI-generated response and includes it in her personal history project without verifying whether the statistic comes from a real source. Her instructor finds the statistic does not exist in any published research. Which principle from the module applies most directly?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="38804">
              <material>
                <mattext texttype="text/plain">Every fact in a submission is the student's responsibility to verify, and submitting unverified AI-generated facts is fabrication.</mattext>
              </material>
            </response_label>
            <response_label ident="25817">
              <material>
                <mattext texttype="text/plain">The student violated the transparency principle by not disclosing that AI provided the statistic.</mattext>
              </material>
            </response_label>
            <response_label ident="89655">
              <material>
                <mattext texttype="text/plain">The student committed mosaic plagiarism by incorporating AI-generated content into her own writing.</mattext>
              </material>
            </response_label>
            <response_label ident="4053">
              <material>
                <mattext texttype="text/plain">The student violated the agency principle by allowing AI to select supporting evidence for her argument.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">25817</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="25817_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">89655</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="89655_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4053</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4053_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">38804</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="25817_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Transparency is a separate concern and would require a disclosure statement, but the act of submitting a false statistic is fabrication regardless of disclosure.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="89655_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Mosaic plagiarism involves imitating sentence structure from a real source.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4053_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Agency relates to decision-making authority, not to fact verification.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g78a98447daf8b844d0e5a10084a0b0e8" title="Question 33">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>82566,78771,67425,53325</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student emails his completed W05 narrative to a friend who is about to take WRIT 101 next term, telling her she can use it as a reference. His friend uses it to model the structure and length of her own narrative but does not copy any sentences. Which statement best describes the integrity situation?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="82566">
              <material>
                <mattext texttype="text/plain">Both students have committed a content sharing violation—the student who shared and the student who obtained the work are equally responsible.</mattext>
              </material>
            </response_label>
            <response_label ident="78771">
              <material>
                <mattext texttype="text/plain">Only the student who shared the work has committed a violation, because his friend did not copy any text.</mattext>
              </material>
            </response_label>
            <response_label ident="67425">
              <material>
                <mattext texttype="text/plain">No violation occurred, because the friend used the narrative only as a structural model without copying.</mattext>
              </material>
            </response_label>
            <response_label ident="53325">
              <material>
                <mattext texttype="text/plain">Only the friend has committed a violation, because she used another student's submitted work to guide her own.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">78771</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="78771_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">67425</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="67425_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">53325</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="53325_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">82566</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="78771_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The violation is not limited to the person who shared.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="67425_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Using work as a structural model without copying text does not exempt the receiver from responsibility.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="53325_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The violation is not limited to the person who shared.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g7ec714d3734942a4b2d811ac9c4ced25" title="Question 34">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>44427,35927,94171,71667</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student writes the following in her assignment: "Research shows that personal narratives improve emotional resilience." She does not include a citation because she believes this is common knowledge. Her instructor flags it as an integrity issue. Why is the instructor correct?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="44427">
              <material>
                <mattext texttype="text/plain">A specific research-based claim requires a citation because it refers to a finding that belongs to its originator, not common knowledge.</mattext>
              </material>
            </response_label>
            <response_label ident="35927">
              <material>
                <mattext texttype="text/plain">The instructor is incorrect because widely accepted research findings do not require citations in personal writing courses.</mattext>
              </material>
            </response_label>
            <response_label ident="94171">
              <material>
                <mattext texttype="text/plain">The statement requires a citation only if the student can identify the specific study it came from.</mattext>
              </material>
            </response_label>
            <response_label ident="71667">
              <material>
                <mattext texttype="text/plain">The statement is acceptable without a citation because it is used to support the student's own argument, not as a standalone claim.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">35927</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="35927_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">94171</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="94171_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">71667</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="71667_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">44427</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="35927_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The instructor is incorrect because widely accepted research findings do not require citations in personal writing courses.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="94171_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The citation requirement is not contingent on whether the student can identify the exact study—if the source is unknown, the claim should not be presented as research-based.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="71667_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The purpose of the claim within the argument does not remove the citation requirement.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g59ac55bf7b38f28a8d58037fe9977ae8" title="Question 35">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>36961,44755,5915,24844</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student asks AI to review his draft and AI returns the following: "Here are three sentences that could be clearer: [lists sentences]. Here are revised versions of each: [rewrites all three]." The student uses the revised versions in his final submission. Which part of this interaction crossed the line from appropriate to inappropriate?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="36961">
              <material>
                <mattext texttype="text/plain">Accepting and submitting AI's rewritten sentences, because the student must make all revisions himself even when AI provides unsolicited rewrites</mattext>
              </material>
            </response_label>
            <response_label ident="44755">
              <material>
                <mattext texttype="text/plain">Asking AI to identify unclear sentences, because evaluation requests are not permitted under the feedback prompt guidelines</mattext>
              </material>
            </response_label>
            <response_label ident="5915">
              <material>
                <mattext texttype="text/plain">Using more than one AI suggestion in a single session, because multiple revisions from one AI interaction exceed permitted use</mattext>
              </material>
            </response_label>
            <response_label ident="24844">
              <material>
                <mattext texttype="text/plain">Submitting the draft without first applying the Explainability Test to the AI-revised sentences</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">44755</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="44755_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5915</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5915_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">24844</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="24844_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">36961</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="44755_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Asking AI to identify unclear sentences is an approved feedback prompt.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5915_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">There is no rule limiting the number of AI suggestions in a single session.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="24844_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The Explainability Test is relevant, but the more direct violation is accepting AI rewrites rather than using the identified problems to revise independently.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gd4340efda15adf172014966b5ec22d05" title="Question 36">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>34894,43278,29617,78104</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student reads the course module and decides that because she is under significant time pressure, she will ask AI to draft her W03 assignment and then heavily edit it to make it her own. She reasons that the final version will reflect her ideas. Which principle does the module apply to this reasoning?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="34894">
              <material>
                <mattext texttype="text/plain">Time pressure does not change course policy—asking AI to draft an assignment is inappropriate regardless of circumstance.</mattext>
              </material>
            </response_label>
            <response_label ident="43278">
              <material>
                <mattext texttype="text/plain">Heavy editing of an AI draft is an approved method as long as the student applies the Explainability Test afterward.</mattext>
              </material>
            </response_label>
            <response_label ident="29617">
              <material>
                <mattext texttype="text/plain">Time pressure is a recognized exception that permits AI drafting when the student substantially revises the output.</mattext>
              </material>
            </response_label>
            <response_label ident="78104">
              <material>
                <mattext texttype="text/plain">The student must disclose AI drafting in her statement, which makes the approach permissible.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">43278</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="43278_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">29617</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="29617_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">78104</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="78104_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">34894</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="43278_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Heavy editing of an AI draft does not restore what was lost.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="29617_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Time pressure is a recognized exception that permits AI drafting when the student substantially revises the output</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="78104_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The Explainability Test and disclosure statements do not make AI drafting permissible—they are tools for appropriate AI use, not remedies for inappropriate use.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g85c7c61552745649c70becf0bb6dbcc5" title="Question 37">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>56504,14120,42988,6684</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student completes his personal narrative and asks his roommate to read it and tell him which parts are confusing. His roommate points out two unclear passages. The student rewrites those passages himself and submits the assignment. Which statement best describes this situation?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="56504">
              <material>
                <mattext texttype="text/plain">This is appropriate collaboration—receiving feedback from another person is permitted as long as the student makes all revisions himself</mattext>
              </material>
            </response_label>
            <response_label ident="14120">
              <material>
                <mattext texttype="text/plain">This is a cheating violation, because the roommate identified problems that the student should have found independently</mattext>
              </material>
            </response_label>
            <response_label ident="42988">
              <material>
                <mattext texttype="text/plain">This is a content sharing violation, because the student shared his draft with another person before submission</mattext>
              </material>
            </response_label>
            <response_label ident="6684">
              <material>
                <mattext texttype="text/plain">This is a voice integrity concern, because the roommate's perspective may have influenced the student's writing choices</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">14120</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="14120_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">42988</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="42988_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6684</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6684_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">56504</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="14120_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Having a reader identify problems does not constitute cheating; the student is expected to develop writing through feedback.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="42988_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Sharing a draft for feedback is not a content sharing violation—content sharing applies to distributing completed assignments for others to copy or model.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6684_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">A reader's perspective identifying confusion does not compromise voice integrity.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="geb5398d4c6f6118c315e35c385d2e2a5" title="Question 38">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>96485,68045,13033,75135</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;A student uses AI to generate five practice sentences for integrating quotations into academic writing. She studies the examples and then writes her own integration sentences using her own sources. She does not include AI's practice sentences in her submission. Which category does this AI use fall into?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="96485">
              <material>
                <mattext texttype="text/plain">Appropriate use, because asking AI to generate practice examples for learning a technique is explicitly approved in the module</mattext>
              </material>
            </response_label>
            <response_label ident="68045">
              <material>
                <mattext texttype="text/plain">Inappropriate use, because any AI-generated sentences create a risk of unintentional plagiarism</mattext>
              </material>
            </response_label>
            <response_label ident="13033">
              <material>
                <mattext texttype="text/plain">Inappropriate use, because the student should have asked her instructor for practice examples instead</mattext>
              </material>
            </response_label>
            <response_label ident="75135">
              <material>
                <mattext texttype="text/plain">Appropriate use only if she discloses in her statement that AI was used for practice purposes</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">68045</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="68045_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">13033</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="13033_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">75135</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="75135_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">96485</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="68045_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">AI-generated practice sentences used for learning and not submitted do not create a plagiarism risk.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="13033_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The instructor is always a resource, but AI practice examples are specifically approved.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="75135_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Because the AI-generated sentences were not submitted or used in the assignment, a disclosure statement is not required for their use.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g8950399c1d243b408bf69df3a270bfee" title="Question 39">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9337,35545,19284,91349</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student is writing her personal history project and wants to include a story her aunt told her about their family's immigration experience. Her aunt shared the story privately and asked that it not be shared publicly. The student enters the full story, including her aunt's name and specific details, into AI to help organize it. What has the student failed to consider?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9337">
              <material>
                <mattext texttype="text/plain">AI tools are not private, and entering identifying personal information and sensitive stories belonging to others violates her ethical obligation to protect those who trust her.</mattext>
              </material>
            </response_label>
            <response_label ident="35545">
              <material>
                <mattext texttype="text/plain">The student needed her aunt's written permission before using the story in an academic assignment.</mattext>
              </material>
            </response_label>
            <response_label ident="19284">
              <material>
                <mattext texttype="text/plain">Personal stories shared privately cannot be used as source material in a WRIT 101 assignment.</mattext>
              </material>
            </response_label>
            <response_label ident="91349">
              <material>
                <mattext texttype="text/plain">The student should have asked her instructor before including any family member's story in her project.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">35545</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="35545_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">19284</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="19284_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">91349</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="91349_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">9337</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="35545_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Written permission from family members is not a requirement identified in the module.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="19284_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Personal family stories are appropriate content for WRIT 101 assignments—the issue is how AI is used with that content, not whether the story can be included.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="91349_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Instructor consultation is always encouraged but is not the specific guidance the module gives for this situation.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g98f6e52f34b89bd733cb51a0dd3dffca" title="Question 4">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>89937,38044,63998,15571</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student asks AI to "improve my essay" before submitting her W05 narrative. AI returns a rewritten version that is smoother and cleaner but sounds nothing like her. She submits the AI version. Which two integrity principles has she violated?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="89937">
              <material>
                <mattext texttype="text/plain">Voice integrity and competence, because she submitted work that no longer reflects her own voice or her own effort</mattext>
              </material>
            </response_label>
            <response_label ident="38044">
              <material>
                <mattext texttype="text/plain">Transparency and fabrication, because she did not disclose AI use and the narrative contains invented details</mattext>
              </material>
            </response_label>
            <response_label ident="63998">
              <material>
                <mattext texttype="text/plain">Privacy and agency, because she entered personal information into AI and accepted its decisions</mattext>
              </material>
            </response_label>
            <response_label ident="15571">
              <material>
                <mattext texttype="text/plain">Transparency and citation, because she did not credit AI as a source in her reference list</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">38044</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="38044_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">63998</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="63998_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">15571</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="15571_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">89937</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="38044_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Transparency and fabrication are not the primary violations here because the events described are still real.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="63998_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Privacy is a concern when sensitive information is entered into AI, but the module's primary concern in this scenario is voice and competence.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="15571_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;AI is not cited as a source in a reference list—it requires a disclosure statement.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gbec7e75f63dfc1c138ab8973119ed7fe" title="Question 40">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>8650,59203,66586,9907</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student reads a paragraph from a published article about cultural storytelling. He writes his own version by replacing every third word with a synonym while keeping all of the original sentences in the same order. He adds a citation. Which integrity issue is present?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="8650">
              <material>
                <mattext texttype="text/plain">Mosaic plagiarism, because replacing individual words while keeping the original sentence structure is not true paraphrasing even when a citation is included</mattext>
              </material>
            </response_label>
            <response_label ident="59203">
              <material>
                <mattext texttype="text/plain">No issue, because the student changed enough words to constitute an original paraphrase</mattext>
              </material>
            </response_label>
            <response_label ident="66586">
              <material>
                <mattext texttype="text/plain">Insufficient citation, because the student should have used a direct quotation instead</mattext>
              </material>
            </response_label>
            <response_label ident="9907">
              <material>
                <mattext texttype="text/plain">Direct plagiarism, because the student used the same sentence order as the original source</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">59203</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="59203_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">66586</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="66586_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9907</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9907_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">8650</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="59203_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Changing every third word does not meet that standard, even with a citation. A direct quotation is not required in place of a paraphrase—the issue is that the paraphrase was not done correctly.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="66586_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Changing every third word does not meet that standard, even with a citation. A direct quotation is not required in place of a paraphrase—the issue is that the paraphrase was not done correctly.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9907_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Direct plagiarism involves copying exact words without quotation marks, which is not what occurred here.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gec339592f9d7169e406757846289e2c2" title="Question 41">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>28686,34062,11819,47087</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student uploads her completed W05 personal narrative to Course Hero after the course ends, believing that sharing knowledge is a community good. Which rule does this violate?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="28686">
              <material>
                <mattext texttype="text/plain">Content sharing, because uploading completed assignments to course-sharing websites is a violation even after the course ends</mattext>
              </material>
            </response_label>
            <response_label ident="34062">
              <material>
                <mattext texttype="text/plain">No rule, because the course has ended and the assignment is no longer subject to academic integrity policies</mattext>
              </material>
            </response_label>
            <response_label ident="11819">
              <material>
                <mattext texttype="text/plain">Voice integrity, because making her narrative public exposes her personal writing to unauthorized use</mattext>
              </material>
            </response_label>
            <response_label ident="47087">
              <material>
                <mattext texttype="text/plain">Self-plagiarism, because she may reuse the uploaded work in a future course</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">34062</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="34062_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">11819</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="11819_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">47087</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="47087_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">28686</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="34062_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Academic integrity obligations for completed work do not expire when a course finishes.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="11819_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Voice integrity applies to the authenticity of submitted writing, not to public sharing after submission.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="47087_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Self-plagiarism is a potential future concern, but it is not the violation the module identifies for this specific action.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g4d369997ee975f0858dcd4de4fcf5636" title="Question 42">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>91001,26498,16473,80049</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;A student has been corresponding with AI throughout his drafting process. His instructor asks him to share the transcripts of his AI conversations. The student deletes the transcripts before responding to the instructor. Which principle does this action most directly undermine?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="91001">
              <material>
                <mattext texttype="text/plain">Transparency, because the module requires students to be prepared to share AI conversation transcripts honestly</mattext>
              </material>
            </response_label>
            <response_label ident="26498">
              <material>
                <mattext texttype="text/plain">Agency, because deleting the transcripts removes evidence of the student's decision-making process</mattext>
              </material>
            </response_label>
            <response_label ident="16473">
              <material>
                <mattext texttype="text/plain">Competence, because the transcripts would have shown whether the student developed skills independently</mattext>
              </material>
            </response_label>
            <response_label ident="80049">
              <material>
                <mattext texttype="text/plain">Privacy, because the transcripts may contain personal information the student has a right to protect</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">26498</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="26498_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">16473</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="16473_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">80049</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="80049_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">91001</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="26498_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Agency relates to the student's decision-making role during the assignment, not to transcript management after the fact.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="16473_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Competence relates to skill development, not to evidence preservation.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="80049_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Privacy applies to protecting others' sensitive information entered into AI, not to protecting the student's own AI usage history from an instructor review.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g3340b7bdb6a55afcb2dadc0ae58ea9d9" title="Question 43">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>69745,78788,87294,59850</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student writes a personal narrative about growing up in her hometown. Her narrative includes vivid sensory details, rhythmic sentence patterns, and expressions drawn from her first language. Her instructor praises her draft for its distinctive voice. She then asks AI to "make it better" before final submission. The final version is smoother but sounds like no one in particular. What has happened?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="69745">
              <material>
                <mattext texttype="text/plain">AI replaced her distinctive voice with generic prose, which is a voice integrity concern even though the events described are still real.</mattext>
              </material>
            </response_label>
            <response_label ident="78788">
              <material>
                <mattext texttype="text/plain">AI improved her narrative technically, which is an appropriate use of AI for a product task.</mattext>
              </material>
            </response_label>
            <response_label ident="87294">
              <material>
                <mattext texttype="text/plain">AI committed direct plagiarism by replacing her original sentences with generated text.</mattext>
              </material>
            </response_label>
            <response_label ident="59850">
              <material>
                <mattext texttype="text/plain">AI violated her privacy by processing personal details from her narrative without consent.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">78788</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="78788_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">87294</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="87294_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">59850</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="59850_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">69745</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="78788_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">A personal narrative is a process task, not a product task, so AI improvement of this kind is not appropriate.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="87294_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Direct plagiarism involves presenting someone else's existing work as your own — AI generating new text is a different concern.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="59850_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Privacy applies to protecting identifying information about others, not to AI processing narrative content.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gc46036e30812e87e9e9747ea677bf161" title="Question 44">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9771,35398,60189,67035</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student finds that an AI tool has returned a response containing a specific claim about memory and storytelling. She wants to use the claim in her assignment. She searches for the original source AI cited, reads it, confirms the claim is accurate, and cites the original source in her reference list. Which statement best describes her approach?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9771">
              <material>
                <mattext texttype="text/plain">Her approach is correct—she verified the source exists, read it, and cited the original publication rather than AI.</mattext>
              </material>
            </response_label>
            <response_label ident="35398">
              <material>
                <mattext texttype="text/plain">Her approach is incorrect because she should have found the source independently without AI's assistance.</mattext>
              </material>
            </response_label>
            <response_label ident="60189">
              <material>
                <mattext texttype="text/plain">Her approach is incorrect because AI-generated claims may not be cited under any circumstances.</mattext>
              </material>
            </response_label>
            <response_label ident="67035">
              <material>
                <mattext texttype="text/plain">Her approach is correct only if she also discloses in her statement that AI identified the source.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">35398</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="35398_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">60189</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="60189_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">67035</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="67035_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">9771</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="35398_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The module does not require sources to be found without any AI involvement—it requires verification and direct engagement with the source.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="60189_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">AI-generated claims may be used when the underlying source is verified and cited.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="67035_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Disclosing that AI identified the source is good practice but is not the specific requirement the module identifies for this scenario.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g673feef10c2d5e23bbbab88376344436" title="Question 45">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>57593,43995,16469,31455</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student receives his graded W03 assignment back with instructor feedback. Before starting W04, he reads through all of the feedback carefully and uses it to plan his next draft. He does not share the feedback with any classmates. Which integrity principle does this behavior reflect?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="57593">
              <material>
                <mattext texttype="text/plain">This behavior does not raise any integrity concerns—reviewing personal instructor feedback is an appropriate academic practice.</mattext>
              </material>
            </response_label>
            <response_label ident="43995">
              <material>
                <mattext texttype="text/plain">Competence, because the student is using feedback to develop his writing skills independently.</mattext>
              </material>
            </response_label>
            <response_label ident="16469">
              <material>
                <mattext texttype="text/plain">Transparency, because the student is openly acknowledging the weaknesses in his previous work.</mattext>
              </material>
            </response_label>
            <response_label ident="31455">
              <material>
                <mattext texttype="text/plain">Agency, because the student is making his own decisions about how to apply the feedback.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">43995</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="43995_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">16469</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="16469_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">31455</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="31455_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">57593</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="43995_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;While the behavior does support competence development, the question asks which principle the behavior reflects in terms of integrity—and the correct answer is that no integrity issue is present.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="16469_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Transparency and agency are integrity principles tied to AI use and decision-making, not to reviewing personal feedback.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="31455_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Transparency and agency are integrity principles tied to AI use and decision-making, not to reviewing personal feedback.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ge8951162b47cceb66cc6cd79e4b30f0b" title="Question 46">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>35689,66319,10615,99734</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student is working on her W04 Family History Research Interview and asks AI: "What questions should I ask my grandmother about her childhood?" She uses AI's suggested questions word for word in her interview. Which principle does this most directly violate?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="35689">
              <material>
                <mattext texttype="text/plain">Agency, because she allowed AI to make decisions about her assignment that belonged to her</mattext>
              </material>
            </response_label>
            <response_label ident="66319">
              <material>
                <mattext texttype="text/plain">Transparency, because she did not disclose that AI generated her interview questions</mattext>
              </material>
            </response_label>
            <response_label ident="10615">
              <material>
                <mattext texttype="text/plain">Competence, because generating interview questions is a skill the assignment is designed to develop</mattext>
              </material>
            </response_label>
            <response_label ident="99734">
              <material>
                <mattext texttype="text/plain">Privacy, because she shared details about her grandmother with an AI tool</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">66319</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="66319_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">10615</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="10615_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">99734</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="99734_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">35689</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="66319_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Transparency is a secondary concern that would require a disclosure statement, but the primary violation is the surrender of decision-making.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="10615_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Competence is also affected, but the module identifies generating content and making decisions as an agency issue.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="99734_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Privacy is relevant when identifying personal information is entered into AI, not when a topic is discussed in general terms.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g907c0cd931a0859c7147287b253b39a5" title="Question 47">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>26804,99294,3262,36344</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;A student reads that President Oaks taught that dependency on others for decisions or resources a person could provide independently weakens a person spiritually. The student applies this principle to his coursework. Which of the following behaviors most directly reflects this teaching?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="26804">
              <material>
                <mattext texttype="text/plain">Writing his own draft before consulting any outside resource, including AI</mattext>
              </material>
            </response_label>
            <response_label ident="99294">
              <material>
                <mattext texttype="text/plain">Asking his instructor for clarification on the assignment requirements before beginning</mattext>
              </material>
            </response_label>
            <response_label ident="3262">
              <material>
                <mattext texttype="text/plain">Using AI to check grammar errors after completing his draft independently**</mattext>
              </material>
            </response_label>
            <response_label ident="36344">
              <material>
                <mattext texttype="text/plain">Reading published examples of personal narratives to understand the genre before writing</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">99294</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="99294_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3262</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3262_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">36344</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="36344_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">26804</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="99294_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Asking an instructor for clarification on requirements is appropriate academic behavior and does not create unhealthy dependency.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3262_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Using AI to check grammar after completing a draft independently is an approved practice that does not replace the student's own effort.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="36344_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Reading published examples for genre understanding is research, not dependency.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gf950f939c116c7a35b47b4f8a99fa822" title="Question 48">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>15237,8442,98,12707</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student discovers that a classmate posted screenshots of their completed WRIT 101 assignments in a Facebook group. The student did not give permission for this. Which statement best describes the integrity situation?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="15237">
              <material>
                <mattext texttype="text/plain">The classmate committed a content sharing violation by posting the student's completed work where others could access it</mattext>
              </material>
            </response_label>
            <response_label ident="8442">
              <material>
                <mattext texttype="text/plain">No violation occurred because the student's work was posted without the student's knowledge or consent</mattext>
              </material>
            </response_label>
            <response_label ident="98">
              <material>
                <mattext texttype="text/plain">Both the student and the classmate committed a violation because the student's work was made available to others</mattext>
              </material>
            </response_label>
            <response_label ident="12707">
              <material>
                <mattext texttype="text/plain">The violation only applies to students who access the Facebook group and use the posted work</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">8442</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="8442_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">98</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="98_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">12707</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="12707_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">15237</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="8442_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;No violation is attributed to the student whose work was shared without permission—the student is the victim of the violation, not a participant in it.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="98_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;No violation is attributed to the student whose work was shared without permission—the student is the victim of the violation, not a participant in it. The violation occurs at the point of posting and is not limited to students who subsequently access and use the work.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="12707_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The violation occurs at the point of posting and is not limited to students who subsequently access and use the work.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gc648f7270902585e90951f9bce96f263" title="Question 49">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>20260,40847,39919,18849</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student reads the module's guidance and decides to ask AI the following question before beginning his W05 draft: "Is this a process task or a product task?" AI confirms it is a process task. The student then asks AI to write the first paragraph as a starting point. Which error in reasoning has the student made?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="20260">
              <material>
                <mattext texttype="text/plain">Knowing a task is a process task means AI drafting is inappropriate—confirming the task type with AI does not change the policy that applies to it.</mattext>
              </material>
            </response_label>
            <response_label ident="40847">
              <material>
                <mattext texttype="text/plain">The student asked AI the wrong question—he should have asked whether AI assistance is permitted, not what type of task it is.</mattext>
              </material>
            </response_label>
            <response_label ident="39919">
              <material>
                <mattext texttype="text/plain">The student should have asked his instructor rather than AI to classify the task type.</mattext>
              </material>
            </response_label>
            <response_label ident="18849">
              <material>
                <mattext texttype="text/plain">Asking AI to write only the first paragraph is a minor use that does not violate process task guidelines.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">40847</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="40847_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">39919</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="39919_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">18849</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="18849_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">20260</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="40847_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The question of whether assistance is permitted is answered by the task type itself—they are the same question.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="39919_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Instructor classification of the task is not required.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="18849_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">There is no threshold of draft length below which AI drafting becomes acceptable for a process task.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g75c48c4dec7a31c66cd8cf00faf1fe95" title="Question 5">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>25270,1311,50753,16971</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student in his first week of WRIT 101 reads that he must submit a disclosure statement with every assignment. He did not use AI on his first assignment. What should his statement say?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="25270">
              <material>
                <mattext texttype="text/plain">"I did not use AI assistance on this assignment."</mattext>
              </material>
            </response_label>
            <response_label ident="1311">
              <material>
                <mattext texttype="text/plain">He does not need to include a statement because he did not use AI.</mattext>
              </material>
            </response_label>
            <response_label ident="50753">
              <material>
                <mattext texttype="text/plain">"This assignment was completed without the use of external tools or resources."</mattext>
              </material>
            </response_label>
            <response_label ident="16971">
              <material>
                <mattext texttype="text/plain">"All ideas and content in this assignment are original and my own."</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1311</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1311_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">50753</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="50753_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">16971</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="16971_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">25270</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="1311_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Omitting the statement because AI was not used does not fulfill the requirement—the statement is mandatory regardless of whether AI was used.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="50753_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The other two options are not the approved wording and do not fulfill the transparency requirement as defined in the module.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="16971_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The other two options are not the approved wording and do not fulfill the transparency requirement as defined in the module.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ge89e1ec74928820ca24756d21cd453db" title="Question 6">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>31731,1994,88463,90751</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student wants to include her mother's business advice in her personal history project. Her mother has trained many apprentices and built a successful business over many years. The student believes this knowledge is widely known in her community and does not need a citation. What should she do?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="31731">
              <material>
                <mattext texttype="text/plain">Ask her instructor whether the personal knowledge requires a citation before submitting the assignment.</mattext>
              </material>
            </response_label>
            <response_label ident="1994">
              <material>
                <mattext texttype="text/plain">Submit the assignment without a citation because community knowledge does not require one in any context.</mattext>
              </material>
            </response_label>
            <response_label ident="88463">
              <material>
                <mattext texttype="text/plain">Replace her mother's advice entirely with a published scholarly source on the same topic.</mattext>
              </material>
            </response_label>
            <response_label ident="90751">
              <material>
                <mattext texttype="text/plain">Include the information and cite her mother informally without following a specific citation style.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1994</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1994_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">88463</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="88463_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">90751</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="90751_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">31731</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="1994_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Submitting without a citation assumes an exception that Western academic standards do not grant.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="88463_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Replacing the personal knowledge entirely discards valuable and authentic content.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="90751_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Including a personal communication citation may be appropriate in some cases if cited correctly, but the module's guidance is to ask the instructor first, not to act independently.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g421b5072e5c0af90c8b23b4ca6aad49e" title="Question 7">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>73884,8023,17780,31379</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;A student completes a personal narrative for WRIT 101. His friend, who passed the course last term, offers to share her completed narrative as a model. The student reads it to understand the format and structure but does not copy any of her writing. Has he committed an integrity violation?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="73884">
              <material>
                <mattext texttype="text/plain">Yes, because obtaining completed assignments from others is a content sharing violation regardless of intent</mattext>
              </material>
            </response_label>
            <response_label ident="8023">
              <material>
                <mattext texttype="text/plain">No, because he did not copy any of her writing into his own assignment</mattext>
              </material>
            </response_label>
            <response_label ident="17780">
              <material>
                <mattext texttype="text/plain">No, because using a completed assignment as a model is an approved study practice</mattext>
              </material>
            </response_label>
            <response_label ident="31379">
              <material>
                <mattext texttype="text/plain">Yes, because he should have asked his instructor for an example instead</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">8023</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="8023_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">17780</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="17780_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">31379</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="31379_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">73884</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="8023_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Intent does not change the violation. The module specifically warns against obtaining completed assignments from students in prior terms, even with minor changes.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="17780_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Using another student's submitted work as a model is not an approved practice, regardless of whether any text is copied.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="31379_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The correct action is to ask the instructor for guidance or examples.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gaefe677a674adc2e6512b81c7b92819c" title="Question 8">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>96900,59838,67219,74010</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;A student is unsure whether his in-text citation format is correct. He asks AI: "Can you explain APA in-text citation format for a paraphrase?" He reads the explanation, then formats his own citation. Which category does this AI use fall into?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="96900">
              <material>
                <mattext texttype="text/plain">Appropriate use, because he asked AI to explain a concept and then applied it himself</mattext>
              </material>
            </response_label>
            <response_label ident="59838">
              <material>
                <mattext texttype="text/plain">Inappropriate use, because APA citation questions must be directed to the instructor only</mattext>
              </material>
            </response_label>
            <response_label ident="67219">
              <material>
                <mattext texttype="text/plain">Inappropriate use, because asking AI any question about the assignment counts as unauthorized assistance</mattext>
              </material>
            </response_label>
            <response_label ident="74010">
              <material>
                <mattext texttype="text/plain">Appropriate use, because AI-formatted citations are permitted when the student reviews them</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">59838</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="59838_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">67219</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="67219_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">74010</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="74010_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">96900</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="59838_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">APA questions do not need to go exclusively to the instructor.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="67219_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Asking AI a concept question is not unauthorized assistance.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="74010_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The student did not ask AI to format the citation for him, so this does not fall under the rule about submitting AI-generated citations without verification.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g2fee9b1c61a552b0302134b06e767bc3" title="Question 9">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>76110,57402,20688,47066</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A student writes her own paraphrase of a source. She then asks AI: "Does my version accurately reflect the original meaning, or have I changed anything important?" She reads AI's response and adjusts her paraphrase herself. What does this approach demonstrate?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="76110">
              <material>
                <mattext texttype="text/plain">The student used AI to check her thinking rather than replace it, which is an approved method</mattext>
              </material>
            </response_label>
            <response_label ident="57402">
              <material>
                <mattext texttype="text/plain">The student violated the agency principle by allowing AI to evaluate her work</mattext>
              </material>
            </response_label>
            <response_label ident="20688">
              <material>
                <mattext texttype="text/plain">The student committed mosaic plagiarism by comparing her paraphrase to the original source</mattext>
              </material>
            </response_label>
            <response_label ident="47066">
              <material>
                <mattext texttype="text/plain">The student should have asked her instructor to check the paraphrase instead of using AI</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">57402</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="57402_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">20688</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="20688_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">47066</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="47066_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">76110</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="57402_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The agency principle is not violated because the student made all decisions and only asked AI to verify accuracy.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="20688_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Comparing a paraphrase to an original source is not mosaic plagiarism—mosaic plagiarism involves imitating the original structure.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="47066_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Asking an instructor is always an option, but this AI use is specifically approved in the module.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
  </objectbank>
</questestinterop>
