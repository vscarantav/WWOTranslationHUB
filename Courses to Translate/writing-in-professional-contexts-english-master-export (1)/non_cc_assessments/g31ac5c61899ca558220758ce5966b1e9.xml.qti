    <item ident="g8f439a8b19bda976c4bf2395b0ed557f" title="AI">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>true_false_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>3635,7634</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Do not turn in an assignment that another person or program (artificial intelligence/AI) created&amp;nbsp;-- even if that assignment is better than your own.&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="3635">
              <material>
                <mattext texttype="text/plain">True</mattext>
              </material>
            </response_label>
            <response_label ident="7634">
              <material>
                <mattext texttype="text/plain">False</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">3635</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="gec62560ed699c172c1fd049bea2e97fe" title="Academic Honesty">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>7149,8707,4036</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;div class="byui nutr150"&gt;Cody and Angie are both in GS 105 but in different sections. Cody needed to take Quiz 1, a timed open-note, open-book, but not an open-person test. Since he had been busy at his job and dating Angie, he did not finish reading the assigned chapters. He had planned on organizing his material prior to the test but needed to help his friend who was sick. Panicked, he called Angie who had already taken the quiz and asked her what questions were on the quiz.&amp;nbsp; Was this academically honest?&amp;nbsp;&lt;/div&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="7149">
              <material>
                <mattext texttype="text/plain">Yes, it is academically honest. Cody made an attempt to study but was too busy to finish the study guides.</mattext>
              </material>
            </response_label>
            <response_label ident="8707">
              <material>
                <mattext texttype="text/plain">Yes. It is academically honest. It is important for students to help one another through difficult times.</mattext>
              </material>
            </response_label>
            <response_label ident="4036">
              <material>
                <mattext texttype="text/plain">No. It is not academically honest. Asking someone who has taken the test what was on it is academically dishonest.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">4036</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
