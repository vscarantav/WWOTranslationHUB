    <item ident="gc7250c554bed546fc81e1b603549e474" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>2067,4916,5947</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;This is the first course in the Commercial Fundamentals Certificate. Below is listed the courses for this certificate. And the following key will help you understand the minimum technology requirements for those courses. For more information about technology requirements go to: &lt;a class="inline_disabled" href="https://www.byupathway.edu/technology-requirements" target="_blank"&gt;BYU-Pathway Technology Requirements&lt;/a&gt;.&lt;/p&gt;
&lt;table style="border-collapse: collapse; width: 100%; border-color: #FFFFFF;" border="1"&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="width: 33.2938%; text-align: center;"&gt;
&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/assessment_questions/smartphone-icon-purple.svg?canvas_download=1" alt="Smartphone" width="247" height="247" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Mobile Device&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Smartphone required with an Android 9+ or iOS 14+ operating system.&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 33.2938%; text-align: center;"&gt;
&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/assessment_questions/light-computer-icon-blue.svg?canvas_download=1" alt="Light computing" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Light Computing&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Laptop required with ability to run Microsoft Office apps like Word and Excel.&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 33.2938%; text-align: center;"&gt;
&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/assessment_questions/heavy-computer-icon-purple.svg?canvas_download=1" alt="Heavy computing" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Heavy Computing&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Laptop is required with the ability to run more demanding apps.&lt;br&gt;&lt;br&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;Courses for the &lt;strong&gt;Commercial Fundamentals Certificate&lt;/strong&gt; and Their Technology Requirements&lt;/p&gt;
&lt;table style="border-collapse: collapse; width: 100%;" border="1"&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="width: 49.9408%; text-align: center;"&gt;&lt;strong&gt;Course&lt;/strong&gt;&lt;/td&gt;
&lt;td style="width: 49.9408%; text-align: center;"&gt;&lt;strong&gt;Technology Requirement&lt;/strong&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="width: 49.9408%;"&gt;BUS 105 - Spreadsheet Essentials&lt;/td&gt;
&lt;td style="width: 49.9408%;"&gt;&lt;img style="display: block; margin-left: auto; margin-right: auto;" src="$IMS-CC-FILEBASE$/assessment_questions/light-computer-icon-blue.svg?canvas_download=1" alt="Light computing" width="87" height="87" loading="lazy"&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="width: 49.9408%;"&gt;COMM 150 - Interpersonal Theory and Practice&lt;/td&gt;
&lt;td style="width: 49.9408%;"&gt;&lt;img style="display: block; margin-left: auto; margin-right: auto;" src="$IMS-CC-FILEBASE$/assessment_questions/light-computer-icon-blue.svg?canvas_download=1" alt="Light computing" width="87" height="87" loading="lazy"&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="width: 49.9408%;"&gt;MKT 120 - Marketing Foundations&lt;/td&gt;
&lt;td style="width: 49.9408%;"&gt;&lt;img style="display: block; margin-left: auto; margin-right: auto;" src="$IMS-CC-FILEBASE$/assessment_questions/light-computer-icon-blue.svg?canvas_download=1" alt="Light computing" width="87" height="87" loading="lazy"&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="width: 49.9408%;"&gt;BUS 180 - Introduction to Financial Managment&lt;/td&gt;
&lt;td style="width: 49.9408%;"&gt;&lt;img style="display: block; margin-left: auto; margin-right: auto;" src="$IMS-CC-FILEBASE$/assessment_questions/light-computer-icon-blue.svg?canvas_download=1" alt="Light computing" width="87" height="87" loading="lazy"&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;What is the technology requirement for the courses in this certificate? Please choose the correct answer below.&lt;br&gt;(If you have further questions, please reach out to your instructor.)&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="2067">
              <material>
                <mattext texttype="text/plain">All the courses require smartphone with an Android 9+ or iOS 14+ operating system.</mattext>
              </material>
            </response_label>
            <response_label ident="4916">
              <material>
                <mattext texttype="text/plain">All the courses require a laptop with the ability to run Microsoft Office apps like Word and Excel.</mattext>
              </material>
            </response_label>
            <response_label ident="5947">
              <material>
                <mattext texttype="text/plain">All the courses require a laptop with the ability to run more demanding apps.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">4916</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
