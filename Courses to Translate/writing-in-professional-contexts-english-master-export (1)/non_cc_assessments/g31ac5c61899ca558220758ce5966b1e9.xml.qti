    <item ident="gdefc3f108e35cb76ab42ff26148115c4" title="TurnItIn">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>true_false_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>2059,6990</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Turnitin is a program that lets you and your teachers know how much your work reflects other peoples work. After you have submitted your work there will be a color flag appear next to your submission in the grades tab. The different color flags will indicate the percentage of your submission that Turnitin has found to be copied. &lt;strong&gt;NOTE&lt;/strong&gt;: Assignments that use templates will have some copying and Turnitin will flag the assignment questions—do not worry about this. Make sure your answers to the questions have not been copied.&lt;/p&gt;
&lt;p&gt;If the color of your flag is red, you must rework your assignment and resubmit it until your flag is no longer red. An assignment that is turned in with the red flag will not be graded and will be given a 0.&lt;/p&gt;
&lt;p&gt;The Turnitin scores are broken down as follows:&lt;/p&gt;
&lt;table style="border-collapse: collapse; width: 33.3965%;" border="1"&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="width: 100%; text-align: center;"&gt;Turnitin Score Icons&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;table style="border-collapse: collapse; width: 33.4497%; height: 209px;" border="1"&gt;
&lt;tbody&gt;
&lt;tr style="height: 43px;"&gt;
&lt;td style="width: 15.2614%; height: 31px; text-align: center;"&gt;&lt;img id="125232114" src="$IMS-CC-FILEBASE$/assessment_questions/W01%20Quiz:%20Syllabus%20GrayFlag.PNG?canvas_download=1" alt="1.2 gray.PNG" width="44" height="36" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 84.6662%; height: 31px;"&gt;&lt;strong&gt;&amp;nbsp;Gray&lt;/strong&gt; (originality report has not been generated)&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 44px;"&gt;
&lt;td style="width: 15.2614%; height: 44px; text-align: center;"&gt;&lt;img id="125231954" src="$IMS-CC-FILEBASE$/assessment_questions/W01%20Quiz:%20Syllabus%20BlueFlag.PNG?canvas_download=1" alt="2blue.PNG" width="47" height="37" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 84.6662%; height: 44px;"&gt;&lt;strong&gt;&amp;nbsp;Blue&lt;/strong&gt; (no matching words)&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29px;"&gt;
&lt;td style="width: 15.2614%; height: 29px; text-align: center;"&gt;&lt;img id="125231948" src="$IMS-CC-FILEBASE$/assessment_questions/W01%20Quiz:%20Syllabus%20GreenFlag.PNG?canvas_download=1" alt="3green.PNG" width="44" height="30" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 84.6662%; height: 29px;"&gt;&lt;strong&gt;&amp;nbsp;Green&lt;/strong&gt; (1-24% similarity index)&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 26px;"&gt;
&lt;td style="width: 15.2614%; height: 18px; text-align: center;"&gt;&lt;img id="125231946" src="$IMS-CC-FILEBASE$/assessment_questions/W01%20Quiz:%20Syllabus%20YellowFlag.PNG?canvas_download=1" alt="4yellow.PNG" width="43" height="37" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 84.6662%; height: 18px;"&gt;&lt;strong&gt;&amp;nbsp;Yellow&lt;/strong&gt; (25-49% similarity index)&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29px;"&gt;
&lt;td style="width: 15.2614%; height: 29px; text-align: center;"&gt;&lt;img id="125231944" src="$IMS-CC-FILEBASE$/assessment_questions/W01%20Quiz:%20Syllabus%20OrangeFlag.PNG?canvas_download=1" alt="5orange.PNG" width="42" height="31" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 84.6662%; height: 29px;"&gt;&lt;strong&gt;&amp;nbsp;Orange&lt;/strong&gt; (50-74% similarity index)&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29px;"&gt;
&lt;td style="width: 15.2614%; height: 29px; text-align: center;"&gt;&lt;img id="125232112" src="$IMS-CC-FILEBASE$/assessment_questions/W01%20Quiz:%20Syllabus%20RedFlag.PNG?canvas_download=1" alt="6.1red.PNG" width="42" height="30" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 84.6662%; height: 29px;"&gt;&lt;strong&gt;&amp;nbsp;Red&lt;/strong&gt; (75-100% similarity index)&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29px;"&gt;
&lt;td style="width: 15.2614%; height: 29px; text-align: center;"&gt;&lt;img id="125231938" src="$IMS-CC-FILEBASE$/assessment_questions/W01%20Quiz:%20Syllabus%20Clock.PNG?canvas_download=1" alt="8clock.PNG" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 84.6662%; height: 29px;"&gt;&lt;strong&gt;&amp;nbsp;Clock&lt;/strong&gt; (Turnitin report is still pending)&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;span&gt;Turnitin can be used to provide immediate feedback so you will know what needs to be fixed before submitting your assignments.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="2059">
              <material>
                <mattext texttype="text/plain">True</mattext>
              </material>
            </response_label>
            <response_label ident="6990">
              <material>
                <mattext texttype="text/plain">False</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6990</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="gc4b7b7ee2d353475c7f9bbd58966671e" title="TurnItIn">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>true_false_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>2059,6990</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Turnitin is a program that lets you and your teachers know how much your work reflects other peoples work. After you have submitted your work there will be a color flag appear next to your submission in the grades tab. The different color flags will indicate the percentage of your submission that Turnitin has found to be copied. &lt;strong&gt;NOTE&lt;/strong&gt;: Assignments that use templates will have some copying and Turnitin will flag the assignment questions—do not worry about this. Make sure your answers to the questions have not been copied.&lt;/p&gt;
&lt;p&gt;If the color of your flag is red, you must rework your assignment and resubmit it until your flag is no longer red. An assignment that is turned in with the red flag will not be graded and will be given a 0.&lt;/p&gt;
&lt;p&gt;The Turnitin scores are broken down as follows:&lt;/p&gt;
&lt;table style="border-collapse: collapse; width: 33.3965%;" border="1"&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="width: 100%; text-align: center;"&gt;Turnitin Score Icons&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;table style="border-collapse: collapse; width: 33.4497%; height: 209px;" border="1"&gt;
&lt;tbody&gt;
&lt;tr style="height: 43px;"&gt;
&lt;td style="width: 15.2614%; height: 31px; text-align: center;"&gt;&lt;img id="125232114" src="https://byui.instructure.com/assessment_questions/79262992/files/126074878/download?verifier=p1LKbTRZaB3sVGgvrqK3EgCTNLTBONLVuQVSMRoa" alt="1.2 gray.PNG" width="40" height="33" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 84.6662%; height: 31px;"&gt;&lt;strong&gt;&amp;nbsp;Gray&lt;/strong&gt; (originality report has not been generated)&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 44px;"&gt;
&lt;td style="width: 15.2614%; height: 44px; text-align: center;"&gt;&lt;img id="125231954" src="https://byui.instructure.com/assessment_questions/79262992/files/126074880/download?verifier=xojWfoFR4DYqSYn0vq7sZcDxU55rkFZMlbHte41d" alt="2blue.PNG" width="44" height="35" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 84.6662%; height: 44px;"&gt;&lt;strong&gt;&amp;nbsp;Blue&lt;/strong&gt; (no matching words)&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29px;"&gt;
&lt;td style="width: 15.2614%; height: 29px; text-align: center;"&gt;&lt;img id="125231948" src="https://byui.instructure.com/assessment_questions/79262992/files/126074882/download?verifier=nYUurMbQ6lNgwj3wgb8TCWy9ft19J4w3RCoH4hCV" alt="3green.PNG" width="44" height="30" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 84.6662%; height: 29px;"&gt;&lt;strong&gt;&amp;nbsp;Green&lt;/strong&gt; (1-24% similarity index)&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 26px;"&gt;
&lt;td style="width: 15.2614%; height: 18px; text-align: center;"&gt;&lt;img id="125231946" src="https://byui.instructure.com/assessment_questions/79262992/files/126074884/download?verifier=h7l0oDWFpToQ5lEqM1vvdjAWA47E7YNorCfCpT7G" alt="4yellow.PNG" width="43" height="37" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 84.6662%; height: 18px;"&gt;&lt;strong&gt;&amp;nbsp;Yellow&lt;/strong&gt; (25-49% similarity index)&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29px;"&gt;
&lt;td style="width: 15.2614%; height: 29px; text-align: center;"&gt;&lt;img id="125231944" src="https://byui.instructure.com/assessment_questions/79262992/files/126074886/download?verifier=sQXg75m3IzGR6XODVXukklE0RWHE0YKC6hK5xNnA" alt="5orange.PNG" width="43" height="32" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 84.6662%; height: 29px;"&gt;&lt;strong&gt;&amp;nbsp;Orange&lt;/strong&gt; (50-74% similarity index)&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29px;"&gt;
&lt;td style="width: 15.2614%; height: 29px; text-align: center;"&gt;&lt;img id="125232112" src="https://byui.instructure.com/assessment_questions/79262992/files/126074888/download?verifier=VfISs38TMgekFFOkj4qB6fkoeAJmkXi7UPoZjqmG" alt="6.1red.PNG" width="45" height="32" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 84.6662%; height: 29px;"&gt;&lt;strong&gt;&amp;nbsp;Red&lt;/strong&gt; (75-100% similarity index)&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29px;"&gt;
&lt;td style="width: 15.2614%; height: 29px; text-align: center;"&gt;&lt;img id="125231938" src="https://byui.instructure.com/assessment_questions/79262992/files/126074890/download?verifier=xaGxRV6UsfndGs8XURPE1UPqW3jtRG0Hm22QVZhj" alt="8clock.PNG" loading="lazy"&gt;&lt;/td&gt;
&lt;td style="width: 84.6662%; height: 29px;"&gt;&lt;strong&gt;&amp;nbsp;Clock&lt;/strong&gt; (Turnitin report is still pending)&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;span&gt;Turnitin can be used to provide immediate feedback so you will know what needs to be fixed before submitting your assignments.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="2059">
              <material>
                <mattext texttype="text/plain">True</mattext>
              </material>
            </response_label>
            <response_label ident="6990">
              <material>
                <mattext texttype="text/plain">False</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">2059</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="gd27df289989fdf5f2e1081ea9e61c959" title="Zoom">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>0.5</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>4131,6115,6074</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;(Refer to the &lt;strong&gt;Downloading and Signing into Zoom &lt;/strong&gt;video.)&lt;/p&gt;
&lt;p&gt;What is the correct choice for signing into Zoom?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="4131">
              <material>
                <mattext texttype="text/plain">Sign in using SSO</mattext>
              </material>
            </response_label>
            <response_label ident="6115">
              <material>
                <mattext texttype="text/plain">Sign in with Google</mattext>
              </material>
            </response_label>
            <response_label ident="6074">
              <material>
                <mattext texttype="text/plain">Sign in with Facebook</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">4131</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="g9d642b16e3d36546ae4a06a85099da7d" title="Zoom etiquette">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_answers_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>0.5</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>8741,5867,7018,329,5746,4317,2650</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;(Refer to the &lt;strong&gt;Zoom Etiquette&lt;/strong&gt; video.)&lt;/p&gt;
&lt;p&gt;Which of the following choices are consistent with good Zoom classroom procedures. (Select all that apply.)&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Multiple">
          <render_choice>
            <response_label ident="8741">
              <material>
                <mattext texttype="text/plain">Being professional and respectful</mattext>
              </material>
            </response_label>
            <response_label ident="5867">
              <material>
                <mattext texttype="text/plain">Attending class while still in bed in your pajamas</mattext>
              </material>
            </response_label>
            <response_label ident="7018">
              <material>
                <mattext texttype="text/plain">Turning on your camera</mattext>
              </material>
            </response_label>
            <response_label ident="329">
              <material>
                <mattext texttype="text/plain">Having your microphone on at all times</mattext>
              </material>
            </response_label>
            <response_label ident="5746">
              <material>
                <mattext texttype="text/plain">Setting up your space to be professional and focused on learning</mattext>
              </material>
            </response_label>
            <response_label ident="4317">
              <material>
                <mattext texttype="text/plain">Being an active participant</mattext>
              </material>
            </response_label>
            <response_label ident="2650">
              <material>
                <mattext texttype="text/plain">Placing the camera at eye level with a bright light behind you</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <and>
              <varequal respident="response1">8741</varequal>
              <not>
                <varequal respident="response1">5867</varequal>
              </not>
              <varequal respident="response1">7018</varequal>
              <not>
                <varequal respident="response1">329</varequal>
              </not>
              <varequal respident="response1">5746</varequal>
              <varequal respident="response1">4317</varequal>
              <not>
                <varequal respident="response1">2650</varequal>
              </not>
            </and>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
  </objectbank>
</questestinterop>
