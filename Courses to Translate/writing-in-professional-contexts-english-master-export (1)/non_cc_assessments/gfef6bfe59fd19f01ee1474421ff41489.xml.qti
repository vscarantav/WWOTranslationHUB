    <item ident="g51b725944475ee0a84a719b8463c79b9" title="Question 16">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>90612,61017,75494,25288</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the purpose of varying sentence length in your writing?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="90612">
              <material>
                <mattext texttype="text/plain">To keep readers engaged and to emphasize the most important points</mattext>
              </material>
            </response_label>
            <response_label ident="61017">
              <material>
                <mattext texttype="text/plain">To make the document appear longer and more detailed</mattext>
              </material>
            </response_label>
            <response_label ident="75494">
              <material>
                <mattext texttype="text/plain">To show the reader that you know many different sentence structures</mattext>
              </material>
            </response_label>
            <response_label ident="25288">
              <material>
                <mattext texttype="text/plain">To meet the minimum word count required by the assignment</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">61017</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="61017_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">75494</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="75494_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">25288</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="25288_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">90612</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="61017_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Varying sentence length is not about appearance, demonstrating knowledge of structures, or meeting word counts. Shorter sentences emphasize key points, while longer sentences explain relationships and provide detail. Using both keeps readers engaged and makes the writing easier to follow.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="75494_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Varying sentence length is not about appearance, demonstrating knowledge of structures, or meeting word counts. Shorter sentences emphasize key points, while longer sentences explain relationships and provide detail. Using both keeps readers engaged and makes the writing easier to follow.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="25288_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Varying sentence length is not about appearance, demonstrating knowledge of structures, or meeting word counts. Shorter sentences emphasize key points, while longer sentences explain relationships and provide detail. Using both keeps readers engaged and makes the writing easier to follow.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
