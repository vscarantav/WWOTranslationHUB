    <item ident="gace5306215e1bfc4a5cec7e2259ae4fd" title="Question 7">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>4706,85151,20125,83806</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which of the following sentences is the most concise?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="4706">
              <material>
                <mattext texttype="text/plain">Students who prepare for exams usually get better results.</mattext>
              </material>
            </response_label>
            <response_label ident="85151">
              <material>
                <mattext texttype="text/plain">It generally appears to be the case that students who carefully and thoughtfully prepare for exams in advance typically achieve better results than those who do not.</mattext>
              </material>
            </response_label>
            <response_label ident="20125">
              <material>
                <mattext texttype="text/plain">When students take the time to prepare for their examinations in a careful manner, they tend to achieve better results on those examinations.</mattext>
              </material>
            </response_label>
            <response_label ident="83806">
              <material>
                <mattext texttype="text/plain">Preparation for exams by students results in better performance outcomes in examination situations.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">85151</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="85151_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">20125</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="20125_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">83806</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="83806_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">4706</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="85151_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The correct answer states the same idea in far fewer words without losing any meaning. The other three options all include unnecessary phrases such as "it generally appears to be the case," "in a careful manner," and "performance outcomes in examination situations." These phrases add length but not clarity. Concise writing removes such phrases.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="20125_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The correct answer states the same idea in far fewer words without losing any meaning. The other three options all include unnecessary phrases such as "it generally appears to be the case," "in a careful manner," and "performance outcomes in examination situations." These phrases add length but not clarity. Concise writing removes such phrases.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="83806_fb">
