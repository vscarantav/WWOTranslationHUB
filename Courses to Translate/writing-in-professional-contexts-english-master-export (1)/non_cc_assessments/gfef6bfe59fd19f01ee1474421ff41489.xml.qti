    <item ident="g218deee2fd321db2079afb069e696800" title="Question 22">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>53187,89367,98111,38445</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does it mean to adapt writing for an audience?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="53187">
              <material>
                <mattext texttype="text/plain">To adjust your tone, language, and content to match the needs and expectations of your reader</mattext>
              </material>
            </response_label>
            <response_label ident="89367">
              <material>
                <mattext texttype="text/plain">To translate your writing into the reader's native language</mattext>
              </material>
            </response_label>
            <response_label ident="98111">
              <material>
                <mattext texttype="text/plain">To shorten your writing so it is easier for all audiences to understand</mattext>
              </material>
            </response_label>
            <response_label ident="38445">
              <material>
                <mattext texttype="text/plain">To remove technical terms so readers with no background knowledge can follow along</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">89367</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="89367_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">98111</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="98111_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">38445</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="38445_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">53187</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="89367_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Audience adaptation is not about translation, shortening, or always removing technical terms. It means making intentional choices about tone, language, and content based on who will read your writing. A message to a friend uses different language than a message to an employer, even when both communicate the same information.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="98111_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Audience adaptation is not about translation, shortening, or always removing technical terms. It means making intentional choices about tone, language, and content based on who will read your writing. A message to a friend uses different language than a message to an employer, even when both communicate the same information.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="38445_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Audience adaptation is not about translation, shortening, or always removing technical terms. It means making intentional choices about tone, language, and content based on who will read your writing. A message to a friend uses different language than a message to an employer, even when both communicate the same information.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g9e0e28454681efbf81657dbfa8bbde98" title="Question 23">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
