    <item ident="g9a54ce97f76afc324b05641582a3a975" title="Question 6">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>80899,64669,25371,84027</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is tone in writing?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="80899">
              <material>
                <mattext texttype="text/plain">The writer’s attitude toward the subject and audience expressed through language</mattext>
              </material>
            </response_label>
            <response_label ident="64669">
              <material>
                <mattext texttype="text/plain">The number of words a writer uses in each sentence</mattext>
              </material>
            </response_label>
            <response_label ident="25371">
              <material>
                <mattext texttype="text/plain">The format a writer follows when organizing paragraphs</mattext>
              </material>
            </response_label>
            <response_label ident="84027">
              <material>
                <mattext texttype="text/plain">The type of evidence a writer includes to support an argument</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">64669</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="64669_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">25371</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="25371_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">84027</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="84027_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">80899</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="64669_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Tone is not about word count, paragraph format, or the type of evidence used. Tone refers to the attitude or feeling a writer conveys through word choice and style. For example, a formal tone sounds different from a casual or conversational tone, even when both communicate the same information.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="25371_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Tone is not about word count, paragraph format, or the type of evidence used. Tone refers to the attitude or feeling a writer conveys through word choice and style. For example, a formal tone sounds different from a casual or conversational tone, even when both communicate the same information.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
