          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the purpose of a concluding sentence in a paragraph?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="11955">
              <material>
                <mattext texttype="text/plain">To close the paragraph by completing the discussion of the paragraph's main idea</mattext>
              </material>
            </response_label>
            <response_label ident="36030">
              <material>
                <mattext texttype="text/plain">To introduce the main idea of the next paragraph</mattext>
              </material>
            </response_label>
            <response_label ident="37398">
              <material>
                <mattext texttype="text/plain">To restate the thesis statement word for word</mattext>
              </material>
            </response_label>
            <response_label ident="92115">
              <material>
                <mattext texttype="text/plain">To list the sources used to support the paragraph's evidence</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">36030</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="36030_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">37398</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="37398_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">92115</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="92115_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">11955</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="36030_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A concluding sentence closes the paragraph and completes the discussion of its one main idea. It does not introduce the next paragraph's idea, repeat the thesis word for word, or list sources. In the reading, Maria Santos ends her paragraph with "These organizational tools help students balance their academic and personal responsibilities," which wraps up the paragraph's focus on smartphone organization tools.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
