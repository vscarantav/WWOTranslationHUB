    <item ident="g6c9b8bc28679115240ad688fd832b030" title="Question 28">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>10686,78404,85288,50407</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does logos mean as a rhetorical appeal?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="10686">
              <material>
                <mattext texttype="text/plain">An appeal to the reader's logic using facts, statistics, and reasoning</mattext>
              </material>
            </response_label>
            <response_label ident="78404">
              <material>
                <mattext texttype="text/plain">An appeal to the reader's emotions using personal stories</mattext>
              </material>
            </response_label>
            <response_label ident="85288">
              <material>
                <mattext texttype="text/plain">An appeal based on the writer's expertise and character</mattext>
              </material>
            </response_label>
            <response_label ident="50407">
              <material>
                <mattext texttype="text/plain">An appeal based on cultural traditions and shared values</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">78404</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="78404_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">85288</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="85288_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">50407</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="50407_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">10686</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="78404_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Logos specifically refers to logical appeals that use facts, data, and reasoning to persuade a reader. Appealing to emotions through stories is pathos. Appealing through the writer's expertise and character is ethos. Cultural traditions and shared values are not one of the three rhetorical appeals introduced in W01.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="85288_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Logos specifically refers to logical appeals that use facts, data, and reasoning to persuade a reader. Appealing to emotions through stories is pathos. Appealing through the writer's expertise and character is ethos. Cultural traditions and shared values are not one of the three rhetorical appeals introduced in W01.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="50407_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Logos specifically refers to logical appeals that use facts, data, and reasoning to persuade a reader. Appealing to emotions through stories is pathos. Appealing through the writer's expertise and character is ethos. Cultural traditions and shared values are not one of the three rhetorical appeals introduced in W01.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g4f1cc6e721484b425ceffb1d74b06031" title="Question 29">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
