      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which of the following is an example of wordiness in a sentence?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="71993">
              <material>
                <mattext texttype="text/plain">"Due to the fact that there are a large number of students who are in the process of learning"</mattext>
              </material>
            </response_label>
            <response_label ident="54347">
              <material>
                <mattext texttype="text/plain">"Because many students are learning"</mattext>
              </material>
            </response_label>
            <response_label ident="7845">
              <material>
                <mattext texttype="text/plain">"Students are learning technology skills"</mattext>
              </material>
            </response_label>
            <response_label ident="62259">
              <material>
                <mattext texttype="text/plain">"The computer lab will extend its hours"</mattext>
              </material>
            </response_label>
