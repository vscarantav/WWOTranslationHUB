    <item ident="g4f64af903d0fba5054c3aeca7d2d999b" title="Question 8">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>33684,67706,17512,27305</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is pathos as a rhetorical appeal?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="33684">
              <material>
                <mattext texttype="text/plain">An appeal to the reader's emotions through stories and personal connections</mattext>
              </material>
            </response_label>
            <response_label ident="67706">
              <material>
                <mattext texttype="text/plain">An appeal to the reader's sense of logic through facts and data</mattext>
              </material>
            </response_label>
            <response_label ident="17512">
              <material>
                <mattext texttype="text/plain">An appeal based on the writer's expertise and credibility</mattext>
              </material>
            </response_label>
            <response_label ident="27305">
              <material>
                <mattext texttype="text/plain">An appeal based on the timing of the argument</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">67706</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="67706_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">17512</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="17512_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">27305</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="27305_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">33684</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="67706_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Pathos is specifically the appeal to emotion. Appealing to logic through facts and data is logos. Appealing to the writer's expertise and credibility is ethos. Appealing to timing is kairos. Pathos connects with readers by using personal stories or emotional language that creates feeling and empathy.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="17512_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Pathos is specifically the appeal to emotion. Appealing to logic through facts and data is logos. Appealing to the writer's expertise and credibility is ethos. Appealing to timing is kairos. Pathos connects with readers by using personal stories or emotional language that creates feeling and empathy.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
