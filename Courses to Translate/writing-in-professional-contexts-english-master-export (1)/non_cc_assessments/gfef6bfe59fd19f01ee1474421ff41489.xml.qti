    <item ident="g209ed80698fd413faa2eff0201c5d470" title="Question 4">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>65983,83916,63163,74614</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the primary purpose of organizing writing into paragraphs?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="65983">
              <material>
                <mattext texttype="text/plain">To present ideas in smaller sections that are easier for readers to understand</mattext>
              </material>
            </response_label>
            <response_label ident="83916">
              <material>
                <mattext texttype="text/plain">To make a document appear longer and more fully developed to the reader</mattext>
              </material>
            </response_label>
            <response_label ident="63163">
              <material>
                <mattext texttype="text/plain">To avoid having to write clear transition sentences between ideas</mattext>
              </material>
            </response_label>
            <response_label ident="74614">
              <material>
                <mattext texttype="text/plain">To impress the reader with the writer's knowledge and style</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">83916</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="83916_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">63163</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="63163_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">74614</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="74614_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">65983</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="83916_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Paragraphs break information into manageable sections, so readers can process one idea at a time. Paragraphs do not exist to make a document look longer, to avoid transitions, or to impress readers. Their purpose is to improve clarity and comprehension.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="63163_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Paragraphs break information into manageable sections, so readers can process one idea at a time. Paragraphs do not exist to make a document look longer, to avoid transitions, or to impress readers. Their purpose is to improve clarity and comprehension.</mattext>
          </material>
