            <fieldentry>13292,10987,90554,70671</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following is an example of an unnecessary word or phrase that should be removed for concise writing?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="13292">
              <material>
                <mattext texttype="text/plain">"Positive benefits"</mattext>
              </material>
            </response_label>
            <response_label ident="10987">
              <material>
                <mattext texttype="text/plain">"Clear argument"</mattext>
              </material>
            </response_label>
            <response_label ident="90554">
              <material>
                <mattext texttype="text/plain">"Supporting evidence"</mattext>
              </material>
            </response_label>
            <response_label ident="70671">
              <material>
                <mattext texttype="text/plain">"Main idea"</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">10987</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="10987_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">90554</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="90554_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">70671</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="70671_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">13292</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="10987_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The phrase "positive benefits" is redundant because the word "benefits" already implies something positive. Adding "positive" does not add meaning. The other options—"clear argument," "supporting evidence," and "main idea"—are not redundant. Each word in those phrases contributes to the meaning.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="90554_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The phrase "positive benefits" is redundant because the word "benefits" already implies something positive. Adding "positive" does not add meaning. The other options—"clear argument," "supporting evidence," and "main idea"—are not redundant. Each word in those phrases contributes to the meaning.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="70671_fb">
