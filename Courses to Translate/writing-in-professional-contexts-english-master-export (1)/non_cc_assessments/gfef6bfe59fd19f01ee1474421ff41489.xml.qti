    <item ident="gd6473ab25400b362ad51a32a157eae5e" title="Question 41">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>28640,4827,70372,96724</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;According to the reading, what is one characteristic that makes a topic sentence strong rather than weak?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="28640">
              <material>
                <mattext texttype="text/plain">It is specific enough to guide the paragraph and general enough to need further explanation.</mattext>
              </material>
            </response_label>
            <response_label ident="4827">
              <material>
                <mattext texttype="text/plain">It restates the thesis statement using different words in order to reinforce the main idea.</mattext>
              </material>
            </response_label>
            <response_label ident="70372">
              <material>
                <mattext texttype="text/plain">It lists all the evidence that will appear in the paragraph to support the main idea.</mattext>
              </material>
            </response_label>
            <response_label ident="96724">
              <material>
                <mattext texttype="text/plain">It is placed at the end of the paragraph to summarize the main idea.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4827</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4827_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">70372</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="70372_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">96724</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="96724_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">28640</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="4827_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">A strong topic sentence is specific enough to give the paragraph direction but general enough that it still needs supporting sentences to develop it fully. It does not restate the thesis, list evidence, or appear at the end of the paragraph. The reading notes that topic sentences usually appear at the beginning of paragraphs and state one clear idea that the paragraph will develop.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="70372_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">A strong topic sentence is specific enough to give the paragraph direction but general enough that it still needs supporting sentences to develop it fully. It does not restate the thesis, list evidence, or appear at the end of the paragraph. The reading notes that topic sentences usually appear at the beginning of paragraphs and state one clear idea that the paragraph will develop.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="96724_fb">
