    <item ident="g76d164ddf7e2b4aa3b37bd5cb5377f46" title="Question 24">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>27750,19668,93960,97777</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the role of supporting sentences in a paragraph?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="27750">
              <material>
                <mattext texttype="text/plain">To explain, develop, or provide evidence for the main idea introduced in the topic sentence</mattext>
              </material>
            </response_label>
            <response_label ident="19668">
              <material>
                <mattext texttype="text/plain">To introduce a new idea that will be developed in the next paragraph in a separate topic sentence</mattext>
              </material>
            </response_label>
            <response_label ident="93960">
              <material>
                <mattext texttype="text/plain">To restate the thesis statement using different words for emphasis and clarity</mattext>
              </material>
            </response_label>
            <response_label ident="97777">
              <material>
                <mattext texttype="text/plain">To summarize all the ideas discussed in the essay so far in a brief concluding statement</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">19668</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="19668_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">93960</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="93960_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">97777</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="97777_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">27750</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="19668_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Supporting sentences follow the topic sentence and develop the one main idea of the paragraph. They do not introduce new ideas, restate the thesis, or summarize the essay. Their job is to explain, give examples, or provide evidence that supports the paragraph's main point.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="93960_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Supporting sentences follow the topic sentence and develop the one main idea of the paragraph. They do not introduce new ideas, restate the thesis, or summarize the essay. Their job is to explain, give examples, or provide evidence that supports the paragraph's main point.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
