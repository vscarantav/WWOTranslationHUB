    <item ident="g0336c208f64d31a490924f9f52884199" title="Question 31">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>21303,48933,26576,15459</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;How should tone be adjusted when writing to an employer?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="21303">
              <material>
                <mattext texttype="text/plain">Writing to an employer requires a professional, confident, and courteous tone</mattext>
              </material>
            </response_label>
            <response_label ident="48933">
              <material>
                <mattext texttype="text/plain">Writing to an employer requires a casual and personal tone to build a relationship</mattext>
              </material>
            </response_label>
            <response_label ident="26576">
              <material>
                <mattext texttype="text/plain">Writing to an employer requires emotional stories to create a personal connection</mattext>
              </material>
            </response_label>
            <response_label ident="15459">
              <material>
                <mattext texttype="text/plain">Writing to an employer requires the same tone used when writing to close friends</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">48933</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="48933_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">26576</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="26576_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">15459</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="15459_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">21303</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="48933_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Professional writing for an employer requires a professional, confident, and courteous tone. A casual or personal tone is appropriate for friends and family, not employers. Emotional personal stories are more appropriate for pathos-based writing aimed at general audiences. Employer communication should be results-focused, direct, and free of slang or informal language.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="26576_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Professional writing for an employer requires a professional, confident, and courteous tone. A casual or personal tone is appropriate for friends and family, not employers. Emotional personal stories are more appropriate for pathos-based writing aimed at general audiences. Employer communication should be results-focused, direct, and free of slang or informal language.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="15459_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Professional writing for an employer requires a professional, confident, and courteous tone. A casual or personal tone is appropriate for friends and family, not employers. Emotional personal stories are more appropriate for pathos-based writing aimed at general audiences. Employer communication should be results-focused, direct, and free of slang or informal language.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gd61982af991f36e5a85e311ce5044af4" title="Question 32">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>75503,47876,99410,51351</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is kairos as a rhetorical concept?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="75503">
              <material>
                <mattext texttype="text/plain">The importance of timing in an argument</mattext>
              </material>
            </response_label>
            <response_label ident="47876">
              <material>
                <mattext texttype="text/plain">An appeal to the reader's emotions</mattext>
              </material>
            </response_label>
            <response_label ident="99410">
              <material>
                <mattext texttype="text/plain">An appeal based on the writer's credibility</mattext>
              </material>
            </response_label>
            <response_label ident="51351">
              <material>
                <mattext texttype="text/plain">The use of facts and statistics to support a claim</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">47876</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="47876_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">99410</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="99410_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">51351</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="51351_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">75503</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="47876_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Kairos refers to the timing of an argument—choosing the right moment to make your case. It is not an emotional appeal, a credibility appeal, or a logical appeal using facts. The reading introduces kairos briefly and notes it will be covered in greater detail in W03 of the course.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="99410_fb">
