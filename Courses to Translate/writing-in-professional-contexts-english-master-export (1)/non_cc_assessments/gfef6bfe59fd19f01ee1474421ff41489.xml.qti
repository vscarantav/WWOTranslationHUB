              <material>
                <mattext texttype="text/plain">Use AI for the task and note it in your submission so the instructor is aware</mattext>
              </material>
            </response_label>
            <response_label ident="58020">
              <material>
                <mattext texttype="text/plain">Skip the assignment until you receive a clear answer from your instructor</mattext>
