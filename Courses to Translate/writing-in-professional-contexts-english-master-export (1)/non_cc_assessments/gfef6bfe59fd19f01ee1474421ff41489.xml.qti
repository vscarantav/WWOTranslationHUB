      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does the term &lt;em&gt;persuasion&lt;/em&gt; mean in the context of writing?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="45204">
              <material>
                <mattext texttype="text/plain">The act of convincing a reader to do or believe something through writing</mattext>
              </material>
            </response_label>
            <response_label ident="28281">
              <material>
                <mattext texttype="text/plain">The use of formal language to establish credibility with an audience</mattext>
              </material>
            </response_label>
            <response_label ident="28649">
              <material>
                <mattext texttype="text/plain">The process of organizing ideas into paragraphs and sections</mattext>
              </material>
            </response_label>
            <response_label ident="58523">
              <material>
                <mattext texttype="text/plain">The method of citing sources to support an argument</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
