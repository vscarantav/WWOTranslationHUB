    <item ident="gc65ef67dd639670e4f2f5b7f946d5921" title="Question 40">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>71235,63064,36708,59469</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does the term &lt;em&gt;stance&lt;/em&gt; mean in writing?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="71235">
              <material>
                <mattext texttype="text/plain">The attitude or position a writer takes toward a topic</mattext>
              </material>
            </response_label>
            <response_label ident="63064">
              <material>
                <mattext texttype="text/plain">The format a writer uses to organize an essay</mattext>
              </material>
            </response_label>
            <response_label ident="36708">
              <material>
                <mattext texttype="text/plain">The length of time a writer spends researching a topic</mattext>
              </material>
            </response_label>
            <response_label ident="59469">
              <material>
                <mattext texttype="text/plain">The number of sources a writer uses to support a claim</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">63064</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="63064_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">36708</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="36708_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">59469</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="59469_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">71235</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="63064_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Stance refers to a writer's attitude or standpoint on a topic. It is closely connected to the angle and argument of the essay. Stance is not about formatting, research time, or the number of sources used. When you take a stance, you commit to a position and then support it with evidence throughout your writing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="36708_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Stance refers to a writer's attitude or standpoint on a topic. It is closely connected to the angle and argument of the essay. Stance is not about formatting, research time, or the number of sources used. When you take a stance, you commit to a position and then support it with evidence throughout your writing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
