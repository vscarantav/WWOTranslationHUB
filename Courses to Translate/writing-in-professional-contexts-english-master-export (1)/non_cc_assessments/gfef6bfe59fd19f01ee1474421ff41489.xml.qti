          <mattext texttype="text/html">&lt;div&gt;According to the reading, what should you do when you are unsure whether a specific writing task permits AI use?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9288">
              <material>
                <mattext texttype="text/plain">Choose the approach that requires more of your own effort, because that choice is always consistent with the spirit of the course</mattext>
              </material>
            </response_label>
            <response_label ident="84247">
              <material>
                <mattext texttype="text/plain">Ask a classmate what they plan to do and follow the same approach</mattext>
