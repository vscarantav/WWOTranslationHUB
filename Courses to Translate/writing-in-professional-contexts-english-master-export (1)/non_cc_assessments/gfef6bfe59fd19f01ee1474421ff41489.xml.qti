    <item ident="g69eced5fbe3e093a927e9816a1af13db" title="Question 44">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>88732,10124,71477,54280</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;According to the reading, what is one reason clear and simple English is often more effective than complex language in international business communication?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="88732">
              <material>
                <mattext texttype="text/plain">People from different countries and professional backgrounds can understand simple, direct language more easily.</mattext>
              </material>
            </response_label>
            <response_label ident="10124">
              <material>
                <mattext texttype="text/plain">Simple language signals that the writer is not an expert and is being humble.</mattext>
              </material>
            </response_label>
            <response_label ident="71477">
              <material>
                <mattext texttype="text/plain">Complex language is reserved for academic writing and is not permitted in business settings.</mattext>
              </material>
            </response_label>
            <response_label ident="54280">
              <material>
                <mattext texttype="text/plain">Simple language takes less time to translate and costs less for international companies.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">10124</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="10124_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">71477</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="71477_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">54280</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="54280_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">88732</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="10124_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The reading states that in international business, simple and clear English communicates more effectively because it can be understood by professionals from many different countries and backgrounds. A software engineer in Brazil, a marketing manager in Kenya, and a finance director in Thailand all benefit from straightforward communication. The other options introduce reasons not stated or supported in the reading.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="71477_fb">
        <flow_mat>
