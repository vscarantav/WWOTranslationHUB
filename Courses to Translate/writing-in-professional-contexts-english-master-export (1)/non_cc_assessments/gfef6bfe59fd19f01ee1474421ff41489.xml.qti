          <mattext texttype="text/html">&lt;div&gt;According to the reading, what is the first step in developing a thesis statement?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="70411">
              <material>
                <mattext texttype="text/plain">Identifying the broad topic you will write about</mattext>
              </material>
            </response_label>
            <response_label ident="42600">
              <material>
                <mattext texttype="text/plain">Writing a complete draft of the essay</mattext>
              </material>
            </response_label>
            <response_label ident="10817">
              <material>
                <mattext texttype="text/plain">Gathering all the evidence you plan to use</mattext>
              </material>
            </response_label>
            <response_label ident="4680">
              <material>
                <mattext texttype="text/plain">Deciding which rhetorical appeal to use</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">42600</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="42600_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">10817</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="10817_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4680</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4680_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">70411</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="42600_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The reading outlines a six-step process for developing a thesis statement. The first step is to identify the broad topic. Writing a draft, gathering evidence, and choosing a rhetorical appeal are not steps in developing a thesis but come later in the writing process. Starting with the broad topic gives you a foundation to narrow and focus your argument.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="10817_fb">
