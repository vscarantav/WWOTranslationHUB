            <fieldentry>55756,30143,8868,40699</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is a transition in writing?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="55756">
              <material>
                <mattext texttype="text/plain">A word or phrase that connects one idea to another</mattext>
              </material>
