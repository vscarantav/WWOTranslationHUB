      <itemfeedback ident="28281_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Persuasion is the act of convincing someone to do or believe something. It is not about formal language, organization, or citation. Persuasive writing uses tools such as rhetorical appeals—logos, pathos, and ethos—to move a reader toward the writer's position.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
