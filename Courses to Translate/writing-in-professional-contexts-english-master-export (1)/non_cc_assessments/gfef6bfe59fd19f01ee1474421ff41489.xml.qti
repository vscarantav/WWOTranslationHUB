      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which rhetorical appeal uses facts, statistics, and logical reasoning to persuade a reader?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="23190">
              <material>
                <mattext texttype="text/plain">Logos</mattext>
              </material>
            </response_label>
            <response_label ident="48261">
              <material>
                <mattext texttype="text/plain">Pathos</mattext>
              </material>
            </response_label>
            <response_label ident="89117">
              <material>
                <mattext texttype="text/plain">Ethos</mattext>
              </material>
            </response_label>
            <response_label ident="11582">
              <material>
                <mattext texttype="text/plain">Kairos</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">48261</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="48261_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">89117</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="89117_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">11582</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="11582_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">23190</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="48261_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Logos is the rhetorical appeal that relies on logic, facts, and reasoning. Pathos appeals to the reader's emotions. Ethos appeals to the writer's credibility and trustworthiness. Kairos relates to the timing of an argument and will be covered in a later week.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="89117_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Logos is the rhetorical appeal that relies on logic, facts, and reasoning. Pathos appeals to the reader's emotions. Ethos appeals to the writer's credibility and trustworthiness. Kairos relates to the timing of an argument and will be covered in a later week.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="11582_fb">
