    <item ident="g6007c2bccc34552995a0b701dede4e92" title="Question 3">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>55892,79745,80249,53543</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does it mean to write concisely?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="55892">
              <material>
                <mattext texttype="text/plain">To express your ideas using only the words necessary to communicate your meaning</mattext>
              </material>
            </response_label>
            <response_label ident="79745">
              <material>
                <mattext texttype="text/plain">To use formal vocabulary and long sentences to sound professional</mattext>
              </material>
            </response_label>
            <response_label ident="80249">
              <material>
                <mattext texttype="text/plain">To write as many details as possible so the reader fully understands</mattext>
              </material>
            </response_label>
            <response_label ident="53543">
              <material>
                <mattext texttype="text/plain">To avoid using any technical terms in your writing</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">79745</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="79745_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">80249</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="80249_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">53543</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="53543_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">55892</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="79745_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Writing concisely means removing unnecessary words while keeping your meaning clear. It does not mean using long sentences, adding more detail, or avoiding technical terms. Concise writing is direct and efficient, not long or overly detailed.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="80249_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Writing concisely means removing unnecessary words while keeping your meaning clear. It does not mean using long sentences, adding more detail, or avoiding technical terms. Concise writing is direct and efficient, not long or overly detailed.</mattext>
          </material>
        </flow_mat>
