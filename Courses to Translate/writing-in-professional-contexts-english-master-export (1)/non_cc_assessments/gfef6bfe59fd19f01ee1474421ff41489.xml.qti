      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;According to the reading, what is one way scientific writing differs from personal narrative writing in its use of rhetorical appeals?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="91298">
              <material>
                <mattext texttype="text/plain">Scientific writing relies heavily on logos, while personal narratives often use pathos</mattext>
              </material>
            </response_label>
            <response_label ident="81203">
              <material>
                <mattext texttype="text/plain">Scientific writing relies heavily on pathos, while personal narratives often use logos</mattext>
              </material>
            </response_label>
            <response_label ident="34859">
              <material>
                <mattext texttype="text/plain">Scientific writing avoids all rhetorical appeals, while personal narratives use ethos</mattext>
              </material>
            </response_label>
            <response_label ident="34646">
              <material>
                <mattext texttype="text/plain">Scientific writing uses ethos only, while personal narratives avoid all appeals</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
