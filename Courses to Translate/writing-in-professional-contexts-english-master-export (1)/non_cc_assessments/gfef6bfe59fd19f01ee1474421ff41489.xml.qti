    <item ident="g9cc9a93e9beb305d10deea2d9e24baa3" title="Question 27">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>6997,48213,49724,32526</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following is the best example of a strong thesis statement?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6997">
              <material>
                <mattext texttype="text/plain">"Online education allows working adults to advance their careers while maintaining family and work responsibilities."</mattext>
              </material>
            </response_label>
            <response_label ident="48213">
              <material>
                <mattext texttype="text/plain">"Online education is good for working adults."</mattext>
              </material>
            </response_label>
            <response_label ident="49724">
              <material>
                <mattext texttype="text/plain">"There are many factors to consider when examining the question of online education."</mattext>
              </material>
            </response_label>
            <response_label ident="32526">
              <material>
                <mattext texttype="text/plain">"Online education has existed for many years and continues to grow in popularity."</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">48213</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="48213_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">49724</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="49724_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">32526</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="32526_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6997</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="48213_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;A strong thesis statement takes a clear, specific position on a focused topic. "Online education is good for working adults" is too vague. "There are many factors to consider" does not take a position. "Online education has existed for many years" only states a fact. The correct answer names a specific topic—online education for working adults—and states a specific angle about career advancement and balancing responsibilities.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="49724_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;A strong thesis statement takes a clear, specific position on a focused topic. "Online education is good for working adults" is too vague. "There are many factors to consider" does not take a position. "Online education has existed for many years" only states a fact. The correct answer names a specific topic—online education for working adults—and states a specific angle about career advancement and balancing responsibilities.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="32526_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;A strong thesis statement takes a clear, specific position on a focused topic. "Online education is good for working adults" is too vague. "There are many factors to consider" does not take a position. "Online education has existed for many years" only states a fact. The correct answer names a specific topic—online education for working adults—and states a specific angle about career advancement and balancing responsibilities.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
