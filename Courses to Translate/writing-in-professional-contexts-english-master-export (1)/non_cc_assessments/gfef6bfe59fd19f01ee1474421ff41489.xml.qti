    <item ident="gdda042a2e5082f884eb820f4caa6eccb" title="Question 17">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>91698,51773,79597,66884</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is a growth accelerator when using AI in a writing course?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="91698">
              <material>
                <mattext texttype="text/plain">A way of using AI to give feedback on work you have already written, while you keep the writing and revision work yourself</mattext>
              </material>
            </response_label>
            <response_label ident="51773">
              <material>
                <mattext texttype="text/plain">A way of using AI to rewrite your sentences so they are more concise and professional</mattext>
              </material>
            </response_label>
            <response_label ident="79597">
              <material>
                <mattext texttype="text/plain">A way of using AI to generate a thesis statement based on your topic</mattext>
              </material>
            </response_label>
            <response_label ident="66884">
              <material>
                <mattext texttype="text/plain">A way of using AI to complete writing tasks faster so you can submit assignments on time</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">51773</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="51773_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">79597</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="79597_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">66884</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="66884_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">91698</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="51773_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A growth accelerator keeps the work with you. It asks AI to observe or identify a problem in writing you have already done, then leaves the fixing to you. Having AI rewrite sentences, generate a thesis, or complete tasks on your behalf are all examples of a dependence trap, not a growth accelerator. The skill only develops when you do the work yourself.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="79597_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A growth accelerator keeps the work with you. It asks AI to observe or identify a problem in writing you have already done, then leaves the fixing to you. Having AI rewrite sentences, generate a thesis, or complete tasks on your behalf are all examples of a dependence trap, not a growth accelerator. The skill only develops when you do the work yourself.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="66884_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A growth accelerator keeps the work with you. It asks AI to observe or identify a problem in writing you have already done, then leaves the fixing to you. Having AI rewrite sentences, generate a thesis, or complete tasks on your behalf are all examples of a dependence trap, not a growth accelerator. The skill only develops when you do the work yourself.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g5727f89d0cd02be17869b9db57734914" title="Question 18">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>30344,67482,75183,30075</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is a dependence trap when using AI in a writing course?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="30344">
              <material>
                <mattext texttype="text/plain">Asking AI to produce or rewrite writing for you, which removes the skill-building from your own work</mattext>
              </material>
            </response_label>
            <response_label ident="67482">
              <material>
                <mattext texttype="text/plain">Asking AI to identify problems in a draft you have already written, without relying on it to rewrite the text for you</mattext>
              </material>
            </response_label>
            <response_label ident="75183">
              <material>
                <mattext texttype="text/plain">Asking AI to explain a grammar rule so you can apply it independently in your own writing</mattext>
              </material>
            </response_label>
            <response_label ident="30075">
              <material>
                <mattext texttype="text/plain">Asking AI to check whether your paragraph has one main idea without rewriting it</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">67482</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="67482_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">75183</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="75183_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">30075</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="30075_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">30344</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="67482_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A dependence trap occurs when you ask AI to do the writing work for you, such as rewriting a sentence or generating a thesis. This produces a result but does not build the skill. Asking AI to identify problems in your own draft, explain a rule, or observe whether your paragraph stays focused without rewriting it are all examples of using AI as a growth accelerator.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="75183_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A dependence trap occurs when you ask AI to do the writing work for you, such as rewriting a sentence or generating a thesis. This produces a result but does not build the skill. Asking AI to identify problems in your own draft, explain a rule, or observe whether your paragraph stays focused without rewriting it are all examples of using AI as a growth accelerator.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="30075_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A dependence trap occurs when you ask AI to do the writing work for you, such as rewriting a sentence or generating a thesis. This produces a result but does not build the skill. Asking AI to identify problems in your own draft, explain a rule, or observe whether your paragraph stays focused without rewriting it are all examples of using AI as a growth accelerator.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gdfbcb27e76b2304533674dd7fe08fa09" title="Question 19">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>85654,31979,64963,69278</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is academic voice in writing?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="85654">
              <material>
                <mattext texttype="text/plain">The specific way a writer organizes and expresses thinking that reflects their own experience, reasoning, and perspective</mattext>
              </material>
            </response_label>
            <response_label ident="31979">
              <material>
                <mattext texttype="text/plain">The formal vocabulary a writer uses to sound educated and professional</mattext>
              </material>
            </response_label>
            <response_label ident="64963">
              <material>
                <mattext texttype="text/plain">The citation style a writer follows when referencing outside sources</mattext>
              </material>
            </response_label>
            <response_label ident="69278">
              <material>
                <mattext texttype="text/plain">The sentence length a writer uses to match the expectations of an academic audience</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">31979</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="31979_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">64963</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="64963_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">69278</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="69278_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">85654</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="31979_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Voice is not vocabulary level, citation style, or sentence length. Voice is the evidence that you did the intellectual work. It reflects your reasoning and perspective and develops through practice. AI-generated writing does not carry your voice because the thinking behind it was not yours.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="64963_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Voice is not vocabulary level, citation style, or sentence length. Voice is the evidence that you did the intellectual work. It reflects your reasoning and perspective and develops through practice. AI-generated writing does not carry your voice because the thinking behind it was not yours.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="69278_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Voice is not vocabulary level, citation style, or sentence length. Voice is the evidence that you did the intellectual work. It reflects your reasoning and perspective and develops through practice. AI-generated writing does not carry your voice because the thinking behind it was not yours.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g591ed329913ca22e520a55540434de9f" title="Question 2">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>73059,49104,15777,51859</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Where does a topic sentence most commonly appear in a paragraph?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="73059">
              <material>
                <mattext texttype="text/plain">At the beginning of the paragraph</mattext>
              </material>
            </response_label>
            <response_label ident="49104">
              <material>
                <mattext texttype="text/plain">In the middle of the paragraph</mattext>
              </material>
            </response_label>
            <response_label ident="15777">
              <material>
                <mattext texttype="text/plain">At the end of the paragraph</mattext>
              </material>
            </response_label>
            <response_label ident="51859">
              <material>
                <mattext texttype="text/plain">In a separate introductory paragraph</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">49104</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="49104_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">15777</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="15777_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">51859</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="51859_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">73059</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="49104_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A topic sentence most commonly appears at the beginning of a paragraph. This placement tells the reader immediately what the paragraph will discuss. Placing it in the middle or at the end would delay the reader's understanding of the paragraph's main idea.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="15777_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A topic sentence most commonly appears at the beginning of a paragraph. This placement tells the reader immediately what the paragraph will discuss. Placing it in the middle or at the end would delay the reader's understanding of the paragraph's main idea.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="51859_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A topic sentence most commonly appears at the beginning of a paragraph. This placement tells the reader immediately what the paragraph will discuss. Placing it in the middle or at the end would delay the reader's understanding of the paragraph's main idea.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gebb09be4f1ec9fa70e88740708e333a5" title="Question 20">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>91440,45643,96939,9065</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the difference between a process task and a product task in writing?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="91440">
              <material>
                <mattext texttype="text/plain">A process task builds a skill through the decisions you make while writing; a product task focuses on producing a clean, usable result.</mattext>
              </material>
            </response_label>
            <response_label ident="45643">
              <material>
                <mattext texttype="text/plain">A process task is completed individually; a product task is completed as a group.</mattext>
              </material>
            </response_label>
            <response_label ident="96939">
              <material>
                <mattext texttype="text/plain">A process task requires more words; a product task requires fewer words.</mattext>
              </material>
            </response_label>
            <response_label ident="9065">
              <material>
                <mattext texttype="text/plain">A process task is graded on effort; a product task is graded on accuracy.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">45643</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="45643_fb"/>
