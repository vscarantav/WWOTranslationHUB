      <itemfeedback ident="65829_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A professional tone with business language is appropriate for employers in formal documents such as cover letters and workplace reports. Friends, family members, and young children are audiences that call for casual or conversational language. Matching tone to audience is a key skill in effective writing.</mattext>
          </material>
        </flow_mat>
