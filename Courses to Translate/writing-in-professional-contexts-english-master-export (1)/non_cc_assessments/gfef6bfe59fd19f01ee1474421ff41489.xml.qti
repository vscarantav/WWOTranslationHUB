    <item ident="ge34036477ec66540583176d777875584" title="Question 1">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>49201,55070,84434,73929</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is a thesis statement?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="49201">
              <material>
                <mattext texttype="text/plain">A single sentence that states the topic and main argument of an essay</mattext>
              </material>
            </response_label>
            <response_label ident="55070">
              <material>
                <mattext texttype="text/plain">A paragraph that introduces the background of a topic</mattext>
              </material>
            </response_label>
            <response_label ident="84434">
              <material>
                <mattext texttype="text/plain">A sentence that summarizes one paragraph in an essay</mattext>
              </material>
            </response_label>
            <response_label ident="73929">
              <material>
                <mattext texttype="text/plain">A list of evidence that supports the writer's position</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">55070</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="55070_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">84434</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="84434_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">73929</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="73929_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">49201</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="55070_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">A thesis statement is not a paragraph, a summary of paragraph, or a list of evidence. It is one specific sentence that tells the reader what topic you are writing about and what position or angle you take on that topic.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="84434_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">A thesis statement is not a paragraph, a summary of paragraph, or a list of evidence. It is one specific sentence that tells the reader what topic you are writing about and what position or angle you take on that topic.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="73929_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">A thesis statement is not a paragraph, a summary of paragraph, or a list of evidence. It is one specific sentence that tells the reader what topic you are writing about and what position or angle you take on that topic.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gae17a34c6a53f8d5b3060552593da49a" title="Question 10">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>75242,53731,20129,90058</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does ethos appeal to in an audience?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="75242">
              <material>
                <mattext texttype="text/plain">The writer's credibility and trustworthiness</mattext>
              </material>
            </response_label>
            <response_label ident="53731">
              <material>
                <mattext texttype="text/plain">The reader's emotions and personal experiences</mattext>
              </material>
            </response_label>
            <response_label ident="20129">
              <material>
                <mattext texttype="text/plain">The use of facts, statistics, and reasoning</mattext>
              </material>
            </response_label>
            <response_label ident="90058">
              <material>
                <mattext texttype="text/plain">The timing of the argument</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">53731</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="53731_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">20129</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="20129_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">90058</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="90058_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">75242</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="53731_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Ethos appeals to the writer's credibility and trustworthiness, not to emotions, facts, or timing. Appealing to emotions is pathos. Appealing through facts and reasoning is logos. Timing is kairos, which is introduced in a later week.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="20129_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Ethos appeals to the writer's credibility and trustworthiness, not to emotions, facts, or timing. Appealing to emotions is pathos. Appealing through facts and reasoning is logos. Timing is kairos, which is introduced in a later week.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="90058_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Ethos appeals to the writer's credibility and trustworthiness, not to emotions, facts, or timing. Appealing to emotions is pathos. Appealing through facts and reasoning is logos. Timing is kairos, which is introduced in a later week.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gf08d1934d9f84ae07ed8dbca88e9e7b8" title="Question 11">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>55782,53982,21854,49990</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the difference between a formal tone and a conversational tone?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="55782">
              <material>
                <mattext texttype="text/plain">A formal tone uses professional language without contractions, while a conversational tone uses informal language and may include contractions.</mattext>
              </material>
            </response_label>
            <response_label ident="53982">
              <material>
                <mattext texttype="text/plain">A formal tone uses shorter sentences, while a conversational tone uses longer sentences.</mattext>
              </material>
            </response_label>
            <response_label ident="21854">
              <material>
                <mattext texttype="text/plain">A formal tone is used only in spoken communication, while a conversational tone is used only in writing.</mattext>
              </material>
            </response_label>
            <response_label ident="49990">
              <material>
                <mattext texttype="text/plain">A formal tone avoids all examples, while a conversational tone relies entirely on examples.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">53982</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="53982_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">21854</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="21854_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">49990</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="49990_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">55782</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="53982_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Tone is not determined by sentence length, the medium of communication, or the use of examples. A formal tone uses professional, objective language without contractions and is common in essays and workplace documents. A conversational tone is more relaxed and personal, is common in texts and messages to friends, and may contain contractions.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="21854_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Tone is not determined by sentence length, the medium of communication, or the use of examples. A formal tone uses professional, objective language without contractions and is common in essays and workplace documents. A conversational tone is more relaxed and personal, is common in texts and messages to friends, and may contain contractions.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="49990_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Tone is not determined by sentence length, the medium of communication, or the use of examples. A formal tone uses professional, objective language without contractions and is common in essays and workplace documents. A conversational tone is more relaxed and personal, is common in texts and messages to friends, and may contain contractions.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g297c4657139b46579508529f5b4d50c3" title="Question 12">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>68219,23742,10374,11696</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;How many main ideas should a single paragraph contain?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="68219">
              <material>
                <mattext texttype="text/plain">One</mattext>
              </material>
            </response_label>
            <response_label ident="23742">
              <material>
                <mattext texttype="text/plain">Two</mattext>
              </material>
            </response_label>
            <response_label ident="10374">
              <material>
                <mattext texttype="text/plain">Three</mattext>
              </material>
            </response_label>
            <response_label ident="11696">
              <material>
                <mattext texttype="text/plain">As many as needed to fully explain the topic</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">23742</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="23742_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">10374</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="10374_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">11696</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="11696_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">68219</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="23742_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Each paragraph should contain only one main idea. When a writer moves to a new idea, a new paragraph begins. Including two or more main ideas in one paragraph makes it harder for readers to follow and understand the writing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="10374_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Each paragraph should contain only one main idea. When a writer moves to a new idea, a new paragraph begins. Including two or more main ideas in one paragraph makes it harder for readers to follow and understand the writing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="11696_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Each paragraph should contain only one main idea. When a writer moves to a new idea, a new paragraph begins. Including two or more main ideas in one paragraph makes it harder for readers to follow and understand the writing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g7ef439299f37bf391d30f2e15b53aae6" title="Question 13">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>83923,99211,25157,77439</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What two questions should a thesis statement answer?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="83923">
              <material>
                <mattext texttype="text/plain">What topic are you writing about, and what position or angle do you take on that topic?</mattext>
              </material>
            </response_label>
            <response_label ident="99211">
              <material>
                <mattext texttype="text/plain">Who is your audience, and what tone will you use?</mattext>
              </material>
            </response_label>
            <response_label ident="25157">
              <material>
                <mattext texttype="text/plain">What evidence will you use, and how long will your essay be?</mattext>
              </material>
            </response_label>
            <response_label ident="77439">
              <material>
                <mattext texttype="text/plain">What is the background of the topic, and what do other writers say about it?</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">99211</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="99211_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">25157</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="25157_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">77439</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="77439_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">83923</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="99211_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A thesis statement answers two specific questions: what topic you are writing about and what position or angle you take on it. Audience, tone, evidence, essay length, and other writers' views are separate considerations that do not belong in a thesis statement.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="25157_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A thesis statement answers two specific questions: what topic you are writing about and what position or angle you take on it. Audience, tone, evidence, essay length, and other writers' views are separate considerations that do not belong in a thesis statement.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="77439_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A thesis statement answers two specific questions: what topic you are writing about and what position or angle you take on it. Audience, tone, evidence, essay length, and other writers' views are separate considerations that do not belong in a thesis statement.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g231a6a68977aa07107a6d767d34a2f17" title="Question 14">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>21009,54865,85062,81972</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which of the following best describes a topic sentence?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="21009">
              <material>
                <mattext texttype="text/plain">A sentence that states the main idea of a single paragraph</mattext>
              </material>
            </response_label>
            <response_label ident="54865">
              <material>
                <mattext texttype="text/plain">A sentence that summarizes the entire essay in one line</mattext>
              </material>
            </response_label>
            <response_label ident="85062">
              <material>
                <mattext texttype="text/plain">A sentence that provides background information before the main argument</mattext>
              </material>
            </response_label>
            <response_label ident="81972">
              <material>
                <mattext texttype="text/plain">A sentence that lists the evidence used to support the paragraph</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">54865</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="54865_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">85062</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="85062_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">81972</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="81972_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">21009</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="54865_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A topic sentence controls one paragraph, not the entire essay. That is the role of a thesis statement. A topic sentence is not background information or a list of evidence. It introduces the one main idea that the rest of the paragraph will develop and support.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="85062_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A topic sentence controls one paragraph, not the entire essay. That is the role of a thesis statement. A topic sentence is not background information or a list of evidence. It introduces the one main idea that the rest of the paragraph will develop and support.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="81972_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A topic sentence controls one paragraph, not the entire essay. That is the role of a thesis statement. A topic sentence is not background information or a list of evidence. It introduces the one main idea that the rest of the paragraph will develop and support.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g7a3c41a1941c608bf052d29976430647" title="Question 15">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>40304,65829,58780,87459</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which audience would most likely require a professional tone with business language?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="40304">
              <material>
                <mattext texttype="text/plain">An employer reading a cover letter or workplace report</mattext>
              </material>
            </response_label>
            <response_label ident="65829">
              <material>
                <mattext texttype="text/plain">A close friend receiving a personal text message</mattext>
              </material>
            </response_label>
            <response_label ident="58780">
              <material>
                <mattext texttype="text/plain">A family member reading a casual email</mattext>
              </material>
            </response_label>
            <response_label ident="87459">
              <material>
                <mattext texttype="text/plain">A young child listening to an explanation</mattext>
              </material>
            </response_label>
