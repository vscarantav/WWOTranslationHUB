        </respcondition>
      </resprocessing>
      <itemfeedback ident="11075_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The module quotes Alma 37:6—"by small and simple things are great things brought to pass"—to explain that daily choices about how students use sources, acknowledge assistance, and interact with AI build the character that shapes their future. Matthew 25 is also referenced in the module, but in relation to the Parable of the Talents and the principle of developing competence, not small daily choices. The other scriptures do not appear in the module.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
