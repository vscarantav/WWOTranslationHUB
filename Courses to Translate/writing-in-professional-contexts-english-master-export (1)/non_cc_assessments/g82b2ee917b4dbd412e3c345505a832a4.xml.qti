    <item ident="g55b92031dc460eafc1cb054d172b1d11" title="Question 16">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>3312,70904,37221,11932</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is direct quotation?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="3312">
              <material>
                <mattext texttype="text/plain">Reproducing an author's exact words inside quotation marks with a citation</mattext>
              </material>
            </response_label>
            <response_label ident="70904">
              <material>
                <mattext texttype="text/plain">Restating an author's argument in your own words and sentence structure</mattext>
              </material>
            </response_label>
            <response_label ident="37221">
              <material>
                <mattext texttype="text/plain">Condensing a source to its main idea without using the author's words</mattext>
              </material>
            </response_label>
            <response_label ident="11932">
              <material>
                <mattext texttype="text/plain">Referencing a source by its title without including any of its content</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">70904</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="70904_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">37221</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="37221_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">11932</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="11932_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">3312</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="70904_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Direct quotation means reproducing an author's exact words, placing them inside quotation marks, and providing a citation. Restating an argument in your own words and structure is paraphrasing. Condensing a source to its main idea is summarizing. Referencing a source by title alone, without engaging with its content, is not a recognized source-use method in academic writing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="37221_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Direct quotation means reproducing an author's exact words, placing them inside quotation marks, and providing a citation. Restating an argument in your own words and structure is paraphrasing. Condensing a source to its main idea is summarizing. Referencing a source by title alone, without engaging with its content, is not a recognized source-use method in academic writing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="11932_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Direct quotation means reproducing an author's exact words, placing them inside quotation marks, and providing a citation. Restating an argument in your own words and structure is paraphrasing. Condensing a source to its main idea is summarizing. Referencing a source by title alone, without engaging with its content, is not a recognized source-use method in academic writing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g11b034b0df7f9ed25746b5b1357fa92a" title="Question 17">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>38776,88106,55144,93596</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What type of information should students never enter into an AI tool?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="38776">
              <material>
                <mattext texttype="text/plain">Full names, contact information, birth dates, or sensitive personal stories belonging to others</mattext>
              </material>
            </response_label>
            <response_label ident="88106">
              <material>
                <mattext texttype="text/plain">Their own thesis statement or essay topic</mattext>
              </material>
            </response_label>
            <response_label ident="55144">
              <material>
                <mattext texttype="text/plain">Grammar questions or requests for concept explanations</mattext>
              </material>
            </response_label>
            <response_label ident="93596">
              <material>
                <mattext texttype="text/plain">The title and author of a source they are citing</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">88106</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="88106_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">55144</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="55144_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">93596</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="93596_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">38776</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="88106_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;AI tools are not private, so students must never enter identifying or sensitive information about other people—including full names, contact details, birth dates, immigration status, health information, or personal stories shared by family members. Entering your own thesis or essay topic carries lower risk and is not specifically prohibited. Asking grammar or concept questions is an approved use of AI. Entering a source title and author for citation help does not raise the same privacy concern.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="55144_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;AI tools are not private, so students must never enter identifying or sensitive information about other people—including full names, contact details, birth dates, immigration status, health information, or personal stories shared by family members. Entering your own thesis or essay topic carries lower risk and is not specifically prohibited. Asking grammar or concept questions is an approved use of AI. Entering a source title and author for citation help does not raise the same privacy concern.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="93596_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;AI tools are not private, so students must never enter identifying or sensitive information about other people—including full names, contact details, birth dates, immigration status, health information, or personal stories shared by family members. Entering your own thesis or essay topic carries lower risk and is not specifically prohibited. Asking grammar or concept questions is an approved use of AI. Entering a source title and author for citation help does not raise the same privacy concern.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g2273b53b321dd3af4431938cd06defe8" title="Question 18">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>99762,97858,40092,60406</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is paraphrasing?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="99762">
              <material>
                <mattext texttype="text/plain">Restating a specific passage in your own words and your own sentence structure</mattext>
              </material>
            </response_label>
            <response_label ident="97858">
              <material>
                <mattext texttype="text/plain">Copying a passage from a source and placing it inside quotation marks</mattext>
              </material>
            </response_label>
            <response_label ident="40092">
              <material>
                <mattext texttype="text/plain">Condensing an entire source to one or two sentences in your own words</mattext>
              </material>
            </response_label>
            <response_label ident="60406">
              <material>
                <mattext texttype="text/plain">Replacing individual words in a source with synonyms</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">97858</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="97858_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">40092</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="40092_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">60406</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="60406_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">99762</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="97858_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Paraphrasing means restating a specific passage using both your own words and your own sentence structure. It requires genuine understanding of the original content. Copying a passage and placing it in quotation marks is direct quotation. Condensing an entire source to a brief statement is summarizing. Replacing only individual words with synonyms, sometimes called the thesaurus method, is still plagiarism, even when the source is cited, because the original structure remains unchanged.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="40092_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Paraphrasing means restating a specific passage using both your own words and your own sentence structure. It requires genuine understanding of the original content. Copying a passage and placing it in quotation marks is direct quotation. Condensing an entire source to a brief statement is summarizing. Replacing only individual words with synonyms, sometimes called the thesaurus method, is still plagiarism, even when the source is cited, because the original structure remains unchanged.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="60406_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Paraphrasing means restating a specific passage using both your own words and your own sentence structure. It requires genuine understanding of the original content. Copying a passage and placing it in quotation marks is direct quotation. Condensing an entire source to a brief statement is summarizing. Replacing only individual words with synonyms, sometimes called the thesaurus method, is still plagiarism, even when the source is cited, because the original structure remains unchanged.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g8baf72cedc42c23211235bc43f9df32d" title="Question 19">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>77722,41730,88373,69622</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which of the following is an example of cheating in WRIT 101?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="77722">
              <material>
                <mattext texttype="text/plain">Asking a family member to write or substantially revise your draft</mattext>
              </material>
            </response_label>
            <response_label ident="41730">
              <material>
                <mattext texttype="text/plain">Asking a family member to read your draft and offer encouragement</mattext>
              </material>
            </response_label>
            <response_label ident="88373">
              <material>
                <mattext texttype="text/plain">Asking your instructor a question about the assignment requirements</mattext>
              </material>
            </response_label>
            <response_label ident="69622">
              <material>
                <mattext texttype="text/plain">Using a dictionary to check the spelling of a word in your essay</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">41730</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="41730_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">88373</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="88373_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">69622</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="69622_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">77722</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="41730_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Cheating occurs when someone other than the student writes or substantially revises the student's work. A family member providing encouragement and general feedback is a welcome form of support. Asking your instructor for clarification is an appropriate and encouraged behavior. Using a dictionary is a standard writing tool and is not a form of cheating.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="88373_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Cheating occurs when someone other than the student writes or substantially revises the student's work. A family member providing encouragement and general feedback is a welcome form of support. Asking your instructor for clarification is an appropriate and encouraged behavior. Using a dictionary is a standard writing tool and is not a form of cheating.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="69622_fb">
        <flow_mat>
