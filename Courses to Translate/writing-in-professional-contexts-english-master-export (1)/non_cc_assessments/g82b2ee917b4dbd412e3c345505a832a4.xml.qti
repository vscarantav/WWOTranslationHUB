    <item ident="gddfefd9275bb7fadd84ca3e03b13e11f" title="Question 43">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>41698,5716,15051,44037</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does the module say a student should do if uncertain whether personal background knowledge requires a citation?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="41698">
              <material>
                <mattext texttype="text/plain">Ask the instructor before submitting the assignment</mattext>
              </material>
            </response_label>
            <response_label ident="5716">
              <material>
                <mattext texttype="text/plain">Omit the information to avoid learning how to cite it</mattext>
              </material>
            </response_label>
            <response_label ident="15051">
              <material>
                <mattext texttype="text/plain">Include the information without a citation since it is personal knowledge</mattext>
              </material>
            </response_label>
            <response_label ident="44037">
              <material>
                <mattext texttype="text/plain">Search for a published source and replace the personal knowledge entirely</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5716</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5716_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">15051</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="15051_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">44037</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="44037_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">41698</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="5716_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The module advises students to ask their instructor before submitting if they are uncertain whether personal background knowledge requires a citation. Omitting the information, submitting it without a citation, or replacing it entirely with a published source are not the recommended actions. The instructor can help the student find the right approach for their specific situation.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="15051_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The module advises students to ask their instructor before submitting if they are uncertain whether personal background knowledge requires a citation. Omitting the information, submitting it without a citation, or replacing it entirely with a published source are not the recommended actions. The instructor can help the student find the right approach for their specific situation.</mattext>
