      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which of the following actions violates content sharing policies?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="27686">
              <material>
                <mattext texttype="text/plain">Uploading a completed assignment to a course-sharing website such as Course Hero</mattext>
              </material>
            </response_label>
            <response_label ident="74355">
              <material>
                <mattext texttype="text/plain">Discussing the assignment prompt with a classmate in a study group</mattext>
              </material>
            </response_label>
            <response_label ident="60862">
              <material>
                <mattext texttype="text/plain">Asking your instructor to review a draft before the final submission deadline</mattext>
              </material>
            </response_label>
            <response_label ident="72360">
              <material>
                <mattext texttype="text/plain">Reading feedback from a previous assignment before starting a new one</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">74355</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="74355_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">60862</varequal>
          </conditionvar>
