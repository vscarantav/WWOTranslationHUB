    <item ident="g03325776f23037ca8f484dbb90279280" title="Question 45">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>54895,58948,13608,29772</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does the module identify as one specific integrity risk when students are from multilingual backgrounds?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="54895">
              <material>
                <mattext texttype="text/plain">Mosaic plagiarism may occur not from dishonesty but from uncertainty about expressing ideas in an unfamiliar language.</mattext>
              </material>
            </response_label>
            <response_label ident="58948">
              <material>
                <mattext texttype="text/plain">Multilingual students may fabricate citations when they lack familiarity with academic research practices.</mattext>
              </material>
            </response_label>
            <response_label ident="13608">
              <material>
                <mattext texttype="text/plain">Multilingual students tend to overuse direct quotation to avoid paraphrasing.</mattext>
              </material>
            </response_label>
            <response_label ident="29772">
              <material>
                <mattext texttype="text/plain">Translation tools automatically produce plagiarized content that students must edit.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">58948</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="58948_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">13608</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="13608_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">29772</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="29772_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">54895</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="58948_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The module explicitly acknowledges that mosaic plagiarism (rearranging or slightly rewording sentences while keeping the original structure)is especially common among multilingual writers, not out of dishonesty, but because of uncertainty about expressing ideas in an unfamiliar language. The module does not suggest multilingual students fabricate citations, overuse direct quotations, or that translation tools automatically produce plagiarized output.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="13608_fb">
        <flow_mat>
