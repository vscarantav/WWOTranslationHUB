            <fieldentry>3098,1093,31018,39020</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is mosaic plagiarism?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="3098">
              <material>
                <mattext texttype="text/plain">Rearranging or slightly rewording someone else's sentences while keeping their original structure</mattext>
              </material>
            </response_label>
            <response_label ident="1093">
              <material>
                <mattext texttype="text/plain">Copying an entire paragraph from a source and placing it in quotation marks</mattext>
              </material>
            </response_label>
            <response_label ident="31018">
              <material>
                <mattext texttype="text/plain">Using more than three direct quotations in a single assignment</mattext>
              </material>
            </response_label>
            <response_label ident="39020">
              <material>
                <mattext texttype="text/plain">Paraphrasing a source without changing the main idea</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
