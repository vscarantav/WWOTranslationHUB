      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What risk does President Dallin H. Oaks connect to depending on others for decisions or resources that a person could provide for themselves?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="48455">
              <material>
                <mattext texttype="text/plain">Spiritual weakening</mattext>
              </material>
            </response_label>
            <response_label ident="48710">
              <material>
                <mattext texttype="text/plain">Academic failure</mattext>
              </material>
            </response_label>
            <response_label ident="80223">
              <material>
                <mattext texttype="text/plain">Loss of professional credentials</mattext>
              </material>
            </response_label>
            <response_label ident="65784">
              <material>
                <mattext texttype="text/plain">Reduced critical thinking skills</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">48710</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="48710_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
