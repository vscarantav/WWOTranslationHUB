          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g67138ee6bb7df9333bee9dfaff2866bf" title="Question 36">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>24040,31960,54965,62896</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;According to the module, what does overuse of direct quotation suggest?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="24040">
              <material>
                <mattext texttype="text/plain">The student is avoiding the harder work of understanding the material.</mattext>
              </material>
            </response_label>
            <response_label ident="31960">
              <material>
                <mattext texttype="text/plain">The student has found strong evidence to support their argument.</mattext>
              </material>
            </response_label>
            <response_label ident="54965">
              <material>
                <mattext texttype="text/plain">The student has read more sources than required for the assignment.</mattext>
              </material>
            </response_label>
            <response_label ident="62896">
              <material>
                <mattext texttype="text/plain">The student has a strong command of academic writing.</mattext>
              </material>
            </response_label>
