        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">17055</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="17055_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">77118</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="77118_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">69841</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="8532_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;WRIT 101 assignments are built around the student's own life—their memories, personal experiences, and family history. This is what makes integrity in this course more personal than in other courses. Published research, news sources, and textbook chapters may support specific assignments, but they are not the foundation of the content. The stories and experiences belong only to the student, which is why no one else can do the work.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
