      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which scripture does the module quote to explain how small daily choices build character?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="66666">
              <material>
                <mattext texttype="text/plain">Alma 37:6—"By small and simple things are great things brought to pass"</mattext>
              </material>
            </response_label>
            <response_label ident="11075">
              <material>
                <mattext texttype="text/plain">Matthew 25—The Parable of the Talents</mattext>
              </material>
            </response_label>
            <response_label ident="84751">
              <material>
                <mattext texttype="text/plain">Doctrine and Covenants 58:27—"Men should be anxiously engaged in a good cause"</mattext>
              </material>
            </response_label>
            <response_label ident="64182">
              <material>
                <mattext texttype="text/plain">Moroni 10:4—A promise about seeking truth with sincere intent</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
