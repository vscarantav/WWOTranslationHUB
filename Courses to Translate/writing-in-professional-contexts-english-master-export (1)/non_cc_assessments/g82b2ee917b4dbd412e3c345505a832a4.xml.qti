          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="94887_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">28875</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="35301_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The module grounds academic integrity in a spiritual principle: choosing honesty in every behavior, including coursework, strengthens a student's relationship with God, while compromise weakens it. Professional preparation, avoiding consequences, and respecting other writers are all valid reasons to maintain integrity, but they are not the spiritual foundation the module identifies as primary.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
