    <item ident="g4c83169617d25e9d092dbeb429c82a7d" title="Question 21">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>25065,61962,37064,66676</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is a product task?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="25065">
              <material>
                <mattext texttype="text/plain">An assignment where the goal is to produce a clean, usable result</mattext>
              </material>
            </response_label>
            <response_label ident="61962">
              <material>
                <mattext texttype="text/plain">An assignment where the goal is to develop a specific skill</mattext>
              </material>
            </response_label>
            <response_label ident="37064">
              <material>
                <mattext texttype="text/plain">An assignment that requires the student to purchase course materials</mattext>
              </material>
            </response_label>
            <response_label ident="66676">
              <material>
                <mattext texttype="text/plain">An assignment that focuses on group collaboration and shared output</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">61962</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="61962_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">37064</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="37064_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">66676</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="66676_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">25065</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="61962_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A product task focuses on producing a finished, usable result. AI assistance may be appropriate for product tasks, as long as the student reviews the output carefully. An assignment focused on developing a skill is a process task, which is the opposite. Purchasing materials and group collaboration are not part of the definition of a product task in this module.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="37064_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A product task focuses on producing a finished, usable result. AI assistance may be appropriate for product tasks, as long as the student reviews the output carefully. An assignment focused on developing a skill is a process task, which is the opposite. Purchasing materials and group collaboration are not part of the definition of a product task in this module.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
