          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is fabrication in academic writing?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="32929">
              <material>
                <mattext texttype="text/plain">Creating false information and presenting it as true</mattext>
              </material>
            </response_label>
            <response_label ident="90685">
              <material>
                <mattext texttype="text/plain">Using a source that is older than five years</mattext>
              </material>
            </response_label>
            <response_label ident="90760">
              <material>
                <mattext texttype="text/plain">Writing more than the required word count for an assignment</mattext>
              </material>
            </response_label>
            <response_label ident="49335">
              <material>
                <mattext texttype="text/plain">Quoting a source without including a page number</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">90685</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="90685_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">90760</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="90760_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">49335</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="49335_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">32929</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="90685_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Fabrication means creating false information—such as inventing events in a personal narrative, making up interview responses, or submitting AI-generated facts without verifying them. Using an older source is a research quality consideration, not fabrication. Exceeding a word count is a formatting issue. Omitting a page number from a citation is an incomplete citation error, not fabrication.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
