    <item ident="g0503b4d936cbf239f95108e4cf6de33e" title="Question 4">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>94358,81375,40674,85003</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What must every major writing assignment in WRIT 101 include at the top of the submission?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="94358">
              <material>
                <mattext texttype="text/plain">A statement disclosing whether or not AI assistance was used</mattext>
              </material>
            </response_label>
            <response_label ident="81375">
              <material>
                <mattext texttype="text/plain">A list of all sources consulted during the writing process</mattext>
              </material>
            </response_label>
            <response_label ident="40674">
              <material>
                <mattext texttype="text/plain">A word count verified by an approved writing tool</mattext>
              </material>
            </response_label>
            <response_label ident="85003">
              <material>
                <mattext texttype="text/plain">A signed agreement confirming the student read the syllabus</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">81375</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="81375_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">40674</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="40674_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">85003</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="85003_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">94358</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="81375_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Every assignment in WRIT 101 requires one disclosure statement at the top. The statement must say either that the student did not use AI assistance or that a named AI tool was used for a specific function, with all ideas and content remaining the student's own. A source list is required in the reference section, not at the top of the document. A word count and a syllabus agreement are not required components of assignment submissions in this module.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="40674_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Every assignment in WRIT 101 requires one disclosure statement at the top. The statement must say either that the student did not use AI assistance or that a named AI tool was used for a specific function, with all ideas and content remaining the student's own. A source list is required in the reference section, not at the top of the document. A word count and a syllabus agreement are not required components of assignment submissions in this module.</mattext>
