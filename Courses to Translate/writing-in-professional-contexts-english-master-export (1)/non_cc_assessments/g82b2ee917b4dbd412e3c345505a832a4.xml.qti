      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What do writing assignments in WRIT 101 draw their content from?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="69841">
              <material>
                <mattext texttype="text/plain">The student's own memories, personal experiences, and family history</mattext>
              </material>
            </response_label>
            <response_label ident="8532">
              <material>
                <mattext texttype="text/plain">Published academic research and peer-reviewed journal articles</mattext>
              </material>
            </response_label>
            <response_label ident="17055">
              <material>
                <mattext texttype="text/plain">Current news events and online reporting</mattext>
              </material>
            </response_label>
            <response_label ident="77118">
              <material>
                <mattext texttype="text/plain">Assigned readings and textbook chapters from the course</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
