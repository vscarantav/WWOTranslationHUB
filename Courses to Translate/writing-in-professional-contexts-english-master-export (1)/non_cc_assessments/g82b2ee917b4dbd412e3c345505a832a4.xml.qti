    <item ident="gcb8a5da2050239dc1b9b5c4472ff8430" title="Question 27">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>59466,12811,80950,27073</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;According to the module, when should direct quotation be used?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="59466">
              <material>
                <mattext texttype="text/plain">Sparingly, when the author's precise language is especially vivid or significant</mattext>
              </material>
            </response_label>
            <response_label ident="12811">
              <material>
                <mattext texttype="text/plain">Whenever a source is referenced, to ensure accuracy</mattext>
              </material>
            </response_label>
            <response_label ident="80950">
              <material>
                <mattext texttype="text/plain">Only in the introduction and conclusion of an essay</mattext>
              </material>
            </response_label>
            <response_label ident="27073">
              <material>
                <mattext texttype="text/plain">Frequently, as the primary method for incorporating sources throughout an assignment</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">12811</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="12811_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">80950</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="80950_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">27073</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="27073_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">59466</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="12811_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Direct quotation should be used sparingly and only when the author's exact wording carries meaning that would be lost through paraphrasing. Overuse of quotation suggests the student is avoiding the harder work of understanding the material. Quoting every referenced source is not required and is discouraged. There is no rule limiting quotations to the introduction and conclusion. Using direct quotation frequently as the primary source method is explicitly discouraged in the module.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="80950_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Direct quotation should be used sparingly and only when the author's exact wording carries meaning that would be lost through paraphrasing. Overuse of quotation suggests the student is avoiding the harder work of understanding the material. Quoting every referenced source is not required and is discouraged. There is no rule limiting quotations to the introduction and conclusion. Using direct quotation frequently as the primary source method is explicitly discouraged in the module.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="27073_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Direct quotation should be used sparingly and only when the author's exact wording carries meaning that would be lost through paraphrasing. Overuse of quotation suggests the student is avoiding the harder work of understanding the material. Quoting every referenced source is not required and is discouraged. There is no rule limiting quotations to the introduction and conclusion. Using direct quotation frequently as the primary source method is explicitly discouraged in the module.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g44205d592de11213823273d24e2039fe" title="Question 28">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
