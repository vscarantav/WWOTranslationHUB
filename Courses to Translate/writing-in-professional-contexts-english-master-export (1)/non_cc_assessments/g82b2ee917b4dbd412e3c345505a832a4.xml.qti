        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">31018</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="31018_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">39020</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="39020_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">3098</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="1093_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Mosaic plagiarism, also called patchwriting, occurs when a writer rearranges or slightly rewords another person's sentences while keeping the original structure, even when the source is acknowledged. Copying a paragraph and placing it in quotation marks with a citation is direct quotation, which is permitted when used and cited correctly. There is no rule in this module limiting the number of quotations based on a specific number. Paraphrasing a source while retaining the main idea is expected and acceptable, as long as the structure is genuinely your own and a citation is provided.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="31018_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Mosaic plagiarism, also called patchwriting, occurs when a writer rearranges or slightly rewords another person's sentences while keeping the original structure, even when the source is acknowledged. Copying a paragraph and placing it in quotation marks with a citation is direct quotation, which is permitted when used and cited correctly. There is no rule in this module limiting the number of quotations based on a specific number. Paraphrasing a source while retaining the main idea is expected and acceptable, as long as the structure is genuinely your own and a citation is provided.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
