            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>66626,50576,40800,55377</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does the module identify as a risk of AI use that Elder Bednar specifically warned about in 2024?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="66626">
              <material>
                <mattext texttype="text/plain">AI's ease can create an addictive influence that causes people to surrender their moral agency.</mattext>
              </material>
            </response_label>
            <response_label ident="50576">
              <material>
                <mattext texttype="text/plain">AI produces inaccurate information that leads students to fail their assignments.</mattext>
              </material>
            </response_label>
            <response_label ident="40800">
              <material>
                <mattext texttype="text/plain">AI tools collect personal data and share it with third parties without consent.</mattext>
              </material>
            </response_label>
            <response_label ident="55377">
              <material>
                <mattext texttype="text/plain">AI replaces human instructors and reduces the quality of university education.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">50576</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="50576_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">40800</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="40800_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">55377</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="55377_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">66626</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="50576_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Elder Bednar warned in 2024 that AI's ease can create a beguiling, addictive, and suffocating influence on the exercise of moral agency, and that people might be seduced into surrendering their agency to a technology that can only think at a lower level. The module does not attribute the other concerns—inaccuracy, data sharing, or replacement of instructors—to Elder Bednar's 2024 warning.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="40800_fb">
