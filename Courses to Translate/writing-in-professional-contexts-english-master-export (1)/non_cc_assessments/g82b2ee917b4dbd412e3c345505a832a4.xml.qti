    <item ident="g00e82c5c3460b8722550d373d11483cb" title="Question 5">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>91898,95778,31355,44829</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is voice integrity in a writing course?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="91898">
              <material>
                <mattext texttype="text/plain">Ensuring that the personality and tone in your writing genuinely come from you</mattext>
              </material>
            </response_label>
            <response_label ident="95778">
              <material>
                <mattext texttype="text/plain">Using formal academic language throughout your assignment in a clear and consistent way</mattext>
              </material>
            </response_label>
            <response_label ident="31355">
              <material>
                <mattext texttype="text/plain">Correcting all grammar and sentence structure errors before submitting your work</mattext>
              </material>
            </response_label>
            <response_label ident="44829">
              <material>
                <mattext texttype="text/plain">Matching the writing style and voice of a published author you admire in your writing</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">95778</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="95778_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">31355</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="31355_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">44829</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="44829_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">91898</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="95778_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Voice integrity means that the personality and tone emerging through your writing choices are authentically yours. It is not about using formal language, though appropriate tone matters. Correcting grammar errors is part of editing, which is separate from voice. Matching another author's style would actually undermine voice integrity, as it replaces your own expression with someone else's patterns.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="31355_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Voice integrity means that the personality and tone emerging through your writing choices are authentically yours. It is not about using formal language, though appropriate tone matters. Correcting grammar errors is part of editing, which is separate from voice. Matching another author's style would actually undermine voice integrity, as it replaces your own expression with someone else's patterns.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
