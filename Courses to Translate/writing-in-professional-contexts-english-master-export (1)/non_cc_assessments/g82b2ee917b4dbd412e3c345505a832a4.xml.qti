    <item ident="g1ca97bf5562220c5ade71bf25b6c492c" title="Question 15">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>48297,98091,11038,13092</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the approved AI prompt for multilingual students who need help expressing an idea in English?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="48297">
              <material>
                <mattext texttype="text/plain">"Help me express this idea more clearly in English while keeping my original meaning and personal voice."</mattext>
              </material>
            </response_label>
            <response_label ident="98091">
              <material>
                <mattext texttype="text/plain">"Rewrite this paragraph so it sounds more fluent in English."</mattext>
              </material>
            </response_label>
            <response_label ident="11038">
              <material>
                <mattext texttype="text/plain">"Translate this sentence from my first language into English."</mattext>
              </material>
            </response_label>
            <response_label ident="13092">
              <material>
                <mattext texttype="text/plain">"Improve the grammar and sentence structure of my entire draft."</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">98091</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="98091_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">11038</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="11038_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">13092</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="13092_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">48297</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="98091_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The approved prompt for multilingual students asks AI to help express a specific idea more clearly in English while preserving the student's original meaning and personal voice. Asking AI to rewrite a paragraph for fluency, translate full sentences, or improve the grammar of an entire draft all go beyond what is permitted—they risk replacing the student's voice and original thinking with AI-generated language. The approved prompt is narrow and specific by design.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="11038_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The approved prompt for multilingual students asks AI to help express a specific idea more clearly in English while preserving the student's original meaning and personal voice. Asking AI to rewrite a paragraph for fluency, translate full sentences, or improve the grammar of an entire draft all go beyond what is permitted—they risk replacing the student's voice and original thinking with AI-generated language. The approved prompt is narrow and specific by design.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
