    <item ident="g504d95f80142d40aac3c2be5b834341b" title="Question 38">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>93718,95362,18664,98754</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does Elder Bednar's personal example of using AI on his own talks demonstrate?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="93718">
              <material>
                <mattext texttype="text/plain">AI can be used to analyze your work after you finish, with all decisions remaining yours.</mattext>
              </material>
            </response_label>
            <response_label ident="95362">
              <material>
                <mattext texttype="text/plain">AI can be used to write a first draft that the author then revises.</mattext>
              </material>
            </response_label>
            <response_label ident="18664">
              <material>
                <mattext texttype="text/plain">AI is most useful for selecting the main argument of a talk or essay.</mattext>
              </material>
            </response_label>
            <response_label ident="98754">
              <material>
                <mattext texttype="text/plain">AI produces better results when given access to the author's full writing history.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">95362</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="95362_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">18664</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="18664_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">98754</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="98754_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">93718</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="95362_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Elder Bednar finishes his talk first, then asks AI to analyze its tone, and uses that feedback to make his own improvements. The talk remains entirely his. This example shows that AI can be a useful analytical tool after the creative and intellectual work is done. It does not endorse AI-assisted drafting, AI-selected arguments, or providing AI with personal writing history.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="18664_fb">
        <flow_mat>
          <material>
