        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="26233">
              <material>
                <mattext texttype="text/plain">Help from the Spirit's influence in learning is lost.</mattext>
              </material>
            </response_label>
            <response_label ident="19763">
              <material>
                <mattext texttype="text/plain">The student receives fewer assignment points but retains spiritual guidance.</mattext>
              </material>
            </response_label>
            <response_label ident="16229">
              <material>
                <mattext texttype="text/plain">The Spirit redirects the student toward better study habits.</mattext>
              </material>
            </response_label>
            <response_label ident="6093">
              <material>
                <mattext texttype="text/plain">The student loses access to personal prayer but retains other spiritual gifts.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
