    <item ident="gdbd13674cba42bcee440b5bfd9a33146" title="Question 40">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>89066,97561,59890,59490</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does the module say is the relationship between the student and AI in WRIT 101?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="89066">
              <material>
                <mattext texttype="text/plain">The student is the creator and AI is the tool.</mattext>
              </material>
            </response_label>
            <response_label ident="97561">
              <material>
                <mattext texttype="text/plain">The student and AI share equal responsibility for the final product.</mattext>
              </material>
            </response_label>
            <response_label ident="59890">
              <material>
                <mattext texttype="text/plain">AI is the primary resource and the student provides direction.</mattext>
              </material>
            </response_label>
            <response_label ident="59490">
              <material>
                <mattext texttype="text/plain">The student uses AI to complete tasks and then reviews the output.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">97561</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="97561_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">59890</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="59890_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">59490</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="59490_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">89066</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="97561_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The module closes with a clear statement: the student is the creator, and AI is the tool. This distinction defines every permitted use of AI in the course. Shared responsibility, AI as a primary resource, and reviewing AI-completed tasks all describe arrangements where AI takes on too large a role. The student must remain the originator of all ideas, decisions, and voice throughout every assignment.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="59890_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">The module closes with a clear statement: the student is the creator, and AI is the tool. This distinction defines every permitted use of AI in the course. Shared responsibility, AI as a primary resource, and reviewing AI-completed tasks all describe arrangements where AI takes on too large a role. The student must remain the originator of all ideas, decisions, and voice throughout every assignment.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
