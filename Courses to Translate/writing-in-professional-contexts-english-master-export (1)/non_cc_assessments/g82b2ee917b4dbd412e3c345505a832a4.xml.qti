    <item ident="gd6c82f8499ff899e9491e68e4e0f77c7" title="Question 49">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>96926,53536,82933,62173</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does the module say about the integrity standards that apply to technologies?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="96926">
              <material>
                <mattext texttype="text/plain">Technologies change, but the Lord's standards do not</mattext>
              </material>
            </response_label>
            <response_label ident="53536">
              <material>
                <mattext texttype="text/plain">New technologies require different standards of integrity</mattext>
              </material>
            </response_label>
            <response_label ident="82933">
              <material>
                <mattext texttype="text/plain">Technologies used for academic purposes are held to lower standards than other tools</mattext>
              </material>
            </response_label>
            <response_label ident="62173">
              <material>
                <mattext texttype="text/plain">Integrity standards apply only to writing tools, not to research or communication tools</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">53536</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="53536_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">82933</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="82933_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">62173</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="62173_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">96926</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="53536_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The module states directly that technologies change, but the Lord's standards do not. This principle means that integrity expectations remain constant regardless of what new tools become available. The module does not suggest that standards must update annually, that academic technologies face lower standards, or that integrity applies only to writing tools. The same honesty and transparency expected of students today will be expected of them as new technologies emerge.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="82933_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The module states directly that technologies change, but the Lord's standards do not. This principle means that integrity expectations remain constant regardless of what new tools become available. The module does not suggest that standards must update annually, that academic technologies face lower standards, or that integrity applies only to writing tools. The same honesty and transparency expected of students today will be expected of them as new technologies emerge.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
