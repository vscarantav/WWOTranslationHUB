    <item ident="g72c62465c0beb9f044fd6463831bbf5c" title="Question 29">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>58953,94621,32723,7542</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the negative consequence of asking AI to "improve" or "make better" a personal narrative?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="58953">
              <material>
                <mattext texttype="text/plain">AI replaces the student's distinctive voice with generic prose</mattext>
              </material>
            </response_label>
            <response_label ident="94621">
              <material>
                <mattext texttype="text/plain">AI corrects all grammar errors</mattext>
              </material>
            </response_label>
            <response_label ident="32723">
              <material>
                <mattext texttype="text/plain">AI substantially shortens the narrative</mattext>
              </material>
            </response_label>
            <response_label ident="7542">
              <material>
                <mattext texttype="text/plain">AI changes the topic of the narrative</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">94621</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="94621_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">32723</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="32723_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7542</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7542_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">58953</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="94621_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;When a student asks AI to &lt;strong&gt;improve&lt;/strong&gt; a personal narrative, the primary negative consequence is that AI removes the irregular rhythms and personal patterns that make a voice distinctive. The result may appear cleaner but no longer reflects the student’s voice. AI correcting all grammar errors introduces other issues, but is not the primary negative consequence introduced in the chapter. AI does not substantially reduce word count unless specifically asked, or change the subject of a narrative. The specific problem identified in the module is the loss of authentic voice.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="32723_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;When a student asks AI to &lt;strong&gt;improve&lt;/strong&gt; a personal narrative, the primary negative consequence is that AI removes the irregular rhythms and personal patterns that make a voice distinctive. The result may appear cleaner but no longer reflects the student’s voice. AI correcting all grammar errors introduces other issues, but is not the primary negative consequence introduced in the chapter. AI does not substantially reduce word count unless specifically asked, or change the subject of a narrative. The specific problem identified in the module is the loss of authentic voice.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7542_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;When a student asks AI to &lt;strong&gt;improve&lt;/strong&gt; a personal narrative, the primary negative consequence is that AI removes the irregular rhythms and personal patterns that make a voice distinctive. The result may appear cleaner but no longer reflects the student’s voice. AI correcting all grammar errors introduces other issues, but is not the primary negative consequence introduced in the chapter. AI does not substantially reduce word count unless specifically asked, or change the subject of a narrative. The specific problem identified in the module is the loss of authentic voice.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gbd14d579e6a3800f252b9abd9a4b7c1a" title="Question 3">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>7468,17119,45982,36143</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which writing method condenses a source to its main idea in your own words?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="7468">
              <material>
                <mattext texttype="text/plain">Summarizing</mattext>
              </material>
            </response_label>
            <response_label ident="17119">
              <material>
                <mattext texttype="text/plain">Quoting directly</mattext>
              </material>
            </response_label>
            <response_label ident="45982">
              <material>
                <mattext texttype="text/plain">Paraphrasing</mattext>
              </material>
            </response_label>
            <response_label ident="36143">
              <material>
                <mattext texttype="text/plain">Transcribing</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">17119</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="17119_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">45982</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="45982_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">36143</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="36143_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">7468</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="17119_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Summarizing condenses a source to its main idea in your own words and is used when you need the overall meaning without all of the details. Quoting directly means reproducing an author's exact words inside quotation marks. Paraphrasing restates a specific passage in your own words and your own sentence structure—it is more detailed than a summary. Transcribing means copying text word for word, which is not an approved source-use method unless combined with quotation marks and a citation.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="45982_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Summarizing condenses a source to its main idea in your own words and is used when you need the overall meaning without all of the details. Quoting directly means reproducing an author's exact words inside quotation marks. Paraphrasing restates a specific passage in your own words and your own sentence structure—it is more detailed than a summary. Transcribing means copying text word for word, which is not an approved source-use method unless combined with quotation marks and a citation.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="36143_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Summarizing condenses a source to its main idea in your own words and is used when you need the overall meaning without all of the details. Quoting directly means reproducing an author's exact words inside quotation marks. Paraphrasing restates a specific passage in your own words and your own sentence structure—it is more detailed than a summary. Transcribing means copying text word for word, which is not an approved source-use method unless combined with quotation marks and a citation.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g97d4157454df8e44a5e649e3bd3ce5ff" title="Question 30">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>2363,95137,74014,57150</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What must a student do with every source that appears in their reference list?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="2363">
              <material>
                <mattext texttype="text/plain">Locate and read the actual source to confirm it is real</mattext>
              </material>
            </response_label>
            <response_label ident="95137">
              <material>
                <mattext texttype="text/plain">Include a direct quotation from the source in the assignment body</mattext>
              </material>
            </response_label>
            <response_label ident="74014">
              <material>
                <mattext texttype="text/plain">Obtain instructor approval before adding the source to the list</mattext>
              </material>
            </response_label>
            <response_label ident="57150">
              <material>
                <mattext texttype="text/plain">Find a second source that confirms the first source's main argument</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
