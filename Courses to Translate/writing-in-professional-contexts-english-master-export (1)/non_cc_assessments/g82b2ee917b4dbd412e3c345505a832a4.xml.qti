      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the term for AI-generated text that looks accurate but refers to a source that does not exist?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="62889">
              <material>
                <mattext texttype="text/plain">Hallucination</mattext>
              </material>
            </response_label>
            <response_label ident="60470">
              <material>
                <mattext texttype="text/plain">Paraphrase</mattext>
              </material>
            </response_label>
            <response_label ident="43865">
              <material>
                <mattext texttype="text/plain">Fabricated summary</mattext>
              </material>
            </response_label>
            <response_label ident="46768">
              <material>
                <mattext texttype="text/plain">Mosaic plagiarism</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">60470</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="60470_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">43865</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="43865_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">46768</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="46768_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">62889</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="60470_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;When AI produces a citation that appears correctly formatted but refers to a publication that does not exist, that is called a hallucination. A paraphrase is a legitimate writing technique in which you restate a real source in your own words. A fabricated summary is not the standard term used for this specific AI error. Mosaic plagiarism refers to rearranging or slightly rewording someone else's sentences while keeping their structure—it describes a writing behavior, not an AI output error.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="43865_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;When AI produces a citation that appears correctly formatted but refers to a publication that does not exist, that is called a hallucination. A paraphrase is a legitimate writing technique in which you restate a real source in your own words. A fabricated summary is not the standard term used for this specific AI error. Mosaic plagiarism refers to rearranging or slightly rewording someone else's sentences while keeping their structure—it describes a writing behavior, not an AI output error.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="46768_fb">
