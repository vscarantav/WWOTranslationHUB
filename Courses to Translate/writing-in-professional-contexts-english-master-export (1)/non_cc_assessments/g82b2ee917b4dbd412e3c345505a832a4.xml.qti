    <item ident="gcf0f17cbcb65331edc7f129aa7159d34" title="Question 42">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>63731,44718,58184,51762</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does Ada Okonkwo's experience in the module illustrate about community knowledge and academic citation?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="63731">
              <material>
                <mattext texttype="text/plain">Personal and community knowledge still require formal citation in Western academic writing</mattext>
              </material>
            </response_label>
            <response_label ident="44718">
              <material>
                <mattext texttype="text/plain">Knowledge passed down within a family does not need to be cited in any academic context</mattext>
              </material>
            </response_label>
            <response_label ident="58184">
              <material>
                <mattext texttype="text/plain">Instructors will accept personal experience as a substitute for required scholarly sources</mattext>
              </material>
            </response_label>
            <response_label ident="51762">
              <material>
                <mattext texttype="text/plain">Community knowledge is more reliable than published academic research</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">44718</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="44718_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">58184</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="58184_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">51762</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="51762_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">63731</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="44718_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Ada Okonkwo's story illustrates that in Western academic writing, even widely shared community knowledge requires formal citation. Ada learned to honor both her personal knowledge and academic standards by finding scholarly sources that documented practices she already knew from experience. The module does not say personal knowledge never needs citation, that instructors accept experience as a substitute for sources, or that community knowledge is more reliable than research.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="58184_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Ada Okonkwo's story illustrates that in Western academic writing, even widely shared community knowledge requires formal citation. Ada learned to honor both her personal knowledge and academic standards by finding scholarly sources that documented practices she already knew from experience. The module does not say personal knowledge never needs citation, that instructors accept experience as a substitute for sources, or that community knowledge is more reliable than research.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
