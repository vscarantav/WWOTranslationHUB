        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">65784</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="65784_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">48455</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="48710_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;President Oaks taught that depending on others for decisions or resources a person could provide independently weakens a person spiritually. The module applies this principle directly to AI use—relying on AI to think for you creates a form of dependency that undermines spiritual growth. Academic failure, loss of credentials, and reduced thinking skills may follow from integrity violations, but the specific risk President Oaks identified is spiritual in nature.&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
