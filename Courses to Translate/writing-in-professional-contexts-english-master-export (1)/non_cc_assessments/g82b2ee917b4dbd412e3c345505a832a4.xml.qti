          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What are the four principles of ethical AI use described in the module?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="69745">
              <material>
                <mattext texttype="text/plain">Develop competence, maintain transparency, preserve agency, and follow course policies</mattext>
              </material>
            </response_label>
            <response_label ident="40071">
              <material>
                <mattext texttype="text/plain">Avoid plagiarism, cite all sources, use feedback prompts, and apply the Explainability Test</mattext>
              </material>
            </response_label>
            <response_label ident="1808">
              <material>
                <mattext texttype="text/plain">Write your draft first, check grammar second, revise for voice third, and submit on time</mattext>
              </material>
            </response_label>
            <response_label ident="18851">
              <material>
                <mattext texttype="text/plain">Use AI for product tasks, avoid AI for process tasks, disclose all use, and protect privacy</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
