          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What does the module identify as the unique challenge of writing courses compared to other academic courses?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="66521">
              <material>
                <mattext texttype="text/plain">The content comes from the student's own life, making integrity more personal</mattext>
              </material>
            </response_label>
            <response_label ident="90084">
              <material>
                <mattext texttype="text/plain">Writing courses require more sources than other courses</mattext>
              </material>
            </response_label>
            <response_label ident="42322">
              <material>
                <mattext texttype="text/plain">Writing courses are graded on grammar and punctuation rather than ideas</mattext>
              </material>
            </response_label>
            <response_label ident="23063">
              <material>
                <mattext texttype="text/plain">Writing courses do not allow any form of collaboration with classmates</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">90084</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="90084_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">42322</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="42322_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">23063</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="23063_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">66521</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="90084_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">The module opens by stating that WRIT 101 is different because students write from their own lives, memories, and voice, which makes integrity more personal and more important than in courses based on fixed content. Writing courses do not inherently require more sources, focus only on grammar, or prohibit all collaboration. The personal nature of the content is what sets this course apart.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="42322_fb">
