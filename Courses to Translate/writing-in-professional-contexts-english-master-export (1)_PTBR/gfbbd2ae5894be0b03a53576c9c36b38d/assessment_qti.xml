<varequal respident="response1">9462</varequal>
<not>
<varequal respident="response1">3085</varequal>
</not>
<varequal respident="response1">2471</varequal>
<not>
<varequal respident="response1">2692</varequal>
</not>
</and>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
