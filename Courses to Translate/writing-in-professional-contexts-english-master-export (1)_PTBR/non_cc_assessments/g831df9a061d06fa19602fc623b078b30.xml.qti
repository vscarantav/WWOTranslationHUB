<mattext texttype="text/html">&lt;div&gt;Quais são os três componentes que se deve considerar antes de escolher uma estratégia de comunicação?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="27193">
<material>
<mattext texttype="text/plain">Público-alvo, propósito e canal</mattext>
