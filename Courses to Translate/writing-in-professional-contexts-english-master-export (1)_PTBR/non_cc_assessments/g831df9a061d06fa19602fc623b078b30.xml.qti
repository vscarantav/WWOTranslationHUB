<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual recurso literário atribui características humanas a um objeto ou ideia não humana?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="3133">
<material>
<mattext texttype="text/plain">Personificação</mattext>
</material>
</response_label>
<response_label ident="40639">
<material>
<mattext texttype="text/plain">Símile</mattext>
</material>
</response_label>
<response_label ident="5361">
<material>
<mattext texttype="text/plain">Hipérbole</mattext>
</material>
</response_label>
<response_label ident="53789">
<material>
<mattext texttype="text/plain">Estrutura paralela</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
