<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>98756,47627,68296,59920</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que é a tradição maori whaikorero?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="98756">
<material>
<mattext texttype="text/plain">Uma prática de oratória formal que honra os antepassados, reconhece a terra e conecta histórias pessoais aos valores da comunidade</mattext>
</material>
</response_label>
<response_label ident="47627">
<material>
<mattext texttype="text/plain">Um formato de debate estruturado que enfatiza progressões lógicas e rigor intelectual</mattext>
</material>
</response_label>
<response_label ident="68296">
<material>
<mattext texttype="text/plain">Uma tradição de contação de histórias que utiliza poesia de louvor e narrativas históricas para influenciar decisões</mattext>
</material>
</response_label>
<response_label ident="59920">
<material>
<mattext texttype="text/plain">Uma prática de oratória em conselho onde cada pessoa contribui para a tomada de decisões coletiva</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">47627</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="47627_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">68296</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="68296_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">59920</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="59920_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">98756</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="47627_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;O debate estruturado com progressões lógicas descreve as tradições de debate etíopes, a poesia de louvor e as narrativas históricas descrevem a tradição Griot da África Ocidental, e a oratória coletiva em conselho descreve as tradições indígenas norte-americanas. O whaikorero maori é uma prática de oratória formal da Nova Zelândia que segue protocolos específicos — incluindo honrar os antepassados, reconhecer a terra e conectar histórias pessoais aos valores da comunidade — para estabelecer autoridade e conexão emocional.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
