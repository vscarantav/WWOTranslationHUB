<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que é a estrutura paralela como recurso literário?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="74592">
<material>
<mattext texttype="text/plain">Repetir o mesmo padrão gramatical de palavras para dar igual ênfase às ideias</mattext>
</material>
</response_label>
<response_label ident="48054">
<material>
<mattext texttype="text/plain">Comparar duas coisas diferentes usando as palavras "como" ou "tal como"</mattext>
</material>
</response_label>
<response_label ident="42521">
<material>
<mattext texttype="text/plain">Atribuir qualidades humanas a um objeto ou ideia não humana</mattext>
</material>
</response_label>
<response_label ident="87141">
<material>
<mattext texttype="text/plain">Apresentar uma alegação como menos significativa do que realmente é</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
