<item ident="gb78ee7730f243b3bfd0dfbf28c8de5a3" title="Pergunta 43">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
