<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual abordagem de comunicação a cultura empresarial brasileira enfatiza antes de tratar de negócios?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="86326">
<material>
<mattext texttype="text/plain">Estabelecer relacionamentos pessoais por meio da conversação</mattext>
</material>
</response_label>
<response_label ident="72935">
<material>
<mattext texttype="text/plain">Apresentar credenciais detalhadas e qualificações especializadas</mattext>
</material>
</response_label>
<response_label ident="44872">
<material>
<mattext texttype="text/plain">Utilizar uma linguagem indireta que se desenvolve gradualmente em direção ao ponto principal</mattext>
</material>
</response_label>
<response_label ident="58797">
<material>
<mattext texttype="text/plain">Apresentar uma solicitação direta fundamentada em dados específicos</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">72935</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="72935_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">44872</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="44872_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">58797</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="58797_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">86326</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="72935_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;A apresentação de credenciais detalhadas descreve a abordagem alemã, a linguagem indireta que se desenvolve gradualmente descreve a comunicação japonesa, e as solicitações diretas com dados descrevem o estilo acadêmico ocidental. A comunicação empresarial brasileira enfatiza o estabelecimento de relacionamentos pessoais em primeiro lugar — as reuniões frequentemente começam com conversas pessoais, e os apelos persuasivos muitas vezes combinam conexão emocional com raciocínio lógico.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
