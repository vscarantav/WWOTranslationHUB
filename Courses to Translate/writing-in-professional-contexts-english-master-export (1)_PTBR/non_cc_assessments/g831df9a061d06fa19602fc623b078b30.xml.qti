</item>
<item ident="ga5bf36ae4ec3b947668be103410ae496" title="Pergunta 13">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>20857,1566,15514,50526</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que é a falácia lógica bandwagon?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="20857">
<material>
<mattext texttype="text/plain">Argumentar que algo está correto porque muitas pessoas acreditam ou fazem isso</mattext>
</material>
</response_label>
<response_label ident="1566">
<material>
<mattext texttype="text/plain">Atacar o caráter pessoal de quem apresenta um argumento</mattext>
</material>
</response_label>
<response_label ident="15514">
<material>
<mattext texttype="text/plain">Presumir que um evento causou automaticamente outro evento</mattext>
</material>
</response_label>
<response_label ident="50526">
<material>
<mattext texttype="text/plain">Apresentar uma alegação exagerada que distorce a verdade</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">1566</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="1566_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">15514</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="15514_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">50526</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="50526_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">20857</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="1566_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Atacar o caráter descreve a falácia ad hominem, presumir causa e efeito sem provas descreve uma falácia causal, e exagerar alegações descreve uma hipérbole. A falácia bandwagon argumenta que, como muitas pessoas acreditam ou fazem algo, você também deveria fazer — usando a popularidade como substituta para evidências reais.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="15514_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Atacar o caráter descreve a falácia ad hominem, presumir causa e efeito sem provas descreve uma falácia causal, e exagerar alegações descreve uma hipérbole. A falácia bandwagon argumenta que, como muitas pessoas acreditam ou fazem algo, você também deveria fazer — usando a popularidade como substituta para evidências reais.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="50526_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Atacar o caráter descreve a falácia ad hominem, presumir causa e efeito sem provas descreve uma falácia causal, e exagerar alegações descreve uma hipérbole. A falácia bandwagon argumenta que, como muitas pessoas acreditam ou fazem algo, você também deveria fazer — usando a popularidade como substituta para evidências reais.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="ga50989b4d55587e90beac042b765ea28" title="Pergunta 14">
