<mattext texttype="text/html">&lt;div&gt;Qual estilo de comunicação cultural valoriza a comunicação indireta e a aproximação gradual do ponto principal?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="32743">
<material>
<mattext texttype="text/plain">Estilo de comunicação japonês</mattext>
</material>
</response_label>
