<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual é o objetivo do corpo de um e-mail profissional?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="51075">
<material>
<mattext texttype="text/plain">Fornecer contexto, apresentar uma solicitação específica e expressar agradecimento</mattext>
</material>
</response_label>
<response_label ident="66531">
<material>
<mattext texttype="text/plain">Listar as credenciais acadêmicas e o histórico de disciplinas/cursos de quem envia</mattext>
</material>
</response_label>
<response_label ident="21998">
<material>
<mattext texttype="text/plain">Reescrever o assunto em orações completas</mattext>
</material>
</response_label>
<response_label ident="28081">
<material>
<mattext texttype="text/plain">Explicar as regras de formatação de e-mails profissionais</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">66531</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="66531_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">21998</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="21998_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">28081</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="28081_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">51075</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="66531_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Listar credenciais, reescrever a linha de assunto e explicar as regras de formatação não são o objetivo do corpo de um e-mail. O corpo de um e-mail profissional tem uma estrutura de três partes: fornece o contexto do motivo do seu contato, apresenta claramente a sua solicitação específica e expressa agradecimento a quem lê.</mattext>
</material>
</flow_mat>
</itemfeedback>
