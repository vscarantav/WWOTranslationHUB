<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual é o papel dos dados numéricos na escrita persuasiva?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="14149">
<material>
<mattext texttype="text/plain">Fortalecer um argumento por meio do fornecimento de fatos e dados precisos</mattext>
</material>
</response_label>
<response_label ident="44737">
<material>
<mattext texttype="text/plain">Apelar para as emoções do público leitor por meio de descrições vívidas</mattext>
</material>
</response_label>
<response_label ident="80125">
<material>
<mattext texttype="text/plain">Estabelecer a credibilidade pessoal e a experiência de quem escreve</mattext>
</material>
</response_label>
<response_label ident="21230">
<material>
<mattext texttype="text/plain">Criar ênfase ao repetir ideias-chave ao longo do texto</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
