</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">87721</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="18523_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">O logos usa lógica e evidências, o ethos constrói credibilidade e o kairos foca na oportunidade (tempo). O pathos é o apelo retórico que se conecta com um público-alvo ao visar suas emoções, como medo, esperança, amor ou senso de justiça.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="37254_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">O logos usa lógica e evidências, o ethos constrói credibilidade e o kairos foca na oportunidade (tempo). O pathos é o apelo retórico que se conecta com um público-alvo ao visar suas emoções, como medo, esperança, amor ou senso de justiça.</mattext>
</material>
</flow_mat>
