</material>
</response_label>
<response_label ident="31578">
<material>
<mattext texttype="text/plain">Extensão, formato e tamanho da fonte</mattext>
</material>
</response_label>
<response_label ident="97334">
<material>
<mattext texttype="text/plain">Assunto, título e contagem de palavras</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
