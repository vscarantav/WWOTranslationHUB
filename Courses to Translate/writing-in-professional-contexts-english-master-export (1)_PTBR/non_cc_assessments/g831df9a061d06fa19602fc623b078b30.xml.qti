<item ident="ge7b823b974adb6b0dd467e736c013da6" title="Pergunta 49">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>5597,68838,62928,27480</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual é uma das maneiras pelas quais quem escreve apoia suas alegações com evidências convincentes na escrita persuasiva?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="5597">
<material>
<mattext texttype="text/plain">Citar estatísticas, fatos ou opiniões de especialistas apropriadas</mattext>
</material>
</response_label>
<response_label ident="68838">
<material>
<mattext texttype="text/plain">Repetir a alegação principal várias vezes ao longo da mensagem</mattext>
</material>
</response_label>
<response_label ident="62928">
<material>
<mattext texttype="text/plain">Usar linguagem informal para tornar o argumento mais fácil de se identificar</mattext>
</material>
</response_label>
<response_label ident="27480">
<material>
<mattext texttype="text/plain">Evitar detalhes específicos para que o argumento se aplique a um público maior</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">68838</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="68838_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">62928</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="62928_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">27480</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="27480_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">5597</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="68838_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Repetir alegações não constitui evidência, a linguagem informal reduz a credibilidade em vez de fortalecer os argumentos, e evitar detalhes específicos enfraquece em vez de fortalecer um caso persuasivo. Quem escreve apoia as alegações com evidências convincentes citando estatísticas, fatos, opiniões de especialistas ou exemplos relevantes — estes fornecem a base lógica que torna um argumento crível e confiável.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="62928_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Repetir alegações não constitui evidência, a linguagem informal reduz a credibilidade em vez de fortalecer os argumentos, e evitar detalhes específicos enfraquece em vez de fortalecer um caso persuasivo. Quem escreve apoia as alegações com evidências convincentes citando estatísticas, fatos, opiniões de especialistas ou exemplos relevantes — estes fornecem a base lógica que torna um argumento crível e confiável.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="27480_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Repetir alegações não constitui evidência, a linguagem informal reduz a credibilidade em vez de fortalecer os argumentos, e evitar detalhes específicos enfraquece em vez de fortalecer um caso persuasivo. Quem escreve apoia as alegações com evidências convincentes citando estatísticas, fatos, opiniões de especialistas ou exemplos relevantes — estes fornecem a base lógica que torna um argumento crível e confiável.&lt;/p&gt;</mattext>
