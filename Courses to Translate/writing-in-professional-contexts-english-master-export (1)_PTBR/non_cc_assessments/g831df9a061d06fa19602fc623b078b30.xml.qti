</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que é persuasão?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="91220">
<material>
<mattext texttype="text/plain">O ato de convencer alguém a fazer algo ou a acreditar que algo é verdade</mattext>
</material>
</response_label>
<response_label ident="65312">
<material>
<mattext texttype="text/plain">O processo de organizar ideias em uma sequência lógica de parágrafos</mattext>
</material>
</response_label>
<response_label ident="41616">
<material>
<mattext texttype="text/plain">A prática de identificar erros de gramática e pontuação</mattext>
</material>
</response_label>
<response_label ident="46712">
<material>
<mattext texttype="text/plain">O método de resumir informações de várias fontes</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
