<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que é a falácia lógica da rampa escorregadia?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="12546">
<material>
<mattext texttype="text/plain">Presumir que uma ação levará automaticamente a uma cadeia de consequências extremas</mattext>
</material>
</response_label>
<response_label ident="18813">
<material>
<mattext texttype="text/plain">Oferecer apenas duas escolhas quando existem outras opções</mattext>
</material>
</response_label>
<response_label ident="40323">
<material>
<mattext texttype="text/plain">Usar a popularidade para argumentar que algo deve estar correto</mattext>
</material>
</response_label>
<response_label ident="32175">
<material>
<mattext texttype="text/plain">Atacar a identidade da pessoa que apresenta um argumento</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
