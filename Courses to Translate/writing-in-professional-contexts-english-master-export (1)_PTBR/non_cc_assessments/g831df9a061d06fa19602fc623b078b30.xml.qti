<item ident="gc2672cfcd96cfef48d2c364079dbe42c" title="Pergunta 23">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>39816,29057,44237,89252</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que é a falácia causal?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="39816">
<material>
<mattext texttype="text/plain">Afirmar que um evento causou outro sem provar uma conexão real</mattext>
</material>
</response_label>
<response_label ident="29057">
<material>
<mattext texttype="text/plain">Argumentar que algo é verdadeiro porque muitas pessoas acreditam nisso</mattext>
</material>
</response_label>
<response_label ident="44237">
<material>
<mattext texttype="text/plain">Atacar o caráter pessoal de quem apresenta um argumento</mattext>
</material>
</response_label>
<response_label ident="89252">
<material>
<mattext texttype="text/plain">Assumir que uma ação levará a uma série de consequências extremas</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">29057</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="29057_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">44237</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="44237_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">89252</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="89252_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">39816</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="29057_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Usar a popularidade para defender uma verdade descreve a falácia do apelo à popularidade (bandwagon), atacar o caráter pessoal descreve o ad hominem, e assumir reações extremas em cadeia descreve a falácia da rampa escorregadia. A falácia causal afirma que, por um evento ter ocorrido após outro, o primeiro deve ter causado o segundo — sem apresentar evidências de uma conexão real entre os dois.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="44237_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Usar a popularidade para defender uma verdade descreve a falácia do apelo à popularidade (bandwagon), atacar o caráter pessoal descreve o ad hominem, e assumir reações extremas em cadeia descreve a falácia da rampa escorregadia. A falácia causal afirma que, por um evento ter ocorrido após outro, o primeiro deve ter causado o segundo — sem apresentar evidências de uma conexão real entre os dois.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="89252_fb">
<flow_mat>
