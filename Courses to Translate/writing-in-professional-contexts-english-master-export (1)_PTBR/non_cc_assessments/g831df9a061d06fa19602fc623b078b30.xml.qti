</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual é o objetivo de compartilhar uma experiência pessoal na Escrita persuasiva?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="38903">
<material>
<mattext texttype="text/plain">Aumentar a credibilidade de quem escreve e apelar às emoções do leitor</mattext>
</material>
</response_label>
<response_label ident="37703">
<material>
<mattext texttype="text/plain">Fornecer dados numéricos que apoiem o argumento principal de quem escreve</mattext>
</material>
</response_label>
<response_label ident="76067">
<material>
<mattext texttype="text/plain">Apresentar dois pontos de vista contrastantes para avaliação do leitor</mattext>
</material>
</response_label>
<response_label ident="66741">
<material>
<mattext texttype="text/plain">Repetir ideias-chave ao longo do texto para dar maior ênfase</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">37703</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="37703_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">76067</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="76067_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">66741</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="66741_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">38903</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="37703_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Os dados numéricos apoiam os argumentos por meio do logos, a apresentação de pontos de vista contrastantes relaciona-se ao reconhecimento da oposição, e a repetição de ideias para dar ênfase descreve o recurso literário da repetição. Compartilhar uma experiência pessoal atende a dois propósitos persuasivos de uma só vez — aumenta a credibilidade de quem escreve (ethos) ao demonstrar conhecimento de primeira mão e também pode apelar para as emoções de quem lê (pathos) ao tornar o Assunto mais próximo e humano.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
