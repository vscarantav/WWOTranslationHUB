</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">27817</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="27817_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">42392</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="75863_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Apresentar credenciais detalhadas primeiro descreve la abordagem retórica alemã, usar declarações diretas e dados descreve a comunicação acadêmica ocidental, e começar com uma conversa pessoal descreve a comunicação empresarial brasileira. Muitas comunidades quenianas e a tradição Griot da África Ocidental usam a contação de histórias e a narrativa como uma técnica persuasiva — apresentando argumentos por meio de histórias que ilustram princípios, em vez de declarações diretas ou dados isolados.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
