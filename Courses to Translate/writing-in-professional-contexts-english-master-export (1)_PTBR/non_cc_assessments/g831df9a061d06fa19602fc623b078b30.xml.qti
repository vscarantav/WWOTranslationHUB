<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual apelo retórico se concentra em construir confiança ao estabelecer a credibilidade de quem escreve?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="68521">
<material>
<mattext texttype="text/plain">Ethos</mattext>
</material>
</response_label>
