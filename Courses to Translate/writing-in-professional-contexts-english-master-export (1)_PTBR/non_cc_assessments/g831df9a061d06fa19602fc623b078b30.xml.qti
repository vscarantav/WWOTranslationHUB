</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que é a hipérbole como recurso retórico?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="11325">
<material>
<mattext texttype="text/plain">Uma afirmação exagerada que amplia a verdade para criar um efeito dramático</mattext>
</material>
</response_label>
<response_label ident="33461">
<material>
<mattext texttype="text/plain">Uma comparação entre duas coisas diferentes usando os conectivos "como" ou "tal como"</mattext>
</material>
</response_label>
<response_label ident="10222">
<material>
<mattext texttype="text/plain">A repetição de um padrão gramatical para dar o mesmo peso às ideias</mattext>
</material>
</response_label>
<response_label ident="85554">
<material>
<mattext texttype="text/plain">Uma pergunta feita para causar efeito dramático que não exige uma resposta</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
