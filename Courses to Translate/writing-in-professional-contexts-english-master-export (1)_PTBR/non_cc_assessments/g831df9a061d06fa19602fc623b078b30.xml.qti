<item ident="gecdb4fbfd9273acf4fc5b5f8ac5d8d42" title="Pergunta 6">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>80862,69638,25460,61654</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que é kairos na comunicação retórica?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="80862">
<material>
<mattext texttype="text/plain">Reconhecer o momento certo para transmitir uma mensagem a um público-alvo receptivo</mattext>
</material>
</response_label>
<response_label ident="69638">
<material>
<mattext texttype="text/plain">Usar linguagem emocional para se conectar com os sentimentos de quem lê</mattext>
</material>
</response_label>
<response_label ident="25460">
<material>
<mattext texttype="text/plain">Citar fontes especializadas para apoiar uma afirmação</mattext>
</material>
</response_label>
<response_label ident="61654">
<material>
<mattext texttype="text/plain">Repetir palavras-chave para criar ênfase em uma mensagem</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">69638</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="69638_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">25460</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="25460_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">61654</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="61654_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">80862</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="69638_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;A linguagem emocional descreve o pathos, citar especialistas se relaciona com o logos ou ethos, e a repetição é um recurso literário. Kairos é o conceito retórico de reconhecer quando o momento é o ideal — transmitir uma mensagem quando o público-alvo está mais receptivo a ela.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="25460_fb">
