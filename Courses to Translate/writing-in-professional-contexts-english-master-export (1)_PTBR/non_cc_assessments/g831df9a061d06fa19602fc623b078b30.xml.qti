<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que a personificação do Smokey Bear realiza na campanha de prevenção de incêndios florestais?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="16551">
<material>
<mattext texttype="text/plain">Estabelece credibilidade ao tornar o Smokey uma figura verossímil e confiável</mattext>
</material>
</response_label>
<response_label ident="36937">
<material>
<mattext texttype="text/plain">Utiliza dados lógicos e estatísticas para argumentar que os incêndios florestais são perigosos</mattext>
</material>
</response_label>
<response_label ident="7726">
<material>
<mattext texttype="text/plain">Apoia-se no kairos ao associar a campanha a um acontecimento recente do noticiário</mattext>
</material>
</response_label>
<response_label ident="56446">
<material>
<mattext texttype="text/plain">Apresenta duas escolhas extremas para motivar o público-alvo a prevenir incêndios</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
