<fieldentry>4039,18198,8769,22962</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que significa estabelecer credibilidade na Escrita persuasiva?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="4039">
<material>
<mattext texttype="text/plain">Demonstrar competência ou bom caráter para que o Público-alvo confie e respeite quem escreve</mattext>
</material>
</response_label>
<response_label ident="18198">
<material>
<mattext texttype="text/plain">Utilizar uma linguagem emocional para se conectar com os sentimentos e valores do Público-alvo</mattext>
</material>
</response_label>
<response_label ident="8769">
<material>
<mattext texttype="text/plain">Fornecer estatísticas e fatos que apoiem a afirmação principal de quem escreve</mattext>
</material>
</response_label>
<response_label ident="22962">
<material>
<mattext texttype="text/plain">Escolher o momento certo para transmitir uma mensagem a um Público-alvo receptivo</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
