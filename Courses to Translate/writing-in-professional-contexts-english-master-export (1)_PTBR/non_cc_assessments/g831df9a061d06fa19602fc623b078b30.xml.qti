<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Que erro comum de e-mail envolve o uso de linguagem informal em uma mensagem profissional?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="65525">
<material>
<mattext texttype="text/plain">Utilizar saudações informais, como "Ei" ou "E aí", em vez de uma saudação profissional</mattext>
</material>
</response_label>
<response_label ident="51951">
<material>
<mattext texttype="text/plain">Incluir seu nome completo e a Seção da disciplina/curso na assinatura do e-mail</mattext>
</material>
</response_label>
<response_label ident="32527">
<material>
<mattext texttype="text/plain">Apresentar sua solicitação de forma clara e específica no corpo do e-mail</mattext>
</material>
</response_label>
<response_label ident="57081">
<material>
<mattext texttype="text/plain">Utilizar "Atenciosamente" como fórmula de encerramento do e-mail</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
