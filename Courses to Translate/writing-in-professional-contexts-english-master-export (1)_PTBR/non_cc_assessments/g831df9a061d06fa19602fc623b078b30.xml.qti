<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual é o objetivo de reconhecer a oposição na Escrita persuasiva?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="40074">
<material>
<mattext texttype="text/plain">Mostrar ao público-alvo que quem escreve considerou pontos de vista opostos</mattext>
</material>
</response_label>
<response_label ident="73569">
<material>
<mattext texttype="text/plain">Confundir quem lê ao introduzir informações conflitantes</mattext>
</material>
</response_label>
<response_label ident="18748">
<material>
<mattext texttype="text/plain">Evitar abordar as fraquezas no argumento de quem escreve</mattext>
</material>
</response_label>
<response_label ident="30500">
<material>
<mattext texttype="text/plain">Atacar a credibilidade de quem discorda de quem escreve</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">73569</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="73569_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">18748</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="18748_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">30500</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="30500_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">40074</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="73569_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Introduzir informações conflitantes para confundir, evitar fraquezas e atacar a credibilidade de oponentes não são estratégias persuasivas legítimas. Reconhecer a oposição mostra a quem lê que quem escreve considerou cuidadosamente outros pontos de vista — isso faz com que quem escreve pareça ter uma postura justa e criteriosa, além de fortalecer o argumento geral ao demonstrar por que a sua posição é preferível.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
