<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual é a estrutura de três partes do corpo de um e-mail profissional?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="21232">
<material>
<mattext texttype="text/plain">Contexto, solicitação e agradecimento</mattext>
</material>
</response_label>
<response_label ident="37172">
<material>
<mattext texttype="text/plain">Assunto, saudação e encerramento</mattext>
</material>
</response_label>
<response_label ident="74723">
