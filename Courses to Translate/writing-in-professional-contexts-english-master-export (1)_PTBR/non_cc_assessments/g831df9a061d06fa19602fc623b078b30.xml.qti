<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que significa ethos como um apelo retórico?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="39613">
<material>
<mattext texttype="text/plain">Usar a credibilidade e o bom caráter para construir confiança com um público-alvo</mattext>
</material>
</response_label>
<response_label ident="45969">
<material>
<mattext texttype="text/plain">Usar fatos e estatísticas para apoiar um argumento lógico</mattext>
</material>
</response_label>
<response_label ident="95469">
<material>
<mattext texttype="text/plain">Usar uma linguagem emocional para se conectar com os sentimentos de quem lê</mattext>
</material>
</response_label>
<response_label ident="36602">
<material>
<mattext texttype="text/plain">Usar o momento certo para transmitir uma mensagem a um público-alvo receptivo</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
