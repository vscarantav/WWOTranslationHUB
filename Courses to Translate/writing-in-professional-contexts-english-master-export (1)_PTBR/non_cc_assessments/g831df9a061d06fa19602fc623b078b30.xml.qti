<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual apelo retórico se conecta com o público leitor ao visar seus sentimentos e emoções?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="87721">
<material>
<mattext texttype="text/plain">Pathos</mattext>
</material>
</response_label>
<response_label ident="18523">
<material>
<mattext texttype="text/plain">Logos</mattext>
</material>
</response_label>
<response_label ident="37254">
<material>
<mattext texttype="text/plain">Ethos</mattext>
</material>
</response_label>
<response_label ident="78416">
<material>
<mattext texttype="text/plain">Kairos</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">18523</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="18523_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">37254</varequal>
</conditionvar>
