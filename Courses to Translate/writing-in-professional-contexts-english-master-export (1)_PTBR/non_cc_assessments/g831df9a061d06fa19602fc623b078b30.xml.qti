</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual estilo de comunicação muitas comunidades quenianas e da África Ocidental usam como técnica persuasiva?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="42392">
<material>
<mattext texttype="text/plain">Contação de histórias e narrativa para ilustrar princípios</mattext>
</material>
</response_label>
<response_label ident="75863">
<material>
<mattext texttype="text/plain">Apresentar credenciais detalhadas antes de fazer uma solicitação</mattext>
</material>
</response_label>
<response_label ident="440">
<material>
<mattext texttype="text/plain">Usar declarações diretas e dados para apoiar argumentos</mattext>
</material>
</response_label>
<response_label ident="27817">
<material>
<mattext texttype="text/plain">Começar com uma conversa pessoal antes de tratar de negócios</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">75863</varequal>
</conditionvar>
