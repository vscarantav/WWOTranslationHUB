<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que é uma símile?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="94394">
<material>
<mattext texttype="text/plain">Uma comparação de duas coisas diferentes usando as palavras "como" ou "tal como"</mattext>
</material>
</response_label>
<response_label ident="33833">
