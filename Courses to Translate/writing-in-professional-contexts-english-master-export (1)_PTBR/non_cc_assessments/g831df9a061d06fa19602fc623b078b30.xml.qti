<item ident="g7f27f6026e9967bef52fc62a7ec13895" title="Pergunta 37">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
