<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que é uma falácia lógica?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="41621">
<material>
<mattext texttype="text/plain">Um argumento falho que usa raciocínio inválido ou irrelevante</mattext>
</material>
</response_label>
<response_label ident="21295">
<material>
<mattext texttype="text/plain">Um argumento forte apoiado por evidências confiáveis</mattext>
</material>
</response_label>
<response_label ident="42039">
<material>
<mattext texttype="text/plain">Uma pergunta retórica usada para criar um efeito dramático</mattext>
</material>
</response_label>
<response_label ident="58801">
<material>
<mattext texttype="text/plain">Uma conclusão lógica extraída de dados estatísticos</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
