<fieldlabel>bank_title</fieldlabel>
<fieldentry>S00 Integridade acadêmica Parte 2</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>bank_type</fieldlabel>
<fieldentry>Course</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
