</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">18851</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="18851_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">69745</varequal>
