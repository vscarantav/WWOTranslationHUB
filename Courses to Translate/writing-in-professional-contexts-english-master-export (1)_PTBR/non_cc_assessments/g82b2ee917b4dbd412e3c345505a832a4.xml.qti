<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual das seguintes opções é uma maneira adequada de usar IA em WRIT 101?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="55173">
<material>
<mattext texttype="text/plain">Pedir para a IA explicar a diferença entre resumir e parafrasear</mattext>
</material>
</response_label>
<response_label ident="77780">
<material>
<mattext texttype="text/plain">Pedir para a IA escrever o primeiro rascunho de sua narrativa pessoal</mattext>
</material>
</response_label>
<response_label ident="42603">
<material>
<mattext texttype="text/plain">Pedir para a IA decidir quais detalhes da história incluir em sua redação</mattext>
</material>
</response_label>
<response_label ident="27458">
<material>
<mattext texttype="text/plain">Pedir para a IA reescrever um parágrafo para deixá-lo mais claro</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
