<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual é o comando de IA aprovado para estudantes multilíngues que precisam de ajuda para expressar uma ideia em inglês?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="48297">
<material>
<mattext texttype="text/plain">"Ajude-me a expressar esta ideia de forma mais clara em inglês, mantendo o meu significado original e a minha voz pessoal."</mattext>
</material>
</response_label>
<response_label ident="98091">
<material>
<mattext texttype="text/plain">"Reescreva este parágrafo para que pareça mais fluente em inglês."</mattext>
</material>
</response_label>
<response_label ident="11038">
<material>
<mattext texttype="text/plain">"Traduza esta oração da minha primeira língua para o inglês."</mattext>
</material>
</response_label>
<response_label ident="13092">
<material>
<mattext texttype="text/plain">"Melhore a gramática e a estrutura das orações de todo o meu rascunho."</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">98091</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="98091_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">11038</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="11038_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">13092</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="13092_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">48297</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="98091_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;O comando aprovado para estudantes multilíngues pede à IA que ajude a expressar uma ideia específica de forma mais clara em inglês, preservando o significado original e a voz pessoal do estudante. Pedir à IA para reescrever um parágrafo para obter fluência, traduzir orações inteiras ou melhorar a gramática de um rascunho completo vai além do permitido — corre-se o risco de substituir a voz e o pensamento original do estudante por linguagem gerada por IA. O comando aprovado é restrito e específico por design.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
