<item ident="gc80bce55f715194f2eeeac2e46e865a3" title="Pergunta 1">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>56973,87235,13875,34331</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que é plágio?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="56973">
<material>
<mattext texttype="text/plain">Apresentar palavras, ideias ou trabalhos criativos de outra pessoa como se fossem seus</mattext>
</material>
</response_label>
<response_label ident="87235">
<material>
<mattext texttype="text/plain">Usar aspas para creditar uma fonte</mattext>
</material>
</response_label>
<response_label ident="13875">
<material>
<mattext texttype="text/plain">Escrever um resumo de uma fonte com suas próprias palavras</mattext>
</material>
</response_label>
<response_label ident="34331">
<material>
<mattext texttype="text/plain">Pedir a um colega de classe para revisar seu rascunho e dar feedback</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">87235</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="87235_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">13875</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="13875_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">34331</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="34331_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">56973</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="87235_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;O plágio não é um método de citação nem uma forma de feedback. É a apresentação de palavras, ideias ou trabalhos criativos de outra pessoa como se fossem seus, seja o ato intencional ou não. Usar aspas e citar uma fonte é o oposto do plágio — é a atribuição correta. Escrever um resumo com suas próprias palavras, incluindo a citação, também é aceitável. Pedir feedback a um colega de classe, sem que ele reescreva seu trabalho, é uma forma permitida de colaboração.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="13875_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;O plágio não é um método de citação nem uma forma de feedback. É a apresentação de palavras, ideias ou trabalhos criativos de outra pessoa como se fossem seus, seja o ato intencional ou não. Usar aspas e citar uma fonte é o oposto do plágio — é a atribuição correta. Escrever um resumo com suas próprias palavras, incluindo a citação, também é aceitável. Pedir feedback a um colega de classe, sem que ele reescreva seu trabalho, é uma forma permitida de colaboração.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="34331_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;O plágio não é um método de citação nem uma forma de feedback. É a apresentação de palavras, ideias ou trabalhos criativos de outra pessoa como se fossem seus, seja o ato intencional ou não. Usar aspas e citar uma fonte é o oposto do plágio — é a atribuição correta. Escrever um resumo com suas próprias palavras, incluindo a citação, também é aceitável. Pedir feedback a um colega de classe, sem que ele reescreva seu trabalho, é uma forma permitida de colaboração.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g02622b04afd55aa56f598923d3f6d853" title="Pergunta 10">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
