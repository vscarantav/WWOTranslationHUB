<item ident="gcf0f17cbcb65331edc7f129aa7159d34" title="Pergunta 42">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>63731,44718,58184,51762</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que a experiência de Ada Okonkwo no módulo ilustra sobre o conhecimento comunitário e a citação acadêmica?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="63731">
<material>
<mattext texttype="text/plain">O conhecimento pessoal e comunitário ainda exige citação formal na escrita acadêmica ocidental</mattext>
</material>
</response_label>
<response_label ident="44718">
<material>
<mattext texttype="text/plain">O conhecimento transmitido dentro de uma família não precisa ser citado em nenhum contexto acadêmico</mattext>
</material>
</response_label>
<response_label ident="58184">
<material>
<mattext texttype="text/plain">Os(as) instrutores(as) aceitarão a experiência pessoal como substituta das fontes acadêmicas exigidas</mattext>
</material>
</response_label>
<response_label ident="51762">
<material>
<mattext texttype="text/plain">O conhecimento comunitário é mais confiável do que a pesquisa acadêmica publicada</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">44718</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="44718_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">58184</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="58184_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">51762</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="51762_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">63731</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="44718_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A história de Ada Okonkwo ilustra que, na escrita acadêmica ocidental, mesmo o conhecimento comunitário amplamente compartilhado exige uma citação formal. Ada aprendeu a respeitar tanto seu conhecimento pessoal quanto os padrões acadêmicos ao encontrar fontes acadêmicas que documentavam práticas que ela já conhecia por experiência. O módulo não afirma que o conhecimento pessoal nunca precisa de citação, que instrutores(as) aceitam a experiência como substituto para as fontes, ou que o conhecimento comunitário é mais confiável do que a pesquisa.</mattext>
</material>
</flow_mat>
</itemfeedback>
