</material>
</response_label>
<response_label ident="17055">
<material>
<mattext texttype="text/plain">Acontecimentos atuais e reportagens on-line</mattext>
</material>
</response_label>
<response_label ident="77118">
<material>
<mattext texttype="text/plain">Leituras designadas e capítulos do livro didático do curso</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
