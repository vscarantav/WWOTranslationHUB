<item ident="g91f8331066128ae1a321f1ecf25725c5" title="Pergunta 48">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>8701,46170,36105,79366</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;De acordo com o módulo, para que tipo de atividade o conteúdo gerado por IA é especialmente prejudicial, além de violar a integridade acadêmica?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="8701">
<material>
<mattext texttype="text/plain">Reflexões espirituais, pois a IA não pode gerar o encontro genuíno com Deus que a atividade foi projetada para proporcionar</mattext>
</material>
</response_label>
<response_label ident="46170">
<material>
<mattext texttype="text/plain">Atividades de pesquisa, pois a IA não consegue acessar bancos de dados acadêmicos com precisão</mattext>
</material>
</response_label>
<response_label ident="36105">
<material>
<mattext texttype="text/plain">Exercícios de gramática, pois a IA corrige erros com os quais o estudante precisa aprender</mattext>
</material>
</response_label>
<response_label ident="79366">
<material>
<mattext texttype="text/plain">Projetos em grupo, pois os resultados da IA não podem representar as contribuições de vários estudantes</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">46170</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="46170_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">36105</varequal>
</conditionvar>
