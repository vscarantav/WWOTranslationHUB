<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>69105,95942,22215,56579</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que é o compartilhamento de conteúdo no contexto da Integridade acadêmica?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="69105">
<material>
<mattext texttype="text/plain">Distribuir atividades concluídas para outros estudantes ou obter atividades concluídas de outras pessoas</mattext>
</material>
</response_label>
<response_label ident="95942">
<material>
<mattext texttype="text/plain">Publicar sua própria redação em um blog pessoal que não é compartilhado com colegas de classe</mattext>
</material>
</response_label>
<response_label ident="22215">
<material>
<mattext texttype="text/plain">Discutir tópicos da atividade com colegas de classe antes de começar a escrever</mattext>
</material>
</response_label>
<response_label ident="56579">
<material>
<mattext texttype="text/plain">Ler o trabalho publicado de um colega de classe para se inspirar</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">95942</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="95942_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">22215</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="22215_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">56579</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="56579_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">69105</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="95942_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">As violações de compartilhamento de conteúdo ocorrem quando um estudante distribui trabalhos concluídos para outras pessoas ou os obtém de terceiros. Tanto a pessoa que compartilha quanto a que recebe são igualmente responsáveis. Publicar sua própria redação em um blog pessoal não é considerado compartilhamento de conteúdo se outros colegas de classe não puderem acessá-la. Discutir tópicos com colegas de classe antes de escrever é um comportamento normal de pré-escrita. Ler o trabalho publicado de um colega de classe para se inspirar, sem copiá-lo, não constitui uma violação de compartilhamento.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="22215_fb">
