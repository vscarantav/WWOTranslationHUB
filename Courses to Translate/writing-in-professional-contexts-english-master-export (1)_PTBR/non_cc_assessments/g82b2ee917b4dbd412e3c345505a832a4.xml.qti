<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>66521,90084,42322,23063</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que o módulo identifica como o desafio único das disciplinas/cursos de escrita em comparação com outras disciplinas/cursos acadêmicos?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="66521">
<material>
<mattext texttype="text/plain">O conteúdo vem da própria vida do estudante, tornando a integridade mais pessoal</mattext>
</material>
</response_label>
<response_label ident="90084">
<material>
<mattext texttype="text/plain">As disciplinas/cursos de escrita exigem mais fontes do que outras disciplinas/cursos</mattext>
</material>
</response_label>
<response_label ident="42322">
<material>
<mattext texttype="text/plain">As disciplinas/cursos de escrita são avaliados com base na gramática e na pontuação, e não pelas ideias</mattext>
</material>
</response_label>
<response_label ident="23063">
<material>
<mattext texttype="text/plain">As disciplinas/cursos de escrita não permitem nenhuma forma de colaboração com colegas de classe</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
