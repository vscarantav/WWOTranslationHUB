<fieldlabel>points_possible</fieldlabel>
<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>81674,52485,65235,1061</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que é uma tarefa de processo?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="81674">
<material>
<mattext texttype="text/plain">Uma atividade cujo objetivo é desenvolver uma habilidade, e não apenas produzir um documento finalizado</mattext>
</material>
</response_label>
<response_label ident="52485">
<material>
<mattext texttype="text/plain">Uma atividade focada em seguir instruções com exatidão em vez de desenvolver a compreensão</mattext>
</material>
</response_label>
<response_label ident="65235">
<material>
<mattext texttype="text/plain">Uma tarefa em que o auxílio de IA é sempre permitido</mattext>
</material>
</response_label>
<response_label ident="1061">
<material>
<mattext texttype="text/plain">Uma atividade focada em produzir um resultado limpo e utilizável</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">52485</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="52485_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">65235</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="65235_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">1061</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="1061_fb"/>
</respcondition>
