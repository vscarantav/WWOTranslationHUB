<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual é o alicerce espiritual que o módulo identifica para a integridade acadêmica em WRIT 101?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="28875">
<material>
<mattext texttype="text/plain">Escolher a honestidade fortalece o relacionamento do estudante com Deus</mattext>
</material>
</response_label>
<response_label ident="35301">
<material>
<mattext texttype="text/plain">Seguir as regras da universidade prepara os estudantes para o emprego profissional</mattext>
</material>
</response_label>
<response_label ident="90366">
<material>
<mattext texttype="text/plain">Evitar o plágio protege o estudante de consequências acadêmicas</mattext>
</material>
</response_label>
<response_label ident="94887">
<material>
<mattext texttype="text/plain">Usar fontes corretamente demonstra respeito pelos outros autores</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
