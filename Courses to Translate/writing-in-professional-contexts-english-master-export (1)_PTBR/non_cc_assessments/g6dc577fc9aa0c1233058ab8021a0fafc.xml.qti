</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual estrutura narrativa ordena corretamente as três partes principais de uma narrativa pessoal?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="93414">
<material>
<mattext texttype="text/plain">Começo, meio e fim</mattext>
</material>
</response_label>
<response_label ident="58913">
<material>
<mattext texttype="text/plain">Ação crescente, clímax, exposição</mattext>
</material>
</response_label>
<response_label ident="35265">
<material>
<mattext texttype="text/plain">Introdução, desenvolvimento, tese</mattext>
</material>
</response_label>
<response_label ident="81772">
<material>
<mattext texttype="text/plain">Conflito, resolução, reflexão</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">58913</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="58913_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">35265</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="35265_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">81772</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="81772_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">93414</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="58913_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Ação crescente, clímax e exposição são elementos dentro de um arco narrativo, não as três partes estruturais principais.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="35265_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Introdução, desenvolvimento e tese descrevem a estrutura de uma redação, não de uma narrativa.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="81772_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Conflito, resolução e reflexão são elementos narrativos, mas não descrevem a estrutura completa.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g1c3c2fb37fdaf4011a3b8d24c76d65d2" title="Pergunta 5">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>23554,28309,59860,14868</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que o termo &lt;strong&gt;showing&lt;/strong&gt; (mostrar) significa na escrita de uma narrativa pessoal?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="23554">
<material>
<mattext texttype="text/plain">Usar detalhes específicos, ações e diálogos para permitir que quem lê vivencie a história</mattext>
</material>
</response_label>
<response_label ident="28309">
<material>
<mattext texttype="text/plain">Declarar emoções e fatos diretamente para que quem lê os compreenda claramente</mattext>
</material>
</response_label>
<response_label ident="59860">
<material>
<mattext texttype="text/plain">Resumir os acontecimentos de maneira eficiente para manter o ritmo da narrativa</mattext>
</material>
</response_label>
<response_label ident="14868">
<material>
<mattext texttype="text/plain">Explicar o significado de uma experiência na conclusão</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">28309</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="28309_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">59860</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="59860_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">14868</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="14868_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">23554</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="28309_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Declarar emoções diretamente, resumir acontecimentos e explicar o significado são formas de &lt;strong&gt;contar&lt;/strong&gt; (&lt;em&gt;telling&lt;/em&gt;), não de mostrar.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="59860_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Declarar emoções diretamente, resumir acontecimentos e explicar o significado são formas de &lt;strong&gt;contar&lt;/strong&gt; (&lt;em&gt;telling&lt;/em&gt;), não de mostrar.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="14868_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Declarar emoções diretamente, resumir acontecimentos e explicar o significado são formas de &lt;strong&gt;contar&lt;/strong&gt; (&lt;em&gt;telling&lt;/em&gt;), não de mostrar.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
