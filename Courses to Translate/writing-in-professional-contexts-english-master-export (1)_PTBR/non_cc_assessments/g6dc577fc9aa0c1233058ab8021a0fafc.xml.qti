</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que é a história superficial de uma narrativa pessoal?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="74460">
<material>
<mattext texttype="text/plain">Uma descrição dos acontecimentos que ocorreram</mattext>
</material>
</response_label>
<response_label ident="83795">
<material>
<mattext texttype="text/plain">A lição que quem escreve aprendeu com a experiência</mattext>
</material>
</response_label>
<response_label ident="62543">
<material>
<mattext texttype="text/plain">A reflexão de quem escreve sobre por que a experiência é importante</mattext>
</material>
</response_label>
<response_label ident="11431">
<material>
<mattext texttype="text/plain">A resposta emocional que quem lê tem em relação à história</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
