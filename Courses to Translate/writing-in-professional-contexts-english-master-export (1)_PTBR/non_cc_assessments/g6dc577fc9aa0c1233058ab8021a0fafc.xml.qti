<item ident="g953767e1c5b8c09a07c5ba09ba23bc85" title="Pergunta 1">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>58578,9215,77955,1489</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Que tipo de escrita relata um acontecimento ou uma experiência específica da própria vida?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="58578">
<material>
<mattext texttype="text/plain">Narrativa pessoal</mattext>
</material>
</response_label>
<response_label ident="9215">
<material>
<mattext texttype="text/plain">Biografia</mattext>
</material>
</response_label>
<response_label ident="77955">
<material>
<mattext texttype="text/plain">Redação analítica</mattext>
</material>
</response_label>
<response_label ident="1489">
<material>
<mattext texttype="text/plain">Relatório de pesquisa</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">9215</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="9215_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">77955</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="77955_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">1489</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="1489_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">58578</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="9215_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Uma biografia é escrita sobre a vida de outra pessoa, não sobre a própria experiência de quem a escreve.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="77955_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Uma redação analítica examina um assunto usando evidências e raciocínio.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="1489_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Um relatório de pesquisa apresenta descobertas de fontes externas.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g467813b6af2d52a2c2b5b6014a74c8ed" title="Pergunta 10">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>54781,59124,88727,55820</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Onde costuma aparecer a reflexão final de uma narrativa pessoal?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="54781">
<material>
<mattext texttype="text/plain">Nos parágrafos finais da narrativa</mattext>
</material>
</response_label>
<response_label ident="59124">
<material>
<mattext texttype="text/plain">Na cena de abertura, antes do início da ação</mattext>
</material>
</response_label>
<response_label ident="88727">
<material>
<mattext texttype="text/plain">Ao longo da seção intermediária, junto com os diálogos</mattext>
</material>
</response_label>
<response_label ident="55820">
<material>
<mattext texttype="text/plain">Imediatamente após a introdução do primeiro detalhe sensorial</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">59124</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="59124_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">88727</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="88727_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">55820</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="55820_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">54781</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="59124_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A cena de abertura estabelece a situação, em vez de oferecer uma reflexão final.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="88727_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A reflexão integrada ao longo da seção intermediária pode preparar as pessoas leitoras para a conclusão, mas a principal reflexão de encerramento surge nos parágrafos finais, nos quais quem escreve relaciona a experiência específica a um significado mais amplo.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="55820_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">O diálogo e os detalhes sensoriais são desenvolvidos na seção intermediária.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g7d7cd73dbad2749a3d2d5dfbe59786ea" title="Pergunta 11">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>51153,68492,65851,13091</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual parte da estrutura da narrativa pessoal costuma ser a mais longa?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="51153">
<material>
<mattext texttype="text/plain">A seção intermediária, onde a experiência é desenvolvida</mattext>
</material>
</response_label>
<response_label ident="68492">
<material>
<mattext texttype="text/plain">O início, onde a situação é estabelecida</mattext>
</material>
</response_label>
<response_label ident="65851">
<material>
<mattext texttype="text/plain">O final, onde quem escreve reflete sobre o significado</mattext>
</material>
</response_label>
<response_label ident="13091">
<material>
<mattext texttype="text/plain">A exposição, onde são fornecidas informações de contexto</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">68492</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="68492_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">65851</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="65851_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">13091</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="13091_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">51153</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="68492_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">O início estabelece a situação de forma breve e não é a seção mais longa.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="65851_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">O final traz uma reflexão, mas costuma ser conciso.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="13091_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A exposição faz parte do início, não sendo uma seção separada de maior extensão.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g1b0c296605afb0604f36f9508615c5d1" title="Pergunta 12">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>27163,65414,60101,53504</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual é o propósito do diálogo em uma narrativa pessoal?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="27163">
<material>
<mattext texttype="text/plain">Revelar traços de personalidade, fazer a história avançar e conectar-se com o público leitor</mattext>
</material>
</response_label>
<response_label ident="65414">
<material>
<mattext texttype="text/plain">Fornecer informações de contexto sobre eventos anteriores ao início da história</mattext>
</material>
</response_label>
<response_label ident="60101">
<material>
<mattext texttype="text/plain">Substituir os detalhes sensoriais ao descrever uma cena</mattext>
</material>
</response_label>
<response_label ident="53504">
<material>
<mattext texttype="text/plain">Resumir o que aconteceu entre dois grandes eventos da narrativa</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">65414</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="65414_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">60101</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="60101_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">53504</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="53504_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">27163</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="65414_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">As informações de contexto pertencem ao início, não ao diálogo.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="60101_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Os detalhes sensoriais e o diálogo servem a propósitos diferentes, e nenhum substitui o outro.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="53504_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Resumir eventos entre as cenas é uma técnica de transição, não o objetivo do diálogo.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="gfda7f6dee2eeadbbd11f611e4cbeb1e9" title="Pergunta 13">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>13492,65555,69560,72918</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que significa o termo "telling" na escrita de narrativas pessoais?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="13492">
<material>
<mattext texttype="text/plain">Declarar emoções ou fatos diretamente, em vez de mostrá-los por meio de detalhes</mattext>
</material>
</response_label>
<response_label ident="65555">
<material>
<mattext texttype="text/plain">Usar ações específicas e detalhes sensoriais para permitir que o público leitor vivencie a história</mattext>
</material>
</response_label>
<response_label ident="69560">
<material>
<mattext texttype="text/plain">Incluir diálogos para que o público leitor possa ouvir os personagens falarem</mattext>
</material>
</response_label>
<response_label ident="72918">
<material>
<mattext texttype="text/plain">Descrever o cenário de uma cena com detalhes visuais precisos</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">65555</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="65555_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">69560</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="69560_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">72918</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="72918_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">13492</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="65555_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Usar ações específicas e detalhes sensoriais é a técnica chamada "showing".</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="69560_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Incluir diálogos é uma ferramenta do "showing".</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="72918_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Descrever o cenário com precisão é uma forma de "showing".</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="gec406f111de4c2911f9c08977263349b" title="Pergunta 14">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>84276,29180,98928,88078</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que é a voz narrativa em uma narrativa pessoal?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="84276">
<material>
<mattext texttype="text/plain">A personalidade, a perspectiva e o tom na escrita de quem escreve</mattext>
</material>
</response_label>
<response_label ident="29180">
<material>
<mattext texttype="text/plain">A sequência de eventos que compõem o enredo da história</mattext>
</material>
</response_label>
<response_label ident="98928">
<material>
<mattext texttype="text/plain">A mensagem central ou lição que a narrativa transmite</mattext>
</material>
</response_label>
<response_label ident="88078">
<material>
<mattext texttype="text/plain">O cenário físico onde ocorrem os eventos da história</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">29180</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="29180_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">98928</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="98928_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">88078</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="88078_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">84276</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="29180_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">O enredo refere-se à sequência de eventos em uma história, não a como ela é contada.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="98928_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">O tema é a mensagem central ou lição, que é independente do estilo de expressão de quem escreve.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="88078_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">O cenário descreve onde e quando a história se passa, não a presença de quem escreve na página.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="gadb8050cd359ed08c7282f56c034cdaa" title="Pergunta 15">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>1105,72500,22517,74058</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual é o definição de cultura conforme utilizada na escrita de narrativas pessoais?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="1105">
<material>
<mattext texttype="text/plain">Os valores, costumes, artes e características compartilhados de um grupo social</mattext>
</material>
</response_label>
<response_label ident="72500">
<material>
<mattext texttype="text/plain">O país ou região específica onde a pessoa autora nasceu</mattext>
</material>
</response_label>
<response_label ident="22517">
<material>
<mattext texttype="text/plain">O idioma que a pessoa autora utiliza para se comunicar com o público leitor</mattext>
</material>
</response_label>
<response_label ident="74058">
<material>
<mattext texttype="text/plain">Os acontecimentos históricos que moldaram as experiências pessoais de quem escreve</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">72500</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="72500_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">22517</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="22517_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">74058</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="74058_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">1105</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="72500_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">O país ou a região de nascimento é um aspecto do contexto de vida, mas não define a cultura por completo.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="22517_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">O idioma é um componente da cultura, mas não abrange todo o seu significado.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="74058_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Os acontecimentos históricos podem influenciar a cultura, mas não são a sua definição.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g099c1fdeedc28c8812478015ff5530b6" title="Pergunta 16">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>7122,54227,87245,85120</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que é um narrador onisciente?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="7122">
<material>
<mattext texttype="text/plain">Um narrador que possui um ponto de vista onisciente (que tudo sabe)</mattext>
</material>
</response_label>
<response_label ident="54227">
<material>
<mattext texttype="text/plain">Um narrador que é personagem na história e a conta usando "eu"</mattext>
</material>
</response_label>
<response_label ident="87245">
<material>
<mattext texttype="text/plain">Um narrador que se alinha a uma personagem e sabe apenas o que essa personagem sabe</mattext>
</material>
</response_label>
<response_label ident="85120">
<material>
<mattext texttype="text/plain">Um narrador que se dirige diretamente ao público leitor usando a palavra "você"</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">54227</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="54227_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">87245</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="87245_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">85120</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="85120_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">7122</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="54227_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Um narrador que é personagem na história utilizando &lt;strong&gt;eu&lt;/strong&gt; é um narrador em primeira pessoa.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="87245_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Um narrador alinhado a uma personagem e que sabe apenas o que ela sabe é um narrador em terceira pessoa limitado.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="85120_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Um narrador que se dirige ao público leitor como &lt;strong&gt;você&lt;/strong&gt; utiliza o ponto de vista em segunda pessoa.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g07cc32998f705f404621de48c8407b29" title="Pergunta 17">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
