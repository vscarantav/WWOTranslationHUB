</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="83795_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">62543</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="62543_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">11431</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="11431_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">74460</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="83795_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A lição aprendida e a reflexão sobre o significado fazem parte da história mais profunda.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="62543_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A lição aprendida e a reflexão sobre o significado fazem parte da história mais profunda.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="11431_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A resposta emocional de quem lê é um resultado, não uma camada da história.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="gaf45474f9d29be13abf8003a5d9c0d1f" title="Pergunta 30">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
