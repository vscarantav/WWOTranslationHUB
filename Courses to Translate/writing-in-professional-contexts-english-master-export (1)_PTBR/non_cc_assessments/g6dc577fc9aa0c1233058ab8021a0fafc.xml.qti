<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>73561,90049,71880,92621</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que é a escrita pessoal?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="73561">
<material>
<mattext texttype="text/plain">Escrita que compartilha com o público leitor as vivências de quem escreve, conta uma história e, muitas vezes, inclui memórias e episódios marcantes</mattext>
</material>
</response_label>
<response_label ident="90049">
<material>
<mattext texttype="text/plain">Escrita que apresenta um argumento fundamentado em pesquisas e apoiado por fontes externas</mattext>
</material>
</response_label>
<response_label ident="71880">
<material>
<mattext texttype="text/plain">Escrita que analisa um texto ou uma ideia sob uma perspectiva crítica</mattext>
</material>
</response_label>
<response_label ident="92621">
<material>
<mattext texttype="text/plain">Escrita que descreve um processo ou procedimento usando instruções passo a passo</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">90049</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="90049_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">71880</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="71880_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">92621</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="92621_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">73561</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="90049_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A escrita que apresenta um argumento fundamentado em pesquisas é a escrita acadêmica ou persuasiva.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="71880_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A escrita que analisa criticamente um texto ou uma ideia é a escrita analítica.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="92621_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A escrita que descreve um processo passo a passo é a escrita processual ou instrucional.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="gf97acf71704578da74dd53c67c225614" title="Pergunta 18">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>8116,36801,88362,76449</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual é o propósito dos detalhes sensoriais em uma narrativa pessoal?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="8116">
<material>
<mattext texttype="text/plain">Transformar a narrativa em uma experiência vívida que o público leitor possa ver, ouvir, sentir, cheirar e saborear</mattext>
</material>
</response_label>
<response_label ident="36801">
<material>
<mattext texttype="text/plain">Fornecer informações de contexto sobre o cenário antes do início da história</mattext>
</material>
</response_label>
<response_label ident="88362">
<material>
<mattext texttype="text/plain">Resumir os acontecimentos da narrativa de maneira concreta</mattext>
</material>
</response_label>
<response_label ident="76449">
<material>
<mattext texttype="text/plain">Substituir o diálogo quando nenhuma conversa ocorreu durante a experiência</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">36801</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="36801_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">88362</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="88362_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">76449</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="76449_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">8116</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="36801_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">As informações de contexto pertencem ao início, não à descrição sensorial.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="88362_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Os detalhes sensoriais criam uma experiência vívida em vez de resumir os acontecimentos.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="76449_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">O diálogo e os detalhes sensoriais servem a propósitos diferentes, e nenhum substitui o outro.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="gc8ebd484d5d67a3b526be4836c54d241" title="Pergunta 19">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>34175,41553,26530,21446</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual das seguintes opções é um exemplo de uma afirmação do tipo &lt;strong&gt;telling&lt;/strong&gt;?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="34175">
<material>
<mattext texttype="text/plain">"Minha avó era uma mulher paciente."</mattext>
</material>
</response_label>
<response_label ident="41553">
<material>
<mattext texttype="text/plain">"Minha avó deixou o tricô de lado e cruzou as mãos no colo sem dizer uma palavra."</mattext>
</material>
</response_label>
<response_label ident="26530">
<material>
<mattext texttype="text/plain">"A voz de minha avó continuou suave, mesmo quando a discussão ao seu redor ficou mais alta."</mattext>
</material>
</response_label>
<response_label ident="21446">
<material>
<mattext texttype="text/plain">"Minha avó serviu chá para todos à mesa antes de servir o dela."</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">41553</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="41553_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">26530</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="26530_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">21446</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="21446_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">34175</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="41553_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Deixar o tricô de lado e cruzar as mãos em silêncio... tudo isso mostra a personalidade através de ações e detalhes específicos.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="26530_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Manter a voz suave durante uma discussão... tudo isso mostra a personalidade através de ações e detalhes específicos.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="21446_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;Servir o chá primeiro para as outras pessoas mostra a personalidade através de ações e detalhes específicos.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g6a6ef53fdfd82cea7df43928d4459189" title="Pergunta 2">
