</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que é um comando de &lt;strong&gt;armadilha de dependência&lt;/strong&gt; ao usar a IA durante a Escrita de uma narrativa pessoal?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="87411">
<material>
<mattext texttype="text/plain">Um comando que pede à IA para gerar diálogos e detalhes sensoriais para uma narrativa pessoal</mattext>
</material>
</response_label>
<response_label ident="40218">
<material>
<mattext texttype="text/plain">Um comando que pede à IA para verificar a gramática e a pontuação em um rascunho concluído</mattext>
</material>
</response_label>
<response_label ident="85512">
<material>
<mattext texttype="text/plain">Um comando que pede à IA para explicar um conceito de Escrita, como "mostrar em vez de contar"</mattext>
</material>
</response_label>
<response_label ident="58111">
<material>
<mattext texttype="text/plain">Um comando que pede à IA para identificar onde o rascunho muda para um tom genérico</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
