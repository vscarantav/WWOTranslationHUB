</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">81123</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="81123_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">38779</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="38779_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">66587</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="89477_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A sequência de acontecimentos é a história superficial.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="81123_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Os detalhes sensoriais são uma técnica de escrita utilizada ao longo de toda a narrativa.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="38779_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">As informações de contexto pertencem à exposição.</mattext>
</material>
</flow_mat>
