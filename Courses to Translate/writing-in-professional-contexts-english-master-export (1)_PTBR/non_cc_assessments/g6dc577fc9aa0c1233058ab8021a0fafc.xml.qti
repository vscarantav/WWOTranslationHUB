<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>20079,94884,57111,64584</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual é o propósito da reflexão em uma narrativa pessoal?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="20079">
<material>
<mattext texttype="text/plain">Conectar a experiência específica a um significado mais amplo e mostrar como a perspectiva de quem escreve mudou</mattext>
</material>
</response_label>
<response_label ident="94884">
<material>
<mattext texttype="text/plain">Apresentar o cenário e os personagens no início da história</mattext>
</material>
</response_label>
<response_label ident="57111">
<material>
<mattext texttype="text/plain">Fornecer informações de contexto antes do início dos acontecimentos principais</mattext>
</material>
</response_label>
<response_label ident="64584">
<material>
<mattext texttype="text/plain">Descrever detalhes sensoriais para que quem lê possa visualizar a cena</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">94884</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="94884_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">57111</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="57111_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">64584</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="64584_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">20079</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="94884_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Apresentar o cenário e os personagens é o propósito do começo.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="57111_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">As informações de contexto também pertencem ao começo.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="64584_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Os detalhes sensoriais são uma técnica utilizada ao longo de toda a narrativa.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="gcded7cf58182cb0f9b6ad181120ecba2" title="Pergunta 9">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
