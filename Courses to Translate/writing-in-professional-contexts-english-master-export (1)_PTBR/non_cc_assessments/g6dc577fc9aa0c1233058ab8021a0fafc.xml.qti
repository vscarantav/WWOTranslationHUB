<fieldentry>50878,61474,14316,52909</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que a leitura identifica como o elemento da narrativa pessoal em que o uso de IA é mais tentador, mas que tem maior probabilidade de enfraquecer a escrita?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="50878">
<material>
<mattext texttype="text/plain">Detalhes sensoriais</mattext>
</material>
</response_label>
<response_label ident="61474">
<material>
<mattext texttype="text/plain">Estrutura narrativa</mattext>
</material>
</response_label>
<response_label ident="14316">
<material>
<mattext texttype="text/plain">Pontuação de diálogos</mattext>
</material>
</response_label>
<response_label ident="52909">
<material>
<mattext texttype="text/plain">Reflexão final</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">61474</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="61474_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">14316</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="14316_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">52909</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="52909_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">50878</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="61474_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A estrutura narrativa é uma área na qual a IA pode servir como um bom recurso para testar ideias após a existência de um rascunho completo.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="14316_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A pontuação de diálogos é uma habilidade mecânica, não a área identificada.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="52909_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A reflexão final é uma percepção própria de quem escreve e não é identificada como a área mais tentadora para o uso de IA.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="gb60bd0db0d13a6483c4b590a3ec3bc57" title="Pergunta 31">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>15430,98563,80636,69639</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;De acordo com a leitura, o que a pessoa que escreve deve fazer se sua narrativa não parecer mais ter sua própria voz após receber feedback da IA?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="15430">
<material>
<mattext texttype="text/plain">Revisar a narrativa para recuperar sua própria voz antes de enviá-la</mattext>
</material>
</response_label>
<response_label ident="98563">
<material>
<mattext texttype="text/plain">Aceitar as alterações porque a IA produz uma escrita acadêmica mais clara</mattext>
</material>
</response_label>
<response_label ident="80636">
<material>
<mattext texttype="text/plain">Pedir à IA para restaurar a versão original a partir do rascunho anterior</mattext>
</material>
</response_label>
<response_label ident="69639">
<material>
<mattext texttype="text/plain">Enviar a versão revisada pela IA e indicar as alterações em uma carta de apresentação</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">98563</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="98563_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">80636</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="80636_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">69639</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="69639_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">15430</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="98563_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Aceitar as alterações da IA porque elas produzem uma escrita mais clara ignora a perda da voz autêntica sobre a qual a leitura alerta.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="80636_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Pedir à IA para restaurar uma versão anterior não resolve o problema subjacente da voz.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="69639_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Enviar uma versão revisada pela IA com uma nota de apresentação não cumpre o propósito da atividade.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="gf1212787d069fe45b927787b1185f84e" title="Pergunta 32">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>46861,10773,27996,53192</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;De acordo com a leitura, qual é uma forma pela qual quem escreve pode manter a honestidade sobre um diálogo reconstruído?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="46861">
<material>
<mattext texttype="text/plain">Incluir uma frase como: "Não consigo me lembrar de suas palavras exatas, mas a mensagem foi clara"</mattext>
</material>
</response_label>
<response_label ident="10773">
<material>
<mattext texttype="text/plain">Remover todo o diálogo da narrativa e substituí-lo por descrição</mattext>
</material>
</response_label>
<response_label ident="27996">
<material>
<mattext texttype="text/plain">Escrever a conversa exatamente como quem escreve acredita que ela ocorreu, sem qualquer menção a isso</mattext>
</material>
</response_label>
<response_label ident="53192">
<material>
<mattext texttype="text/plain">Colocar o diálogo reconstruído em itálico para sinalizar que ele pode não ser exato</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">10773</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="10773_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">27996</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="27996_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">53192</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="53192_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">46861</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="10773_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Remover todo o diálogo enfraquece a narrativa ao eliminar o senso de imediatismo e a revelação dos personagens.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="27996_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Escrever um diálogo reconstruído sem essa menção distorce o nível de certeza de quem escreve.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="53192_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">O uso de itálico para diálogos reconstruídos não é uma convenção identificada na leitura.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g1dd588f23412f0c0fec6967c283fb3a7" title="Pergunta 33">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>79390,57595,21284,15760</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que a leitura identifica como o momento correto no processo de escrita para a IA atuar como um recurso de validação estrutural?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="79390">
<material>
<mattext texttype="text/plain">Após quem escreve ter concluído um rascunho completo com começo, meio, fim, detalhes sensoriais e reflexão pessoal</mattext>
</material>
</response_label>
<response_label ident="57595">
<material>
<mattext texttype="text/plain">No início do processo para ajudar quem escreve a identificar qual memória utilizar</mattext>
</material>
</response_label>
<response_label ident="21284">
<material>
<mattext texttype="text/plain">Após quem escreve ter redigido uma oração inicial, mas antes de desenvolver a narrativa completa</mattext>
</material>
</response_label>
<response_label ident="15760">
<material>
<mattext texttype="text/plain">Durante a seção intermediária para ajudar quem escreve a desenvolver cenas e diálogos</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">57595</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="57595_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">21284</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="21284_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">15760</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="15760_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">79390</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="57595_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Usar a IA no início para identificar uma memória substitui a reflexão pessoal de quem escreve.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="21284_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Usar a IA após uma oração inicial, mas antes de um rascunho completo, introduz a ferramenta muito cedo no processo.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="15760_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Usar a IA durante a seção intermediária para desenvolver cenas substitui a narrativa da própria pessoa que escreve.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="gb849d3f45534c93dc82a289753c7acef" title="Pergunta 4">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
