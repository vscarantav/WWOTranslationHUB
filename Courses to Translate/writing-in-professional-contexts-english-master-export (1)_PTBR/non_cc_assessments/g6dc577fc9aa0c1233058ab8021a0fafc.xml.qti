<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual é a definição da história mais profunda de uma narrativa pessoal?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="66587">
<material>
<mattext texttype="text/plain">O significado por trás dos acontecimentos e o motivo pelo qual a experiência é importante</mattext>
</material>
</response_label>
<response_label ident="89477">
<material>
<mattext texttype="text/plain">A sequência de acontecimentos que ocorreram durante a experiência</mattext>
</material>
</response_label>
<response_label ident="81123">
<material>
<mattext texttype="text/plain">Os detalhes sensoriais que a pessoa que escreve usa para descrever a cena</mattext>
</material>
</response_label>
<response_label ident="38779">
<material>
<mattext texttype="text/plain">As informações de contexto fornecidas no início da narrativa</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
