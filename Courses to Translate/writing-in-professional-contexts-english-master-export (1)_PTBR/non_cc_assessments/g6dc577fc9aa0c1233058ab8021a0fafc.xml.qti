</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">85512</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="85512_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">58111</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="58111_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">87411</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="40218_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Pedir à IA para verificar a gramática em um rascunho concluído é um uso apropriado da IA.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="85512_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Pedir à IA que explique conceitos de Escrita ajuda quem escreve a compreender a tarefa.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="58111_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Pedir à IA que identifique mudanças de tom em um rascunho mantém quem escreve no controle das revisões.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="gcc48285dc6932342256aa10c3ed680e5" title="Pergunta 3">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
