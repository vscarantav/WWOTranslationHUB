</item>
<item ident="g327df27f8e634b622bbff27707b37ce4" title="Pergunta 20">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>15016,89619,28158,67031</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que quem escreve deve fazer quando não consegue se lembrar das palavras exatas ditas em uma conversa sobre a qual está escrevendo?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="15016">
<material>
<mattext texttype="text/plain">Reconstruir o tom, as frases principais e o conteúdo emocional da conversa</mattext>
</material>
</response_label>
<response_label ident="89619">
<material>
<mattext texttype="text/plain">Deixar a conversa totalmente fora da narrativa</mattext>
</material>
</response_label>
<response_label ident="28158">
<material>
<mattext texttype="text/plain">Escrever apenas as partes da conversa de que se lembra palavra por palavra</mattext>
</material>
</response_label>
<response_label ident="67031">
<material>
<mattext texttype="text/plain">Substituir a conversa por um resumo do que foi discutido</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">89619</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="89619_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">28158</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="28158_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">67031</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="67031_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">15016</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="89619_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Deixar de fora uma conversa que é importante para a história enfraquece a narrativa.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="28158_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Escrever apenas palavras literais limita o que quem escreve pode incluir de sua memória.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="67031_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Substituir a conversa por um resumo elimina o imediatismo que o diálogo proporciona.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="gbc0db6d2fbb94b9b9f85ea8a8c4fe340" title="Pergunta 21">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>19644,51919,43759,32282</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual é o primeiro passo que quem escreve deve dar antes de usar o feedback de IA em um rascunho de narrativa pessoal?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="19644">
<material>
<mattext texttype="text/plain">Escrever um rascunho completo que inclua começo, meio, fim, detalhes sensoriais e reflexão pessoal</mattext>
</material>
</response_label>
<response_label ident="51919">
<material>
<mattext texttype="text/plain">Gerar um esboço usando IA para organizar a estrutura da narrativa</mattext>
</material>
</response_label>
<response_label ident="43759">
<material>
<mattext texttype="text/plain">Pedir à IA que sugira detalhes sensoriais antes de começar a escrever</mattext>
</material>
</response_label>
<response_label ident="32282">
<material>
<mattext texttype="text/plain">Compartilhar um rascunho inicial com a IA para que ela possa identificar quais memórias devem ser incluídas</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">51919</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="51919_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">43759</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="43759_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">32282</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="32282_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">19644</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="51919_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Usar a IA para gerar um esboço antes de escrever substitui o próprio processo de planejamento de quem escreve.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="43759_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Pedir detalhes sensoriais à IA antes de escrever substitui a memória e a própria experiência de quem escreve.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="32282_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Compartilhar um rascunho inicial para que a IA identifique memórias substitui o próprio julgamento de quem escreve pelo da IA.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="ge2ce72e1f69850b97a87d4683d5f3f4f" title="Pergunta 22">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>22794,82767,71755,70078</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que uma abertura de narrativa forte faz?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="22794">
<material>
<mattext texttype="text/plain">Coloca quem lê imediatamente na cena usando detalhes sensoriais</mattext>
</material>
</response_label>
<response_label ident="82767">
<material>
<mattext texttype="text/plain">Oferece um histórico detalhado sobre a vida de quem escreve antes de a história começar</mattext>
</material>
</response_label>
<response_label ident="71755">
<material>
<mattext texttype="text/plain">Explica o tema da narrativa para que quem lê compreenda seu significado</mattext>
</material>
</response_label>
<response_label ident="70078">
<material>
<mattext texttype="text/plain">Resume os acontecimentos que ocorrerão ao longo da narrativa</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">82767</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="82767_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">71755</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="71755_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">70078</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="70078_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">22794</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="82767_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Um histórico detalhado antes do início da história retarda o engajamento e pode incluir informações irrelevantes.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="71755_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Explicar o tema na abertura elimina a descoberta que quem lê deveria vivenciar.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="70078_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Resumir os próximos acontecimentos elimina o suspense e o ritmo da narrativa.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g3091215402867bd23941c9cddb14e216" title="Pergunta 23">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>10566,39305,35630,61563</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual é o significado do termo "tarefa de processo" conforme usado na leitura da S05?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="10566">
<material>
<mattext texttype="text/plain">Uma Atividade em que o aprendizado provém do próprio ato de pensar, lembrar e interpretar de quem escreve</mattext>
</material>
</response_label>
<response_label ident="39305">
<material>
<mattext texttype="text/plain">Uma Atividade que exige que quem escreve siga um conjunto fixo de etapas em uma ordem específica</mattext>
</material>
</response_label>
<response_label ident="35630">
<material>
<mattext texttype="text/plain">Uma Atividade que usa ferramentas de IA para gerar e refinar conteúdo escrito</mattext>
</material>
</response_label>
<response_label ident="61563">
<material>
<mattext texttype="text/plain">Uma Atividade que se concentra em editar e revisar uma obra de Escrita existente</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">39305</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="39305_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">35630</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="35630_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">61563</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="61563_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">10566</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="39305_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Seguir um conjunto fixo de etapas descreve uma tarefa procedural.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="35630_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Usar a IA para gerar conteúdo é o oposto do que a leitura descreve como uma tarefa de processo.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="61563_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Editar e revisar uma obra existente é uma etapa da Escrita, não a definição de uma tarefa de processo.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g928d2d5666f03ef625d8240fb1fd5e1d" title="Pergunta 24">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>1630,38228,49579,31568</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual é o risco de pedir à IA para "melhorar minha escrita" após concluir o rascunho de uma narrativa pessoal?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="1630">
<material>
<mattext texttype="text/plain">A IA pode substituir a voz marcante de quem escreve por uma prosa genérica e padronizada</mattext>
</material>
</response_label>
<response_label ident="38228">
<material>
<mattext texttype="text/plain">A IA sempre tornará a Escrita informal demais para o Envio de Tarefa acadêmica</mattext>
</material>
</response_label>
<response_label ident="49579">
<material>
<mattext texttype="text/plain">A IA não consegue ler rascunhos de narrativas pessoais e produzirá conteúdo não relacionado</mattext>
</material>
</response_label>
<response_label ident="31568">
<material>
<mattext texttype="text/plain">A IA sempre encurtará a narrativa, independentemente do comando</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">38228</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="38228_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">49579</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="49579_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">31568</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="31568_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">1630</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="38228_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;A IA não produz Escrita informal de forma consistente — esse não é o risco identificado.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="49579_fb">
<flow_mat>
<material>
<mattext texttype="text/html">A IA pode ler rascunhos de narrativas pessoais e responder a eles.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="31568_fb">
<flow_mat>
<material>
<mattext texttype="text/html">A IA não reduz automaticamente a Escrita para menos do que o comprimento exigido.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g3128e84f1eaf6214f4c919b2e979f2dc" title="Pergunta 25">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>48462,78236,79969,50142</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual é uma forma apropriada de usar a IA durante o processo de Escrita da narrativa pessoal?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="48462">
<material>
<mattext texttype="text/plain">Pedir à IA que explique o que significa "mostrar em vez de contar" com exemplos</mattext>
</material>
</response_label>
<response_label ident="78236">
<material>
<mattext texttype="text/plain">Pedir à IA para gerar o primeiro rascunho da narrativa</mattext>
</material>
</response_label>
<response_label ident="79969">
<material>
<mattext texttype="text/plain">Pedir à IA para selecionar sobre qual memória pessoal escrever</mattext>
</material>
</response_label>
<response_label ident="50142">
<material>
<mattext texttype="text/plain">Pedir à IA para adicionar detalhes sensoriais a uma cena que quem escreve ainda não escreveu</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">78236</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="78236_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">79969</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="79969_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">50142</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="50142_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">48462</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="78236_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Pedir à IA que gere o primeiro rascunho substitui completamente o próprio processo de quem escreve.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="79969_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Pedir à IA que selecione uma memória substitui a reflexão pessoal de quem escreve pelo julgamento da IA.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="50142_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Pedir à IA para adicionar detalhes sensoriais a uma cena não escrita substitui a memória de quem escreve por um conteúdo que não pertence à experiência pessoal real de ninguém.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="ga75bec780144b1c1b2e63ab0f8569717" title="Pergunta 26">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>8447,1687,25311,22712</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;De acordo com a leitura da S05, o que torna autênticos os detalhes sensoriais em uma narrativa pessoal?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="8447">
<material>
<mattext texttype="text/plain">Eles se baseiam na memória específica que quem escreve tem da experiência.</mattext>
</material>
</response_label>
<response_label ident="1687">
<material>
<mattext texttype="text/plain">Eles utilizam um vocabulário altamente técnico ou acadêmico para aprimorar a descrição.</mattext>
</material>
</response_label>
<response_label ident="25311">
<material>
<mattext texttype="text/plain">Eles descrevem todos os cinco sentidos igualmente em cada parágrafo.</mattext>
</material>
</response_label>
<response_label ident="22712">
<material>
<mattext texttype="text/plain">Eles são genéricos o suficiente para que qualquer pessoa que leia possa tê-los vivenciado.</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">1687</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="1687_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">25311</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="25311_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">22712</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="22712_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">8447</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="1687_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Um vocabulário preciso de fontes externas não torna os detalhes autênticos para uma experiência pessoal.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="25311_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Abranger todos os cinco sentidos igualmente em cada parágrafo não é obrigatório nem recomendado.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="22712_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Detalhes tão nítidos que qualquer pessoa poderia tê-los escrito caracterizam uma Escrita genérica, e não autêntica.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g15459b56ffa550282f4496c004fdfe5d" title="Pergunta 27">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>9374,4812,82913,85807</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;No estudo de caso de abertura da S05, qual era o principal problema com o primeiro rascunho de Ada?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="9374">
<material>
<mattext texttype="text/plain">Ele tentou abranger coisas demais em vez de focar em um momento específico.</mattext>
</material>
</response_label>
<response_label ident="4812">
<material>
<mattext texttype="text/plain">Ele usou detalhes sensoriais em excesso que não tinham relação com a história.</mattext>
</material>
</response_label>
<response_label ident="82913">
<material>
<mattext texttype="text/plain">Ele dependeu excessivamente de diálogos em vez de descrever os acontecimentos.</mattext>
</material>
</response_label>
<response_label ident="85807">
<material>
<mattext texttype="text/plain">Ele começou muito perto da Ação sem fornecer informações de contexto suficientes.</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">4812</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="4812_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">82913</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="82913_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">85807</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="85807_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">9374</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="4812_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;O primeiro rascunho de Ada não incluía detalhes sensoriais excessivos — na verdade, faltavam detalhes.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="82913_fb">
<flow_mat>
<material>
<mattext texttype="text/html">O rascunho não dependia de diálogos.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="85807_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Começar muito perto da Ação é um ponto forte na Escrita de narrativas pessoais, não um problema.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g8dd01f675e1738ef90030ed2fcd60fe2" title="Pergunta 28">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>78342,38414,32022,17136</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que é um comando de &lt;strong&gt;acelerador de crescimento&lt;/strong&gt; ao usar a IA durante a Escrita de uma narrativa pessoal?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="78342">
<material>
<mattext texttype="text/plain">Um comando que pede à IA para identificar problemas no próprio rascunho de quem escreve, sem reescrever nada</mattext>
</material>
</response_label>
<response_label ident="38414">
<material>
<mattext texttype="text/plain">Um comando que pede à IA para gerar o parágrafo de abertura da narrativa</mattext>
</material>
</response_label>
<response_label ident="32022">
<material>
<mattext texttype="text/plain">Um comando que pede à IA para adicionar detalhes sensoriais às cenas que quem escreve descreveu</mattext>
</material>
</response_label>
<response_label ident="17136">
<material>
<mattext texttype="text/plain">Um comando que pede à IA para selecionar a memória mais interessante de uma lista fornecida por quem escreve</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">38414</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="38414_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">32022</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="32022_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">17136</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="17136_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">78342</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="38414_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Pedir à IA para gerar um parágrafo de abertura é uma armadilha de dependência, não um acelerador de crescimento.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="32022_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Pedir à IA para adicionar detalhes sensoriais substitui a memória de quem escreve.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="17136_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Pedir à IA para selecionar uma memória substitui a reflexão pessoal de quem escreve pelo julgamento da IA.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="gfd7ccc407447cbd73d1d3c6683a58076" title="Pergunta 29">
<itemmetadata>
