<itemfeedback ident="47136_fb">
<flow_mat>
<material>
<mattext texttype="text/html">&lt;p&gt;A segunda pessoa se dirige ao público leitor como &lt;strong&gt;você&lt;/strong&gt;.&lt;/p&gt;</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="21844_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Tanto a terceira pessoa limitada quanto a terceira pessoa onisciente situam a voz narrativa fora da história.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="59546_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Tanto a terceira pessoa limitada quanto a terceira pessoa onisciente situam a voz narrativa fora da história.</mattext>
</material>
