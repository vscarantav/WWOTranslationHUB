<item ident="g651b3d5e901f71196ba359b265f72b60" title="Pergunta 3">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_answers_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>181,2401,9462,3085,2471,2692</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>assessment_question_identifierref</fieldlabel>
<fieldentry>g8c48f127c4767aa352558d4f4fb5d488</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Como parte do Código de Honra do Sistema Educacional da Igreja, espera-se que você realize seus próprios trabalhos em cada disciplina/curso.&lt;/p&gt;
&lt;p&gt;Caso opte por participar de&lt;span&gt; &lt;/span&gt;&lt;strong&gt;quaisquer&lt;/strong&gt;&lt;span&gt; &lt;/span&gt;ações que violem a política de honestidade acadêmica, a universidade terá o direito de&lt;span&gt; &lt;/span&gt;&lt;strong&gt;alterar a sua nota na disciplina/curso para F agora ou em qualquer momento no futuro&lt;/strong&gt;. Isso significa que, mesmo que a desonestidade só seja descoberta após a conclusão do seu certificado ou diploma, a universidade ainda terá o direito de alterar a sua nota e&lt;span&gt; &lt;/span&gt;&lt;strong&gt;revogar o seu certificado ou diploma&lt;/strong&gt;.&lt;/p&gt;
&lt;p&gt;Quais das seguintes opções constituem violações do Código de Honra ou da política de honestidade acadêmica? Observe que esta lista não é exaustiva (ver Jacó 6:12).&lt;span&gt; &lt;/span&gt;&lt;strong&gt;Marque todas as opções aplicáveis.&lt;/strong&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Multiple">
<render_choice>
<response_label ident="181">
<material>
<mattext texttype="text/plain">Publicar ou compartilhar seus trabalhos escolares (projetos, atividades, etc.) em qualquer site da internet, por meio de comunicação eletrônica ou por qualquer outro meio.</mattext>
</material>
</response_label>
<response_label ident="2401">
<material>
<mattext texttype="text/plain">Obter o trabalho de outra pessoa e enviá-lo, no todo ou em parte, como se fosse seu próprio trabalho.</mattext>
</material>
</response_label>
<response_label ident="9462">
<material>
<mattext texttype="text/plain">Entregar a sua atividade a outro estudante ou aceitar a dele.</mattext>
</material>
</response_label>
<response_label ident="3085">
<material>
<mattext texttype="text/plain">Usar um mecanismo de busca como o Google para encontrar uma fórmula do Excel que resolva o seu projeto.</mattext>
</material>
</response_label>
<response_label ident="2471">
<material>
<mattext texttype="text/plain">Obter documentos da disciplina/curso no Course Hero ou em outros sites semelhantes.</mattext>
</material>
</response_label>
<response_label ident="2692">
<material>
<mattext texttype="text/plain">Fazer perguntas sobre os projetos no anúncio semanal do(a) instrutor(a), o qual todos podem ver.</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="No">
<conditionvar>
<and>
<varequal respident="response1">181</varequal>
<varequal respident="response1">2401</varequal>
<varequal respident="response1">9462</varequal>
<not>
<varequal respident="response1">3085</varequal>
</not>
<varequal respident="response1">2471</varequal>
<not>
<varequal respident="response1">2692</varequal>
</not>
</and>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
</item>
