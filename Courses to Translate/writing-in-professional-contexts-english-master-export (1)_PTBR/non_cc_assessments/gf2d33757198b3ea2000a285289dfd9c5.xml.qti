<item ident="g2f62a78395a0677c168860a7971e9deb" title="Pergunta 7">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>90858,3376,45905,76051</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que significa a sigla SMART no contexto de definição de metas para a melhoria da escrita?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="90858">
<material>
<mattext texttype="text/plain">Específico, Mensurável, Atingível, Relevante, Temporal.</mattext>
</material>
</response_label>
