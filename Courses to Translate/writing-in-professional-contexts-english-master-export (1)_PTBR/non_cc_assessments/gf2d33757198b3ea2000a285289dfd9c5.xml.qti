<mattext texttype="text/html">&lt;div&gt;O que a conclusão de uma redação reflexiva geralmente apresenta, de acordo com a leitura?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="50882">
<material>
<mattext texttype="text/plain">Percepções ou constatações.</mattext>
</material>
</response_label>
<response_label ident="10972">
<material>
<mattext texttype="text/plain">Uma reafirmação da tese e dos principais argumentos.</mattext>
</material>
</response_label>
<response_label ident="46123">
<material>
<mattext texttype="text/plain">Uma lista de fontes usadas ao longo da redação.</mattext>
</material>
</response_label>
<response_label ident="94112">
<material>
<mattext texttype="text/plain">Um resumo do ponto de vista oposto.</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
