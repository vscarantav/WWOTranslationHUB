<mattext texttype="text/plain">Verificar se há erros de ortografia em um trabalho concluído</mattext>
</material>
</response_label>
<response_label ident="65451">
<material>
<mattext texttype="text/plain">Reorganizar os parágrafos após receber feedback</mattext>
</material>
</response_label>
<response_label ident="892">
<material>
<mattext texttype="text/plain">Selecionar fontes para apoiar um argumento</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
