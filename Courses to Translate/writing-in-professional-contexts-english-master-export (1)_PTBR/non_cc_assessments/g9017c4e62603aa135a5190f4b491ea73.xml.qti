<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;De acordo com o capítulo, qual é a principal diferença de estrutura entre uma narrativa pessoal e uma redação argumentativa?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="54187">
<material>
