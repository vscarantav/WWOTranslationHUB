<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;De acordo com o capítulo, qual é a papel do clímax ou ponto de virada em uma narrativa pessoal?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="55442">
<material>
<mattext texttype="text/plain">Um momento determinante em que algo importante acontece ou muda</mattext>
</material>
</response_label>
<response_label ident="14789">
<material>
<mattext texttype="text/plain">A abertura que define o cenário e introduz as pessoas principais</mattext>
</material>
</response_label>
<response_label ident="77427">
<material>
<mattext texttype="text/plain">A seção que conecta a história a uma reflexão ou lição mais ampla</mattext>
</material>
</response_label>
<response_label ident="21980">
<material>
<mattext texttype="text/plain">A parte que cria tensão por meio de uma série de eventos específicos</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
