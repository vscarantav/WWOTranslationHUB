</material>
</response_label>
<response_label ident="73244">
<material>
<mattext texttype="text/plain">Substituir todos os adjetivos por substantivos específicos para melhorar a clareza</mattext>
</material>
</response_label>
<response_label ident="16132">
<material>
<mattext texttype="text/plain">Usar advérbios para modificar cada verbo para maior precisão</mattext>
</material>
</response_label>
</render_choice>
