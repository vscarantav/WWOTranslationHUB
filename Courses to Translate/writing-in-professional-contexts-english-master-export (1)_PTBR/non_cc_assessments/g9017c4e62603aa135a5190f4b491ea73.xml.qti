</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;De acordo com o capítulo, qual é a primeira prioridade que quem escreve deve abordar ao revisar um rascunho?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="69752">
<material>
<mattext texttype="text/plain">Questões gerais, como a clareza da declaração de tese e a organização lógica</mattext>
</material>
</response_label>
<response_label ident="10182">
<material>
<mattext texttype="text/plain">Questões no nível da oração, como formulações confusas</mattext>
</material>
</response_label>
<response_label ident="92003">
<material>
<mattext texttype="text/plain">Questões mecânicas, como ortografia e pontuação</mattext>
</material>
</response_label>
<response_label ident="76194">
<material>
<mattext texttype="text/plain">Questões no nível do parágrafo, como as orações iniciais</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">10182</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="10182_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">92003</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="92003_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">76194</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="76194_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">69752</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="10182_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">As questões no nível da oração são a terceira prioridade.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="92003_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">As questões mecânicas, como ortografia e pontuação, são a quarta e última prioridade.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="76194_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">As questões no nível do parágrafo são a segunda prioridade.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
