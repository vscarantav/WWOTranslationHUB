<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>88830,58325,44383,94858</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual é a definição de &lt;span class="TextRun SCXW201429381 BCX8" data-contrast="auto" lang="EN-US"&gt;&lt;span class="NormalTextRun SCXW201429381 BCX8"&gt;"estrutura" conforme apresentada nos termos-chave deste capítulo?&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="88830">
<material>
<mattext texttype="text/plain">A maneira como o autor ordena e organiza um trabalho para criar um significado geral</mattext>
</material>
</response_label>
<response_label ident="58325">
<material>
<mattext texttype="text/plain">As palavras precisas que o autor seleciona para expressar uma ideia</mattext>
</material>
</response_label>
<response_label ident="44383">
<material>
<mattext texttype="text/plain">O processo de verificar se há erros gramaticais em um rascunho</mattext>
</material>
</response_label>
<response_label ident="94858">
<material>
<mattext texttype="text/plain">O tom que um autor utiliza na escrita acadêmica formal</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">58325</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="58325_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">44383</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="44383_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">94858</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="94858_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">88830</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="58325_fb">
<flow_mat>
<material>
<mattext texttype="text/html">A seleção de palavras descreve a dicção ou o estilo.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="44383_fb">
<flow_mat>
<material>
<mattext texttype="text/html">A verificação de erros descreve a revisão final.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="94858_fb">
<flow_mat>
<material>
<mattext texttype="text/html">O tom usado na escrita formal descreve o tom formal, que é um conceito diferente.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="gd5658f2791ceb63520164bd9f33707bf" title="Pergunta 11">
