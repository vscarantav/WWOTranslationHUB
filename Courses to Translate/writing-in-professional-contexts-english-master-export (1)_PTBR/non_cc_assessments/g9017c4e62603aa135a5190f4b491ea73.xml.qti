<itemfeedback ident="59472_fb">
<flow_mat>
<material>
<mattext texttype="text/html">A verificação de erros de ortografia é a revisão final.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="65451_fb">
<flow_mat>
<material>
<mattext texttype="text/html">A reorganização de parágrafos após o feedback é a revisão.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="892_fb">
<flow_mat>
<material>
<mattext texttype="text/html">A seleção de fontes ocorre durante as etapas de pesquisa e planejamento, antes da elaboração do rascunho.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g81a510bf66006c0fcc60a0460435616b" title="Pergunta 13">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>82897,13740,24019,29655</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;De acordo com o capítulo, quando quem escreve deve fazer uma pausa para melhorar a revisão final?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="82897">
<material>
<mattext texttype="text/plain">Antes da revisão final, para que um olhar renovado possa detectar mais erros</mattext>
</material>
</response_label>
<response_label ident="13740">
<material>
<mattext texttype="text/plain">Após enviar o rascunho final para o(a) instrutor(a)</mattext>
</material>
</response_label>
<response_label ident="24019">
<material>
<mattext texttype="text/plain">Antes de escrever o primeiro rascunho para reunir ideias</mattext>
</material>
</response_label>
<response_label ident="29655">
<material>
<mattext texttype="text/plain">Após receber feedback de um colega revisor</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">13740</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="13740_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">24019</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="24019_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">29655</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="29655_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">82897</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="13740_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Fazer uma pausa após o envio de tarefa não traz benefícios para o processo de escrita.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="24019_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Uma pausa antes da elaboração do rascunho está relacionada ao planejamento, não à revisão final.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="29655_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Uma pausa após a revisão por pares refere-se à revisão de conteúdo, não à etapa de revisão final.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g945a30a874858cbfa005cf223d395db2" title="Pergunta 14">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
