<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;De acordo com o capítulo, o que é o &lt;span class="TextRun SCXW229163650 BCX8" data-contrast="auto" lang="PT-BR"&gt;&lt;span class="NormalTextRun ContextualSpellingAndGrammarErrorV2Themed SCXW229163650 BCX8"&gt;"tom&lt;/span&gt;&lt;span class="NormalTextRun SCXW229163650 BCX8"&gt;&lt;span&gt; &lt;/span&gt;formal" na escrita acadêmica?&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW229163650 BCX8" data-ccp-props='{"134233117":false,"134233118":false,"335559738":240,"335559739":240}'&gt; &lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
