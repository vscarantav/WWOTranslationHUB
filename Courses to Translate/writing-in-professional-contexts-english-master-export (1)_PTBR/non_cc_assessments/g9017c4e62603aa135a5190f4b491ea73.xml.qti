<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;De acordo com o capítulo, o que a &lt;span class="TextRun SCXW123308712 BCX8" data-contrast="auto" lang="EN-US"&gt;&lt;span class="NormalTextRun CommentStart SCXW123308712 BCX8"&gt;"escrita acadêmica formal" exige em relação a adjetivos e advérbios?&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW123308712 BCX8" data-ccp-props='{"134233117":false,"134233118":false,"335559738":240,"335559739":240}'&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
