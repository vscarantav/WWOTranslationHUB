</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual das seguintes alternativas descreve o &lt;span class="TextRun SCXW8047058 BCX8" data-contrast="auto" lang="EN-US"&gt;&lt;span class="NormalTextRun SCXW8047058 BCX8"&gt;"estilo" de um texto?&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="90509">
<material>
<mattext texttype="text/plain">A maneira como quem escreve constrói as orações, escolhe as palavras e usa o tom</mattext>
</material>
</response_label>
<response_label ident="43197">
<material>
<mattext texttype="text/plain">A ordem lógica na qual quem escreve organiza os parágrafos</mattext>
</material>
</response_label>
<response_label ident="39317">
<material>
<mattext texttype="text/plain">O processo de correção de erros de gramática e pontuação</mattext>
</material>
</response_label>
<response_label ident="33854">
<material>
<mattext texttype="text/plain">As informações de contexto fornecidas no início de uma redação</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">43197</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="43197_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">39317</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="39317_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">33854</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="33854_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">90509</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="43197_fb">
<flow_mat>
<material>
<mattext texttype="text/html">A ordem lógica dos parágrafos descreve a estrutura.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="39317_fb">
<flow_mat>
<material>
<mattext texttype="text/html">A correção de gramática e pontuação descreve a revisão final.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="33854_fb">
<flow_mat>
<material>
<mattext texttype="text/html">As informações de contexto no início de uma redação fazem parte da introdução.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g922f7e9a8534d12f88da4f302cdc5f0b" title="Pergunta 12">
