</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">77427</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="77427_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">21980</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="21980_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">55442</varequal>
</conditionvar>
