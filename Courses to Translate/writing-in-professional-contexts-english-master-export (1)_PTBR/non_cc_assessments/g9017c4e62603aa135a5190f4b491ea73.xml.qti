<itemfeedback ident="73531_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">O recuo na primeira linha é usado para parágrafos-padrão, não para entradas de referência.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="77549_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A ordem cronológica por data de publicação e a ordem de aparição não são os formatos especificados no capítulo.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="85930_fb">
