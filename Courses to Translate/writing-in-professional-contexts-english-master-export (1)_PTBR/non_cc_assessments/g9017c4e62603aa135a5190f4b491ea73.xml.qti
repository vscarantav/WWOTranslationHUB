<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;De acordo com o capítulo, como devem ser formatadas as entradas da página de referências?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="14450">
<material>
<mattext texttype="text/plain">Com recuo pendente e em ordem alfabética</mattext>
</material>
</response_label>
<response_label ident="73531">
<material>
<mattext texttype="text/plain">Com recuo na primeira linha e em ordem de aparecimento no trabalho</mattext>
</material>
</response_label>
<response_label ident="77549">
<material>
<mattext texttype="text/plain">Sem recuo e em ordem cronológica por data de publicação</mattext>
</material>
</response_label>
<response_label ident="85930">
<material>
<mattext texttype="text/plain">Com recuo pendente e em ordem de aparecimento no trabalho</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
