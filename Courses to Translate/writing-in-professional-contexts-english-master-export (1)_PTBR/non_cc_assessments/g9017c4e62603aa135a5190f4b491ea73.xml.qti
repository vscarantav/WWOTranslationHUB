<item ident="g0d12d76d7976d172865b283fabf1d8bf" title="Pergunta 26">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>57509,7227,51579,82513</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;De acordo com o capítulo, qual é a segunda prioridade que quem escreve deve abordar ao revisar um rascunho?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="57509">
<material>
<mattext texttype="text/plain">Problemas no nível do parágrafo, como orações iniciais, transições e detalhes de apoio</mattext>
</material>
</response_label>
<response_label ident="7227">
<material>
<mattext texttype="text/plain">Questões gerais, como a clareza da tese e a estrutura geral</mattext>
</material>
</response_label>
<response_label ident="51579">
<material>
<mattext texttype="text/plain">Problemas no nível da oração, como formulações confusas e palavras vagas</mattext>
</material>
</response_label>
<response_label ident="82513">
<material>
<mattext texttype="text/plain">Problemas mecânicos, como ortografia, pontuação e formatação</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">7227</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="7227_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">51579</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="51579_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">82513</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="82513_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">57509</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="7227_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Questões gerais, como a clareza da tese, são a primeira prioridade.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="51579_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Problemas no nível da oração, como formulações confusas, são a terceira prioridade.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="82513_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Problemas mecânicos, como ortografia e formatação, são a quarta e última prioridade.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g47d15647253f7a80b63910b94665822a" title="Pergunta 27">
