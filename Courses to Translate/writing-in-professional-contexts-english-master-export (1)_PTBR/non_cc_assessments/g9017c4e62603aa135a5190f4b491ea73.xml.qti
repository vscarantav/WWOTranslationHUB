<conditionvar>
<varequal respident="response1">26609</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="26609_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">36166</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="36166_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">35054</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="29161_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Apresentar o argumento mais forte primeiro descreve uma abordagem diferente.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="26609_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Reservar os contra-argumentos para o parágrafo final é uma estratégia comum, mas menos persuasiva.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="36166_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Evitar completamente os pontos de vista opostos enfraquece o argumento em vez de fortalecê-lo.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
