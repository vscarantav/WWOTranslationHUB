<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;De acordo com o capítulo, o que é o método rogeriano de argumentação?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="35054">
<material>
<mattext texttype="text/plain">Um método que reconhece pontos de vista opostos logo no início da redação antes de apresentar a sua própria posição</mattext>
</material>
</response_label>
<response_label ident="29161">
<material>
<mattext texttype="text/plain">Um método que apresenta o seu argumento mais forte no parágrafo de abertura</mattext>
</material>
</response_label>
<response_label ident="26609">
<material>
<mattext texttype="text/plain">Um método que reserva todos os contra-argumentos para o parágrafo final</mattext>
</material>
</response_label>
<response_label ident="36166">
<material>
<mattext texttype="text/plain">Um método que evita abordar pontos de vista opostos para manter o foco do argumento</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
