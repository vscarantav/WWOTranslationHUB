<render_choice>
<response_label ident="37412">
<material>
<mattext texttype="text/plain">Apresentar clareza e concisão em sua escrita para o seu público-alvo</mattext>
</material>
</response_label>
<response_label ident="90355">
<material>
<mattext texttype="text/plain">Usar linguagem formal e vocabulário preciso na escrita acadêmica</mattext>
</material>
</response_label>
<response_label ident="93265">
<material>
<mattext texttype="text/plain">Verificar erros de ortografia, pontuação e gramática</mattext>
</material>
</response_label>
<response_label ident="99013">
<material>
<mattext texttype="text/plain">Variar a extensão e a estrutura das orações ao longo de um parágrafo</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
