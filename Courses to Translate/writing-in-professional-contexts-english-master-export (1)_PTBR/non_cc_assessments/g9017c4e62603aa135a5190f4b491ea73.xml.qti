</material>
</response_label>
<response_label ident="89160">
<material>
<mattext texttype="text/plain">O estágio intermediário do rascunho</mattext>
</material>
</response_label>
<response_label ident="71628">
<material>
<mattext texttype="text/plain">O estágio do esboço</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
