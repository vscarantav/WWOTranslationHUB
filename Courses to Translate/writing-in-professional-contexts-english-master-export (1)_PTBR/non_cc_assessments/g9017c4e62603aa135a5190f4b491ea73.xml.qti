</respcondition>
</resprocessing>
<itemfeedback ident="14789_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A abertura que define o cenário descreve a introdução.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="77427_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A conexão com uma reflexão mais ampla descreve a conclusão.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="21980_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A criação de tensão por meio de eventos específicos descreve o desenvolvimento da ação.</mattext>
</material>
</flow_mat>
</itemfeedback>
