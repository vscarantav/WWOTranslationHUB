<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;De acordo com o capítulo, qual é um sinal de que se deve continuar revisando?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="52704">
<material>
<mattext texttype="text/plain">Os leitores relatam confusão sobre o ponto principal do trabalho</mattext>
</material>
</response_label>
<response_label ident="94021">
<material>
<mattext texttype="text/plain">O trabalho atinge o comprimento mínimo exigido para a atividade</mattext>
</material>
</response_label>
<response_label ident="63635">
<material>
<mattext texttype="text/plain">Quem escreve concluiu todas as quatro prioridades de revisão</mattext>
</material>
</response_label>
<response_label ident="24206">
<material>
<mattext texttype="text/plain">O trabalho inclui uma introdução, parágrafos-padrão e uma conclusão</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
