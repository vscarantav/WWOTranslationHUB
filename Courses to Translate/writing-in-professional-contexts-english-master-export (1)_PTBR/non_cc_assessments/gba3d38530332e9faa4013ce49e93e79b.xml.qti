<item ident="g480c0d96887523dbabe5c424ed5c0ed1" title="Pergunta 12">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>70753,49438,24594,68234</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual é a definição de letramento?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="70753">
<material>
<mattext texttype="text/plain">A capacidade de ler e escrever com eficácia em contextos acadêmicos e profissionais</mattext>
</material>
</response_label>
<response_label ident="49438">
<material>
<mattext texttype="text/plain">A capacidade de memorizar grandes quantidades de texto rapidamente</mattext>
</material>
</response_label>
<response_label ident="24594">
<material>
<mattext texttype="text/plain">A capacidade de falar vários idiomas fluentemente</mattext>
</material>
</response_label>
<response_label ident="68234">
<material>
<mattext texttype="text/plain">A capacidade de digitar documentos escritos sem erros</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">70753</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="70753_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">49438</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="49438_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">24594</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="24594_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">68234</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="68234_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">70753</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="70753_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">O letramento é a capacidade de ler e escrever com eficácia em contextos acadêmicos e profissionais. O letramento moderno inclui a avaliação crítica de informações, a compreensão de textos complexos e a comunicação clara em diferentes formatos e para diversos públicos-alvo.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="49438_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Memorizar grandes quantidades de texto rapidamente não é a definição de letramento. O letramento refere-se a ler e escrever de forma eficaz, incluindo a avaliação crítica e a comunicação clara.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="24594_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Falar vários idiomas fluentemente descreve o bilinguismo ou o multilinguismo, não o letramento. O letramento refere-se especificamente à capacidade de ler e escrever com eficácia.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="68234_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Digitar documentos escritos sem erros descreve uma habilidade técnica, não o letramento. O letramento refere-se a ler e escrever com eficácia em contextos acadêmicos e profissionais.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="g9d17bb4e58a1bfbd00f7729554e1426a" title="Pergunta 13">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
