</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;De acordo com a leitura, quando a leitura para fins educacionais exige que você interaja com o texto?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="3899">
<material>
<mattext texttype="text/plain">Várias vezes, para obter uma compreensão mais profunda dos conceitos</mattext>
</material>
</response_label>
<response_label ident="23386">
<material>
<mattext texttype="text/plain">Uma única vez antes de passar para a próxima atividade</mattext>
</material>
</response_label>
<response_label ident="56457">
<material>
<mattext texttype="text/plain">Apenas durante os debates em sala de aula e atividades em grupo</mattext>
</material>
</response_label>
<response_label ident="32358">
<material>
<mattext texttype="text/plain">Apenas ao se preparar para uma prova ou atividade escrita</mattext>
</material>
</response_label>
