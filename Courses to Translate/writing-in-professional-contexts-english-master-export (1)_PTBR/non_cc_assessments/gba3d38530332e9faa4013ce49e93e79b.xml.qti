<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual das seguintes opções é mencionada na leitura como uma dica para gerenciar distrações digitais durante a leitura?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="75030">
<material>
<mattext texttype="text/plain">Desativar as notificações nos dispositivos</mattext>
</material>
</response_label>
<response_label ident="19383">
<material>
<mattext texttype="text/plain">Imprimir todos os textos digitais antes de lê-los</mattext>
</material>
</response_label>
