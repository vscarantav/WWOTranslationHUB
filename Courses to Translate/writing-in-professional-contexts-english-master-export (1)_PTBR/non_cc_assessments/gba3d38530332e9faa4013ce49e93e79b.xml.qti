</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual das seguintes opções é listada na leitura como uma ferramenta de anotação digital?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="64478">
<material>
<mattext texttype="text/plain">Uma extensão de navegador web, como o Hypothesis ou o Diigo</mattext>
</material>
</response_label>
<response_label ident="6607">
<material>
<mattext texttype="text/plain">Um índice impresso no final de um livro didático</mattext>
</material>
</response_label>
<response_label ident="46336">
<material>
<mattext texttype="text/plain">Um mecanismo de busca, como o Google</mattext>
</material>
</response_label>
<response_label ident="38986">
<material>
<mattext texttype="text/plain">Um marca-texto físico usado em páginas impressas</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
