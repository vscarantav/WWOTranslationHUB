<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Que critério quem lê deve verificar ao avaliar a atualidade de uma fonte on-line?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="90699">
