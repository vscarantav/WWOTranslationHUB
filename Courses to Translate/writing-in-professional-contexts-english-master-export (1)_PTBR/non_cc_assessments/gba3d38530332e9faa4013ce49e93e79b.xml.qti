</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Como é chamada a estratégia de leitura que envolve passar os olhos pelo texto em um padrão de zigue-zague ou em "S" para encontrar uma informação específica?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="49892">
<material>
<mattext texttype="text/plain">Varredura (scanning)</mattext>
</material>
</response_label>
<response_label ident="89573">
<material>
<mattext texttype="text/plain">Leitura rápida (skimming)</mattext>
</material>
</response_label>
<response_label ident="83926">
<material>
<mattext texttype="text/plain">Pré-visualização</mattext>
</material>
</response_label>
<response_label ident="85846">
<material>
<mattext texttype="text/plain">Anotação</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
