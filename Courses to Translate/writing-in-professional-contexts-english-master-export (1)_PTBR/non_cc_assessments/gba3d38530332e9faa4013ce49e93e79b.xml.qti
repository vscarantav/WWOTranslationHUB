</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual é o objetivo do questionamento durante o processo de leitura?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="94896">
<material>
<mattext texttype="text/plain">Pensar ativamente e interagir com o texto durante a leitura</mattext>
</material>
</response_label>
<response_label ident="69528">
<material>
<mattext texttype="text/plain">Localizar uma estatística ou data específica no texto</mattext>
</material>
</response_label>
<response_label ident="45381">
<material>
<mattext texttype="text/plain">Examinar títulos e subtítulos antes da leitura</mattext>
</material>
</response_label>
<response_label ident="53536">
<material>
<mattext texttype="text/plain">Destacar as orações mais importantes no texto</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
