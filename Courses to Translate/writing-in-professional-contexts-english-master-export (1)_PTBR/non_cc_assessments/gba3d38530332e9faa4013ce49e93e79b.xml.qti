</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Para que é utilizado o skimming?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="53997">
<material>
<mattext texttype="text/plain">Para obter rapidamente as informações mais importantes de um texto</mattext>
</material>
</response_label>
<response_label ident="2566">
<material>
<mattext texttype="text/plain">Para encontrar um nome ou uma data específica em um texto</mattext>
</material>
</response_label>
<response_label ident="3220">
<material>
<mattext texttype="text/plain">Para escrever perguntas nas margens de um texto</mattext>
</material>
</response_label>
<response_label ident="90098">
<material>
<mattext texttype="text/plain">Para refletir sobre o que você aprendeu após a leitura</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
