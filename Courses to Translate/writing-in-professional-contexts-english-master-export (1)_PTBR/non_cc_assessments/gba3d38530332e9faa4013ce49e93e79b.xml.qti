</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual das seguintes perguntas é listada como um exemplo de pergunta a ser feita durante a etapa de questionamento do ciclo do processo de leitura?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="56653">
<material>
<mattext texttype="text/plain">Qual é o ponto principal do autor?</mattext>
</material>
</response_label>
<response_label ident="75592">
<material>
<mattext texttype="text/plain">Quais são os títulos e subtítulos deste texto?</mattext>
</material>
</response_label>
<response_label ident="43644">
<material>
<mattext texttype="text/plain">Quais símbolos devo usar para fazer anotações neste texto?</mattext>
</material>
</response_label>
<response_label ident="78969">
<material>
<mattext texttype="text/plain">O que eu aprendi com esta atividade de leitura?</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
