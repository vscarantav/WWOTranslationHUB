</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual é a definição de questionamento como uma etapa do ciclo do processo de leitura?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="63717">
<material>
<mattext texttype="text/plain">Pensar de forma ativa e interagir com o texto ao criar um diálogo com quem o escreveu</mattext>
</material>
</response_label>
<response_label ident="38198">
<material>
<mattext texttype="text/plain">Examinar títulos e subtítulos antes de iniciar a leitura detalhada</mattext>
</material>
</response_label>
<response_label ident="320">
<material>
<mattext texttype="text/plain">Marcar trechos importantes e escrever notas nas margens</mattext>
</material>
</response_label>
<response_label ident="3500">
<material>
<mattext texttype="text/plain">Refletir sobre o que você aprendeu após concluir uma Atividade de leitura</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
