<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;De acordo com a leitura, o que torna a leitura para fins educacionais tão valiosa?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="26309">
<material>
<mattext texttype="text/plain">A reflexão que você faz ao avançar pelo texto</mattext>
</material>
</response_label>
<response_label ident="87701">
