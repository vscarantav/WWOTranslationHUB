<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual é o termo usado na leitura para descrever um prompt de IA que pula o processo de leitura e transfere o trabalho de compreensão para a IA?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
