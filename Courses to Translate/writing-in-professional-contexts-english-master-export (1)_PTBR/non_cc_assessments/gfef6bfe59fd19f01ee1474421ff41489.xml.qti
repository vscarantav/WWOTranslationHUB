<fieldentry>49201,55070,84434,73929</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que é uma declaração de tese?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="49201">
<material>
<mattext texttype="text/plain">Uma única oração que apresenta o assunto e o argumento principal de uma redação</mattext>
</material>
</response_label>
<response_label ident="55070">
<material>
<mattext texttype="text/plain">Um parágrafo que apresenta o contexto de um assunto</mattext>
</material>
</response_label>
<response_label ident="84434">
<material>
<mattext texttype="text/plain">Uma oração que resume um parágrafo de uma redação</mattext>
</material>
</response_label>
<response_label ident="73929">
<material>
<mattext texttype="text/plain">Uma lista de evidências que apoia o posicionamento de quem escreve</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">55070</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="55070_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">84434</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="84434_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">73929</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="73929_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">49201</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="55070_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Uma declaração de tese não é um parágrafo, um resumo de um parágrafo ou uma lista de evidências. É uma oração específica que informa ao leitor sobre qual assunto você está escrevendo e qual posicionamento ou perspectiva você adota em relação a esse assunto.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="84434_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Uma declaração de tese não é um parágrafo, um resumo de um parágrafo ou uma lista de evidências. É uma oração específica que informa ao leitor sobre qual assunto você está escrevendo e qual posicionamento ou perspectiva você adota em relação a esse assunto.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="73929_fb">
<flow_mat>
<material>
<mattext texttype="text/html">Uma declaração de tese não é um parágrafo, um resumo de um parágrafo ou uma lista de evidências. É uma oração específica que informa ao leitor sobre qual assunto você está escrevendo e qual posicionamento ou perspectiva você adota em relação a esse assunto.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
<item ident="gae17a34c6a53f8d5b3060552593da49a" title="Pergunta 10">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
