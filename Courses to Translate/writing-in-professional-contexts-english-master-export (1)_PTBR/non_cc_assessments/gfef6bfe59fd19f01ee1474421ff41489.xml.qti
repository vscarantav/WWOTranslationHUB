<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;O que é kairos como um conceito retórico?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="75503">
<material>
<mattext texttype="text/plain">A importância do momento oportuno em um argumento</mattext>
</material>
</response_label>
<response_label ident="47876">
