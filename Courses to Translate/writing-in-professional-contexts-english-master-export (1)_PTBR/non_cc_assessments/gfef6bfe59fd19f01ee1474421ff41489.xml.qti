<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que é tom na escrita?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="80899">
<material>
<mattext texttype="text/plain">A atitude de quem escreve em relação ao assunto e ao público-alvo, expressa por meio da linguagem</mattext>
</material>
</response_label>
<response_label ident="64669">
<material>
<mattext texttype="text/plain">O número de palavras que quem escreve utiliza em cada oração</mattext>
</material>
</response_label>
