<item ident="gb2a783a58ce5526740e692b5ea9d5c28" title="Pergunta 43">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>55756,30143,8868,40699</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que é uma transição na escrita?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="55756">
<material>
<mattext texttype="text/plain">Uma palavra ou frase que conecta uma ideia a outra</mattext>
</material>
</response_label>
<response_label ident="30143">
<material>
<mattext texttype="text/plain">Uma oração que introduz um novo parágrafo com um assunto diferente</mattext>
</material>
</response_label>
<response_label ident="8868">
<material>
<mattext texttype="text/plain">Um sinal de pontuação usado para unir duas orações independentes</mattext>
</material>
</response_label>
<response_label ident="40699">
<material>
<mattext texttype="text/plain">Uma oração de resumo colocada no final de cada parágrafo</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">30143</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="30143_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">8868</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="8868_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">40699</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="40699_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">55756</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="30143_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Uma transição é uma palavra ou frase que conecta ideias e ajuda a escrita a fluir suavemente de um pensamento para o outro. Não se trata de uma oração completa, de um sinal de pontuação ou de um resumo. As transições guiam quem lê através de um texto, mostrando as relações entre as ideias, como contraste, sequência ou causa e efeito.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="8868_fb">
<flow_mat>
<material>
