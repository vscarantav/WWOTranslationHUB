</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual é a função das orações de apoio em um parágrafo?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="27750">
<material>
<mattext texttype="text/plain">Explicar, desenvolver ou fornecer evidências para a ideia principal apresentada na oração inicial</mattext>
</material>
</response_label>
<response_label ident="19668">
<material>
<mattext texttype="text/plain">Apresentar uma nova ideia que será desenvolvida no próximo parágrafo em uma oração inicial separada</mattext>
</material>
</response_label>
<response_label ident="93960">
<material>
<mattext texttype="text/plain">Reafirmar a declaração de tese usando palavras diferentes para ênfase e clareza</mattext>
</material>
</response_label>
<response_label ident="97777">
<material>
<mattext texttype="text/plain">Resumir todas as ideias discutidas na redação até o momento em uma breve declaração de conclusão</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
