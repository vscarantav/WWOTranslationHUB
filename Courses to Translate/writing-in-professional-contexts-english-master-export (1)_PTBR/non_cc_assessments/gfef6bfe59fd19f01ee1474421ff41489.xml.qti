<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Quais duas perguntas uma declaração de tese deve responder?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="83923">
<material>
<mattext texttype="text/plain">Sobre qual assunto você está escrevendo e qual posicionamento ou perspectiva você adota em relação a esse assunto?</mattext>
</material>
</response_label>
<response_label ident="99211">
<material>
<mattext texttype="text/plain">Quem é o seu público-alvo e qual tom você usará?</mattext>
</material>
</response_label>
<response_label ident="25157">
<material>
<mattext texttype="text/plain">Quais evidências você usará e qual será a extensão da sua redação?</mattext>
</material>
</response_label>
<response_label ident="77439">
<material>
<mattext texttype="text/plain">Qual é o contexto do assunto e o que outros autores dizem sobre ele?</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
