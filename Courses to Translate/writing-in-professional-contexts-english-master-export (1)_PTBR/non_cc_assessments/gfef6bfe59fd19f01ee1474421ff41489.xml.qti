<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual das seguintes opções é um exemplo de prolixidade em uma oração?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="71993">
<material>
<mattext texttype="text/plain">"Devido ao fato de que há um grande número de estudantes que estão em processo de aprendizagem"</mattext>
</material>
</response_label>
<response_label ident="54347">
<material>
<mattext texttype="text/plain">"Porque muitos estudantes estão aprendendo"</mattext>
</material>
</response_label>
<response_label ident="7845">
<material>
<mattext texttype="text/plain">"Estudantes estão aprendendo habilidades tecnológicas"</mattext>
</material>
</response_label>
<response_label ident="62259">
<material>
<mattext texttype="text/plain">"O laboratório de informática estenderá seu horário de funcionamento"</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">54347</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="54347_fb"/>
