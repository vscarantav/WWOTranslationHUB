<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Quais são os três apelos retóricos apresentados na S01?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="45428">
<material>
<mattext texttype="text/plain">Logos, pathos e ethos</mattext>
</material>
</response_label>
<response_label ident="74138">
<material>
<mattext texttype="text/plain">Tom, linguagem e público-alvo</mattext>
</material>
</response_label>
<response_label ident="21834">
<material>
<mattext texttype="text/plain">Clareza, concisão e estrutura</mattext>
</material>
</response_label>
<response_label ident="98960">
<material>
<mattext texttype="text/plain">Oração inicial, tese e evidências</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
