<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>21303,48933,26576,15459</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Como o tom deve ser ajustado ao escrever para um empregador?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="21303">
<material>
<mattext texttype="text/plain">Escrever para um empregador exige um tom profissional, confiante e cortês</mattext>
</material>
</response_label>
<response_label ident="48933">
<material>
<mattext texttype="text/plain">Escrever para um empregador exige um tom informal e pessoal para construir um relacionamento</mattext>
</material>
</response_label>
<response_label ident="26576">
<material>
<mattext texttype="text/plain">Escrever para um empregador exige histórias emocionais para criar uma conexão pessoal</mattext>
</material>
</response_label>
<response_label ident="15459">
<material>
<mattext texttype="text/plain">Escrever para um empregador exige o mesmo tom usado ao escrever para amigos próximos</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">48933</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="48933_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">26576</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="26576_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">15459</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="15459_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">21303</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="48933_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A escrita profissional para um empregador exige um tom profissional, confiante e cortês. Um tom informal ou pessoal é adequado para amigos e familiares, não para empregadores. Histórias pessoais emocionais são mais apropriadas para uma escrita baseada em pathos direcionada ao público-alvo geral. A comunicação com o empregador deve ser focada em resultados, direta e livre de gírias ou linguagem informal.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="26576_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">A escrita profissional para um empregador exige um tom profissional, confiante e cortês. Um tom informal ou pessoal é adequado para amigos e familiares, não para empregadores. Histórias pessoais emocionais são mais apropriadas para uma escrita baseada em pathos direcionada ao público-alvo geral. A comunicação com o empregador deve ser focada em resultados, direta e livre de gírias ou linguagem informal.</mattext>
</material>
</flow_mat>
</itemfeedback>
