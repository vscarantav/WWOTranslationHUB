<mattext texttype="text/html">&lt;div&gt;Qual é o objetivo de uma oração de conclusão em um parágrafo?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="11955">
<material>
<mattext texttype="text/plain">Para encerrar o parágrafo ao concluir a discussão da ideia principal do parágrafo</mattext>
</material>
</response_label>
<response_label ident="36030">
<material>
<mattext texttype="text/plain">Para introduzir a ideia principal do próximo parágrafo</mattext>
</material>
</response_label>
<response_label ident="37398">
<material>
<mattext texttype="text/plain">Para reafirmar a declaração de tese palavra por palavra</mattext>
</material>
</response_label>
<response_label ident="92115">
<material>
<mattext texttype="text/plain">Para listar as fontes usadas para sustentar as evidências do parágrafo</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
