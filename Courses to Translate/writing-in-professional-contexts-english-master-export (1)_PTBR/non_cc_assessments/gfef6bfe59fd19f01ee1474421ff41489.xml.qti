<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que significa escrever de forma concisa?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="55892">
<material>
<mattext texttype="text/plain">Expressar suas ideias usando apenas as palavras necessárias para comunicar seu significado</mattext>
</material>
</response_label>
<response_label ident="79745">
<material>
<mattext texttype="text/plain">Usar vocabulário formal e orações longas para parecer profissional</mattext>
</material>
</response_label>
<response_label ident="80249">
<material>
<mattext texttype="text/plain">Escrever o máximo de detalhes possível para que quem lê compreenda totalmente</mattext>
</material>
</response_label>
<response_label ident="53543">
<material>
<mattext texttype="text/plain">Evitar o uso de quaisquer termos técnicos em sua escrita</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">79745</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="79745_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">80249</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="80249_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">53543</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="53543_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">55892</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="79745_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Escrever de forma concisa significa remover palavras desnecessárias, mantendo o significado claro. Não significa usar orações longas, adicionar mais detalhes ou evitar termos técnicos. Uma escrita concisa é direta e eficiente, não longa ou excessivamente detalhada.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="80249_fb">
