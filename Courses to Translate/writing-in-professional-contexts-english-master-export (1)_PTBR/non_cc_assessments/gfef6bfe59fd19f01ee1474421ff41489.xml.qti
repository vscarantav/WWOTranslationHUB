</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual é o objetivo principal de organizar a Escrita em parágrafos?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="65983">
<material>
<mattext texttype="text/plain">Apresentar ideias em Seções menores que sejam mais fáceis de compreender por quem lê</mattext>
</material>
</response_label>
<response_label ident="83916">
<material>
<mattext texttype="text/plain">Fazer com que um documento pareça mais longo e mais desenvolvido para quem lê</mattext>
</material>
</response_label>
<response_label ident="63163">
<material>
<mattext texttype="text/plain">Evitar a necessidade de escrever Orações de transição claras entre as ideias</mattext>
</material>
</response_label>
<response_label ident="74614">
<material>
<mattext texttype="text/plain">Impressionar quem lê com o conhecimento e o estilo de quem escreve</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
