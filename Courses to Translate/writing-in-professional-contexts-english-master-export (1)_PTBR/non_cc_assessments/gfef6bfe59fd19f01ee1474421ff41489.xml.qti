<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que é uma armadilha de dependência ao usar IA em um curso de escrita?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="30344">
<material>
<mattext texttype="text/plain">Pedir à IA para produzir ou reescrever a escrita para você, o que elimina o desenvolvimento de habilidades de seu próprio trabalho</mattext>
</material>
</response_label>
<response_label ident="67482">
<material>
<mattext texttype="text/plain">Pedir à IA para identificar problemas em um rascunho que você já escreveu, sem depender dela para reescrever o texto para você</mattext>
</material>
</response_label>
<response_label ident="75183">
