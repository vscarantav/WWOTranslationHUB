<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>563,74161,32132,7633</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;De acordo com a leitura, o que se deve fazer após redigir o primeiro rascunho de uma declaração de tese?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="563">
<material>
<mattext texttype="text/plain">Testar a tese perguntando se ela pode ser sustentada com evidências, se é específica o suficiente e se assume uma posição clara.</mattext>
</material>
</response_label>
<response_label ident="74161">
<material>
<mattext texttype="text/plain">Pedir para a IA reescrever a tese para que pareça mais profissional e focada.</mattext>
</material>
</response_label>
<response_label ident="32132">
<material>
<mattext texttype="text/plain">Enviar a tese ao(à) Instrutor(a) para obter feedback antes de escrever o restante da redação.</mattext>
</material>
</response_label>
<response_label ident="7633">
<material>
<mattext texttype="text/plain">Substituir a tese por uma oração inicial que abranja a mesma ideia.</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
