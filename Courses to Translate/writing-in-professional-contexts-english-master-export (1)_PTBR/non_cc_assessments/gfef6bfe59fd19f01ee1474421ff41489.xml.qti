<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual apelo retórico utiliza fatos, estatísticas e raciocínio lógico para persuadir quem lê?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
