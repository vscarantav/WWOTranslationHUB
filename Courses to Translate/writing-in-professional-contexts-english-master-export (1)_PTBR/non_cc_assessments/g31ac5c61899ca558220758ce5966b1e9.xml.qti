<item ident="gf036b2bf6ab17fa3a8575b90ca7c2eee" title="Notificação do Canvas">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>true_false_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1.0</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>296,479</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;ol&gt;
&lt;li&gt;&lt;a class="inline_disabled" href="https://community.instructure.com/pt/kb/articles/662886-how-do-i-add-contact-methods-to-receive-canvas-notifications" target="_blank"&gt;Adicione seus métodos de contato no Canvas&lt;/a&gt; para que possa receber notificações em seu canal de envio preferido (mensagem de texto ou e-mail).&lt;/li&gt;
&lt;li&gt;&lt;a class="inline_disabled" href="https://community.instructure.com/pt/kb/articles/662894-how-do-i-manage-my-canvas-notification-settings" target="_blank"&gt;Defina suas preferências de notificação no Canvas&lt;/a&gt; para receber atualizações sempre que houver um novo anúncio, comentário ou nota em sua atividade, atualizações de discussões, etc.&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;Explicação da Imagem&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;O sino verde significa que você será notificado(a) imediatamente.&lt;/li&gt;
&lt;li&gt;A página verde significa que você será notificado(a) ao final do dia.&lt;/li&gt;
&lt;li&gt;&lt;span&gt;O calendário verde significa que você será notificado(a) ao final da semana.&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;O sino branco significa que você não quer receber essa notificação.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;img alt="Captura de tela de Notificações do Curso mostrando um ícone de calendário verde para Datas de entrega e Políticas de avaliação e mostrando um ícone de sino verde para anúncios." height="325" id="60347678" loading="lazy" src="$IMS-CC-FILEBASE$/assessment_questions/W01%20Quiz:%20Syllabus%20Notifications.JPG?canvas_download=1" width="350"/&gt;&lt;/p&gt;
&lt;p&gt;V/F: Posso definir notificações individualmente para cada disciplina.&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="296">
<material>
<mattext texttype="text/plain">True</mattext>
</material>
</response_label>
<response_label ident="479">
<material>
<mattext texttype="text/plain">False</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">296</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
</item>
