</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual é a diferença entre a linha paterna e a linha materna na pesquisa de história da família?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="9217">
<material>
<mattext texttype="text/plain">A linha paterna refere-se à família do pai e a linha materna refere-se à família da mãe</mattext>
</material>
</response_label>
<response_label ident="8212">
<material>
<mattext texttype="text/plain">A linha paterna refere-se a gerações mais antigas e a linha materna refere-se a gerações mais jovens</mattext>
</material>
</response_label>
<response_label ident="89756">
<material>
<mattext texttype="text/plain">A linha paterna refere-se a parentes vivos e a linha materna refere-se a parentes falecidos</mattext>
</material>
</response_label>
<response_label ident="90448">
<material>
<mattext texttype="text/plain">A linha paterna refere-se a parentes do sexo masculino e a linha materna refere-se a parentes do sexo feminino</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
