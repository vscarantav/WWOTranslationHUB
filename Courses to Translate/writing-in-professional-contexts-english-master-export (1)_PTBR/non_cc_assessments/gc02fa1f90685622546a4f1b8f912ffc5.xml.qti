<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que é um Assunto na Escrita de pesquisa?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="41692">
<material>
<mattext texttype="text/plain">Um assunto ou tema que serve como o foco de sua pesquisa</mattext>
</material>
</response_label>
<response_label ident="73093">
<material>
<mattext texttype="text/plain">A proposta de resposta para a sua principal pergunta de pesquisa</mattext>
</material>
</response_label>
<response_label ident="44376">
<material>
<mattext texttype="text/plain">A lista de fontes que você planeja usar em seu trabalho</mattext>
</material>
</response_label>
<response_label ident="30297">
<material>
<mattext texttype="text/plain">A conclusão final a que você chega após concluir sua pesquisa</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
