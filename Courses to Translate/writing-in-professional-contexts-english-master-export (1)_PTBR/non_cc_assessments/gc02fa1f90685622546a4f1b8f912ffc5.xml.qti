<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual é o formato recomendado para apresentar informações em um projeto de história da família?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="5106">
<material>
<mattext texttype="text/plain">Orações completas e parágrafos organizados sob títulos de seção claros</mattext>
</material>
</response_label>
<response_label ident="45196">
<material>
<mattext texttype="text/plain">Uma lista numerada de nomes, datas e localizações de cada membro da família</mattext>
</material>
</response_label>
<response_label ident="17873">
<material>
<mattext texttype="text/plain">Uma transcrição de perguntas e respostas de entrevistas familiares</mattext>
</material>
</response_label>
<response_label ident="41652">
<material>
<mattext texttype="text/plain">Um esboço em tópicos dos fatos principais de cada geração</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
