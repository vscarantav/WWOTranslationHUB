</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Quantas etapas existem no processo de escrita de pesquisa?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="3122">
<material>
<mattext texttype="text/plain">Seis</mattext>
</material>
</response_label>
<response_label ident="57071">
<material>
<mattext texttype="text/plain">Três</mattext>
</material>
</response_label>
<response_label ident="75960">
<material>
<mattext texttype="text/plain">Oito</mattext>
</material>
</response_label>
<response_label ident="92689">
<material>
<mattext texttype="text/plain">Quatro</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">3122</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="3122_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">57071</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="57071_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">75960</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="75960_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">92689</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="92689_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">3122</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="3122_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Existem seis etapas no processo de escrita de pesquisa. São elas: escolher um assunto, planejar e programar, realizar pesquisas, organizar pesquisas e ideias, redigir o seu trabalho e revisar e editar o seu trabalho.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="57071_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Três, oito e quatro estão incorretas. O processo de escrita de pesquisa tem exatamente seis etapas, cada uma das quais se baseia na anterior. Pular ou combinar etapas pode levar a trabalhos desorganizados e prazos perdidos.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="75960_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Três, oito e quatro estão incorretas. O processo de escrita de pesquisa tem exatamente seis etapas, cada uma das quais se baseia na anterior. Pular ou combinar etapas pode levar a trabalhos desorganizados e prazos perdidos.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="92689_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Três, oito e quatro estão incorretas. O processo de escrita de pesquisa tem exatamente seis etapas, cada uma das quais se baseia na anterior. Pular ou combinar etapas pode levar a trabalhos desorganizados e prazos perdidos.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
