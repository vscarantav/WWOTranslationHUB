<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Que tipo de pergunta gera as informações mais úteis durante uma entrevista de pesquisa?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="65924">
<material>
<mattext texttype="text/plain">Uma pergunta aberta que não pode ser respondida com sim ou não</mattext>
</material>
</response_label>
<response_label ident="9268">
<material>
<mattext texttype="text/plain">Uma pergunta fechada que exige apenas uma resposta sim ou não</mattext>
</material>
</response_label>
<response_label ident="91366">
<material>
<mattext texttype="text/plain">Uma pergunta que confirma fatos que quem pesquisa já conhece</mattext>
</material>
</response_label>
<response_label ident="91785">
<material>
<mattext texttype="text/plain">Uma pergunta que solicita à pessoa entrevistada que escolha entre duas opções</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
