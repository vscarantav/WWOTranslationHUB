<conditionvar>
<varequal respident="response1">85832</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="85832_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">62090</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="62090_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">82267</varequal>
</conditionvar>
