<item ident="gcb16ea1329633c09e0809de30b625f0d" title="Pergunta 9">
<itemmetadata>
<qtimetadata>
<qtimetadatafield>
<fieldlabel>question_type</fieldlabel>
<fieldentry>multiple_choice_question</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>points_possible</fieldlabel>
<fieldentry>1</fieldentry>
</qtimetadatafield>
<qtimetadatafield>
<fieldlabel>original_answer_ids</fieldlabel>
<fieldentry>40470,19266,86373,65463</fieldentry>
</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Quando se deve incluir uma citação para material parafraseado?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="40470">
<material>
<mattext texttype="text/plain">Sempre, porque as ideias pertencem ao autor original</mattext>
</material>
</response_label>
<response_label ident="19266">
<material>
<mattext texttype="text/plain">Apenas quando a paráfrase usa mais de cinco palavras da fonte</mattext>
</material>
</response_label>
<response_label ident="86373">
<material>
<mattext texttype="text/plain">Apenas quando a fonte for uma citação direta</mattext>
</material>
</response_label>
<response_label ident="65463">
<material>
<mattext texttype="text/plain">Nunca, porque mudar as palavras elimina a necessidade de citar</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">40470</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="40470_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">19266</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="19266_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">86373</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="86373_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">65463</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="65463_fb"/>
</respcondition>
<respcondition continue="No">
<conditionvar>
<varequal respident="response1">40470</varequal>
</conditionvar>
<setvar action="Set" varname="SCORE">100</setvar>
</respcondition>
</resprocessing>
<itemfeedback ident="40470_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Deve-se sempre incluir uma citação para materiais parafraseados. Mesmo ao reformular as informações com suas próprias palavras, as ideias, os dados ou os argumentos pertencem ao autor original. Não citar o material parafraseado constitui plágio.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="19266_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Não existe uma regra baseada em uma contagem específica de palavras para paráfrases. As citações não se limitam a citações diretas. Mudar as palavras de uma fonte não elimina a obrigação de citá-la. A fonte da ideia deve sempre receber o devido crédito, independentemente de como seja expressa.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="86373_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Não existe uma regra baseada em uma contagem específica de palavras para paráfrases. As citações não se limitam a citações diretas. Mudar as palavras de uma fonte não elimina a obrigação de citá-la. A fonte da ideia deve sempre receber o devido crédito, independentemente de como seja expressa.</mattext>
</material>
</flow_mat>
</itemfeedback>
<itemfeedback ident="65463_fb">
<flow_mat>
<material>
<mattext texttype="text/plain">Não existe uma regra baseada em uma contagem específica de palavras para paráfrases. As citações não se limitam a citações diretas. Mudar as palavras de uma fonte não elimina a obrigação de citá-la. A fonte da ideia deve sempre receber o devido crédito, independentemente de como seja expressa.</mattext>
</material>
</flow_mat>
</itemfeedback>
</item>
</objectbank>
</questestinterop>