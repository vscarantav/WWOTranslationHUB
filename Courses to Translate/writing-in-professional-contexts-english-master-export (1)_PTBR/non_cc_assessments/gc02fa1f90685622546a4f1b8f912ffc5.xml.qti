<conditionvar>
<varequal respident="response1">41503</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="41503_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">97550</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="97550_fb"/>
