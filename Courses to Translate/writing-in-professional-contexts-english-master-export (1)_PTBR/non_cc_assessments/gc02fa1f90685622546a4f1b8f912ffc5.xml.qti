</qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual é a primeira coisa que você deve fazer para se preparar para uma entrevista de história da família com um parente?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="61014">
<material>
<mattext texttype="text/plain">Entrar em contato com o membro da família no início do processo de pesquisa e explicar seu objetivo</mattext>
</material>
</response_label>
<response_label ident="7993">
<material>
<mattext texttype="text/plain">Começar a escrever sua história pessoal antes de realizar a entrevista</mattext>
</material>
</response_label>
<response_label ident="33623">
<material>
<mattext texttype="text/plain">Enviar ao seu parente um rascunho concluído da história da família para revisão</mattext>
</material>
</response_label>
<response_label ident="32363">
<material>
<mattext texttype="text/plain">Gravar a entrevista sem pedir a permissão do seu parente primeiro</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
