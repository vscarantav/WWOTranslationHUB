</material>
</response_label>
<response_label ident="71112">
<material>
<mattext texttype="text/plain">Um rascunho</mattext>
</material>
</response_label>
<response_label ident="65107">
<material>
<mattext texttype="text/plain">Uma citação</mattext>
</material>
