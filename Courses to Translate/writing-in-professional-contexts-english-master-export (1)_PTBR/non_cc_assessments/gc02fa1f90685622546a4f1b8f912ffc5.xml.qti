<varequal respident="response1">50452</varequal>
</conditionvar>
<displayfeedback feedbacktype="Response" linkrefid="50452_fb"/>
</respcondition>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">28953</varequal>
</conditionvar>
