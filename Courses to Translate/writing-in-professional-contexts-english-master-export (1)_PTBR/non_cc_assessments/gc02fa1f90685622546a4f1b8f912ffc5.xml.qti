</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;Qual é o objetivo de criar um cronograma de pesquisa durante a Etapa 2 do processo de Escrita de pesquisa?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="19633">
<material>
<mattext texttype="text/plain">Dividir o projeto em tarefas menores e evitar a sensação de sobrecarga</mattext>
</material>
</response_label>
<response_label ident="58929">
<material>
<mattext texttype="text/plain">Identificar quais fontes você citará diretamente em seu trabalho</mattext>
</material>
</response_label>
<response_label ident="29427">
<material>
<mattext texttype="text/plain">Determinar a estrutura final de seu trabalho antes de pesquisar</mattext>
</material>
</response_label>
<response_label ident="24029">
<material>
<mattext texttype="text/plain">Selecionar a pergunta de pesquisa que guiará sua Escrita</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
