<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que você deve fazer com suas anotações de entrevista imediatamente após o término da entrevista?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="35061">
<material>
