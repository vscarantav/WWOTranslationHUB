<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;O que é uma fonte primária?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="19196">
<material>
<mattext texttype="text/plain">Uma fonte direta e em primeira mão de informações ou dados</mattext>
</material>
</response_label>
<response_label ident="39545">
<material>
<mattext texttype="text/plain">Um artigo de revista escrito sobre um evento histórico</mattext>
</material>
</response_label>
<response_label ident="50452">
<material>
<mattext texttype="text/plain">Uma biografia escrita sobre uma pessoa famosa</mattext>
</material>
</response_label>
<response_label ident="28953">
<material>
<mattext texttype="text/plain">Uma resenha literária de um romance publicado</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
