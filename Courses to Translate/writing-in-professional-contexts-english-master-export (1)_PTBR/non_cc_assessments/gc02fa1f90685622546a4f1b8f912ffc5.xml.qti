</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Qual etapa do processo de escrita de pesquisa envolve decidir quais fontes citar e confirmar que as evidências apoiam sua tese?&lt;/p&gt;&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="96015">
<material>
<mattext texttype="text/plain">Organizar a pesquisa e as ideias</mattext>
</material>
</response_label>
<response_label ident="40704">
<material>
<mattext texttype="text/plain">Realizar a pesquisa</mattext>
</material>
</response_label>
<response_label ident="24313">
<material>
<mattext texttype="text/plain">Redigir o rascunho do seu artigo</mattext>
</material>
</response_label>
<response_label ident="32390">
<material>
<mattext texttype="text/plain">Revisar e editar seu artigo</mattext>
</material>
</response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing>
<outcomes>
<decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
</outcomes>
<respcondition continue="Yes">
<conditionvar>
<varequal respident="response1">96015</varequal>
</conditionvar>
