<mattext texttype="text/html">&lt;div&gt;O que é uma tese de trabalho?&lt;/div&gt;</mattext>
</material>
<response_lid ident="response1" rcardinality="Single">
<render_choice>
<response_label ident="31694">
<material>
<mattext texttype="text/plain">Uma resposta proposta para a sua pergunta de pesquisa</mattext>
</material>
</response_label>
<response_label ident="99755">
