    <item ident="g58ccf48272faa669fd211a6ab28df05d" title="Profile Picture">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>true_false_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9170,903</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;div class="byui gs105"&gt;
&lt;div style="border: 6px solid #376070; padding: 5px;"&gt;
&lt;div style="float: right; color: #fae5c3; font-size: 26px; margin-left: 5px; padding: 5px; background-color: #376070;"&gt;Profile Picture&lt;/div&gt;
&lt;h2&gt;2. Identification&lt;/h2&gt;
&lt;p&gt;&lt;span&gt;You can add a profile picture to your Canvas account using this&lt;/span&gt;&lt;a href="https://community.canvaslms.com/t5/Student-Guide/How-do-I-add-a-profile-picture-in-my-user-account-as-a-student/ta-p/518"&gt; &lt;span&gt;profile tutorial.&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;p&gt;A successfully added profile picture will appear in your Canvas Toolbar similar to the image below.&lt;/p&gt;
&lt;p&gt;T/F: The Canvas profile picture, I uploaded, is a headshot of myself.&lt;/p&gt;
&lt;p&gt;&lt;img id="56880130" src="https://byupw.instructure.com/assessment_questions/52948210/files/87683804/download?verifier=JFXgo6p9ZL5aNzEhLDWRo7yPbYs6If1zpOnZpa2y" alt="Screenshot of upper left-hand corner of Canvas screen with BYUI logo at the top and account image right below." width="100" height="185" loading="lazy"&gt;&amp;nbsp;&lt;/p&gt;
&lt;/div&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9170">
              <material>
                <mattext texttype="text/plain">True</mattext>
              </material>
            </response_label>
            <response_label ident="903">
              <material>
                <mattext texttype="text/plain">False</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">9170</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
