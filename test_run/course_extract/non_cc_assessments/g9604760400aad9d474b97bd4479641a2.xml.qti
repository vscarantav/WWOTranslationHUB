  <assessment ident="g9604760400aad9d474b97bd4479641a2" title="W02 Learning Activities">
    <qtimetadata>
      <qtimetadatafield>
        <fieldlabel>cc_maxattempts</fieldlabel>
        <fieldentry>3</fieldentry>
      </qtimetadatafield>
    </qtimetadata>
    <section ident="root_section">
      <item ident="gb5b00c907d38a9e52dbf778fbb83c4e9" title="Web APIs">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>3396,5465,8856,247,1383</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>g1b59f9eb0058ce50e6890806dde676cb</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following is &lt;strong&gt;not&lt;/strong&gt; a correct categorization of a Web Platform API provided by browsers?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="3396">
                <material>
                  <mattext texttype="text/plain">Fetch</mattext>
                </material>
              </response_label>
              <response_label ident="5465">
                <material>
                  <mattext texttype="text/plain">Twitter</mattext>
                </material>
              </response_label>
              <response_label ident="8856">
                <material>
                  <mattext texttype="text/plain">DOM</mattext>
                </material>
              </response_label>
              <response_label ident="247">
                <material>
                  <mattext texttype="text/plain">Geolocation</mattext>
                </material>
              </response_label>
              <response_label ident="1383">
                <material>
                  <mattext texttype="text/plain">localStorage</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <varequal respident="response1">3396</varequal>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="3396_fb"/>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">5465</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="3396_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Twitter is a third-party web service, not a built-in browser API. All the others (Fetch, DOM, Geolocation, and localStorage) are part of the Web Platform APIs provided by browsers.&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="gcecb1b456c2da6047378667660487b38" title="setInterval()">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>5686,4966,6953,3770</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>ge44a33795f5c1ca9563f4045fb8afacd</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What will be the output of the following JavaScript code?&lt;/p&gt;
&lt;pre&gt;let count = 0;&lt;br&gt;const intervalId = setInterval(() =&amp;gt; {&lt;br&gt;&amp;nbsp; count += 1;&lt;br&gt;&amp;nbsp; console.log(count);&lt;br&gt;&amp;nbsp; if (count === 3) {&lt;br&gt;&amp;nbsp; &amp;nbsp; clearInterval(intervalId);&lt;br&gt;&amp;nbsp; }&lt;br&gt;}, 1000);&lt;br&gt;&lt;br&gt;&lt;/pre&gt;
&lt;p&gt;&lt;strong&gt;NOTE&lt;/strong&gt;: The answers show the output in one line versus the actual multiline console result because of Canvas limitations.&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="5686">
                <material>
                  <mattext texttype="text/plain">1 2 3</mattext>
                </material>
              </response_label>
              <response_label ident="4966">
                <material>
                  <mattext texttype="text/plain">1 2 3 4</mattext>
                </material>
              </response_label>
              <response_label ident="6953">
                <material>
                  <mattext texttype="text/plain">0 1 2 3 4</mattext>
                </material>
              </response_label>
              <response_label ident="3770">
                <material>
                  <mattext texttype="text/plain">0 1 2 3</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">5686</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
          <respcondition continue="Yes">
            <conditionvar>
              <other/>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_incorrect_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;ul&gt;
&lt;li&gt;The &lt;code&gt;setInterval()&lt;/code&gt; function will execute the callback function every 1000 milliseconds (1 second).&lt;/li&gt;
&lt;li&gt;The &lt;code&gt;count&lt;/code&gt; variable is incremented by 1 on each iteration, and its value is logged to the console.&lt;/li&gt;
&lt;li&gt;When &lt;code&gt;count&lt;/code&gt; reaches 3, the &lt;code&gt;clearInterval(intervalId)&lt;/code&gt; function is called to stop the interval, preventing further executions.&lt;/li&gt;
&lt;/ul&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="gf0ae14b7349c34301dbd129b7b7c5b43" title="DevTools Debugging">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>1096,9847,6009,9145</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gde74e33e9e4cb1b715bfd2e776d74cf5</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following is the correct way to set a breakpoint in a JavaScript file using browser DevTools?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="1096">
                <material>
                  <mattext texttype="text/plain">Open DevTools, go to the "Sources" tab, navigate to the JavaScript file, and click on the line number where you want to set the breakpoint.</mattext>
                </material>
              </response_label>
              <response_label ident="9847">
                <material>
                  <mattext texttype="text/plain">Open DevTools, go to the "Elements" tab, and right-click on a line in the HTML code to set a breakpoint.</mattext>
                </material>
              </response_label>
              <response_label ident="6009">
                <material>
                  <mattext texttype="text/plain">Open DevTools, go to the "Console" tab, type the line number where you want the breakpoint, and press Enter.</mattext>
                </material>
              </response_label>
              <response_label ident="9145">
                <material>
                  <mattext texttype="text/plain">Open DevTools, go to the "Network" tab, find the script in the network log, and select "Set Breakpoint" next to the desired line.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">1096</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g08394299ac3fcca4aa86ce79c28d0807" title="Window Object">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>8976,9072,9466,1247</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>g49ec045c5ca6bfffee2b8c6bd550a6e7</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following code snippets correctly retrieves the current page filename (assuming that it exists) from the URL using &lt;code&gt;window.location&lt;/code&gt;?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="8976">
                <material>
                  <mattext texttype="text/plain">window.location.pathname.split("/").pop();</mattext>
                </material>
              </response_label>
              <response_label ident="9072">
                <material>
                  <mattext texttype="text/plain">window.location.hostname;</mattext>
                </material>
              </response_label>
              <response_label ident="9466">
                <material>
                  <mattext texttype="text/plain">window.location.filename;</mattext>
                </material>
              </response_label>
              <response_label ident="1247">
                <material>
                  <mattext texttype="text/plain">window.location.href.split('/').slice(-1);</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">8976</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g6e24110d1518ad7568b9d5e843fea9c6" title="Template">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>4370,1520,252,3478</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>g78846a1ce018887950d9b7b75136a1b4</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;&lt;span&gt;Fill in the blank.&lt;br&gt;&lt;br&gt;The&amp;nbsp;&lt;/span&gt;&lt;strong&gt;&lt;code&gt;__________&lt;/code&gt;&lt;/strong&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;HTML&lt;span&gt;&amp;nbsp;element serves as a mechanism for holding&amp;nbsp;&lt;/span&gt;HTML&lt;span&gt;&amp;nbsp;fragments, which can either be used later via JavaScript or generated immediately into shadow DOM.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="4370">
                <material>
                  <mattext texttype="text/plain">&lt;template&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="1520">
                <material>
                  <mattext texttype="text/plain">&lt;details&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="252">
                <material>
                  <mattext texttype="text/plain">&lt;frag&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="3478">
                <material>
                  <mattext texttype="text/plain">&lt;fragment&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">4370</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g2e4d5031950aae31f8016c39f2ab821c" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>2275,5542,2634,60</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>g7331d345ecd2beb46b481e7f0534f038</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;In the native browser web API learning activity's &lt;a class="inline_disabled" href="https://codepen.io/BYU-Idaho/pen/NPPZXzp" target="_blank"&gt;CodePen&lt;/a&gt;, why was there no welcome message displayed after correctly going through steps 1 through 5 of the activity?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="2275">
                <material>
                  <mattext texttype="text/plain">Because the application used sessionStorage</mattext>
                </material>
              </response_label>
              <response_label ident="5542">
                <material>
                  <mattext texttype="text/plain">Because the application used localStorage</mattext>
                </material>
              </response_label>
              <response_label ident="2634">
                <material>
                  <mattext texttype="text/plain">Because the browser tab was refreshed.</mattext>
                </material>
              </response_label>
              <response_label ident="60">
                <material>
                  <mattext texttype="text/plain">Because the browser tab emptied the cache and hard reloaded</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">2275</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g717d73d97a4a4695f7f274f9cf98dd8c" title="Template Element">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>8131,3131,4453,6909</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>g74306f8d19fac3ec30510fbdddeb6839</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is a key characteristic of the HTML &lt;code data-start="155" data-end="167"&gt;&amp;lt;template&amp;gt;&lt;/code&gt; element?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="8131">
                <material>
                  <mattext texttype="text/plain">It holds HTML content that is not rendered until it is activated via JavaScript.</mattext>
                </material>
              </response_label>
              <response_label ident="3131">
                <material>
                  <mattext texttype="text/plain">It renders its content immediately when the page loads.</mattext>
                </material>
              </response_label>
              <response_label ident="4453">
                <material>
                  <mattext texttype="text/plain">It allows CSS to be scoped to a specific element.</mattext>
                </material>
              </response_label>
              <response_label ident="6909">
                <material>
                  <mattext texttype="text/plain">It is required for all form elements to function correctly.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">8131</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g3c9664f4b81aa230ec9d03bb2809f544" title="window">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>true_false_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>3507,4905</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf6ad625e505f913e8b0d703d28c3bdcd</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;You must always include &lt;code data-start="551" data-end="560" data-is-only-node=""&gt;window.&lt;/code&gt; when accessing global methods like &lt;code data-start="596" data-end="605"&gt;alert()&lt;/code&gt; or &lt;code data-start="609" data-end="623"&gt;localStorage&lt;/code&gt;.&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="3507">
                <material>
                  <mattext texttype="text/plain">True</mattext>
                </material>
              </response_label>
              <response_label ident="4905">
                <material>
                  <mattext texttype="text/plain">False</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">4905</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g11e3c439cc1699ee2dbea0fd358330cc" title="geolocation">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>9348,8439,2922,1421</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>g3cf70085cab49f2ce45ccc681ee78bfc</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Using your browser's DevTools, inspect the &lt;strong&gt;getGeoLocation.js&lt;/strong&gt; script supporting the &lt;code&gt;navigator.geolocation.getCurrentPosition&lt;/code&gt; exercise in the Geolocation API section of the &lt;a class="inline_disabled" href="https://byui-cse.github.io/wdd330-ww-course/week02/prepare-web-apis.html" target="_blank"&gt;native browser web API learning activity&lt;/a&gt;.&lt;/p&gt;
&lt;p&gt;Which of the following is &lt;strong&gt;not&lt;/strong&gt; provided as a region in the conditional switch statement based upon latitude and longitude?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="9348">
                <material>
                  <mattext texttype="text/plain">Middle East</mattext>
                </material>
              </response_label>
              <response_label ident="8439">
                <material>
                  <mattext texttype="text/plain">Africa</mattext>
                </material>
              </response_label>
              <response_label ident="2922">
                <material>
                  <mattext texttype="text/plain">Central America</mattext>
                </material>
              </response_label>
              <response_label ident="1421">
                <material>
                  <mattext texttype="text/plain">Oceania</mattext>
