        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the file extension that creates a Markdown file?&lt;/p&gt;
&lt;p&gt;&lt;span style="font-size: 10pt;"&gt;Example answer format: The answer for a plain text file would be&lt;strong&gt; .txt&lt;/strong&gt; or &lt;strong&gt;txt&lt;/strong&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_str ident="response1" rcardinality="Single">
            <render_fib>
              <response_label ident="answer1" rshuffle="No"/>
            </render_fib>
          </response_str>
        </presentation>
