              <fieldentry>gac773f042afd72c5862ae22b467325f9</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following lines of code correctly selects all the article elements on the page?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="6787">
                <material>
                  <mattext texttype="text/plain">document.querySelectorAll('article')</mattext>
                </material>
              </response_label>
              <response_label ident="2516">
                <material>
                  <mattext texttype="text/plain">document.getElementById('article')</mattext>
                </material>
              </response_label>
              <response_label ident="4656">
                <material>
                  <mattext texttype="text/plain">document.querySelector('#article');</mattext>
                </material>
              </response_label>
              <response_label ident="9316">
                <material>
                  <mattext texttype="text/plain">document.querySelector('.article')</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">6787</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="ge724134d8c6dd379adb2bab7b80125bc" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>6463,9498,8287,7567</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>g7851086b86a2b6fa310432d1792e9271</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following lines correctly adds a click event handler to a button with the ID &lt;code data-start="207" data-end="220"&gt;"order"&lt;/code&gt;?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="6463">
                <material>
                  <mattext texttype="text/plain">document.querySelector("#order").addEventListener("click", function() { alert("Submitted"); });</mattext>
                </material>
              </response_label>
              <response_label ident="9498">
                <material>
                  <mattext texttype="text/plain">order.click = function() { alert("Submitted"); }</mattext>
                </material>
              </response_label>
              <response_label ident="8287">
                <material>
                  <mattext texttype="text/plain">document.getElementById("order").onclick("Submitted");</mattext>
                </material>
              </response_label>
              <response_label ident="7567">
                <material>
                  <mattext texttype="text/plain">document.addClickListener("order", function() { alert("Submitted"); });</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">6463</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g85798f3abb503051ac0a4fc1c8c39375" title="this">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>6171,1675,8437,7828</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>g20f8d837dd65510847f357be2ff83ae7</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Why is the &lt;code data-start="154" data-end="160"&gt;this&lt;/code&gt; keyword important in JavaScript?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="6171">
                <material>
                  <mattext texttype="text/plain">It provides a way for functions and methods to access the object they belong to or were called on.</mattext>
                </material>
              </response_label>
              <response_label ident="1675">
                <material>
                  <mattext texttype="text/plain">It allows functions to refer to the variable named this in the global scope.</mattext>
                </material>
              </response_label>
              <response_label ident="8437">
                <material>
                  <mattext texttype="text/plain">It ensures that all variables are declared globally.</mattext>
                </material>
              </response_label>
              <response_label ident="7828">
                <material>
                  <mattext texttype="text/plain">It is required for declaring new variables inside a function.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">6171</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g5af82f0908393e45227c0a24c6f8cb41" title="version control">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>matching_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>4689,9355,2196,3254,8654</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>g7ec7a1d70403fa0a205984e39a10997b</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Match each term with its correct description:&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response_4689">
            <material>
              <mattext texttype="text/plain">git</mattext>
            </material>
            <render_choice>
              <response_label ident="6513">
                <material>
                  <mattext>A distributed version control system for tracking changes in source code.</mattext>
                </material>
              </response_label>
              <response_label ident="1338">
                <material>
                  <mattext>A hosted platform for storing and collaborating on Git repositories.</mattext>
                </material>
              </response_label>
              <response_label ident="91">
                <material>
                  <mattext>A snapshot of a repository’s history, allowing version control and collaboration.</mattext>
                </material>
              </response_label>
              <response_label ident="685">
                <material>
                  <mattext>A version of a repository that diverges from the main codebase to allow changes without affecting the original.</mattext>
                </material>
              </response_label>
              <response_label ident="6230">
                <material>
                  <mattext>A saved state of changes, including a message, that records progress in a repository.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
          <response_lid ident="response_9355">
            <material>
              <mattext texttype="text/plain">GitHub</mattext>
            </material>
            <render_choice>
              <response_label ident="6513">
                <material>
                  <mattext>A distributed version control system for tracking changes in source code.</mattext>
                </material>
              </response_label>
              <response_label ident="1338">
                <material>
                  <mattext>A hosted platform for storing and collaborating on Git repositories.</mattext>
                </material>
              </response_label>
              <response_label ident="91">
                <material>
                  <mattext>A snapshot of a repository’s history, allowing version control and collaboration.</mattext>
