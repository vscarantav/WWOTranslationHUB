        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;&lt;span&gt;The&amp;nbsp;&lt;span style="text-decoration: underline;"&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;shows the changes in your branch to other people and allows people to accept, reject, or suggest additional changes to your branch.&lt;br&gt;In a side-by-side comparison, this feature is going to keep the changes you just made on your branch and propose applying them to the &lt;/span&gt;&lt;code&gt;main&lt;/code&gt;&lt;span&gt;&amp;nbsp;project branch.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="6924">
                <material>
                  <mattext texttype="text/plain">pull request</mattext>
                </material>
              </response_label>
              <response_label ident="3814">
                <material>
                  <mattext texttype="text/plain">merge</mattext>
                </material>
              </response_label>
              <response_label ident="8420">
                <material>
                  <mattext texttype="text/plain">action bot</mattext>
                </material>
              </response_label>
              <response_label ident="2872">
                <material>
                  <mattext texttype="text/plain">git-include</mattext>
                </material>
              </response_label>
