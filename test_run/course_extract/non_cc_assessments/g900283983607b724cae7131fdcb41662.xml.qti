    <section ident="root_section">
      <item ident="g575bd680c199253fd33ab0710a0db5b8" title="GitHub Basics">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>short_answer_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>5409,2473</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>g528c6a3445486043787ecfb098999c7d</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;By default, repositories on GitHub have one branch named&amp;nbsp;&lt;span style="text-decoration: underline;"&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt; and it is considered to be the definitive branch.&amp;nbsp;&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_str ident="response1" rcardinality="Single">
            <render_fib>
              <response_label ident="answer1" rshuffle="No"/>
            </render_fib>
          </response_str>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <varequal respident="response1">master</varequal>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="5409_fb"/>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">master</varequal>
              <varequal respident="response1">main</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="5409_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">This is from older accounts on GitHub. The new default branch is named &lt;strong&gt;&lt;em&gt;main&lt;/em&gt;&lt;/strong&gt;.</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="geb52d768fda1390493318d4aa2446274" title="Markdown">
