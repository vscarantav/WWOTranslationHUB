    <item ident="g72fdf8d8537e7216e925325924f51dc1" title="CSS @keyframe">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>541,2993,7086,7225</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A UI designer wants to create a loading spinner that consists of a single &lt;code&gt;&amp;lt;div&amp;gt;&lt;/code&gt; element. The desired animation is for the div to rotate a full 360 degrees continuously. The animation should take exactly 1.5 seconds to complete one full rotation and should loop forever.&lt;/p&gt;
&lt;p&gt;Which of the following CSS snippets will correctly create and apply this continuous spinning animation to the &lt;code&gt;.spinner&lt;/code&gt; class?&lt;/p&gt;
&lt;p&gt;A)&lt;/p&gt;
&lt;p&gt;@keyframes spin {&lt;br&gt;&amp;nbsp; from { transform: rotate(0deg); }&lt;br&gt;&amp;nbsp; to { transform: rotate(180deg); }&lt;br&gt;}&lt;/p&gt;
&lt;p&gt;.spinner {&lt;br&gt;&amp;nbsp; animation: spin 1.5s infinite;&lt;br&gt;}&lt;/p&gt;
&lt;p&gt;B)&lt;/p&gt;
&lt;p&gt;.spinner {&lt;br&gt;&amp;nbsp; transition: transform 1.5s linear;&lt;br&gt;}&lt;/p&gt;
&lt;p&gt;.spinner:active {&lt;br&gt;&amp;nbsp; transform: rotate(360deg);&lt;br&gt;}&lt;/p&gt;
&lt;p&gt;C)&lt;/p&gt;
&lt;p&gt;@keyframes spin {&lt;br&gt;&amp;nbsp; to { transform: rotate(360deg); }&lt;br&gt;}&lt;/p&gt;
&lt;p&gt;.spinner {&lt;br&gt;&amp;nbsp; animation-name: spin;&lt;br&gt;&amp;nbsp; animation-duration: 1.5s;&lt;br&gt;}&lt;/p&gt;
&lt;p&gt;D)&lt;/p&gt;
&lt;p&gt;@keyframes spin {&lt;br&gt;&amp;nbsp; from { transform: rotate(0deg); }&lt;br&gt;&amp;nbsp; to { transform: rotate(360deg); }&lt;br&gt;}&lt;/p&gt;
&lt;p&gt;.spinner {&lt;br&gt;&amp;nbsp; animation: spin 1.5s linear infinite;&lt;br&gt;}&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="541">
              <material>
                <mattext texttype="text/plain">D</mattext>
              </material>
            </response_label>
            <response_label ident="2993">
              <material>
                <mattext texttype="text/plain">A</mattext>
              </material>
            </response_label>
            <response_label ident="7086">
              <material>
                <mattext texttype="text/plain">C</mattext>
              </material>
            </response_label>
            <response_label ident="7225">
              <material>
                <mattext texttype="text/plain">B</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">541</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="gf71b7ed34da9558b37489f73cf35d57f" title="CSS Transition">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>5179,2889,196,6991</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A developer wants a button to smoothly fade out when a &lt;code&gt;.hidden&lt;/code&gt; class is added to it. Why is a &lt;code&gt;transition&lt;/code&gt; a more direct and simpler solution for this specific scenario compared to an &lt;code&gt;animation&lt;/code&gt;?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5179">
              <material>
                <mattext texttype="text/plain">The task involves a simple, one-way change from a starting state (visible) to an ending state (hidden), which is the exact purpose of a transition.</mattext>
              </material>
            </response_label>
            <response_label ident="2889">
              <material>
                <mattext texttype="text/plain">Animations cannot change the opacity property.</mattext>
              </material>
            </response_label>
            <response_label ident="196">
              <material>
                <mattext texttype="text/plain">Animations require a state change (like :hover or adding a class) to begin, while transitions do not.</mattext>
              </material>
            </response_label>
            <response_label ident="6991">
              <material>
                <mattext texttype="text/plain">Using animation would require at least three keyframe steps (0%, 50%, 100%) to work correctly.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">5179</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
