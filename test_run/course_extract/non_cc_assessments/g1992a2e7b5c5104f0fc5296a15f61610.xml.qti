    <item ident="ga6fe19b28025caac0b2d490d263a3a38" title="Fetch">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9834,3363,1147,5571</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;You need to send a JavaScript object to a server endpoint using a &lt;code&gt;POST&lt;/code&gt; request. Which code snippet correctly configures the &lt;code&gt;fetch&lt;/code&gt; call to do this?&lt;/p&gt;
&lt;p&gt;A)&lt;/p&gt;
&lt;pre&gt;fetch(&lt;span class="hljs-string"&gt;'/api/data'&lt;/span&gt;, {&lt;br&gt;  &lt;span class="hljs-attr"&gt;method&lt;/span&gt;: &lt;span class="hljs-string"&gt;'POST'&lt;/span&gt;,&lt;br&gt;  &lt;span class="hljs-attr"&gt;body&lt;/span&gt;: { &lt;span class="hljs-attr"&gt;id&lt;/span&gt;: &lt;span class="hljs-number"&gt;1&lt;/span&gt;, &lt;span class="hljs-attr"&gt;name&lt;/span&gt;: &lt;span class="hljs-string"&gt;'test'&lt;/span&gt; }&lt;br&gt;});&lt;/pre&gt;
&lt;p&gt;B)&lt;/p&gt;
&lt;pre&gt;fetch(&lt;span class="hljs-string"&gt;'/api/data'&lt;/span&gt;, {&lt;br&gt;  &lt;span class="hljs-attr"&gt;method&lt;/span&gt;: &lt;span class="hljs-string"&gt;'POST'&lt;/span&gt;,&lt;br&gt;  &lt;span class="hljs-attr"&gt;headers&lt;/span&gt;: {&lt;br&gt;    &lt;span class="hljs-string"&gt;'Content-Type'&lt;/span&gt;: &lt;span class="hljs-string"&gt;'application/json'&lt;br&gt;&lt;/span&gt;  },&lt;br&gt;  &lt;span class="hljs-attr"&gt;body&lt;/span&gt;: &lt;span class="hljs-built_in"&gt;JSON&lt;/span&gt;.stringify({ &lt;span class="hljs-attr"&gt;id&lt;/span&gt;: &lt;span class="hljs-number"&gt;1&lt;/span&gt;, &lt;span class="hljs-attr"&gt;name&lt;/span&gt;: &lt;span class="hljs-string"&gt;'test'&lt;/span&gt; })&lt;br&gt; });&lt;/pre&gt;
&lt;p&gt;C)&lt;/p&gt;
&lt;pre&gt;fetch(&lt;span class="hljs-string"&gt;'/api/data'&lt;/span&gt;, {&lt;br&gt;  &lt;span class="hljs-attr"&gt;method&lt;/span&gt;: &lt;span class="hljs-string"&gt;'GET'&lt;/span&gt;,&lt;br&gt;  &lt;span class="hljs-attr"&gt;headers&lt;/span&gt;: {&lt;br&gt;    &lt;span class="hljs-string"&gt;'Content-Type'&lt;/span&gt;: &lt;span class="hljs-string"&gt;'application/json'&lt;br&gt;&lt;/span&gt;  },&lt;br&gt;  &lt;span class="hljs-attr"&gt;body&lt;/span&gt;: &lt;span class="hljs-built_in"&gt;JSON&lt;/span&gt;.stringify({ &lt;span class="hljs-attr"&gt;id&lt;/span&gt;: &lt;span class="hljs-number"&gt;1&lt;/span&gt;, &lt;span class="hljs-attr"&gt;name&lt;/span&gt;: &lt;span class="hljs-string"&gt;'test'&lt;/span&gt; })&lt;br&gt;});&lt;/pre&gt;
&lt;p&gt;D)&lt;/p&gt;
&lt;pre&gt;const formData = new FormData();&lt;br&gt;formData.append('id', 1);&lt;br&gt;formData.append('name', 'test');&lt;br&gt;fetch('/api/data', {&lt;br&gt;&amp;nbsp; method: 'POST',&lt;br&gt;&amp;nbsp; headers: {&lt;br&gt;&amp;nbsp; &amp;nbsp; 'Content-Type': 'application/json'&lt;br&gt;&amp;nbsp; },&lt;br&gt;&amp;nbsp; body: formData&lt;br&gt;});&lt;/pre&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9834">
              <material>
                <mattext texttype="text/plain">B</mattext>
              </material>
            </response_label>
            <response_label ident="3363">
