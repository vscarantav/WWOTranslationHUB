&lt;p&gt;&lt;span style="font-size: 10pt;"&gt;&lt;em&gt;Do not include any notation like { :&lt;br&gt;Just write the selector using standard CSS selector subject notation.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;pre&gt;article {&lt;br&gt;&amp;nbsp; color: black;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;amp; a {&lt;br&gt;&amp;nbsp; &amp;nbsp; color: blue;&lt;br&gt;&amp;nbsp; }&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;amp;:hover {&lt;br&gt;&amp;nbsp; &amp;nbsp; color: red;&lt;br&gt;&amp;nbsp; }&lt;br&gt;}&lt;/pre&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_str ident="response1" rcardinality="Single">
          <render_fib>
            <response_label ident="answer1" rshuffle="No"/>
          </render_fib>
        </response_str>
