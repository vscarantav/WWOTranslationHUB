      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;In the native browser web API learning activity's CodePen, why was there no welcome message displayed after correctly going through steps 1 through 5 of the activity?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="2275">
              <material>
                <mattext texttype="text/plain">Because the application used sessionStorage</mattext>
              </material>
            </response_label>
            <response_label ident="5542">
              <material>
                <mattext texttype="text/plain">Because the application used localStorage</mattext>
              </material>
            </response_label>
            <response_label ident="2634">
              <material>
                <mattext texttype="text/plain">Because the browser tab was refreshed.</mattext>
              </material>
            </response_label>
            <response_label ident="60">
              <material>
                <mattext texttype="text/plain">Because the browser tab emptied the cache and hard reloaded</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">2275</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="g83f4127d408fcb1a80ea35fbe40bdb71" title="Question">
