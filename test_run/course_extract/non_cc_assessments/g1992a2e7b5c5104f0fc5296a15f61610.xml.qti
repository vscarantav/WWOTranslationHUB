    <item ident="g738f81f8c48ac1fc70b1b378ce3b71ac" title="Closures">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>6708,9846,2784,1458</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Consider the following JavaScript code. What will be logged to the console when &lt;code&gt;counter()&lt;/code&gt; is called the third time?&lt;/p&gt;
&lt;pre&gt;function createAdder(x) {&lt;br&gt;&amp;nbsp; return function(y) {&lt;br&gt;&amp;nbsp; &amp;nbsp; return x + y;&lt;br&gt;&amp;nbsp; };&lt;br&gt;}&lt;br&gt;&lt;br&gt;const addFive = createAdder(5);&lt;br&gt;const addTen = createAdder(10);&lt;br&gt;&lt;br&gt;console.log(addTen(3));&lt;/pre&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6708">
              <material>
                <mattext texttype="text/plain">13</mattext>
              </material>
            </response_label>
            <response_label ident="9846">
              <material>
                <mattext texttype="text/plain">8</mattext>
              </material>
            </response_label>
            <response_label ident="2784">
              <material>
                <mattext texttype="text/plain">15</mattext>
              </material>
            </response_label>
            <response_label ident="1458">
              <material>
                <mattext texttype="text/plain">NaN</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6708</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
