      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;When applying CSS-only validation to the contact form provided (&lt;a class="ng-star-inserted" href="https://codepen.io/blazzard-jason/pen/dBjWje" target="_blank"&gt;Learning Activity CodePen&lt;/a&gt;), which of the following groups of CSS pseudo-classes is most directly used to style an input field based on whether its current value meets HTML5 validation constraints (e.g., being a correctly formatted email or a filled-in required field)?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9296">
              <material>
                <mattext texttype="text/plain">:valid, :invalid, :required</mattext>
              </material>
            </response_label>
            <response_label ident="8744">
              <material>
                <mattext texttype="text/plain">:hover, :active, :focus</mattext>
              </material>
            </response_label>
            <response_label ident="527">
              <material>
                <mattext texttype="text/plain">::before, ::after, ::placeholder-shown</mattext>
              </material>
            </response_label>
            <response_label ident="2677">
              <material>
                <mattext texttype="text/plain">:validity, :check-form</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">9296</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
