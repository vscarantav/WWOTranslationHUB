    <item ident="gb7e423ce44706c13f36a1d03a34e1e32" title="nested media queries">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>6490,4293,6444,1217</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following statements accurately describes how media queries (&lt;code&gt;@media&lt;/code&gt;) can be used with modern CSS nesting?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6490">
              <material>
                <mattext texttype="text/plain">Media queries can be nested directly inside a style rule to apply styles to that parent selector under specific conditions.</mattext>
              </material>
            </response_label>
            <response_label ident="4293">
              <material>
                <mattext texttype="text/plain">Nesting media queries is only possible when using CSS preprocessors like Sass, not in native CSS.</mattext>
              </material>
            </response_label>
            <response_label ident="6444">
              <material>
                <mattext texttype="text/plain">Media queries must use the &amp; symbol to be nested correctly (e.g., &amp; @media (...)).</mattext>
              </material>
            </response_label>
            <response_label ident="1217">
              <material>
                <mattext texttype="text/plain">Media queries cannot be nested inside a style rule and must always wrap the entire selector block.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6490</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="gac6afae57f7d57c9db304f1e62fc987f" title="null vs. undefined in async">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>5824,7919,8889,5214</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Given this code snippet which fetches data from a third-party API,&lt;/p&gt;
&lt;pre&gt;&lt;span class="token keyword"&gt;const&lt;/span&gt;&lt;span&gt; url &lt;/span&gt;&lt;span class="token operator"&gt;=&lt;/span&gt; &lt;span class="token string"&gt;"https://pokeapi.co/api/v2/pokemon/ditto"&lt;/span&gt;&lt;span class="token punctuation"&gt;;&lt;/span&gt;&lt;br&gt;&lt;span class="token keyword"&gt;let&lt;/span&gt;&lt;span&gt; results &lt;/span&gt;&lt;span class="token operator"&gt;=&lt;/span&gt; &lt;span class="token keyword"&gt;null&lt;/span&gt;&lt;span class="token punctuation"&gt;;&lt;br&gt;&lt;/span&gt;&lt;br&gt;&lt;span class="token keyword"&gt;async&lt;/span&gt; &lt;span class="token keyword"&gt;function&lt;/span&gt; &lt;span class="token function"&gt;getPokemon&lt;/span&gt;&lt;span class="token punctuation"&gt;(&lt;/span&gt;&lt;span class="token parameter"&gt;url&lt;/span&gt;&lt;span class="token punctuation"&gt;)&lt;/span&gt; &lt;span class="token punctuation"&gt;{&lt;/span&gt;&lt;br&gt;&lt;span class="token keyword"&gt;&amp;nbsp; const&lt;/span&gt;&lt;span&gt; response &lt;/span&gt;&lt;span class="token operator"&gt;=&lt;/span&gt; &lt;span class="token keyword"&gt;await&lt;/span&gt; &lt;span class="token function"&gt;fetch&lt;/span&gt;&lt;span class="token punctuation"&gt;(&lt;/span&gt;&lt;span&gt;url&lt;/span&gt;&lt;span class="token punctuation"&gt;)&lt;/span&gt;&lt;span class="token punctuation"&gt;;&lt;/span&gt;&lt;br&gt;&lt;span class="token keyword"&gt;&amp;nbsp; if&lt;/span&gt; &lt;span class="token punctuation"&gt;(&lt;/span&gt;&lt;span&gt;response&lt;/span&gt;&lt;span class="token punctuation"&gt;.&lt;/span&gt;&lt;span&gt;ok&lt;/span&gt;&lt;span class="token punctuation"&gt;)&lt;/span&gt; &lt;span class="token punctuation"&gt;{&lt;/span&gt;&lt;br&gt;&lt;span class="token comment"&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span class="token keyword"&gt;const&lt;/span&gt;&lt;span&gt; data &lt;/span&gt;&lt;span class="token operator"&gt;=&lt;/span&gt; &lt;span class="token keyword"&gt;await&lt;/span&gt;&lt;span&gt; response&lt;/span&gt;&lt;span class="token punctuation"&gt;.&lt;/span&gt;&lt;span class="token function"&gt;json&lt;/span&gt;&lt;span class="token punctuation"&gt;(&lt;/span&gt;&lt;span class="token punctuation"&gt;)&lt;/span&gt;&lt;span class="token punctuation"&gt;;&lt;/span&gt;&lt;br&gt;&lt;span class="token function"&gt;&amp;nbsp; &amp;nbsp; doStuff&lt;/span&gt;&lt;span class="token punctuation"&gt;(&lt;/span&gt;&lt;span&gt;data&lt;/span&gt;&lt;span class="token punctuation"&gt;)&lt;/span&gt;&lt;span class="token punctuation"&gt;;&lt;/span&gt;&lt;br&gt;&lt;span class="token punctuation"&gt;&amp;nbsp; }&lt;/span&gt;&lt;br&gt;&lt;span class="token punctuation"&gt;}&lt;br&gt;&lt;/span&gt;&lt;br&gt;&lt;span class="token keyword"&gt;function&lt;/span&gt; &lt;span class="token function"&gt;doStuff&lt;/span&gt;&lt;span class="token punctuation"&gt;(&lt;/span&gt;&lt;span class="token parameter"&gt;data&lt;/span&gt;&lt;span class="token punctuation"&gt;)&lt;/span&gt; &lt;span class="token punctuation"&gt;{&lt;/span&gt;&lt;br&gt;&lt;span&gt;  results &lt;/span&gt;&lt;span class="token operator"&gt;=&lt;/span&gt;&lt;span&gt; data&lt;/span&gt;&lt;span class="token punctuation"&gt;;&lt;/span&gt;&lt;br&gt;&lt;span&gt;  console&lt;/span&gt;&lt;span class="token punctuation"&gt;.&lt;/span&gt;&lt;span class="token function"&gt;log&lt;/span&gt;&lt;span class="token punctuation"&gt;(&lt;/span&gt;&lt;span class="token string"&gt;"first: "&lt;/span&gt;&lt;span class="token punctuation"&gt;,&lt;/span&gt;&lt;span&gt; results&lt;/span&gt;&lt;span class="token punctuation"&gt;)&lt;/span&gt;&lt;span class="token punctuation"&gt;;&lt;/span&gt;&lt;br&gt;&lt;span class="token punctuation"&gt;}&lt;br&gt;&lt;/span&gt;
&lt;span class="token function"&gt;getPokemon&lt;/span&gt;&lt;span class="token punctuation"&gt;(&lt;/span&gt;&lt;span&gt;url&lt;/span&gt;&lt;span class="token punctuation"&gt;)&lt;/span&gt;&lt;span class="token punctuation"&gt;;&lt;/span&gt;&lt;br&gt;&lt;span&gt;console&lt;/span&gt;&lt;span class="token punctuation"&gt;.&lt;/span&gt;&lt;span class="token function"&gt;log&lt;/span&gt;&lt;span class="token punctuation"&gt;(&lt;/span&gt;&lt;span class="token string"&gt;"second: "&lt;/span&gt;&lt;span class="token punctuation"&gt;,&lt;/span&gt;&lt;span&gt; results&lt;/span&gt;&lt;span class="token punctuation"&gt;)&lt;/span&gt;&lt;span class="token punctuation"&gt;;&lt;/span&gt;&lt;/pre&gt;
&lt;p&gt;why is a good idea to initialize the variable &lt;code&gt;results&lt;/code&gt; with the value of &lt;code&gt;null&lt;/code&gt; (line 2) versus being just &lt;code&gt;undefined&lt;/code&gt;?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5824">
              <material>
                <mattext texttype="text/plain">JavaScript runs the getPokemon(url) asynchronously, so the console.log("second: ", results); at the end will likely run before the fetch operation completes. At this point, results is still null, showing that the data has not yet been fetched.</mattext>
              </material>
            </response_label>
            <response_label ident="7919">
              <material>
                <mattext texttype="text/plain">The JavaScript will not run unless it is set to null. Not initializing the value causes an error when the second console log attempts to display the results.</mattext>
              </material>
            </response_label>
            <response_label ident="8889">
              <material>
                <mattext texttype="text/plain">The output of the console.log("second: ", results); will never be updated given this code.</mattext>
              </material>
            </response_label>
            <response_label ident="5214">
              <material>
                <mattext texttype="text/plain">Variables with undefined values produce a long message that is displayed to the user about the variable only being declared but not populated.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">5824</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="gac773f042afd72c5862ae22b467325f9" title="querySelector">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>6787,2516,4656,9316</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following lines of code correctly selects all the article elements on the page?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6787">
              <material>
                <mattext texttype="text/plain">document.querySelectorAll('article')</mattext>
              </material>
            </response_label>
            <response_label ident="2516">
              <material>
                <mattext texttype="text/plain">document.getElementById('article')</mattext>
              </material>
            </response_label>
            <response_label ident="4656">
              <material>
                <mattext texttype="text/plain">document.querySelector('#article');</mattext>
              </material>
            </response_label>
            <response_label ident="9316">
              <material>
                <mattext texttype="text/plain">document.querySelector('.article')</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6787</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="ge44a33795f5c1ca9563f4045fb8afacd" title="setInterval()">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>5686,4966,6953,3770</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What will be the output of the following JavaScript code?&lt;/p&gt;
&lt;pre&gt;let count = 0;&lt;br&gt;const intervalId = setInterval(() =&amp;gt; {&lt;br&gt;&amp;nbsp; count += 1;&lt;br&gt;&amp;nbsp; console.log(count);&lt;br&gt;&amp;nbsp; if (count === 3) {&lt;br&gt;&amp;nbsp; &amp;nbsp; clearInterval(intervalId);&lt;br&gt;&amp;nbsp; }&lt;br&gt;}, 1000);&lt;br&gt;&lt;br&gt;&lt;/pre&gt;
&lt;p&gt;&lt;em&gt;NOTE: The answers show the output in one line versus the actual multiline console result because of Canvas limitations.&lt;/em&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5686">
              <material>
                <mattext texttype="text/plain">1 2 3</mattext>
              </material>
            </response_label>
            <response_label ident="4966">
              <material>
                <mattext texttype="text/plain">1 2 3 4</mattext>
              </material>
            </response_label>
            <response_label ident="6953">
              <material>
                <mattext texttype="text/plain">0 1 2 3 4</mattext>
              </material>
            </response_label>
            <response_label ident="3770">
              <material>
                <mattext texttype="text/plain">0 1 2 3</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">5686</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_incorrect_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;ul&gt;
&lt;li&gt;The &lt;code&gt;setInterval()&lt;/code&gt; function will execute the callback function every 1000 milliseconds (1 second).&lt;/li&gt;
&lt;li&gt;The &lt;code&gt;count&lt;/code&gt; variable is incremented by 1 on each iteration, and its value is logged to the console.&lt;/li&gt;
&lt;li&gt;When &lt;code&gt;count&lt;/code&gt; reaches 3, the &lt;code&gt;clearInterval(intervalId)&lt;/code&gt; function is called to stop the interval, preventing further executions.&lt;/li&gt;
&lt;/ul&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g20f8d837dd65510847f357be2ff83ae7" title="this">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>6171,1675,8437,7828</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Why is the &lt;code data-start="154" data-end="160"&gt;this&lt;/code&gt; keyword important in JavaScript?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6171">
              <material>
                <mattext texttype="text/plain">It provides a way for functions and methods to access the object they belong to or were called on.</mattext>
              </material>
            </response_label>
            <response_label ident="1675">
              <material>
                <mattext texttype="text/plain">t allows functions to refer to the variable named this in the global scope.</mattext>
              </material>
            </response_label>
            <response_label ident="8437">
              <material>
                <mattext texttype="text/plain">It ensures that all variables are declared globally.</mattext>
              </material>
            </response_label>
            <response_label ident="7828">
              <material>
                <mattext texttype="text/plain">It is required for declaring new variables inside a function.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6171</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
