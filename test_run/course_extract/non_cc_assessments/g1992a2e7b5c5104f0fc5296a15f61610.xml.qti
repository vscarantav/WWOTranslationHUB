          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following lines correctly adds a click event handler to a button with the ID &lt;code data-start="207" data-end="220"&gt;"order"&lt;/code&gt;?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6463">
              <material>
                <mattext texttype="text/plain">document.querySelector("#order").addEventListener("click", function() { alert("Submitted"); });</mattext>
              </material>
            </response_label>
            <response_label ident="9498">
              <material>
                <mattext texttype="text/plain">order.click = function() { alert("Submitted"); }</mattext>
              </material>
            </response_label>
            <response_label ident="8287">
              <material>
                <mattext texttype="text/plain">document.getElementById("order").onclick("Submitted");</mattext>
              </material>
            </response_label>
            <response_label ident="7567">
              <material>
                <mattext texttype="text/plain">document.addClickListener("order", function() { alert("Submitted"); });</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6463</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
