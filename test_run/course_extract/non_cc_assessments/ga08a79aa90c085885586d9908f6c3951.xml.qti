    <item ident="g528c6a3445486043787ecfb098999c7d" title="GitHub Basics">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>short_answer_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>5409,2473</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span style="font-size: 10pt;"&gt;&lt;em&gt;Fill in the blank.&lt;/em&gt;&lt;/span&gt;&lt;br&gt;By default, repositories on GitHub have one branch named&amp;nbsp; __________&amp;nbsp; and it is considered to be the definitive branch.&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_str ident="response1" rcardinality="Single">
          <render_fib>
            <response_label ident="answer1" rshuffle="No"/>
          </render_fib>
        </response_str>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">master</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5409_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">master</varequal>
            <varequal respident="response1">main</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="5409_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">This is from older accounts on GitHub. The new default branch is named &lt;strong&gt;&lt;em&gt;main&lt;/em&gt;&lt;/strong&gt;.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gea621e3ea2702fb81be9d85b32dd489e" title="Markdown">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>short_answer_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>707,5445</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the file extension that creates a Markdown file?&lt;/p&gt;
&lt;p&gt;&lt;span style="font-size: 10pt;"&gt;&lt;em&gt;Example answer format: The answer for a plain text file would be&lt;strong&gt; .txt&lt;/strong&gt; or &lt;strong&gt;txt&lt;/strong&gt;&amp;nbsp;&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_str ident="response1" rcardinality="Single">
          <render_fib>
            <response_label ident="answer1" rshuffle="No"/>
          </render_fib>
        </response_str>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">.md</varequal>
            <varequal respident="response1">md</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="gfedaaf34fcdabc1963eaaf94cfac902a" title="Pull Requests">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>6924,3814,8420,2872</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span&gt;The __________ shows the changes in your branch to other people and allows people to accept, reject, or suggest additional changes to your branch.&lt;br&gt;In a side by side comparison, this feature is going to keep the changes you just made on your branch and propose applying them to the&amp;nbsp;&lt;/span&gt;&lt;code&gt;main&lt;/code&gt;&lt;span&gt;&amp;nbsp;project branch.&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6924">
              <material>
                <mattext texttype="text/plain">pull request</mattext>
              </material>
            </response_label>
            <response_label ident="3814">
              <material>
                <mattext texttype="text/plain">merge</mattext>
              </material>
            </response_label>
            <response_label ident="8420">
              <material>
                <mattext texttype="text/plain">action bot</mattext>
              </material>
            </response_label>
            <response_label ident="2872">
              <material>
                <mattext texttype="text/plain">git-include</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6924</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
