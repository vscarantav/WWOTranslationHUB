      <item ident="g2590dba6104bc69a4325fef480a46dfd" title="Closures">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>6708,9846,2784,1458</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>g738f81f8c48ac1fc70b1b378ce3b71ac</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Consider the following JavaScript code. What will be logged to the console?&lt;/p&gt;
&lt;pre&gt;function createAdder(x) {&lt;br&gt;&amp;nbsp; return function(y) {&lt;br&gt;&amp;nbsp; &amp;nbsp; return x + y;&lt;br&gt;&amp;nbsp; };&lt;br&gt;}&lt;br&gt;&lt;br&gt;const addFive = createAdder(5);&lt;br&gt;const addTen = createAdder(10);&lt;br&gt;&lt;br&gt;console.log(addTen(3));&lt;/pre&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="6708">
                <material>
                  <mattext texttype="text/plain">13</mattext>
                </material>
              </response_label>
              <response_label ident="9846">
                <material>
                  <mattext texttype="text/plain">8</mattext>
                </material>
              </response_label>
              <response_label ident="2784">
                <material>
                  <mattext texttype="text/plain">15</mattext>
                </material>
              </response_label>
              <response_label ident="1458">
                <material>
                  <mattext texttype="text/plain">NaN</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">6708</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="ga66850bb0778b846be5de243498432eb" title="Callbacks">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>7353,7995,855,4500</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>g9dec07993b436df75993fd6882ec3035</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;What are functions that are passed as arguments to other functions and are executed at a later time called?
This allows for asynchronous programming, where a function can continue executing while waiting for another function to complete.&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="7353">
                <material>
                  <mattext texttype="text/plain">callback</mattext>
                </material>
              </response_label>
              <response_label ident="7995">
                <material>
                  <mattext texttype="text/plain">recursion</mattext>
                </material>
              </response_label>
              <response_label ident="855">
                <material>
                  <mattext texttype="text/plain">hoisting</mattext>
                </material>
              </response_label>
              <response_label ident="4500">
                <material>
                  <mattext texttype="text/plain">IIFE</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">7353</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gada5f723805ea5158e72e271e4c5a138" title="Recursion">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>6271,3719,4174,1487</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>g83edc8d4d84ca4e44e31446dc22ba183</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A developer is tasked with creating a function to calculate the total size of all files within a directory structure, represented by a nested JavaScript object. The structure can have folders nested within other folders to an unknown depth. Each file has a &lt;code&gt;size&lt;/code&gt; property, and each folder has a &lt;code&gt;children&lt;/code&gt; property containing more files or folders.&lt;/p&gt;
&lt;pre&gt;const directory = {&lt;br&gt;&amp;nbsp; name: 'root',&lt;br&gt;&amp;nbsp; children: [&lt;br&gt;&amp;nbsp; &amp;nbsp; { name: 'file1.txt', size: 100 },&lt;br&gt;&amp;nbsp; &amp;nbsp; {&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; name: 'folderA',&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; children: [&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; { name: 'file2.txt', size: 250 },&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; name: 'subfolderB',&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; children: [{ name: 'file3.txt', size: 50 }]&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ]&lt;br&gt;&amp;nbsp; &amp;nbsp; },&lt;br&gt;&amp;nbsp; &amp;nbsp; { name: 'file4.txt', size: 120 }&lt;br&gt;&amp;nbsp; ]&lt;br&gt;};&lt;/pre&gt;
&lt;p&gt;Which programming concept is best suited for elegantly solving this problem, where a function must navigate a data structure of unknown and variable depth?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="6271">
                <material>
                  <mattext texttype="text/plain">Recursion, where the function calls itself to calculate the size of sub-folders and adds it to the total.</mattext>
                </material>
              </response_label>
              <response_label ident="3719">
                <material>
                  <mattext texttype="text/plain">A single for...of loop to iterate through the top-level children array and sum the sizes.</mattext>
                </material>
              </response_label>
              <response_label ident="4174">
                <material>
                  <mattext texttype="text/plain">A  .map() function to create a new array containing only the file sizes.</mattext>
                </material>
              </response_label>
              <response_label ident="1487">
                <material>
                  <mattext texttype="text/plain">A while loop that continues as long as the total size is less than a predefined limit.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">6271</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
