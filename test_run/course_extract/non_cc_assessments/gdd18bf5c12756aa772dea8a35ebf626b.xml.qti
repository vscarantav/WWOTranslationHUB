    <section ident="root_section">
      <item ident="g7c90083a4a658317e8c4ddb52aeb07f8" title="Web APIs">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_answers_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>9037,379,6648,8199</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gd8277ffbfa5acb8c6fd48c9d91f44444</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A well-designed Web API should abstract away the complexities of the server-side implementation. Users (developers) should be able to interact with the API without needing to understand the internal workings of the server.&amp;nbsp;&lt;/p&gt;
&lt;p&gt;Which of the following statements is another characteristic of a &lt;strong&gt;good&lt;em&gt; &lt;/em&gt;&lt;/strong&gt;API?\&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Select all that apply.&lt;/strong&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Multiple">
            <render_choice>
              <response_label ident="9037">
                <material>
                  <mattext texttype="text/plain">Clear and comprehensive documentation.</mattext>
                </material>
              </response_label>
              <response_label ident="379">
                <material>
                  <mattext texttype="text/plain">Returning data in a structured format like JSON or XML.</mattext>
                </material>
              </response_label>
              <response_label ident="6648">
                <material>
                  <mattext texttype="text/plain">Using standard HTTP methods like GET, POST, PUT, and DELETE.</mattext>
                </material>
              </response_label>
              <response_label ident="8199">
                <material>
                  <mattext texttype="text/plain">Requiring developers to have extensive knowledge of the server-side implementation.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <and>
                <varequal respident="response1">9037</varequal>
                <varequal respident="response1">379</varequal>
                <varequal respident="response1">6648</varequal>
                <not>
                  <varequal respident="response1">8199</varequal>
                </not>
              </and>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
