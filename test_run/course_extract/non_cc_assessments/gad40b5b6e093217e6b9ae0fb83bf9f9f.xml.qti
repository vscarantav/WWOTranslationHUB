        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;&lt;span class="TextRun SCXW56497021 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW56497021 BCX8"&gt;I have a computer that I can use for this course.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span&gt;&lt;span class="TextRun SCXW56497021 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW56497021 BCX8"&gt;(&lt;/span&gt;&lt;span class="NormalTextRun SCXW56497021 BCX8"&gt;This course&amp;nbsp;&lt;strong&gt;can&lt;/strong&gt;&lt;/span&gt;&lt;strong&gt;&lt;span class="NormalTextRun SCXW56497021 BCX8"&gt;not&lt;/span&gt;&lt;/strong&gt;&lt;span class="NormalTextRun SCXW56497021 BCX8"&gt;&lt;span style="color: #e03e2d;"&gt;&lt;strong&gt;&amp;nbsp;&lt;/strong&gt;&lt;/span&gt;be completed on a mobile device.&lt;/span&gt;&lt;span class="NormalTextRun SCXW56497021 BCX8"&gt;)&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW56497021 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:false,&amp;quot;134233118&amp;quot;:false,&amp;quot;201341983&amp;quot;:0,&amp;quot;335551550&amp;quot;:1,&amp;quot;335551620&amp;quot;:1,&amp;quot;335559737&amp;quot;:0,&amp;quot;335559738&amp;quot;:0,&amp;quot;335559739&amp;quot;:160,&amp;quot;335559740&amp;quot;:279}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="7104">
                <material>
                  <mattext texttype="text/plain">True</mattext>
                </material>
              </response_label>
              <response_label ident="7988">
                <material>
                  <mattext texttype="text/plain">False</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
