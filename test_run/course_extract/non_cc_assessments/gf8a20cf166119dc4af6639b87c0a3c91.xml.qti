          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the output of the following code?&lt;/p&gt;
&lt;pre&gt;&lt;span class="hljs-function"&gt;&lt;span class="hljs-keyword"&gt;function&lt;/span&gt; &lt;span class="hljs-title"&gt;outerFunction&lt;/span&gt;(&lt;span class="hljs-params"&gt;x&lt;/span&gt;) &lt;/span&gt;{&lt;br&gt;  &lt;span class="hljs-keyword"&gt;let&lt;/span&gt; innerVar = x * &lt;span class="hljs-number"&gt;2&lt;/span&gt;;&lt;br&gt;  &lt;br&gt;&lt;span class="hljs-function"&gt;&lt;span class="hljs-keyword"&gt;  function&lt;/span&gt; &lt;span class="hljs-title"&gt;innerFunction&lt;/span&gt;(&lt;span class="hljs-params"&gt;y&lt;/span&gt;) &lt;/span&gt;{&lt;br&gt;    &lt;span class="hljs-keyword"&gt;return&lt;/span&gt; innerVar + y;&lt;br&gt;  }&lt;br&gt;&lt;br&gt;  &lt;span class="hljs-keyword"&gt;return&lt;/span&gt; innerFunction;&lt;br&gt;}&lt;br&gt;&lt;br&gt;&lt;span class="hljs-keyword"&gt;let&lt;/span&gt; closure = outerFunction(&lt;span class="hljs-number"&gt;5&lt;/span&gt;);&lt;br&gt;&lt;span class="hljs-built_in"&gt;console&lt;/span&gt;.log(closure(&lt;span class="hljs-number"&gt;3&lt;/span&gt;));&lt;/pre&gt;&lt;/div&gt;</mattext>
