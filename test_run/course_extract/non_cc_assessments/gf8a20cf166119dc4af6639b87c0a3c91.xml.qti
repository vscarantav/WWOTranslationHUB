    <item ident="gd094bbae73a4c9944376cf3deb90116f" title="HTML Template">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>8976,9072,9466,1247</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following code snippets correctly retrieves the current page filename (assuming that it exists) from the URL using &lt;code&gt;window.location&lt;/code&gt;?&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="8976">
              <material>
                <mattext texttype="text/plain">window.location.pathname.split("/").pop();</mattext>
              </material>
            </response_label>
            <response_label ident="9072">
              <material>
                <mattext texttype="text/plain">window.location.hostname;</mattext>
              </material>
            </response_label>
            <response_label ident="9466">
              <material>
                <mattext texttype="text/plain">window.location.filename;</mattext>
              </material>
            </response_label>
            <response_label ident="1247">
              <material>
                <mattext texttype="text/plain">window.location.href.split('/').slice(-1)[0];</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">8976</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="g812bd83d926497b302462c14b38fd7aa" title="Hoisting">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>1479,9723,8427,3517</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Given this code snippet,&amp;nbsp;&lt;/p&gt;
&lt;p&gt;testFunction();&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;function testFunction() {&lt;br&gt;&amp;nbsp; console.log("Testing");&lt;br&gt;}&lt;/p&gt;
&lt;p&gt;Which of the following would be outputted to the console?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="1479">
              <material>
                <mattext texttype="text/plain">Testing</mattext>
              </material>
            </response_label>
            <response_label ident="9723">
              <material>
                <mattext texttype="text/plain">undefined</mattext>
              </material>
            </response_label>
            <response_label ident="8427">
              <material>
                <mattext texttype="text/plain">ReferenceError: Cannot access 'testFunction' before initialization</mattext>
              </material>
            </response_label>
            <response_label ident="3517">
              <material>
                <mattext texttype="text/plain">TypeError: testFunction is not a function</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">1479</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="gcceb792e8368185cdfc26c3d1fed66c2" title="OOP Basics">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>short_answer_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9372</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Given the following JavaScript class declaration,&lt;/p&gt;
&lt;pre&gt;class House {&lt;br&gt;  constructor(color) {&lt;br&gt;    this.color = color;&lt;br&gt;  }&lt;br&gt;  getFurniture() {&lt;br&gt;    return 'sofa';&lt;br&gt;  }&lt;br&gt;}&lt;/pre&gt;
&lt;p&gt;What will be the output to the console given the follow lines of code?&lt;/p&gt;
&lt;pre&gt;const houseObject = new House('red');&lt;br&gt;const houseObject2 = new House('blue');&lt;br&gt;console.log(houseObject2.getFurniture());&lt;/pre&gt;
&lt;p&gt;&lt;span style="font-size: 10pt;"&gt;&lt;em&gt;Your answer should not include any extra characters or numbers or notation. Just provide the exact console output.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_str ident="response1" rcardinality="Single">
          <render_fib>
            <response_label ident="answer1" rshuffle="No"/>
          </render_fib>
        </response_str>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">sofa</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="g788e11b5f1b7378f50a42da4637415b5" title="Promises">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>5644,7035,4370,7798</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;What is the purpose of a Promise in JavaScript?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5644">
              <material>
                <mattext texttype="text/plain">To execute code sequentially, blocking the main thread until all operations are complete.</mattext>
              </material>
            </response_label>
            <response_label ident="7035">
              <material>
                <mattext texttype="text/plain">To handle asynchronous operations, allowing code to continue running while waiting for a result.</mattext>
              </material>
            </response_label>
            <response_label ident="4370">
              <material>
                <mattext texttype="text/plain">To pause the execution of the code indefinitely until a user input is received.</mattext>
              </material>
            </response_label>
            <response_label ident="7798">
              <material>
                <mattext texttype="text/plain">To execute a function only once, preventing it from being called multiple times.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">5644</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="g2137014597498e5102e625f13984214f" title="Question 3">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>4272,6503,6378,2449</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following code snippets demonstrates an Immediately Invoked Function Expression (IIFE)?&lt;/p&gt;
&lt;p&gt;A.&amp;nbsp;&lt;/p&gt;
&lt;pre&gt;&lt;span class="hljs-function"&gt;&lt;span class="hljs-keyword"&gt;function&lt;/span&gt; &lt;span class="hljs-title"&gt;myFunction&lt;/span&gt;() &lt;/span&gt;{ &lt;br&gt;&lt;span class="hljs-built_in"&gt;  console&lt;/span&gt;.log(&lt;span class="hljs-string"&gt;"Hello!"&lt;/span&gt;);&lt;br&gt;}&lt;br&gt;myFunction(); &lt;/pre&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;B.&lt;/p&gt;
&lt;pre&gt;&lt;span class="hljs-keyword"&gt;let&lt;/span&gt; myFunction = &lt;span class="hljs-function"&gt;&lt;span class="hljs-keyword"&gt;function&lt;/span&gt;() &lt;/span&gt;{ &lt;br&gt;&lt;span class="hljs-built_in"&gt;  console&lt;/span&gt;.log(&lt;span class="hljs-string"&gt;"Hello!"&lt;/span&gt;);&lt;br&gt;};&lt;br&gt;myFunction();&lt;/pre&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;C.&lt;/p&gt;
&lt;pre&gt;(&lt;span class="hljs-function"&gt;&lt;span class="hljs-keyword"&gt;function&lt;/span&gt;() &lt;/span&gt;{&lt;br&gt;  &lt;span class="hljs-built_in"&gt;console&lt;/span&gt;.log(&lt;span class="hljs-string"&gt;"Hello!"&lt;/span&gt;);&lt;br&gt;})();&lt;/pre&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;D.&lt;/p&gt;
&lt;pre&gt;&lt;span class="hljs-function"&gt;&lt;span class="hljs-keyword"&gt;function&lt;/span&gt;() &lt;/span&gt;{&lt;br&gt;  &lt;span class="hljs-built_in"&gt;console&lt;/span&gt;.log(&lt;span class="hljs-string"&gt;"Hello!"&lt;/span&gt;);&lt;br&gt;}&lt;/pre&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="4272">
              <material>
                <mattext texttype="text/plain">C</mattext>
              </material>
            </response_label>
            <response_label ident="6503">
              <material>
                <mattext texttype="text/plain">A</mattext>
              </material>
            </response_label>
            <response_label ident="6378">
              <material>
                <mattext texttype="text/plain">B</mattext>
              </material>
            </response_label>
            <response_label ident="2449">
              <material>
                <mattext texttype="text/plain">D</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">4272</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="g72645554618e173658ac670afc70748f" title="Question 3">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>4272,6503,6378,2449</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following code snippets demonstrates an Immediately Invoked Function Expression (IIFE)?&lt;/p&gt;
&lt;p&gt;A.&amp;nbsp;&lt;/p&gt;
&lt;pre&gt;&lt;span class="hljs-function"&gt;&lt;span class="hljs-keyword"&gt;function&lt;/span&gt; &lt;span class="hljs-title"&gt;myFunction&lt;/span&gt;() &lt;/span&gt;{ &lt;br&gt;&lt;span class="hljs-built_in"&gt;  console&lt;/span&gt;.log(&lt;span class="hljs-string"&gt;"Hello!"&lt;/span&gt;);&lt;br&gt;}&lt;br&gt;myFunction(); &lt;/pre&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;B.&lt;/p&gt;
&lt;pre&gt;&lt;span class="hljs-keyword"&gt;let&lt;/span&gt; myFunction = &lt;span class="hljs-function"&gt;&lt;span class="hljs-keyword"&gt;function&lt;/span&gt;() &lt;/span&gt;{ &lt;br&gt;&lt;span class="hljs-built_in"&gt;  console&lt;/span&gt;.log(&lt;span class="hljs-string"&gt;"Hello!"&lt;/span&gt;);&lt;br&gt;};&lt;br&gt;myFunction();&lt;/pre&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;C.&lt;/p&gt;
&lt;pre&gt;(&lt;span class="hljs-function"&gt;&lt;span class="hljs-keyword"&gt;function&lt;/span&gt;() &lt;/span&gt;{&lt;br&gt;  &lt;span class="hljs-built_in"&gt;console&lt;/span&gt;.log(&lt;span class="hljs-string"&gt;"Hello!"&lt;/span&gt;);&lt;br&gt;})();&lt;/pre&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;D.&lt;/p&gt;
&lt;pre&gt;&lt;span class="hljs-function"&gt;&lt;span class="hljs-keyword"&gt;function&lt;/span&gt;() &lt;/span&gt;{&lt;br&gt;  &lt;span class="hljs-built_in"&gt;console&lt;/span&gt;.log(&lt;span class="hljs-string"&gt;"Hello!"&lt;/span&gt;);&lt;br&gt;}&lt;/pre&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
