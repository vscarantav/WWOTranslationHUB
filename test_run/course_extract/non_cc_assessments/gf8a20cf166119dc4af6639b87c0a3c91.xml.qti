    <item ident="gec21da5a256bb87265b78db66e0a3336" title="Canvas API">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>2367,8783,844,8607</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span&gt;The&amp;nbsp;&lt;/span&gt;&lt;strong&gt;Canvas API&lt;/strong&gt;&lt;span&gt;&amp;nbsp;provides a means for drawing graphics via JavaScript and the HTML ________________ &lt;/span&gt;&lt;span&gt;element.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="2367">
              <material>
                <mattext texttype="text/plain">canvas</mattext>
              </material>
            </response_label>
            <response_label ident="8783">
              <material>
                <mattext texttype="text/plain">drawing</mattext>
              </material>
            </response_label>
            <response_label ident="844">
              <material>
                <mattext texttype="text/plain">iframe</mattext>
              </material>
            </response_label>
            <response_label ident="8607">
              <material>
                <mattext texttype="text/plain">picture</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">2367</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="gde74e33e9e4cb1b715bfd2e776d74cf5" title="DevTools Debugging">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>1096,9847,6009,9145</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Which of the following is the correct way to set a breakpoint in a JavaScript file using browser DevTools?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="1096">
              <material>
                <mattext texttype="text/plain">Open DevTools, go to the "Sources" tab, navigate to the JavaScript file, and click on the line number where you want to set the breakpoint.</mattext>
              </material>
            </response_label>
            <response_label ident="9847">
              <material>
                <mattext texttype="text/plain">Open DevTools, go to the "Elements" tab, and right-click on a line in the HTML code to set a breakpoint.</mattext>
              </material>
            </response_label>
            <response_label ident="6009">
              <material>
                <mattext texttype="text/plain">Open DevTools, go to the "Console" tab, type the line number where you want the breakpoint, and press Enter.</mattext>
              </material>
            </response_label>
            <response_label ident="9145">
              <material>
                <mattext texttype="text/plain">Open DevTools, go to the "Network" tab, find the script in the network log, and click "Set Breakpoint" next to the desired line.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">1096</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
