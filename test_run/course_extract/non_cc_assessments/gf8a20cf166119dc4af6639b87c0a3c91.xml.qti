      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the output of this code?&lt;/p&gt;
&lt;pre&gt;&lt;span class="hljs-function"&gt;&lt;span class="hljs-keyword"&gt;function&lt;/span&gt; &lt;span class="hljs-title"&gt;processData&lt;/span&gt;(&lt;span class="hljs-params"&gt;data, successCallback, errorCallback&lt;/span&gt;) &lt;/span&gt;{&lt;br&gt;  &lt;span class="hljs-keyword"&gt;if&lt;/span&gt; (data !== &lt;span class="hljs-literal"&gt;null&lt;/span&gt;) {&lt;br&gt;    &lt;span class="hljs-comment"&gt;// Process the data (simulated)&lt;br&gt;&lt;/span&gt;    &lt;span class="hljs-keyword"&gt;let&lt;/span&gt; processedResult = data * &lt;span class="hljs-number"&gt;2&lt;/span&gt;;&lt;br&gt;    successCallback(processedResult);&lt;br&gt;  } &lt;span class="hljs-keyword"&gt;else&lt;/span&gt; { &lt;br&gt;&lt;span class="hljs-keyword"&gt;    let&lt;/span&gt; errorMessage = &lt;span class="hljs-string"&gt;"Invalid data!"&lt;/span&gt;;&lt;br&gt;    errorCallback(errorMessage);&lt;br&gt;  }&lt;br&gt;}&lt;br&gt;&lt;span class="hljs-function"&gt;&lt;span class="hljs-keyword"&gt;&lt;br&gt;function&lt;/span&gt; &lt;span class="hljs-title"&gt;handleSuccess&lt;/span&gt;(&lt;span class="hljs-params"&gt;result&lt;/span&gt;) &lt;/span&gt;{&lt;br&gt;  &lt;span class="hljs-built_in"&gt;console&lt;/span&gt;.log(&lt;span class="hljs-string"&gt;"Success! Result:"&lt;/span&gt;, result);&lt;br&gt;}&lt;br&gt;&lt;br&gt;&lt;span class="hljs-function"&gt;&lt;span class="hljs-keyword"&gt;function&lt;/span&gt; &lt;span class="hljs-title"&gt;handleError&lt;/span&gt;(&lt;span class="hljs-params"&gt;error&lt;/span&gt;) &lt;/span&gt;{&lt;br&gt;  &lt;span class="hljs-built_in"&gt;console&lt;/span&gt;.error(&lt;span class="hljs-string"&gt;"Error:"&lt;/span&gt;, error);&lt;br&gt;}&lt;br&gt;&lt;br&gt;processData(&lt;span class="hljs-number"&gt;5&lt;/span&gt;, handleSuccess, handleError);&lt;br&gt;processData(&lt;span class="hljs-literal"&gt;null&lt;/span&gt;, handleSuccess, handleError);&amp;nbsp;&lt;/pre&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5433">
              <material>
                <mattext texttype="text/plain">Success! Result: 10</mattext>
              </material>
            </response_label>
            <response_label ident="4903">
              <material>
                <mattext texttype="text/plain">Error: Invalid data!</mattext>
              </material>
            </response_label>
            <response_label ident="7894">
              <material>
                <mattext texttype="text/plain">Success! Result: null</mattext>
              </material>
            </response_label>
            <response_label ident="4065">
              <material>
                <mattext texttype="text/plain">Success! Result: 5</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">5433</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
