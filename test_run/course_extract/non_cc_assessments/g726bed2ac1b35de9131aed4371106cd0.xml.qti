          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="4203">
                <material>
                  <mattext texttype="text/plain">1. No impact</mattext>
                </material>
              </response_label>
              <response_label ident="6029">
                <material>
                  <mattext texttype="text/plain">2. Slight impact</mattext>
                </material>
              </response_label>
              <response_label ident="473">
                <material>
                  <mattext texttype="text/plain">3. Moderate impact</mattext>
                </material>
              </response_label>
              <response_label ident="1915">
                <material>
                  <mattext texttype="text/plain">4. Strong impact</mattext>
                </material>
              </response_label>
              <response_label ident="9209">
                <material>
                  <mattext texttype="text/plain">5. Extreme impact</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">4203</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
