      <item ident="gcceb792e8368185cdfc26c3d1fed66c2" title="OOP Basics">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.fib.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Given the following JavaScript class declaration,&lt;/p&gt;
&lt;pre&gt;class House {&lt;br&gt;  constructor(color) {&lt;br&gt;    this.color = color;&lt;br&gt;  }&lt;br&gt;  getFurniture() {&lt;br&gt;    return 'sofa';&lt;br&gt;  }&lt;br&gt;}&lt;/pre&gt;
&lt;p&gt;what will be the output to the console given the following lines of code?&lt;/p&gt;
&lt;pre&gt;const houseObject = new House('red');&lt;br&gt;const houseObject2 = new House('blue');&lt;br&gt;console.log(houseObject2.getFurniture());&lt;/pre&gt;
&lt;p&gt;&lt;span style="font-size: 10pt;"&gt;Your answer should not include any extra characters, numbers, or notation. Just provide the exact console output.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_str ident="response1" rcardinality="Single">
            <render_fib>
              <response_label ident="answer1" rshuffle="No"/>
            </render_fib>
          </response_str>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">sofa</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
