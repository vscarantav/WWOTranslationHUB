      <item ident="g3ff26ad8f3326e536c953d6d26da7fa3" title="FirstClassObjects">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_response.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What does the fact that functions in JavaScript are first-class objects mean?&lt;br&gt;&lt;em&gt;&lt;strong&gt;Select all statements below that are true.&lt;/strong&gt;&lt;/em&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Multiple">
            <render_choice>
              <response_label ident="1391">
                <material>
                  <mattext texttype="text/plain">You can store a function in a variable.</mattext>
                </material>
              </response_label>
              <response_label ident="4049">
                <material>
                  <mattext texttype="text/plain">You can pass a function as an argument to another function.</mattext>
                </material>
              </response_label>
              <response_label ident="1460">
                <material>
                  <mattext texttype="text/plain">A function can return another function as its result.</mattext>
                </material>
              </response_label>
              <response_label ident="6204">
                <material>
                  <mattext texttype="text/plain">You can store functions in arrays or objects.</mattext>
                </material>
              </response_label>
              <response_label ident="8774">
                <material>
                  <mattext texttype="text/plain">Functions have their own properties and methods.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <and>
                <varequal respident="response1">1391</varequal>
                <varequal respident="response1">4049</varequal>
                <varequal respident="response1">1460</varequal>
                <varequal respident="response1">6204</varequal>
                <varequal respident="response1">8774</varequal>
              </and>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gc994423f8700fa4d7d8811d1b71bc66e" title="Question">
